@page
@model MoneyTracker.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    // allow register mode via querystring: ?mode=register
    var mode = ViewContext.HttpContext.Request.Query["mode"].ToString();
}

<style>
    /* Page background */
    .sliding-auth-page {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: linear-gradient(180deg, #eef2f6 0%, #f7fbff 100%);
    }

    /* Card */
    .sliding-card {
        width: 960px;
        max-width: 96vw;
        height: 560px;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(17, 24, 39, 0.12);
        display: flex;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(6px);
    }

    /* Left animated panel */
    .panel-left {
        flex: 1 1 50%;
        position: relative;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        overflow: hidden;
    }

    /* animated gradient */
    .animated-gradient {
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, #00c853, #00b0ff, #7c4dff);
        background-size: 300% 300%;
        animation: gradientShift 12s linear infinite;
        filter: saturate(1.05) contrast(1.02);
    }

    @@keyframes gradientShift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* subtle noise overlay */
    .noise {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.06;
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><filter id="n"><feTurbulence baseFrequency="0.9" numOctaves="2" seed="2"/></filter><rect width="100%" height="100%" filter="url(%23n)"/></svg>');
        mix-blend-mode: overlay;
    }

    /* parallax icons */
    .parallax {
        position: absolute;
        will-change: transform;
    }

    .par-coin {
        width: 72px;
        right: 18%;
        top: 20%;
    }

    .par-chart {
        width: 90px;
        left: 12%;
        top: 24%;
    }

    .par-rocket {
        width: 64px;
        left: 30%;
        bottom: 16%;
    }

    .branding {
        position: relative;
        z-index: 3;
        text-align: center;
        user-select: none;
    }

    .branding .logo {
        width: 84px;
        height: 84px;
        border-radius: 12px;
        margin: 0 auto 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        background: rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 28px;
    }

    .branding h2 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    }

    .branding p {
        margin-top: 8px;
        opacity: 0.95;
        font-size: 0.95rem
    }

    /* Right panel - forms */
    .panel-right {
        flex: 1 1 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        position: relative;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.85));
    }

    .forms-wrap {
        width: 100%;
        max-width: 360px;
        position: relative;
        height: 100%;
    }

    .form-layer {
        position: absolute;
        inset: 0;
        background: transparent;
        transition: transform 600ms cubic-bezier(.2, .9, .25, 1), opacity 350ms ease;
        display: flex;
        align-items: center;
    }

    .form-card {
        width: 100%;
        background: white;
        border-radius: 12px;
        padding: 26px;
        box-shadow: 0 8px 28px rgba(18, 23, 35, 0.08);
    }

    /* Login on top by default */
    .form-layer.login {
        transform: translateX(0%);
        z-index: 6;
    }

    .form-layer.register {
        transform: translateX(110%);
        z-index: 5;
    }

    .forms-wrap.show-register .login {
        transform: translateX(-110%);
        opacity: 0.95;
    }

    .forms-wrap.show-register .register {
        transform: translateX(0%);
        opacity: 1;
        z-index: 7;
    }

    .form-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 8px
    }

    /* Floating label style */
    .floating {
        position: relative;
        margin-bottom: 14px
    }

    .floating input {
        width: 100%;
        padding: 14px 12px 10px 12px;
        border-radius: 8px;
        border: 1px solid #e6e6e9;
        transition: border-color .18s, box-shadow .18s;
    }

    .floating label {
        position: absolute;
        left: 12px;
        top: 12px;
        pointer-events: none;
        color: #777;
        font-size: 0.92rem;
        transition: transform .18s, font-size .18s, top .18s;
        transform-origin: left top;
    }

    .floating input:focus {
        outline: none;
        border-color: #1aa3a3;
        box-shadow: 0 6px 18px rgba(26, 163, 163, 0.08);
    }

    .floating input:not(:placeholder-shown)+label,
    .floating input:focus+label {
        transform: translateY(-10px) scale(.88);
        top: 6px;
        font-size: 0.78rem;
        color: #1aa3a3;
    }

    .social-row {
        display: flex;
        gap: 10px;
        margin-top: 10px
    }

    .social-btn {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 10px;
        border-radius: 8px;
        border: 1px solid #e6e6e9;
        background: #fff;
        cursor: pointer;
        transition: transform .12s, box-shadow .12s;
    }

    .social-btn:hover {
        transform: scale(1.03);
        box-shadow: 0 8px 22px rgba(2, 6, 23, 0.06);
    }

    .btn-primary-animated {
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: none;
        color: white;
        background: linear-gradient(90deg, #00c853, #00b0ff);
        cursor: pointer;
        transition: transform .12s, box-shadow .12s, opacity .12s;
    }

    .btn-primary-animated:disabled {
        opacity: 0.7;
        cursor: default;
    }

    .helper-links {
        font-size: 0.88rem;
        margin-top: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center
    }

    /* small responsive */
    @@media (max-width:900px) {
        .sliding-card {
            flex-direction: column;
            height: auto
        }

        .panel-left {
            height: 200px
        }

        .panel-right {
            padding: 20px
        }
    }
</style>

<div class="sliding-auth-page">
    <div class="sliding-card" id="slidingCard">
        <div class="panel-left" aria-hidden="true">
            <div class="animated-gradient"></div>
            <div class="noise" aria-hidden="true"></div>

            <!-- parallax decorative svgs -->
            <img class="parallax par-coin" src="/favicon.ico" alt="coin" />
            <svg class="parallax par-chart" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 17h18" stroke="rgba(255,255,255,0.9)" stroke-width="1.5" stroke-linecap="round" />
                <path d="M7 13v4M12 9v8M17 5v12" stroke="rgba(255,255,255,0.95)" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg class="parallax par-rocket" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3 7-3 3-3-3 3-7z" fill="rgba(255,255,255,0.95)" />
            </svg>

            <div class="branding">
                <div class="logo"><img src="/favicon.ico" alt="logo"
                        style="width:56px;height:56px;border-radius:10px;" /></div>
                <h2>Money Tracker</h2>
                <p>Quản lý tài chính, làm chủ tương lai</p>
            </div>
        </div>

        <div class="panel-right">
            <div class="forms-wrap @(mode == "register" ? "show-register" : "")" id="formsWrap">

                <!-- LOGIN LAYER -->
                <div class="form-layer login">
                    <div class="form-card">
                        <div class="form-title">Đăng nhập</div>
                        <form method="post" id="loginForm">
                            <div class="floating">
                                <input asp-for="Input.UserNameOrEmail" placeholder=" " autocomplete="username" />
                                <label for="Input_UserNameOrEmail">Email hoặc tên đăng nhập</label>
                                <span asp-validation-for="Input.UserNameOrEmail" class="text-danger small"></span>
                            </div>

                            <div class="floating">
                                <input asp-for="Input.Password" placeholder=" " type="password"
                                    autocomplete="current-password" />
                                <label for="Input_Password">Mật khẩu</label>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="helper-links">
                                <div><label style="font-size:0.9rem"><input asp-for="Input.RememberMe" /> Ghi
                                        nhớ</label></div>
                                <div><a asp-page="/Account/ForgotPassword">Quên mật khẩu?</a></div>
                            </div>

                            <div style="margin-top:14px">
                                <button id="loginBtn" type="submit" class="btn-primary-animated">Đăng nhập</button>
                            </div>

                            <div style="margin-top:12px; text-align:center; font-size:0.95rem">Chưa có tài khoản? <a
                                    href="javascript:void(0)" id="toRegister">Đăng ký</a></div>

                            <div style="margin-top:14px">
                                <div class="sep" style="text-align:center;color:#999"><span
                                        style="display:inline-block;width:30% ;height:1px;background:#eee;vertical-align:middle"></span>&nbsp;<strong
                                        style="font-weight:600;color:#999">HOẶC</strong>&nbsp;<span
                                        style="display:inline-block;width:30% ;height:1px;background:#eee;vertical-align:middle"></span>
                                </div>
                                <div class="social-row">
                                    <form method="get" action="/Account/ExternalLogin"
                                        style="width:100%;display:inline-flex;gap:10px">
                                        <input type="hidden" name="provider" value="Google" />
                                        <button type="submit" class="social-btn" title="Google">
                                            <img src="/wwwroot/lib/google-icon.png" alt="G" style="height:18px;" /> Tiếp
                                            tục với Google
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- REGISTER LAYER -->
                <div class="form-layer register">
                    <div class="form-card">
                        <div class="form-title">Tạo tài khoản</div>
                        <!-- This form posts to the Register page so the RegisterModel binds correctly -->
                        <form method="post" action="/Account/Register" id="registerForm">
                            <div class="floating">
                                <input name="Input.UserName" id="reg_UserName" placeholder=" " autocomplete="name" />
                                <label for="reg_UserName">Họ và tên</label>
                            </div>

                            <div class="floating">
                                <input name="Input.Email" id="reg_Email" placeholder=" " type="email"
                                    autocomplete="email" />
                                <label for="reg_Email">Email</label>
                            </div>

                            <div class="floating">
                                <input name="Input.Password" id="reg_Password" placeholder=" " type="password"
                                    autocomplete="new-password" />
                                <label for="reg_Password">Mật khẩu</label>
                            </div>

                            <div class="floating">
                                <input name="Input.ConfirmPassword" id="reg_ConfirmPassword" placeholder=" "
                                    type="password" autocomplete="new-password" />
                                <label for="reg_ConfirmPassword">Nhập lại mật khẩu</label>
                            </div>

                            <div style="display:flex;align-items:center;gap:8px;margin-top:6px">
                                <input type="checkbox" name="Input.AcceptTerms" id="reg_terms" /> <label for="reg_terms"
                                    style="font-size:0.9rem">Tôi đồng ý với điều khoản</label>
                            </div>

                            <div style="margin-top:12px">
                                <button id="registerBtn" type="submit" class="btn-primary-animated">Tạo tài
                                    khoản</button>
                            </div>

                            <div style="margin-top:12px; text-align:center; font-size:0.95rem">Đã có tài khoản? <a
                                    href="javascript:void(0)" id="toLogin">Đăng nhập</a></div>

                            <div style="margin-top:12px">
                                <div class="sep" style="text-align:center;color:#999"><span
                                        style="display:inline-block;width:30% ;height:1px;background:#eee;vertical-align:middle"></span>&nbsp;<strong
                                        style="font-weight:600;color:#999">HOẶC</strong>&nbsp;<span
                                        style="display:inline-block;width:30% ;height:1px;background:#eee;vertical-align:middle"></span>
                                </div>
                                <div class="social-row">
                                    <form method="get" action="/Account/ExternalLogin"
                                        style="width:100%;display:inline-flex;gap:10px">
                                        <input type="hidden" name="provider" value="Facebook" />
                                        <button type="submit" class="social-btn" title="Facebook">
                                            <img src="/wwwroot/lib/facebook-icon.png" alt="F" style="height:18px;" />
                                            Đăng ký với Facebook
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    // small parallax handler
    (function () {
        const wrap = document.querySelector('.panel-left');
        if (!wrap) return;
        const items = wrap.querySelectorAll('.parallax');
        wrap.addEventListener('mousemove', e => {
            const r = wrap.getBoundingClientRect();
            const cx = (e.clientX - r.left) / r.width - 0.5;
            const cy = (e.clientY - r.top) / r.height - 0.5;
            items.forEach((it, i) => {
                const depth = 6 + i * 4;
                const tx = -cx * depth;
                const ty = -cy * depth * 0.6;
                it.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
            });
        });
    })();

    // toggle forms
    (function () {
        const formsWrap = document.getElementById('formsWrap');
        const toRegister = document.getElementById('toRegister');
        const toLogin = document.getElementById('toLogin');
        if (toRegister) toRegister.addEventListener('click', () => formsWrap.classList.add('show-register'));
        if (toLogin) toLogin.addEventListener('click', () => formsWrap.classList.remove('show-register'));

        // floating label polyfill for inputs using placeholder-shown CSS
        function syncPlaceholders(root) {
            root.querySelectorAll('input').forEach(i => {
                if (i.placeholder === undefined) i.placeholder = ' ';
            });
        }
        syncPlaceholders(document);

        // button loading behavior
        const loginBtn = document.getElementById('loginBtn');
        const loginForm = document.getElementById('loginForm');
        if (loginForm && loginBtn) {
            loginForm.addEventListener('submit', function () {
                loginBtn.disabled = true; loginBtn.innerText = '';
                const spinner = document.createElement('span'); spinner.className = 'spinner-border spinner-border-sm'; spinner.setAttribute('role', 'status'); spinner.setAttribute('aria-hidden', 'true');
                loginBtn.appendChild(spinner);
            });
        }
        const regBtn = document.getElementById('registerBtn');
        const regForm = document.getElementById('registerForm');
        if (regForm && regBtn) {
            regForm.addEventListener('submit', function () {
                regBtn.disabled = true; regBtn.innerText = '';
                const spinner = document.createElement('span'); spinner.className = 'spinner-border spinner-border-sm'; spinner.setAttribute('role', 'status'); spinner.setAttribute('aria-hidden', 'true');
                regBtn.appendChild(spinner);
            });
        }
    })();
</script>