@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<h2>Change Password</h2>

<form method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Current Password</label>
        <input asp-for="Input.OldPassword" type="password" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">New Password</label>
        <input asp-for="Input.NewPassword" type="password" class="form-control" />
    </div>
    <button class="btn btn-primary" type="submit">Update</button>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="text-danger mt-2">@Model.Error</div>
    }
    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success mt-2">@Model.Success</div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


