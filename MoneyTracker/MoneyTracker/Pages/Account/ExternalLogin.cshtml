@page
@model MoneyTracker.Pages.Account.ExternalLoginModel
@{
    ViewData["Title"] = "External Login";
}

<div class="mt-3">
    <form method="post">
        <input type="hidden" name="provider" value="@Model.Provider" />
        <button class="btn btn-primary" type="submit">Continue with @Model.Provider</button>
    </form>
</div>


