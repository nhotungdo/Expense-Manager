@page
@model MoneyTracker.Pages.Account.TwoFactor.EnableModel
@{
    ViewData["Title"] = "Enable 2FA";
}

<h2>Enable Two-Factor Authentication (TOTP)</h2>

<p>Scan this QR code with Google Authenticator or any TOTP app, then enter the 6-digit code.</p>

<div class="mb-3">
    <img src="@Model.QrCodeDataUrl" alt="QR Code" />
</div>

<div class="mb-2">
    <strong>Manual key:</strong> @Model.ManualKey
</div>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Code" class="form-label"></label>
        <input asp-for="Input.Code" class="form-control" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Enable</button>
</form>

<partial name="_ValidationScriptsPartial" />


