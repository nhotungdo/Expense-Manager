@page "/Account/Logout"
@model MoneyTracker.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
    Layout = null; // No layout for logout page
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MoneyTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .logout-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 3rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            text-align: center;
            max-width: 400px;
            width: 90%;
        }
        
        .logout-icon {
            font-size: 4rem;
            color: #667eea;
            margin-bottom: 1.5rem;
            animation: pulse 2s infinite;
        }
        
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        
        .btn-logout {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 10px;
        }
        
        .btn-logout:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            color: white;
        }
        
        .btn-cancel {
            background: transparent;
            border: 2px solid #667eea;
            color: #667eea;
            padding: 10px 30px;
            border-radius: 25px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 10px;
        }
        
        .btn-cancel:hover {
            background: #667eea;
            color: white;
        }
        
        .loading-spinner {
            display: none;
            margin-left: 10px;
        }
    </style>
</head>
<body>
    <div class="logout-container">
        <div class="logout-icon">
            <i class="fas fa-sign-out-alt"></i>
        </div>
        
        <h2 class="mb-3">Đăng xuất</h2>
        <p class="text-muted mb-4">Bạn có chắc chắn muốn đăng xuất khỏi tài khoản?</p>
        
        <div class="d-flex justify-content-center flex-wrap">
            <button type="button" class="btn btn-logout" onclick="performLogout()">
                <i class="fas fa-sign-out-alt me-2"></i>
                Đăng xuất
                <div class="spinner-border spinner-border-sm loading-spinner" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </button>
            
            <button type="button" class="btn btn-cancel" onclick="cancelLogout()">
                <i class="fas fa-times me-2"></i>
                Hủy
            </button>
        </div>
        
        <div id="logoutMessage" class="mt-3" style="display: none;"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto logout after 3 seconds if user doesn't interact
        let autoLogoutTimer;
        
        function startAutoLogout() {
            autoLogoutTimer = setTimeout(() => {
                performLogout();
            }, 3000);
        }
        
        function cancelAutoLogout() {
            if (autoLogoutTimer) {
                clearTimeout(autoLogoutTimer);
            }
        }
        
        // Start auto logout when page loads
        document.addEventListener('DOMContentLoaded', function() {
            startAutoLogout();
        });
        
        async function performLogout() {
            const logoutBtn = document.querySelector('.btn-logout');
            const spinner = logoutBtn.querySelector('.loading-spinner');
            const messageDiv = document.getElementById('logoutMessage');
            
            // Show loading state
            logoutBtn.disabled = true;
            spinner.style.display = 'inline-block';
            logoutBtn.innerHTML = '<i class="fas fa-sign-out-alt me-2"></i>Đang đăng xuất...';
            
            try {
                // Call logout API
                const token = localStorage.getItem('authToken');
                if (token) {
                    await fetch('/api/auth/logout', {
                        method: 'POST',
                        headers: {
                            'Authorization': 'Bearer ' + token,
                            'Content-Type': 'application/json'
                        }
                    });
                }
                
                // Clear local storage
                localStorage.removeItem('authToken');
                localStorage.removeItem('user');
                sessionStorage.clear();
                
                // Show success message
                messageDiv.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>Đăng xuất thành công!</div>';
                messageDiv.style.display = 'block';
                
                // Redirect to homepage after 1 second
                setTimeout(() => {
                    window.location.href = '/HomePage';
                }, 1000);
                
            } catch (error) {
                console.error('Logout error:', error);
                
                // Even if API fails, clear local storage and redirect
                localStorage.removeItem('authToken');
                localStorage.removeItem('user');
                sessionStorage.clear();
                
                messageDiv.innerHTML = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i>Đã đăng xuất (có thể có lỗi kết nối)</div>';
                messageDiv.style.display = 'block';
                
                setTimeout(() => {
                    window.location.href = '/HomePage';
                }, 2000);
            }
        }
        
        function cancelLogout() {
            cancelAutoLogout();
            window.location.href = '/Dashboard';
        }
        
        // Cancel auto logout on any user interaction
        document.addEventListener('click', cancelAutoLogout);
        document.addEventListener('keydown', cancelAutoLogout);
    </script>
</body>
</html>
