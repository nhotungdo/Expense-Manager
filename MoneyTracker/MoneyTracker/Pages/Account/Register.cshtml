@page
@model MoneyTracker.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<!-- Lightweight redirect to the sliding login page in register mode -->
<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:40px">
    <div
        style="max-width:680px;text-align:center;padding:22px;border-radius:10px;background:#fff;box-shadow:0 8px 26px rgba(0,0,0,0.06)">
        <h3>Chuyển sang giao diện đăng ký...</h3>
        <p>Bạn sẽ được đưa tới giao diện đăng ký với hiệu ứng mượt mà.</p>
        <script>
            // navigate to Login but with mode=register so the sliding panel shows register
            window.location.replace('/Account/Login?mode=register');
        </script>
        <noscript>
            <div>JavaScript cần để hiển thị giao diện. <a href="/Account/Login?mode=register">Nhấn vào đây</a> để tiếp
                tục.</div>
        </noscript>
    </div>
</div>