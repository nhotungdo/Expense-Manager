@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<h2>Profile</h2>

<form method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input asp-for="Input.FirstName" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input asp-for="Input.LastName" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Date of Birth</label>
                <input asp-for="Input.DateOfBirth" type="date" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <input asp-for="Input.Address" class="form-control" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Language</label>
                <input asp-for="Input.Language" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Default Currency</label>
                <input asp-for="Input.DefaultCurrency" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Theme</label>
                <input asp-for="Input.Theme" class="form-control" />
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" asp-for="Input.EmailNotifications" />
                <label class="form-check-label">Email Notifications</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="Input.PushNotifications" />
                <label class="form-check-label">Push Notifications</label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="text-danger mt-2">@Model.Error</div>
    }
    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success mt-2">@Model.Success</div>
    }
</form>


