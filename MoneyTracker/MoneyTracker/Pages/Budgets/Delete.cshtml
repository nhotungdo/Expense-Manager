@page "{id:long}"
@model MoneyTracker.Pages.Budgets.DeleteModel
@{
    ViewData["Title"] = "Delete Budget";
}

<h2>Delete Budget</h2>
<div class="alert alert-danger">Are you sure you want to delete this budget?</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>


