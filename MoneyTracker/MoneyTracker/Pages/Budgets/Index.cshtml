@page "/Budgets"
@model MoneyTracker.Pages.Budgets.IndexModel
@{
    ViewData["Title"] = "Budgets";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Ngân sách</h2>
    <a class="btn btn-primary" asp-page="/Budgets/Create"><i class="fa-solid fa-plus me-1"></i>Thêm ngân sách</a>
</div>

<div class="table-responsive card border-0 shadow-sm">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Danh mục</th>
                <th>Giới hạn</th>
                <th>Đã chi</th>
                <th>% sử dụng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Ăn uống</td>
                <td>2,000,000</td>
                <td>1,200,000</td>
                <td style="min-width: 220px;">
                    <div class="progress" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar bg-success" style="width: 60%">60%</div>
                    </div>
                </td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Budgets/Edit"><i
                            class="fa-solid fa-pen-to-square"></i></a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="/Budgets/Delete"><i
                            class="fa-solid fa-trash"></i></a>
                </td>
            </tr>
        </tbody>
    </table>
</div>
