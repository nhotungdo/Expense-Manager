@page
@model MoneyTracker.Pages.Budgets.IndexModel
@{
    ViewData["Title"] = "Budgets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Budgets</h2>
    <a asp-page="Edit" class="btn btn-primary">Add Budget</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Category</th>
            <th>Period</th>
            <th>Start</th>
            <th>End</th>
            <th class="text-end">Amount</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var b in Model.Items)
    {
        <tr>
            <td>@b.Category?.Name</td>
            <td>@(b.Period==1?"Monthly":b.Period==2?"Quarterly":b.Period==3?"Yearly":"Custom")</td>
            <td>@b.StartDate.ToString("yyyy-MM-dd")</td>
            <td>@b.EndDate.ToString("yyyy-MM-dd")</td>
            <td class="text-end">@b.Amount.ToString("N2")</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-page="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
  </table>


