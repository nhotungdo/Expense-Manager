@page
@model BudgetsIndexModel
@{
    ViewData["Title"] = "Budgets";
}

<h2>Budgets</h2>

<form method="post" class="row g-2 mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col-md-3">
        <select asp-for="Create.CategoryId" class="form-select">
            <option value="">All Categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input asp-for="Create.Amount" type="number" step="0.01" class="form-control" placeholder="Amount" />
    </div>
    <div class="col-md-2">
        <select asp-for="Create.Period" class="form-select">
            <option value="7">Weekly</option>
            <option value="30">Monthly</option>
            <option value="365">Yearly</option>
        </select>
    </div>
    <div class="col-md-2">
        <input asp-for="Create.StartDate" type="date" class="form-control" />
    </div>
    <div class="col-md-2">
        <input asp-for="Create.EndDate" type="date" class="form-control" />
    </div>
    <div class="col-md-1">
        <button class="btn btn-success w-100" type="submit">Add</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Period</th>
            <th>Range</th>
            <th>Progress</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Items)
        {
            var progress = Model.ProgressMap.ContainsKey(b.Id) ? Model.ProgressMap[b.Id] : null;
            var percent = progress?.percent ?? 0;
            var status = progress?.status ?? "OK";
            var barClass = status == "Exceeded" ? "bg-danger" : status == "Warning" ? "bg-warning" : "bg-success";
            <tr>
                <td>@(b.CategoryId?.ToString() ?? "All")</td>
                <td>@b.Period</td>
                <td>@b.StartDate.ToString("yyyy-MM-dd") - @b.EndDate.ToString("yyyy-MM-dd")</td>
                <td style="min-width:260px;">
                    <div class="progress">
                        <div class="progress-bar @barClass" role="progressbar" style="width:@percent%">@percent.ToString("F0")%</div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


