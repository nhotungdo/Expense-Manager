@page
@model dynamic
@{
    ViewData["Title"] = "Thêm ngân sách";
}

<h3 class="mb-3"><i class="fa-solid fa-plus me-2"></i>Thêm ngân sách</h3>
<form class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Danh mục</label>
        <select class="form-select"><option>Ăn uống</option></select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Giới hạn</label>
        <input type="number" class="form-control" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu</button>
        <a class="btn btn-outline-secondary" asp-page="/Budgets/Index">Hủy</a>
    </div>
    </form>

