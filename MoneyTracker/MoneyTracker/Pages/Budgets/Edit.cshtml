@page "{id?}"
@model MoneyTracker.Pages.Budgets.EditModel
@{
    ViewData["Title"] = Model.Input.Id==0?"Add Budget":"Edit Budget";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.CategoryId" class="form-label"></label>
                <select asp-for="Input.CategoryId" class="form-select" asp-items="Model.CategoryOptions"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Period" class="form-label"></label>
                <select asp-for="Input.Period" class="form-select">
                    <option value="1">Monthly</option>
                    <option value="2">Quarterly</option>
                    <option value="3">Yearly</option>
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.StartDate" class="form-label"></label>
                <input asp-for="Input.StartDate" type="date" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.EndDate" class="form-label"></label>
                <input asp-for="Input.EndDate" type="date" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Amount" class="form-label"></label>
                <input asp-for="Input.Amount" class="form-control" />
            </div>
        </div>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

<partial name="_ValidationScriptsPartial" />


