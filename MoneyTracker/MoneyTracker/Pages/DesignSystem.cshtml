@page
@model MoneyTracker.Pages.DesignSystemModel
@{
    ViewData["Title"] = "Design System - Money Tracker";

}

@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
}

<div class="container-fluid" style="padding: 2rem;">
    <!-- Header -->
    <div class="text-center mb-6">
        <h1 class="h1">Money Tracker Design System</h1>
        <p class="text-lg text-secondary">Modern Personal Finance Management UI/UX Components</p>
    </div>

    <!-- Color Palette -->
    <section class="mb-8">
        <h2 class="h2">Color Palette</h2>
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div style="height: 120px; background: var(--primary-blue); border-radius: var(--radius-lg); margin-bottom: var(--space-3);"></div>
                    <h5 class="card-title">Primary Blue</h5>
                    <p class="text-sm text-secondary">#1A3A5A</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div style="height: 120px; background: var(--accent-green); border-radius: var(--radius-lg); margin-bottom: var(--space-3);"></div>
                    <h5 class="card-title">Accent Green</h5>
                    <p class="text-sm text-secondary">#2ECC71</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div style="height: 120px; background: var(--income-green); border-radius: var(--radius-lg); margin-bottom: var(--space-3);"></div>
                    <h5 class="card-title">Income Green</h5>
                    <p class="text-sm text-secondary">#2ECC71</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div style="height: 120px; background: var(--expense-red); border-radius: var(--radius-lg); margin-bottom: var(--space-3);"></div>
                    <h5 class="card-title">Expense Red</h5>
                    <p class="text-sm text-secondary">#E74C3C</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Typography -->
    <section class="mb-8">
        <h2 class="h2">Typography</h2>
        <div class="card">
            <div class="card-body">
                <h1 class="h1">Heading 1 - Main Page Title</h1>
                <h2 class="h2">Heading 2 - Section Title</h2>
                <h3 class="h3">Heading 3 - Subsection Title</h3>
                <h4 class="h4">Heading 4 - Card Title</h4>
                <h5 class="h5">Heading 5 - Small Title</h5>
                <h6 class="h6">Heading 6 - Label</h6>
                <p class="text-base">Body text - Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                <p class="text-sm text-secondary">Small text - Used for captions, metadata, and secondary information.</p>
            </div>
        </div>
    </section>

    <!-- Buttons -->
    <section class="mb-8">
        <h2 class="h2">Buttons</h2>
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <button class="btn btn-primary">Primary Button</button>
                    <button class="btn btn-secondary">Secondary Button</button>
                    <button class="btn btn-outline">Outline Button</button>
                    <button class="btn btn-ghost">Ghost Button</button>
                </div>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <button class="btn btn-primary btn-sm">Small Button</button>
                    <button class="btn btn-primary">Normal Button</button>
                    <button class="btn btn-primary btn-lg">Large Button</button>
                    <button class="btn btn-primary btn-xl">Extra Large Button</button>
                </div>
                <div class="btn-group">
                    <button class="btn btn-outline">Left</button>
                    <button class="btn btn-outline">Middle</button>
                    <button class="btn btn-outline">Right</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Cards -->
    <section class="mb-8">
        <h2 class="h2">Cards</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Basic Card</h5>
                        <p class="card-subtitle">Card subtitle</p>
                    </div>
                    <div class="card-body">
                        <p>This is a basic card with glassmorphism effect. It has a subtle background, border, and shadow.</p>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-primary">Action</button>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card card-elevated">
                    <div class="card-header">
                        <h5 class="card-title">Elevated Card</h5>
                        <p class="card-subtitle">With enhanced shadow</p>
                    </div>
                    <div class="card-body">
                        <p>This card has an elevated shadow for more prominence and visual hierarchy.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card card-interactive">
                    <div class="card-header">
                        <h5 class="card-title">Interactive Card</h5>
                        <p class="card-subtitle">Hover to see effect</p>
                    </div>
                    <div class="card-body">
                        <p>This card has hover effects and is designed for user interaction.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Statistics Cards -->
    <section class="mb-8">
        <h2 class="h2">Statistics Cards</h2>
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <div class="stat-value">$12,450</div>
                    <div class="stat-label">Total Income</div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i>
                        <span>+12.5%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <div class="stat-value">$8,230</div>
                    <div class="stat-label">Total Expenses</div>
                    <div class="stat-change negative">
                        <i class="fas fa-arrow-down"></i>
                        <span>-5.2%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <div class="stat-value">$4,220</div>
                    <div class="stat-label">Net Savings</div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i>
                        <span>+8.1%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card">
                    <div class="stat-value">47</div>
                    <div class="stat-label">Transactions</div>
                    <div class="stat-change neutral">
                        <i class="fas fa-minus"></i>
                        <span>0%</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Forms -->
    <section class="mb-8">
        <h2 class="h2">Forms</h2>
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Add Transaction</h5>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="form-group">
                                <label class="form-label">Transaction Type</label>
                                <select class="form-control form-select">
                                    <option>Income</option>
                                    <option>Expense</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Amount</label>
                                <input type="number" class="form-control" placeholder="0.00">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Category</label>
                                <select class="form-control form-select">
                                    <option>Food & Dining</option>
                                    <option>Transportation</option>
                                    <option>Shopping</option>
                                    <option>Entertainment</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" rows="3" placeholder="Enter description..."></textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Date</label>
                                <input type="date" class="form-control">
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="recurring">
                                <label class="form-check-label" for="recurring">Recurring transaction</label>
                            </div>
                            <div class="d-flex gap-3 mt-4">
                                <button type="submit" class="btn btn-primary">Add Transaction</button>
                                <button type="button" class="btn btn-outline">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Form Controls</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Input Sizes</label>
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Small input">
                            <input type="text" class="form-control mb-2" placeholder="Normal input">
                            <input type="text" class="form-control form-control-lg" placeholder="Large input">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Disabled Input</label>
                            <input type="text" class="form-control" placeholder="Disabled input" disabled>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Radio Buttons</label>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="radio" id="radio1">
                                <label class="form-check-label" for="radio1">Option 1</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="radio" id="radio2">
                                <label class="form-check-label" for="radio2">Option 2</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Transaction List -->
    <section class="mb-8">
        <h2 class="h2">Transaction List</h2>
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Recent Transactions</h5>
            </div>
            <div class="card-body">
                <div class="transaction-item">
                    <div class="transaction-icon income">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                    <div class="transaction-details">
                        <div class="transaction-title">Salary Payment</div>
                        <div class="transaction-meta">Work • Today</div>
                    </div>
                    <div class="transaction-amount income">+$5,000.00</div>
                </div>
                <div class="transaction-item">
                    <div class="transaction-icon expense">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                    <div class="transaction-details">
                        <div class="transaction-title">Grocery Shopping</div>
                        <div class="transaction-meta">Food & Dining • Yesterday</div>
                    </div>
                    <div class="transaction-amount expense">-$125.50</div>
                </div>
                <div class="transaction-item">
                    <div class="transaction-icon expense">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                    <div class="transaction-details">
                        <div class="transaction-title">Gas Station</div>
                        <div class="transaction-meta">Transportation • 2 days ago</div>
                    </div>
                    <div class="transaction-amount expense">-$45.00</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Budget Progress -->
    <section class="mb-8">
        <h2 class="h2">Budget Progress</h2>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="budget-item">
                    <div class="budget-header">
                        <div class="budget-title">Food & Dining</div>
                        <div class="budget-amount">$450 / $600</div>
                    </div>
                    <div class="budget-progress">
                        <div class="budget-progress-bar" style="width: 75%;"></div>
                    </div>
                    <div class="budget-footer">
                        <div class="budget-remaining">$150 remaining</div>
                        <div class="budget-percentage">75%</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="budget-item">
                    <div class="budget-header">
                        <div class="budget-title">Entertainment</div>
                        <div class="budget-amount">$320 / $300</div>
                    </div>
                    <div class="budget-progress">
                        <div class="budget-progress-bar danger" style="width: 107%;"></div>
                    </div>
                    <div class="budget-footer">
                        <div class="budget-remaining">$20 over budget</div>
                        <div class="budget-percentage">107%</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Chart Container -->
    <section class="mb-8">
        <h2 class="h2">Chart Container</h2>
        <div class="chart-container">
            <div class="chart-header">
                <h5 class="chart-title">Monthly Spending Trends</h5>
                <div class="chart-actions">
                    <button class="chart-btn">Export</button>
                    <button class="chart-btn">Refresh</button>
                </div>
            </div>
            <div style="height: 300px; background: var(--gray-50); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; color: var(--gray-500);">
                <div class="text-center">
                    <i class="fas fa-chart-line fa-3x mb-3"></i>
                    <p>Chart would be rendered here</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Navigation -->
    <section class="mb-8">
        <h2 class="h2">Navigation</h2>
        <div class="card">
            <div class="card-body">
                <nav class="navbar">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <a href="#" class="navbar-brand">Money Tracker</a>
                        <ul class="navbar-nav">
                            <li><a href="#" class="nav-link active">Dashboard</a></li>
                            <li><a href="#" class="nav-link">Transactions</a></li>
                            <li><a href="#" class="nav-link">Budgets</a></li>
                            <li><a href="#" class="nav-link">Reports</a></li>
                            <li><a href="#" class="nav-link">Settings</a></li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </section>

    <!-- Loading States -->
    <section class="mb-8">
        <h2 class="h2">Loading States</h2>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Loading Skeleton</h5>
                    </div>
                    <div class="card-body">
                        <div class="loading-skeleton" style="height: 60px; margin-bottom: 1rem;"></div>
                        <div class="loading-skeleton" style="height: 60px; margin-bottom: 1rem;"></div>
                        <div class="loading-skeleton" style="height: 60px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Loading Spinner</h5>
                    </div>
                    <div class="card-body text-center">
                        <div class="loading-spinner mx-auto mb-3"></div>
                        <p class="text-secondary">Loading data...</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Responsive Demo -->
    <section class="mb-8">
        <h2 class="h2">Responsive Design</h2>
        <div class="card">
            <div class="card-body">
                <p class="mb-4">The design system is fully responsive and adapts to different screen sizes:</p>
                <div class="row">
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="stat-card">
                            <div class="stat-value">$1,234</div>
                            <div class="stat-label">Mobile View</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="stat-card">
                            <div class="stat-value">$5,678</div>
                            <div class="stat-label">Tablet View</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="stat-card">
                            <div class="stat-value">$9,012</div>
                            <div class="stat-label">Desktop View</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        // Theme toggle functionality
        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        }

        // Initialize theme
        document.addEventListener('DOMContentLoaded', function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        });

        // Add interactive effects
        document.querySelectorAll('.card-interactive').forEach(card => {
            card.addEventListener('click', function() {
                this.style.transform = 'scale(0.98)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 150);
            });
        });

        // Animate elements on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-fade-in');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.card, .stat-card').forEach(el => {
            observer.observe(el);
        });
    </script>
}
