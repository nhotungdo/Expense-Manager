@page
@model NotificationsIndexModel
@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>

<form method="post">
    <button class="btn btn-sm btn-outline-secondary" name="action" value="readAll" type="submit">Mark all as read</button>
</form>

<table class="table mt-3">
    <thead><tr><th>When</th><th>Title</th><th>Message</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var n in Model.Items)
    {
        <tr>
            <td>@n.CreatedAt</td>
            <td>@n.Title</td>
            <td>@n.Message</td>
            <td>@(n.IsRead ? "Read" : "Unread")</td>
            <td>
                @if (!n.IsRead)
                {
                    <form method="post" class="d-inline">
                        <input type="hidden" name="id" value="@n.Id" />
                        <button class="btn btn-sm btn-primary" name="action" value="readOne" type="submit">Mark read</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>


