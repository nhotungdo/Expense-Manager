@page
@model MoneyTracker.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
}

<h2>Reports</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">From</label>
        <input class="form-control" asp-for="Filter.From" type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label">To</label>
        <input class="form-control" asp-for="Filter.To" type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Type</label>
        <select class="form-select" asp-for="Filter.Type">
            <option value="">All</option>
            <option>Income</option>
            <option>Expense</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-outline-secondary me-2" type="submit">Filter</button>
    <a class="btn btn-outline-primary me-2" asp-page="ExportCsv" asp-route-from="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" asp-route-type="@(Model.Filter.Type)">Export CSV</a>
    <a class="btn btn-outline-success me-2" asp-page="ExportExcel" asp-route-from="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" asp-route-type="@(Model.Filter.Type)">Export Excel</a>
    <a class="btn btn-outline-danger" asp-page="ExportPdf" asp-route-from="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" asp-route-type="@(Model.Filter.Type)">Export PDF</a>
    </div>
</form>

<table class="table table-striped">
    <thead><tr><th>Date</th><th>Type</th><th>Account</th><th>Category</th><th class="text-end">Amount</th><th>Note</th></tr></thead>
    <tbody>
    @foreach (var t in Model.Items)
    {
        <tr>
            <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
            <td>@t.TransactionType</td>
            <td>@t.Account?.Name</td>
            <td>@t.Category?.Name</td>
            <td class="text-end">@t.Amount.ToString("N2")</td>
            <td>@t.Note</td>
        </tr>
    }
    </tbody>
   </table>

<div class="row g-3 mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Spending by Category</h5>
                <canvas id="chartCategory"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Daily Trend</h5>
                <canvas id="chartTrend"></canvas>
            </div>
        </div>
    </div>
  </div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(async function(){
  const res = await fetch('?handler=ChartData');
  const data = await res.json();
  new Chart(document.getElementById('chartCategory'), {type:'pie', data:{labels:data.categories, datasets:[{data:data.categoryAmounts, backgroundColor:['#ff6384','#36a2eb','#ffce56','#4bc0c0','#9966ff','#ff9f40']}]}});
  new Chart(document.getElementById('chartTrend'), {type:'line', data:{labels:data.days, datasets:[{label:'Daily Total', data:data.dailyTotals, borderColor:'#36a2eb', fill:false}]}});
})();
</script>
}


