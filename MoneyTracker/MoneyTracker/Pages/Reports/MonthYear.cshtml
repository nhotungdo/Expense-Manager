@page
@model MoneyTracker.Pages.Reports.MonthYearModel
@{
    ViewData["Title"] = "Monthly/Yearly Comparison";
}

<h2>Monthly/Yearly Comparison</h2>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Monthly Expense (12 months)</h5>
            <canvas id="chartMonthly"></canvas>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Yearly Income vs Expense</h5>
            <canvas id="chartYearly"></canvas>
        </div></div>
    </div>
  </div>

@section Scripts{
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(async function(){
  const res = await fetch('?handler=Data');
  const data = await res.json();
  new Chart(document.getElementById('chartMonthly'), {type:'line', data:{labels:data.months, datasets:[{label:'Expense', data:data.monthlyExpense, borderColor:'#dc3545', fill:false}]}});
  new Chart(document.getElementById('chartYearly'), {type:'bar', data:{labels:data.years, datasets:[{label:'Income', data:data.yearlyIncome, backgroundColor:'#198754'},{label:'Expense', data:data.yearlyExpense, backgroundColor:'#dc3545'}]}});
})();
</script>
}


