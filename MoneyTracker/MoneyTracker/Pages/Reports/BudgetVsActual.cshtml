@page
@model MoneyTracker.Pages.Reports.BudgetVsActualModel
@{
    ViewData["Title"] = "Budget vs Actual";
}

<h2>Budget vs Actual (This Month)</h2>

<table class="table table-striped">
    <thead><tr><th>Category</th><th class="text-end">Budget</th><th class="text-end">Spent</th><th class="text-end">% Used</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
        <tr>
            <td>@row.CategoryName</td>
            <td class="text-end">@row.Budget.ToString("N2")</td>
            <td class="text-end">@row.Spent.ToString("N2")</td>
            <td class="text-end">@((row.Budget>0? row.Spent/row.Budget*100:0).ToString("0.#"))%</td>
        </tr>
    }
    </tbody>
  </table>


