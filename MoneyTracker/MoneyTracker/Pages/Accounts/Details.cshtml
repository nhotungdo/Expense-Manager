@page "{id:long}"
@model MoneyTracker.Pages.Accounts.DetailsModel
@{
    ViewData["Title"] = "Account Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Account?.Name</h2>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</div>

<div class="mb-3">
    <strong>Balance:</strong> @Model.Account?.CurrentBalance.ToString("N2") @Model.Account?.Currency
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Date</th><th>Type</th><th>Category</th><th class="text-end">Amount</th><th>Note</th></tr>
    </thead>
    <tbody>
    @foreach (var t in Model.Transactions)
    {
        <tr>
            <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
            <td>@t.TransactionType</td>
            <td>@t.Category?.Name</td>
            <td class="text-end">@t.Amount.ToString("N2")</td>
            <td>@t.Note</td>
        </tr>
    }
    </tbody>
  </table>


