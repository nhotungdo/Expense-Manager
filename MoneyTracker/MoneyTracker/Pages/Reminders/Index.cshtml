@page
@model MoneyTracker.Pages.Reminders.IndexModel
@{
    ViewData["Title"] = "Reminders";
}

<h2>Reminders</h2>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Due Debts</h5>
                @if (Model.DueDebts.Any())
                {
                    <ul class="list-group list-group-flush">
                    @foreach (var debt in Model.DueDebts)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@debt.Name - @debt.PersonName</span>
                            <span class="text-danger">@debt.DueDate?.ToString("yyyy-MM-dd")</span>
                        </li>
                    }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No due debts</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Today's Scheduled</h5>
                @if (Model.TodayScheduled.Any())
                {
                    <ul class="list-group list-group-flush">
                    @foreach (var sched in Model.TodayScheduled)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@sched.Account?.Name - @sched.Amount.ToString("N2")</span>
                            <span class="text-info">@sched.Frequency</span>
                        </li>
                    }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No scheduled transactions today</p>
                }
            </div>
        </div>
    </div>
</div>

<form method="post">
    <button type="submit" class="btn btn-primary">Generate Reminder Emails</button>
</form>

@if (Model.Generated)
{
    <div class="alert alert-success mt-3">
        <strong>Reminder emails queued:</strong>
        <ul class="mb-0">
        @foreach (var email in Model.QueuedEmails)
        {
            <li>@email.Subject - @email.Status</li>
        }
        </ul>
    </div>
}
