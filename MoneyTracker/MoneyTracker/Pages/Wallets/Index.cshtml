@page "/Wallets"
@model MoneyTracker.Pages.Wallets.IndexModel
@{
    ViewData["Title"] = "Wallets";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Ví tiền</h2>
    <a class="btn btn-primary" asp-page="/Wallets/Create"><i class="fa-solid fa-plus me-1"></i>Thêm ví</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0"><i class="fa-solid fa-wallet me-2"></i>Tiền mặt</h5>
                    <span class="badge bg-secondary">Tiền mặt</span>
                </div>
                <div class="display-6 my-3">2,000,000</div>
                <div class="mt-auto">
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Wallets/Edit"><i
                            class="fa-solid fa-pen-to-square"></i></a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="/Wallets/Delete"><i
                            class="fa-solid fa-trash"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>
