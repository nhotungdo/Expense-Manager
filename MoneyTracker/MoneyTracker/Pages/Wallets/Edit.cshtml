@page
@model dynamic
@{
    ViewData["Title"] = "Chỉnh sửa ví";
}

<h3 class="mb-3"><i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa ví</h3>
<form class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Tên ví</label>
        <input class="form-control" value="Tiền mặt" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Loại</label>
        <select class="form-select"><option selected>Tiền mặt</option><option>Ngân hàng</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Số dư</label>
        <input type="number" class="form-control" value="2000000" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Cập nhật</button>
        <a class="btn btn-outline-secondary" asp-page="/Wallets/Index">Hủy</a>
    </div>
    </form>

