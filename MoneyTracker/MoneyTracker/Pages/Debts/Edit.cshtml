@page "{id?}"
@model MoneyTracker.Pages.Debts.EditModel
@{
    ViewData["Title"] = Model.Input.Id==0?"Add Debt":"Edit Debt";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.PersonName" class="form-label"></label>
                <input asp-for="Input.PersonName" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.DebtType" class="form-label"></label>
                <select asp-for="Input.DebtType" class="form-select">
                    <option value="0">I owe</option>
                    <option value="1">They owe</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.InterestRate" class="form-label"></label>
                <input asp-for="Input.InterestRate" class="form-control" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.InitialAmount" class="form-label"></label>
                <input asp-for="Input.InitialAmount" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.StartDate" class="form-label"></label>
                <input asp-for="Input.StartDate" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.DueDate" class="form-label"></label>
                <input asp-for="Input.DueDate" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Status" class="form-label"></label>
                <select asp-for="Input.Status" class="form-select">
                    <option value="1">Active</option>
                    <option value="2">Closed</option>
                    <option value="0">Overdue</option>
                </select>
            </div>
        </div>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>


