@page
@model MoneyTracker.Pages.Debts.IndexModel
@{
    ViewData["Title"] = "Debts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Debts</h2>
    <a asp-page="Edit" class="btn btn-primary">Add Debt</a>
  </div>

<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Person</th><th>Type</th><th class="text-end">Initial</th><th class="text-end">Paid</th><th>Due</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Items)
    {
        <tr>
            <td>@d.Name</td>
            <td>@d.PersonName</td>
            <td>@(d.DebtType==0?"I owe":"They owe")</td>
            <td class="text-end">@d.InitialAmount.ToString("N2")</td>
            <td class="text-end">@d.AmountPaid.ToString("N2")</td>
            <td>@(d.DueDate?.ToString("yyyy-MM-dd"))</td>
            <td>@(d.Status==1?"Active":d.Status==2?"Closed":"Overdue")</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-page="Pay" asp-route-id="@d.Id" class="btn btn-sm btn-success">Record Payment</a>
                <a asp-page="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
  </table>


