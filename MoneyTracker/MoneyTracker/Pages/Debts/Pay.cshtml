@page "{id:long}"
@model MoneyTracker.Pages.Debts.PayModel
@{
    ViewData["Title"] = "Record Payment";
}

<h2>Record Payment - @Model.DebtName</h2>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.Amount" class="form-label"></label>
                <input asp-for="Input.Amount" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.AccountId" class="form-label"></label>
                <select asp-for="Input.AccountId" class="form-select" asp-items="Model.AccountOptions"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PaymentDate" class="form-label"></label>
                <input asp-for="Input.PaymentDate" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Note" class="form-label"></label>
                <input asp-for="Input.Note" class="form-control" />
            </div>
        </div>
    </div>
    <button class="btn btn-success" type="submit">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>


