@page
@model MoneyTracker.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">This Month Income</div>
                <div class="h4">@Model.ThisMonthIncome.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">This Month Expense</div>
                <div class="h4 text-danger">@Model.ThisMonthExpense.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Net</div>
                <div class="h4">@Model.Net.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Transactions</div>
                <div class="h4">@Model.TxCount</div>
            </div>
        </div>
    </div>
  </div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Spending by Category (This Month)</h5>
        <table class="table table-sm">
            <thead>
                <tr><th>Category</th><th class="text-end">Amount</th></tr>
            </thead>
            <tbody>
            @foreach (var row in Model.SpendingByCategory)
            {
                <tr>
                    <td>@row.CategoryName</td>
                    <td class="text-end">@row.Total.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
  </div>

<div class="row g-3 mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Daily Spending (This Month)</h5>
                <canvas id="chartDaily"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Income vs Expense (This Month)</h5>
                <canvas id="chartIe"></canvas>
            </div>
        </div>
    </div>
  </div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(async function(){
  const res = await fetch('?handler=ChartData');
  const data = await res.json();
  const ctx1 = document.getElementById('chartDaily');
  new Chart(ctx1, {type:'bar', data: {labels: data.days, datasets:[{label:'Expense', data: data.dailyExpense, backgroundColor:'#dc3545'}]}});
  const ctx2 = document.getElementById('chartIe');
  new Chart(ctx2, {type:'bar', data: {labels: ['Income','Expense'], datasets:[{label:'Amount', data:[data.income, data.expense], backgroundColor:['#198754','#dc3545']}]}});
})();
</script>
}


