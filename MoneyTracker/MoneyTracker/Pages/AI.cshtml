@page
@model MoneyTracker.Pages.AIModel
@{
    ViewData["Title"] = "AI Gợi Ý";

}

@section Styles {
    <style>
        .ai-container {
            min-height: calc(100vh - 80px);
            padding: 2rem;
        }

        .ai-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
        }

        .ai-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .suggestion-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

        .suggestion-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .suggestion-warning {
            border-left: 4px solid #f59e0b;
        }

        .suggestion-success {
            border-left: 4px solid #10b981;
        }

        .suggestion-danger {
            border-left: 4px solid #ef4444;
        }

        .suggestion-info {
            border-left: 4px solid #3b82f6;
        }

        .ai-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .ai-icon.warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
        }

        .ai-icon.success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }

        .ai-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
        }

        .ai-icon.info {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
        }

        .generate-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 15px;
            padding: 1rem 2rem;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .generate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            color: white;
        }

        .generate-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .loading-skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
            border-radius: 15px;
            height: 120px;
            margin-bottom: 1rem;
        }

        @@keyframes loading {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        .pulse-animation {
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }
    </style>
}

<div class="ai-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-white">
                <i class="fas fa-robot me-3"></i>
                AI Gợi Ý Thông Minh
            </h1>
            <p class="text-white-50 mb-0">Nhận lời khuyên tài chính từ AI dựa trên thói quen chi tiêu của bạn</p>
        </div>
        <div class="d-flex gap-3">
            <button class="generate-btn" onclick="generateSuggestions()" id="generateBtn">
                <i class="fas fa-magic me-2"></i>
                Tạo Gợi Ý Mới
            </button>
        </div>
    </div>

    <!-- AI Analysis Summary -->
    <div class="ai-card">
        <div class="row">
            <div class="col-md-8">
                <h5 class="text-white mb-3">
                    <i class="fas fa-chart-line me-2"></i>
                    Phân Tích Tài Chính Của Bạn
                </h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <h6 class="text-white-50 mb-1">Mức Chi Tiêu</h6>
                            <h4 class="text-warning mb-0" id="spendingLevel">Cao</h4>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <h6 class="text-white-50 mb-1">Xu Hướng</h6>
                            <h4 class="text-danger mb-0" id="trend">Tăng</h4>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <h6 class="text-white-50 mb-1">Điểm Số</h6>
                            <h4 class="text-info mb-0" id="score">7.2/10</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="ai-icon info mx-auto">
                        <i class="fas fa-brain"></i>
                    </div>
                    <h6 class="text-white mb-2">AI Đánh Giá</h6>
                    <p class="text-white-50 mb-0">Dựa trên 30 ngày gần nhất</p>
                </div>
            </div>
        </div>
    </div>

    <!-- AI Suggestions -->
    <div class="ai-card">
        <h5 class="text-white mb-4">
            <i class="fas fa-lightbulb me-2"></i>
            Gợi Ý Thông Minh
        </h5>
        <div id="suggestionsList">
            <!-- Loading skeleton -->
            <div class="loading-skeleton"></div>
            <div class="loading-skeleton"></div>
            <div class="loading-skeleton"></div>
        </div>
    </div>

    <!-- Budget Recommendations -->
    <div class="ai-card">
        <h5 class="text-white mb-4">
            <i class="fas fa-piggy-bank me-2"></i>
            Khuyến Nghị Ngân Sách
        </h5>
        <div id="budgetRecommendations">
            <!-- Loading skeleton -->
            <div class="loading-skeleton"></div>
            <div class="loading-skeleton"></div>
        </div>
    </div>

    <!-- Spending Insights -->
    <div class="ai-card">
        <h5 class="text-white mb-4">
            <i class="fas fa-eye me-2"></i>
            Thông Tin Chi Tiêu
        </h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="suggestion-card suggestion-info">
                    <div class="d-flex align-items-start">
                        <div class="ai-icon info me-3">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <div>
                            <h6 class="text-white mb-2">Danh Mục Chi Tiêu Nhiều Nhất</h6>
                            <p class="text-white-50 mb-2">Ăn uống chiếm 35% tổng chi tiêu của bạn</p>
                            <small class="text-info">Gợi ý: Hãy cân nhắc nấu ăn tại nhà nhiều hơn</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="suggestion-card suggestion-warning">
                    <div class="d-flex align-items-start">
                        <div class="ai-icon warning me-3">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <h6 class="text-white mb-2">Thời Điểm Chi Tiêu</h6>
                            <p class="text-white-50 mb-2">Bạn thường chi tiêu nhiều vào cuối tuần</p>
                            <small class="text-warning">Gợi ý: Lập kế hoạch chi tiêu cho cuối tuần</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Goals & Tips -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="ai-card">
                <h5 class="text-white mb-4">
                    <i class="fas fa-target me-2"></i>
                    Mục Tiêu Được Đề Xuất
                </h5>
                <div id="suggestedGoals">
                    <!-- Loading skeleton -->
                    <div class="loading-skeleton" style="height: 200px;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="ai-card">
                <h5 class="text-white mb-4">
                    <i class="fas fa-tips me-2"></i>
                    Mẹo Tiết Kiệm
                </h5>
                <div id="savingTips">
                    <!-- Loading skeleton -->
                    <div class="loading-skeleton" style="height: 200px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Global variables
        let suggestions = [];

        // Initialize page
        document.addEventListener('DOMContentLoaded', function () {
            loadAIData();
        });

        // Load AI data
        async function loadAIData() {
            try {
                showLoadingState();

                // Load AI insights
                await loadAIInsights();

                // Load suggestions
                await loadSuggestions();

                // Load budget recommendations
                await loadBudgetRecommendations();

                // Load suggested goals
                await loadSuggestedGoals();

                // Load saving tips
                await loadSavingTips();

            } catch (error) {
                console.error('Error loading AI data:', error);
                loadMockData();
            }
        }

        // Load AI insights
        async function loadAIInsights() {
            try {
                const response = await fetch('/api/dashboard/insights');
                if (response.ok) {
                    const insights = await response.json();
                    updateAIInsights(insights);
                } else {
                    // Use mock data
                    updateAIInsights([
                        { type: 'warning', title: 'Chi tiêu tăng cao', message: 'Bạn đã chi tiêu nhiều hơn 20% so với tháng trước' },
                        { type: 'success', title: 'Thu nhập tăng trưởng', message: 'Thu nhập của bạn đã tăng 15% so với tháng trước!' }
                    ]);
                }
            } catch (error) {
                console.error('Error loading AI insights:', error);
            }
        }

        // Update AI insights
        function updateAIInsights(insights) {
            // Update spending level, trend, and score based on insights
            const hasWarning = insights.some(i => i.type === 'warning' || i.type === 'danger');
            const hasSuccess = insights.some(i => i.type === 'success');

            if (hasWarning) {
                document.getElementById('spendingLevel').textContent = 'Cao';
                document.getElementById('spendingLevel').className = 'text-danger mb-0';
                document.getElementById('trend').textContent = 'Tăng';
                document.getElementById('trend').className = 'text-danger mb-0';
                document.getElementById('score').textContent = '6.2/10';
                document.getElementById('score').className = 'text-warning mb-0';
            } else if (hasSuccess) {
                document.getElementById('spendingLevel').textContent = 'Trung bình';
                document.getElementById('spendingLevel').className = 'text-warning mb-0';
                document.getElementById('trend').textContent = 'Ổn định';
                document.getElementById('trend').className = 'text-info mb-0';
                document.getElementById('score').textContent = '7.8/10';
                document.getElementById('score').className = 'text-success mb-0';
            } else {
                document.getElementById('spendingLevel').textContent = 'Thấp';
                document.getElementById('spendingLevel').className = 'text-success mb-0';
                document.getElementById('trend').textContent = 'Giảm';
                document.getElementById('trend').className = 'text-success mb-0';
                document.getElementById('score').textContent = '8.5/10';
                document.getElementById('score').className = 'text-success mb-0';
            }
        }

        // Load suggestions
        async function loadSuggestions() {
            try {
                const response = await fetch('/api/ai-suggestions');
                if (response.ok) {
                    suggestions = await response.json();
                    displaySuggestions(suggestions);
                } else {
                    // Use mock data
                    displayMockSuggestions();
                }
            } catch (error) {
                console.error('Error loading suggestions:', error);
                displayMockSuggestions();
            }
        }

        // Display suggestions
        function displaySuggestions(suggestions) {
            const container = document.getElementById('suggestionsList');
            container.innerHTML = '';

            if (suggestions.length === 0) {
                container.innerHTML = `
                        <div class="text-center text-white-50 py-4">
                            <i class="fas fa-lightbulb fa-2x mb-3"></i>
                            <h6>Chưa có gợi ý nào</h6>
                            <p>Hãy tạo gợi ý mới để nhận lời khuyên từ AI!</p>
                        </div>
                    `;
                return;
            }

            suggestions.forEach(suggestion => {
                const suggestionElement = document.createElement('div');
                suggestionElement.className = `suggestion-card suggestion-${suggestion.type || 'info'}`;

                const iconClass = getSuggestionIcon(suggestion.type);
                const iconElement = getSuggestionIconElement(suggestion.type);

                suggestionElement.innerHTML = `
                        <div class="d-flex align-items-start">
                            <div class="ai-icon ${suggestion.type || 'info'} me-3">
                                <i class="${iconClass}"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="text-white mb-2">${suggestion.title || 'Gợi ý'}</h6>
                                <p class="text-white-50 mb-2">${suggestion.message || suggestion.suggestion}</p>
                                <small class="text-white-50">
                                    <i class="fas fa-clock me-1"></i>
                                    ${formatDate(suggestion.createdAt || new Date())}
                                </small>
                            </div>
                        </div>
                    `;

                container.appendChild(suggestionElement);
            });
        }

        // Display mock suggestions
        function displayMockSuggestions() {
            const mockSuggestions = [
                {
                    type: 'warning',
                    title: 'Chi tiêu tăng cao',
                    message: 'Bạn đã chi tiêu nhiều hơn 20% so với tháng trước. Hãy xem xét cắt giảm chi phí không cần thiết.',
                    createdAt: new Date()
                },
                {
                    type: 'success',
                    title: 'Thu nhập tăng trưởng',
                    message: 'Thu nhập của bạn đã tăng 15% so với tháng trước! Hãy tiếp tục duy trì xu hướng tích cực này.',
                    createdAt: new Date()
                },
                {
                    type: 'info',
                    title: 'Gợi ý tiết kiệm',
                    message: 'Bạn có thể tiết kiệm thêm 500,000 VND mỗi tháng bằng cách giảm chi tiêu ăn uống ngoài.',
                    createdAt: new Date()
                }
            ];

            displaySuggestions(mockSuggestions);
        }

        // Load budget recommendations
        async function loadBudgetRecommendations() {
            try {
                const response = await fetch('/api/budgets/recommendations');
                if (response.ok) {
                    const recommendations = await response.json();
                    displayBudgetRecommendations(recommendations);
                } else {
                    // Use mock data
                    displayMockBudgetRecommendations();
                }
            } catch (error) {
                console.error('Error loading budget recommendations:', error);
                displayMockBudgetRecommendations();
            }
        }

        // Display budget recommendations
        function displayBudgetRecommendations(recommendations) {
            const container = document.getElementById('budgetRecommendations');
            container.innerHTML = '';

            recommendations.forEach(rec => {
                const recElement = document.createElement('div');
                recElement.className = 'suggestion-card suggestion-info';
                recElement.innerHTML = `
                        <div class="d-flex align-items-start">
                            <div class="ai-icon info me-3">
                                <i class="fas fa-piggy-bank"></i>
                            </div>
                            <div>
                                <h6 class="text-white mb-2">${rec.category}</h6>
                                <p class="text-white-50 mb-2">Ngân sách đề xuất: ${formatCurrency(rec.recommendedAmount)}</p>
                                <small class="text-info">Dựa trên chi tiêu trung bình của bạn</small>
                            </div>
                        </div>
                    `;
                container.appendChild(recElement);
            });
        }

        // Display mock budget recommendations
        function displayMockBudgetRecommendations() {
            const mockRecommendations = [
                {
                    category: 'Ăn uống',
                    recommendedAmount: 4000000,
                    currentAmount: 5000000
                },
                {
                    category: 'Mua sắm',
                    recommendedAmount: 2000000,
                    currentAmount: 2500000
                },
                {
                    category: 'Giao thông',
                    recommendedAmount: 1500000,
                    currentAmount: 1800000
                }
            ];

            displayBudgetRecommendations(mockRecommendations);
        }

        // Load suggested goals
        async function loadSuggestedGoals() {
            const container = document.getElementById('suggestedGoals');
            container.innerHTML = '';

            const mockGoals = [
                {
                    title: 'Tiết kiệm khẩn cấp',
                    target: 10000000,
                    current: 3000000,
                    description: 'Quỹ dự phòng 6 tháng chi tiêu'
                },
                {
                    title: 'Mua xe mới',
                    target: 50000000,
                    current: 15000000,
                    description: 'Mục tiêu trong 2 năm tới'
                },
                {
                    title: 'Du lịch',
                    target: 15000000,
                    current: 5000000,
                    description: 'Kỳ nghỉ hè năm sau'
                }
            ];

            mockGoals.forEach(goal => {
                const percentage = (goal.current / goal.target) * 100;
                const goalElement = document.createElement('div');
                goalElement.className = 'mb-3';
                goalElement.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white">${goal.title}</span>
                            <span class="text-white-50">${formatCurrency(goal.current)} / ${formatCurrency(goal.target)}</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: ${percentage}%"></div>
                        </div>
                        <small class="text-white-50">${goal.description}</small>
                    `;
                container.appendChild(goalElement);
            });
        }

        // Load saving tips
        async function loadSavingTips() {
            const container = document.getElementById('savingTips');
            container.innerHTML = '';

            const mockTips = [
                {
                    icon: 'fas fa-home',
                    title: 'Nấu ăn tại nhà',
                    description: 'Tiết kiệm 30% chi phí ăn uống'
                },
                {
                    icon: 'fas fa-bus',
                    title: 'Sử dụng phương tiện công cộng',
                    description: 'Giảm 50% chi phí giao thông'
                },
                {
                    icon: 'fas fa-shopping-cart',
                    title: 'Mua sắm thông minh',
                    description: 'So sánh giá trước khi mua'
                },
                {
                    icon: 'fas fa-lightbulb',
                    title: 'Tiết kiệm điện',
                    description: 'Tắt thiết bị khi không sử dụng'
                }
            ];

            mockTips.forEach(tip => {
                const tipElement = document.createElement('div');
                tipElement.className = 'd-flex align-items-start mb-3';
                tipElement.innerHTML = `
                        <div class="me-3">
                            <i class="${tip.icon} text-info"></i>
                        </div>
                        <div>
                            <h6 class="text-white mb-1">${tip.title}</h6>
                            <small class="text-white-50">${tip.description}</small>
                        </div>
                    `;
                container.appendChild(tipElement);
            });
        }

        // Generate new suggestions
        async function generateSuggestions() {
            const btn = document.getElementById('generateBtn');
            const icon = btn.querySelector('i');

            // Add loading state
            btn.disabled = true;
            icon.classList.add('fa-spin');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang tạo gợi ý...';

            try {
                const response = await fetch('/api/ai-suggestions/generate', {
                    method: 'POST'
                });

                if (response.ok) {
                    // Reload suggestions
                    await loadSuggestions();
                    showNotification('Gợi ý mới đã được tạo thành công!', 'success');
                } else {
                    showNotification('Có lỗi xảy ra khi tạo gợi ý!', 'error');
                }
            } catch (error) {
                console.error('Error generating suggestions:', error);
                showNotification('Có lỗi xảy ra khi tạo gợi ý!', 'error');
            } finally {
                // Remove loading state
                btn.disabled = false;
                icon.classList.remove('fa-spin');
                btn.innerHTML = '<i class="fas fa-magic me-2"></i>Tạo Gợi Ý Mới';
            }
        }

        // Load mock data
        function loadMockData() {
            displayMockSuggestions();
            displayMockBudgetRecommendations();
            loadSuggestedGoals();
            loadSavingTips();
        }

        // Show loading state
        function showLoadingState() {
            document.getElementById('suggestionsList').innerHTML = `
                    <div class="loading-skeleton"></div>
                    <div class="loading-skeleton"></div>
                    <div class="loading-skeleton"></div>
                `;
            document.getElementById('budgetRecommendations').innerHTML = `
                    <div class="loading-skeleton"></div>
                    <div class="loading-skeleton"></div>
                `;
        }

        // Show notification
        function showNotification(message, type) {
            alert(message);
        }

        // Get suggestion icon
        function getSuggestionIcon(type) {
            switch (type) {
                case 'warning': return 'fas fa-exclamation-triangle';
                case 'success': return 'fas fa-check-circle';
                case 'danger': return 'fas fa-exclamation-circle';
                default: return 'fas fa-info-circle';
            }
        }

        // Get suggestion icon element
        function getSuggestionIconElement(type) {
            const iconClass = getSuggestionIcon(type);
            return `<i class="${iconClass}"></i>`;
        }

        // Utility functions
        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }

        function formatDate(date) {
            return new Date(date).toLocaleDateString('vi-VN');
        }
    </script>
}