@page
@model MoneyTracker.Pages.AIModel
@{
    ViewData["Title"] = "AI Gợi Ý";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 animate-fade-in">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white">AI Gợi Ý Thông Minh</h2>
                <p class="text-gray-600 dark:text-gray-300">Nhận gợi ý tài chính từ AI dựa trên thói quen chi tiêu của bạn</p>
            </div>
            <button onclick="refreshSuggestions()" class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-6 py-3 rounded-xl hover:from-purple-600 hover:to-pink-600 transition-all duration-300 transform hover:-translate-y-1 shadow-lg">
                <i class="fas fa-sync-alt mr-2"></i>
                Làm Mới
            </button>
        </div>
    </div>

    <!-- AI Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-gradient-to-br from-blue-400 to-cyan-500 rounded-2xl p-6 text-white shadow-xl animate-slide-in-up">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-blue-100 text-sm font-medium">Tổng Gợi Ý</p>
                    <p class="text-3xl font-bold" id="total-suggestions">0</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-lightbulb text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-green-400 to-emerald-500 rounded-2xl p-6 text-white shadow-xl animate-slide-in-up" style="animation-delay: 0.1s">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-green-100 text-sm font-medium">Đã Áp Dụng</p>
                    <p class="text-3xl font-bold" id="applied-suggestions">0</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-check-circle text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-yellow-400 to-orange-500 rounded-2xl p-6 text-white shadow-xl animate-slide-in-up" style="animation-delay: 0.2s">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-yellow-100 text-sm font-medium">Cảnh Báo</p>
                    <p class="text-3xl font-bold" id="warning-suggestions">0</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-exclamation-triangle text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-purple-400 to-pink-500 rounded-2xl p-6 text-white shadow-xl animate-slide-in-up" style="animation-delay: 0.3s">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-purple-100 text-sm font-medium">Tiết Kiệm</p>
                    <p class="text-3xl font-bold" id="savings-potential">0 VND</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-piggy-bank text-2xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 animate-fade-in">
        <div class="flex flex-wrap items-center gap-4">
            <div class="flex items-center space-x-2">
                <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Lọc theo:</label>
                <select id="type-filter" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent bg-white/50 dark:bg-gray-800/50">
                    <option value="">Tất cả loại</option>
                    <option value="info">Thông tin</option>
                    <option value="warning">Cảnh báo</option>
                    <option value="critical">Nghiêm trọng</option>
                </select>
            </div>
            <div class="flex items-center space-x-2">
                <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Danh mục:</label>
                <select id="category-filter" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent bg-white/50 dark:bg-gray-800/50">
                    <option value="">Tất cả danh mục</option>
                    <!-- Categories will be loaded here -->
                </select>
            </div>
            <div class="flex items-center space-x-2">
                <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Trạng thái:</label>
                <select id="status-filter" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent bg-white/50 dark:bg-gray-800/50">
                    <option value="">Tất cả trạng thái</option>
                    <option value="new">Mới</option>
                    <option value="viewed">Đã xem</option>
                    <option value="applied">Đã áp dụng</option>
                    <option value="dismissed">Đã bỏ qua</option>
                </select>
            </div>
            <button onclick="applyFilters()" class="px-4 py-2 bg-purple-500 text-white rounded-lg hover:bg-purple-600 transition-colors">
                <i class="fas fa-filter mr-2"></i>
                Lọc
            </button>
        </div>
    </div>

    <!-- AI Suggestions List -->
    <div class="space-y-4" id="suggestions-list">
        <!-- Suggestions will be loaded here -->
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden bg-white/20 backdrop-blur-xl rounded-2xl p-12 shadow-lg border border-white/20 text-center animate-fade-in">
        <div class="w-24 h-24 bg-purple-100 dark:bg-purple-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-robot text-3xl text-purple-600 dark:text-purple-400"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Chưa có gợi ý nào</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">AI đang phân tích dữ liệu của bạn để đưa ra gợi ý phù hợp</p>
        <button onclick="refreshSuggestions()" class="bg-purple-500 text-white px-6 py-3 rounded-lg hover:bg-purple-600 transition-colors">
            <i class="fas fa-sync-alt mr-2"></i>
            Làm Mới
        </button>
    </div>
</div>

<!-- Suggestion Detail Modal -->
<div id="suggestion-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white/90 backdrop-blur-xl rounded-2xl shadow-2xl max-w-2xl w-full p-6 animate-fade-in">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-semibold text-gray-800" id="modal-title">Chi Tiết Gợi Ý</h3>
                <button onclick="closeModal('suggestion-modal')" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <i class="fas fa-times text-gray-500"></i>
                </button>
            </div>
            <div id="suggestion-content">
                <!-- Suggestion content will be loaded here -->
            </div>
            <div class="flex space-x-3 mt-6">
                <button onclick="closeModal('suggestion-modal')" class="flex-1 px-4 py-3 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors">
                    Đóng
                </button>
                <button onclick="applySuggestion()" class="flex-1 px-4 py-3 bg-purple-500 text-white rounded-lg hover:bg-purple-600 transition-colors">
                    <i class="fas fa-check mr-2"></i>
                    Áp Dụng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSuggestion = null;
        let currentFilters = {};
        
        document.addEventListener('DOMContentLoaded', function() {
            loadSuggestions();
            loadCategories();
        });
        
        async function loadSuggestions() {
            try {
                showLoading();
                
                const params = new URLSearchParams(currentFilters);
                const data = await apiCall(`/api/ai-suggestions?${params}`);
                
                // Update stats
                document.getElementById('total-suggestions').textContent = data.totalCount || 0;
                document.getElementById('applied-suggestions').textContent = data.appliedCount || 0;
                document.getElementById('warning-suggestions').textContent = data.warningCount || 0;
                document.getElementById('savings-potential').textContent = formatCurrency(data.savingsPotential || 0);
                
                // Render suggestions
                renderSuggestions(data.suggestions || []);
                
            } catch (error) {
                console.error('Error loading suggestions:', error);
                showToast('Có lỗi xảy ra khi tải gợi ý', 'error');
            } finally {
                hideLoading();
            }
        }
        
        async function loadCategories() {
            try {
                const data = await apiCall('/api/category');
                const select = document.getElementById('category-filter');
                
                select.innerHTML = '<option value="">Tất cả danh mục</option>';
                data.forEach(category => {
                    const option = document.createElement('option');
                    option.value = category.id;
                    option.textContent = category.name;
                    select.appendChild(option);
                });
            } catch (error) {
                console.error('Error loading categories:', error);
            }
        }
        
        function renderSuggestions(suggestions) {
            const container = document.getElementById('suggestions-list');
            const emptyState = document.getElementById('empty-state');
            
            if (suggestions.length === 0) {
                container.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }
            
            container.classList.remove('hidden');
            emptyState.classList.add('hidden');
            
            container.innerHTML = suggestions.map((suggestion, index) => `
                <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 animate-fade-in" style="animation-delay: ${index * 0.1}s">
                    <div class="flex items-start space-x-4">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center ${getSuggestionIconClass(suggestion.type)}">
                            <i class="${getSuggestionIcon(suggestion.type)} text-xl"></i>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="text-lg font-semibold text-gray-800 dark:text-white">${suggestion.title}</h3>
                                <div class="flex items-center space-x-2">
                                    <span class="px-2 py-1 text-xs font-medium rounded-full ${getSuggestionBadgeClass(suggestion.type)}">
                                        ${getSuggestionTypeText(suggestion.type)}
                                    </span>
                                    <span class="px-2 py-1 text-xs font-medium rounded-full ${getStatusBadgeClass(suggestion.status)}">
                                        ${getStatusText(suggestion.status)}
                                    </span>
                                </div>
                            </div>
                            <p class="text-gray-600 dark:text-gray-300 mb-4">${suggestion.message}</p>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-4 text-sm text-gray-500 dark:text-gray-400">
                                    <span><i class="fas fa-calendar mr-1"></i>${formatDate(suggestion.createdAt)}</span>
                                    ${suggestion.categoryName ? `<span><i class="fas fa-tag mr-1"></i>${suggestion.categoryName}</span>` : ''}
                                    ${suggestion.savingsAmount ? `<span><i class="fas fa-piggy-bank mr-1"></i>Tiết kiệm: ${formatCurrency(suggestion.savingsAmount)}</span>` : ''}
                                </div>
                                <div class="flex items-center space-x-2">
                                    <button onclick="viewSuggestion(${suggestion.id})" class="px-3 py-1 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors text-sm">
                                        <i class="fas fa-eye mr-1"></i>
                                        Xem
                                    </button>
                                    ${suggestion.status !== 'applied' ? `
                                        <button onclick="applySuggestion(${suggestion.id})" class="px-3 py-1 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors text-sm">
                                            <i class="fas fa-check mr-1"></i>
                                            Áp dụng
                                        </button>
                                    ` : ''}
                                    <button onclick="dismissSuggestion(${suggestion.id})" class="px-3 py-1 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors text-sm">
                                        <i class="fas fa-times mr-1"></i>
                                        Bỏ qua
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        }
        
        function getSuggestionIcon(type) {
            switch(type) {
                case 'warning': return 'fas fa-exclamation-triangle';
                case 'critical': return 'fas fa-exclamation-circle';
                case 'info': return 'fas fa-lightbulb';
                default: return 'fas fa-info-circle';
            }
        }
        
        function getSuggestionIconClass(type) {
            switch(type) {
                case 'warning': return 'bg-yellow-100 dark:bg-yellow-900/20';
                case 'critical': return 'bg-red-100 dark:bg-red-900/20';
                case 'info': return 'bg-blue-100 dark:bg-blue-900/20';
                default: return 'bg-gray-100 dark:bg-gray-900/20';
            }
        }
        
        function getSuggestionBadgeClass(type) {
            switch(type) {
                case 'warning': return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-300';
                case 'critical': return 'bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-300';
                case 'info': return 'bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-300';
                default: return 'bg-gray-100 text-gray-800 dark:bg-gray-900/20 dark:text-gray-300';
            }
        }
        
        function getSuggestionTypeText(type) {
            switch(type) {
                case 'warning': return 'Cảnh báo';
                case 'critical': return 'Nghiêm trọng';
                case 'info': return 'Thông tin';
                default: return 'Gợi ý';
            }
        }
        
        function getStatusBadgeClass(status) {
            switch(status) {
                case 'new': return 'bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-300';
                case 'viewed': return 'bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-300';
                case 'applied': return 'bg-purple-100 text-purple-800 dark:bg-purple-900/20 dark:text-purple-300';
                case 'dismissed': return 'bg-gray-100 text-gray-800 dark:bg-gray-900/20 dark:text-gray-300';
                default: return 'bg-gray-100 text-gray-800 dark:bg-gray-900/20 dark:text-gray-300';
            }
        }
        
        function getStatusText(status) {
            switch(status) {
                case 'new': return 'Mới';
                case 'viewed': return 'Đã xem';
                case 'applied': return 'Đã áp dụng';
                case 'dismissed': return 'Đã bỏ qua';
                default: return 'Không xác định';
            }
        }
        
        function applyFilters() {
            currentFilters = {
                type: document.getElementById('type-filter').value,
                categoryId: document.getElementById('category-filter').value,
                status: document.getElementById('status-filter').value
            };
            
            // Remove empty filters
            Object.keys(currentFilters).forEach(key => {
                if (!currentFilters[key]) {
                    delete currentFilters[key];
                }
            });
            
            loadSuggestions();
        }
        
        function refreshSuggestions() {
            loadSuggestions();
        }
        
        async function viewSuggestion(id) {
            try {
                const suggestion = await apiCall(`/api/ai-suggestions/${id}`);
                currentSuggestion = suggestion;
                
                document.getElementById('modal-title').textContent = suggestion.title;
                document.getElementById('suggestion-content').innerHTML = `
                    <div class="space-y-4">
                        <div class="p-4 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                            <p class="text-gray-700 dark:text-gray-300">${suggestion.message}</p>
                        </div>
                        ${suggestion.details ? `
                            <div>
                                <h4 class="font-semibold text-gray-800 dark:text-white mb-2">Chi tiết:</h4>
                                <p class="text-gray-600 dark:text-gray-300">${suggestion.details}</p>
                            </div>
                        ` : ''}
                        ${suggestion.recommendations ? `
                            <div>
                                <h4 class="font-semibold text-gray-800 dark:text-white mb-2">Khuyến nghị:</h4>
                                <ul class="list-disc list-inside space-y-1 text-gray-600 dark:text-gray-300">
                                    ${suggestion.recommendations.map(rec => `<li>${rec}</li>`).join('')}
                                </ul>
                            </div>
                        ` : ''}
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span class="font-medium text-gray-800 dark:text-white">Ngày tạo:</span>
                                <span class="text-gray-600 dark:text-gray-300">${formatDate(suggestion.createdAt)}</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-800 dark:text-white">Danh mục:</span>
                                <span class="text-gray-600 dark:text-gray-300">${suggestion.categoryName || 'Không xác định'}</span>
                            </div>
                            ${suggestion.savingsAmount ? `
                                <div>
                                    <span class="font-medium text-gray-800 dark:text-white">Tiết kiệm tiềm năng:</span>
                                    <span class="text-green-600 font-semibold">${formatCurrency(suggestion.savingsAmount)}</span>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                `;
                
                openModal('suggestion-modal');
                
                // Mark as viewed
                await apiCall(`/api/ai-suggestions/${id}/view`, { method: 'POST' });
                
            } catch (error) {
                console.error('Error viewing suggestion:', error);
                showToast('Có lỗi xảy ra khi xem gợi ý', 'error');
            }
        }
        
        async function applySuggestion(id) {
            try {
                await apiCall(`/api/ai-suggestions/${id}/apply`, { method: 'POST' });
                showToast('Áp dụng gợi ý thành công!', 'success');
                loadSuggestions();
                
                if (currentSuggestion && currentSuggestion.id === id) {
                    closeModal('suggestion-modal');
                }
            } catch (error) {
                console.error('Error applying suggestion:', error);
                showToast('Có lỗi xảy ra khi áp dụng gợi ý', 'error');
            }
        }
        
        async function dismissSuggestion(id) {
            showConfirm('Bạn có chắc chắn muốn bỏ qua gợi ý này?', async (confirmed) => {
                if (confirmed) {
                    try {
                        await apiCall(`/api/ai-suggestions/${id}/dismiss`, { method: 'POST' });
                        showToast('Đã bỏ qua gợi ý', 'info');
                        loadSuggestions();
                    } catch (error) {
                        console.error('Error dismissing suggestion:', error);
                        showToast('Có lỗi xảy ra khi bỏ qua gợi ý', 'error');
                    }
                }
            });
        }
    </script>
}
