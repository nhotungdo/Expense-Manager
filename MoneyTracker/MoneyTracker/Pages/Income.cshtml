@page
@model MoneyTracker.Pages.IncomeModel
@{
    ViewData["Title"] = "Quản Lý Thu Nhập";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 animate-fade-in">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white">Quản Lý Thu Nhập</h2>
                <p class="text-gray-600 dark:text-gray-300">Theo dõi và quản lý các khoản thu nhập của bạn</p>
            </div>
            <button onclick="openModal('add-income-modal')" class="bg-gradient-to-r from-green-500 to-emerald-500 text-white px-6 py-3 rounded-xl hover:from-green-600 hover:to-emerald-600 transition-all duration-300 transform hover:-translate-y-1 shadow-lg">
                <i class="fas fa-plus mr-2"></i>
                Thêm Thu Nhập
            </button>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 animate-fade-in">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Từ ngày</label>
                <input type="date" id="start-date" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white/50 dark:bg-gray-800/50">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Đến ngày</label>
                <input type="date" id="end-date" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white/50 dark:bg-gray-800/50">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Danh mục</label>
                <select id="category-filter" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white/50 dark:bg-gray-800/50">
                    <option value="">Tất cả danh mục</option>
                    <!-- Categories will be loaded here -->
                </select>
            </div>
            <div class="flex items-end">
                <button onclick="applyFilters()" class="w-full bg-blue-500 text-white px-4 py-3 rounded-lg hover:bg-blue-600 transition-colors">
                    <i class="fas fa-search mr-2"></i>
                    Lọc
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gradient-to-br from-green-400 to-emerald-500 rounded-2xl p-6 text-white shadow-xl animate-slide-in-up">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-green-100 text-sm font-medium">Tổng Thu Nhập</p>
                    <p class="text-3xl font-bold" id="total-income">0 VND</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-coins text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-blue-400 to-cyan-500 rounded-2xl p-6 text-white shadow-xl animate-slide-in-up" style="animation-delay: 0.1s">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-blue-100 text-sm font-medium">Giao Dịch</p>
                    <p class="text-3xl font-bold" id="total-transactions">0</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-list text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-teal-400 to-green-500 rounded-2xl p-6 text-white shadow-xl animate-slide-in-up" style="animation-delay: 0.2s">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-teal-100 text-sm font-medium">Trung Bình</p>
                    <p class="text-3xl font-bold" id="average-income">0 VND</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-chart-line text-2xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 animate-fade-in">
        <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Thao Tác Nhanh</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button onclick="quickAddIncome('salary')" class="flex items-center space-x-3 p-4 bg-green-50 dark:bg-green-900/20 rounded-xl hover:bg-green-100 dark:hover:bg-green-900/30 transition-colors">
                <div class="w-12 h-12 bg-green-100 dark:bg-green-800 rounded-lg flex items-center justify-center">
                    <i class="fas fa-briefcase text-green-600 dark:text-green-400 text-xl"></i>
                </div>
                <div class="text-left">
                    <p class="font-medium text-gray-800 dark:text-white">Nhập Lương</p>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Thu nhập hàng tháng</p>
                </div>
            </button>
            <button onclick="quickAddIncome('investment')" class="flex items-center space-x-3 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl hover:bg-blue-100 dark:hover:bg-blue-900/30 transition-colors">
                <div class="w-12 h-12 bg-blue-100 dark:bg-blue-800 rounded-lg flex items-center justify-center">
                    <i class="fas fa-chart-line text-blue-600 dark:text-blue-400 text-xl"></i>
                </div>
                <div class="text-left">
                    <p class="font-medium text-gray-800 dark:text-white">Đầu Tư</p>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Lợi nhuận đầu tư</p>
                </div>
            </button>
            <button onclick="quickAddIncome('bonus')" class="flex items-center space-x-3 p-4 bg-purple-50 dark:bg-purple-900/20 rounded-xl hover:bg-purple-100 dark:hover:bg-purple-900/30 transition-colors">
                <div class="w-12 h-12 bg-purple-100 dark:bg-purple-800 rounded-lg flex items-center justify-center">
                    <i class="fas fa-gift text-purple-600 dark:text-purple-400 text-xl"></i>
                </div>
                <div class="text-left">
                    <p class="font-medium text-gray-800 dark:text-white">Thưởng</p>
                    <p class="text-sm text-gray-600 dark:text-gray-300">Thưởng, phụ cấp</p>
                </div>
            </button>
        </div>
    </div>

    <!-- Income Table -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl shadow-lg border border-white/20 animate-fade-in">
        <div class="p-6 border-b border-white/20">
            <div class="flex items-center justify-between">
                <h3 class="text-xl font-semibold text-gray-800 dark:text-white">Danh Sách Thu Nhập</h3>
                <div class="flex items-center space-x-2">
                    <button onclick="exportIncome()" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors">
                        <i class="fas fa-download mr-2"></i>
                        Xuất Excel
                    </button>
                    <button onclick="refreshIncome()" class="p-2 bg-white/20 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-white/30 transition-colors">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-white/10">
                    <tr>
                        <th class="text-left py-4 px-6 text-sm font-medium text-gray-600 dark:text-gray-300">Ngày</th>
                        <th class="text-left py-4 px-6 text-sm font-medium text-gray-600 dark:text-gray-300">Danh mục</th>
                        <th class="text-left py-4 px-6 text-sm font-medium text-gray-600 dark:text-gray-300">Ghi chú</th>
                        <th class="text-right py-4 px-6 text-sm font-medium text-gray-600 dark:text-gray-300">Số tiền</th>
                        <th class="text-center py-4 px-6 text-sm font-medium text-gray-600 dark:text-gray-300">Hành động</th>
                    </tr>
                </thead>
                <tbody id="income-table">
                    <!-- Income will be loaded here -->
                </tbody>
            </table>
        </div>
        <div class="p-6 border-t border-white/20">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-600 dark:text-gray-300">
                    Hiển thị <span id="showing-count">0</span> trong tổng số <span id="total-count">0</span> giao dịch
                </div>
                <div class="flex items-center space-x-2">
                    <button onclick="previousPage()" class="px-3 py-2 bg-white/20 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-white/30 transition-colors disabled:opacity-50" id="prev-btn">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <span class="px-3 py-2 text-sm text-gray-600 dark:text-gray-300" id="page-info">1 / 1</span>
                    <button onclick="nextPage()" class="px-3 py-2 bg-white/20 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-white/30 transition-colors disabled:opacity-50" id="next-btn">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Income Modal -->
<div id="add-income-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white/90 backdrop-blur-xl rounded-2xl shadow-2xl max-w-md w-full p-6 animate-fade-in">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-semibold text-gray-800" id="modal-title">Thêm Thu Nhập</h3>
                <button onclick="closeModal('add-income-modal')" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <i class="fas fa-times text-gray-500"></i>
                </button>
            </div>
            <form id="income-form">
                <input type="hidden" name="id" id="income-id">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Số tiền *</label>
                        <input type="number" name="amount" id="income-amount" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" placeholder="Nhập số tiền">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Danh mục *</label>
                        <select name="categoryId" id="income-category" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                            <option value="">Chọn danh mục</option>
                            <!-- Categories will be loaded here -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Ngày *</label>
                        <input type="date" name="incomeDate" id="income-date" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Ghi chú</label>
                        <textarea name="note" id="income-note" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" placeholder="Nhập ghi chú (tùy chọn)"></textarea>
                    </div>
                </div>
                <div class="flex space-x-3 mt-6">
                    <button type="button" onclick="closeModal('add-income-modal')" class="flex-1 px-4 py-3 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors">
                        Hủy
                    </button>
                    <button type="submit" class="flex-1 px-4 py-3 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors">
                        <span id="submit-text">Thêm</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let currentFilters = {};
        
        document.addEventListener('DOMContentLoaded', function() {
            // Set default date range (current month)
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            
            document.getElementById('start-date').value = firstDay.toISOString().split('T')[0];
            document.getElementById('end-date').value = lastDay.toISOString().split('T')[0];
            
            // Load initial data
            loadCategories();
            loadIncome();
        });
        
        async function loadCategories() {
            try {
                const data = await apiCall('/api/category?type=INCOME');
                const categorySelects = document.querySelectorAll('#category-filter, #income-category');
                
                categorySelects.forEach(select => {
                    select.innerHTML = '<option value="">Tất cả danh mục</option>';
                    data.forEach(category => {
                        const option = document.createElement('option');
                        option.value = category.id;
                        option.textContent = category.name;
                        select.appendChild(option);
                    });
                });
            } catch (error) {
                console.error('Error loading categories:', error);
            }
        }
        
        async function loadIncome() {
            try {
                showLoading();
                
                const params = new URLSearchParams({
                    page: currentPage,
                    pageSize: 10,
                    ...currentFilters
                });
                
                const data = await apiCall(`/api/income?${params}`);
                
                // Update stats
                document.getElementById('total-income').textContent = formatCurrency(data.totalAmount || 0);
                document.getElementById('total-transactions').textContent = data.totalCount || 0;
                document.getElementById('average-income').textContent = formatCurrency(data.averageAmount || 0);
                
                // Update table
                const tbody = document.getElementById('income-table');
                if (data.items && data.items.length > 0) {
                    tbody.innerHTML = data.items.map(income => `
                        <tr class="border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <td class="py-4 px-6 text-sm text-gray-600 dark:text-gray-300">${formatDate(income.incomeDate)}</td>
                            <td class="py-4 px-6">
                                <div class="flex items-center space-x-2">
                                    <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-tag text-green-600 text-sm"></i>
                                    </div>
                                    <span class="text-sm text-gray-600 dark:text-gray-300">${income.categoryName || 'Không có danh mục'}</span>
                                </div>
                            </td>
                            <td class="py-4 px-6 text-sm text-gray-600 dark:text-gray-300">${income.note || '-'}</td>
                            <td class="py-4 px-6 text-sm font-medium text-right text-green-600">${formatCurrency(income.amount)}</td>
                            <td class="py-4 px-6 text-center">
                                <div class="flex items-center justify-center space-x-2">
                                    <button onclick="editIncome(${income.id})" class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors" title="Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button onclick="deleteIncome(${income.id})" class="p-2 text-red-600 hover:bg-red-100 rounded-lg transition-colors" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-gray-500">Không có dữ liệu</td></tr>';
                }
                
                // Update pagination
                totalPages = Math.ceil((data.totalCount || 0) / 10);
                updatePagination();
                
            } catch (error) {
                console.error('Error loading income:', error);
                showToast('Có lỗi xảy ra khi tải dữ liệu', 'error');
            } finally {
                hideLoading();
            }
        }
        
        function updatePagination() {
            document.getElementById('page-info').textContent = `${currentPage} / ${totalPages}`;
            document.getElementById('showing-count').textContent = Math.min(currentPage * 10, document.getElementById('total-count').textContent);
            document.getElementById('total-count').textContent = document.getElementById('total-transactions').textContent;
            
            document.getElementById('prev-btn').disabled = currentPage === 1;
            document.getElementById('next-btn').disabled = currentPage === totalPages;
        }
        
        function applyFilters() {
            currentFilters = {
                startDate: document.getElementById('start-date').value,
                endDate: document.getElementById('end-date').value,
                categoryId: document.getElementById('category-filter').value
            };
            
            // Remove empty filters
            Object.keys(currentFilters).forEach(key => {
                if (!currentFilters[key]) {
                    delete currentFilters[key];
                }
            });
            
            currentPage = 1;
            loadIncome();
        }
        
        function previousPage() {
            if (currentPage > 1) {
                currentPage--;
                loadIncome();
            }
        }
        
        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                loadIncome();
            }
        }
        
        function refreshIncome() {
            loadIncome();
        }
        
        function editIncome(id) {
            loadIncomeForEdit(id);
        }
        
        async function loadIncomeForEdit(id) {
            try {
                const income = await apiCall(`/api/income/${id}`);
                
                document.getElementById('modal-title').textContent = 'Chỉnh Sửa Thu Nhập';
                document.getElementById('submit-text').textContent = 'Cập nhật';
                document.getElementById('income-id').value = income.id;
                document.getElementById('income-amount').value = income.amount;
                document.getElementById('income-category').value = income.categoryId;
                document.getElementById('income-date').value = income.incomeDate;
                document.getElementById('income-note').value = income.note || '';
                
                openModal('add-income-modal');
            } catch (error) {
                console.error('Error loading income:', error);
                showToast('Có lỗi xảy ra khi tải dữ liệu', 'error');
            }
        }
        
        function deleteIncome(id) {
            showConfirm('Bạn có chắc chắn muốn xóa giao dịch này?', async (confirmed) => {
                if (confirmed) {
                    try {
                        await apiCall(`/api/income/${id}`, {
                            method: 'DELETE'
                        });
                        
                        showToast('Xóa giao dịch thành công!', 'success');
                        loadIncome();
                    } catch (error) {
                        console.error('Error deleting income:', error);
                        showToast('Có lỗi xảy ra khi xóa giao dịch', 'error');
                    }
                }
            });
        }
        
        function exportIncome() {
            showToast('Tính năng xuất Excel đang được phát triển', 'info');
        }
        
        function quickAddIncome(type) {
            // Pre-fill form based on type
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('income-date').value = today;
            
            let categoryId = '';
            let note = '';
            
            switch(type) {
                case 'salary':
                    note = 'Lương tháng';
                    break;
                case 'investment':
                    note = 'Lợi nhuận đầu tư';
                    break;
                case 'bonus':
                    note = 'Thưởng, phụ cấp';
                    break;
            }
            
            document.getElementById('income-note').value = note;
            openModal('add-income-modal');
        }
        
        // Form handling
        document.getElementById('income-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            if (!validateForm('income-form')) {
                showToast('Vui lòng điền đầy đủ thông tin', 'error');
                return;
            }
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            const incomeId = document.getElementById('income-id').value;
            
            try {
                if (incomeId) {
                    // Update existing income
                    await apiCall(`/api/income/${incomeId}`, {
                        method: 'PUT',
                        body: JSON.stringify(data)
                    });
                    showToast('Cập nhật thu nhập thành công!', 'success');
                } else {
                    // Create new income
                    await apiCall('/api/income', {
                        method: 'POST',
                        body: JSON.stringify(data)
                    });
                    showToast('Thêm thu nhập thành công!', 'success');
                }
                
                closeModal('add-income-modal');
                this.reset();
                loadIncome();
            } catch (error) {
                console.error('Error saving income:', error);
                showToast('Có lỗi xảy ra khi lưu dữ liệu', 'error');
            }
        });
        
        // Reset form when modal is closed
        document.getElementById('add-income-modal').addEventListener('hidden.bs.modal', function() {
            document.getElementById('income-form').reset();
            document.getElementById('modal-title').textContent = 'Thêm Thu Nhập';
            document.getElementById('submit-text').textContent = 'Thêm';
            document.getElementById('income-id').value = '';
        });
    </script>
}
