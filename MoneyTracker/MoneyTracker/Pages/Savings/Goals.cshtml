@page
@model MoneyTracker.Pages.Savings.GoalsModel
@{
    ViewData["Title"] = "Savings Goals";
}

<h2>Savings Goals</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted">Track your savings progress and get smart suggestions</p>
    <a asp-page="Edit" class="btn btn-primary">Add Goal</a>
</div>

<div class="row g-3">
@foreach (var goal in Model.Goals)
{
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@goal.Name</h5>
                <p class="text-muted">Target: @goal.TargetAmount.ToString("N2")</p>
                
                <div class="progress mb-2" style="height: 20px;">
                    <div class="progress-bar" role="progressbar" style="width: @(goal.CurrentAmount / goal.TargetAmount * 100)%">
                        @(goal.CurrentAmount / goal.TargetAmount * 100)%
                    </div>
                </div>
                
                <div class="d-flex justify-content-between">
                    <span>@goal.CurrentAmount.ToString("N2") / @goal.TargetAmount.ToString("N2")</span>
                    <span class="text-muted">@goal.Status</span>
                </div>
                
                @if (goal.TargetDate.HasValue)
                {
                    <div class="mt-2">
                        <small class="text-muted">Target: @goal.TargetDate.Value.ToString("yyyy-MM-dd")</small>
                        @if (Model.Suggestions.ContainsKey(goal.Id))
                        {
                            <div class="alert alert-info mt-2">
                                <strong>Suggestion:</strong> @Model.Suggestions[goal.Id]
                            </div>
                        }
                    </div>
                }
                
                <div class="mt-3">
                    <a asp-page="Contribute" asp-route-id="@goal.Id" class="btn btn-sm btn-outline-primary">Contribute</a>
                    <a asp-page="Edit" asp-route-id="@goal.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@goal.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </div>
        </div>
    </div>
}
</div>

@if (Model.SmartSuggestions.Any())
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Smart Savings Suggestions</h5>
            <ul class="list-group list-group-flush">
            @foreach (var suggestion in Model.SmartSuggestions)
            {
                <li class="list-group-item">@suggestion</li>
            }
            </ul>
        </div>
    </div>
}
