@page
@model MoneyTracker.Pages.Savings.IndexModel
@{
    ViewData["Title"] = "Savings Goals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Savings Goals</h2>
    <a asp-page="Edit" class="btn btn-primary">Add Goal</a>
  </div>

<table class="table table-striped">
    <thead><tr><th>Name</th><th class="text-end">Current</th><th class="text-end">Target</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var g in Model.Items)
    {
        <tr>
            <td>@g.Name</td>
            <td class="text-end">@g.CurrentAmount.ToString("N2")</td>
            <td class="text-end">@g.TargetAmount.ToString("N2")</td>
            <td>@(g.Status==1?"Active":g.Status==2?"Completed":"Paused")</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-page="Contribute" asp-route-id="@g.Id" class="btn btn-sm btn-success">Contribute</a>
                <a asp-page="Delete" asp-route-id="@g.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
  </table>


