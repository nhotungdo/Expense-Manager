@page
@model MoneyTracker.Pages.BudgetsModel
@{
    ViewData["Title"] = "Ngân Sách";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Ngân Sách</h1>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBudgetModal">
        <i class="fas fa-plus me-2"></i>
        Tạo Ngân Sách Mới
    </button>
</div>

<!-- Budget Grid -->
<div class="row g-4">
    <!-- Budget Card 1 -->
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <i class="fas fa-utensils text-warning" style="font-size: 2rem;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Ăn uống</h5>
                        <small class="text-muted">Tháng 1/2024</small>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 84%" aria-valuenow="84"
                        aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Đã chi 4,200,000 / 5,000,000 ₫</span>
                    <span class="badge bg-warning">84%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Card 2 -->
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <i class="fas fa-shopping-cart text-info" style="font-size: 2rem;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Mua sắm</h5>
                        <small class="text-muted">Tháng 1/2024</small>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-danger" role="progressbar" style="width: 107%" aria-valuenow="107"
                        aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Đã chi 3,200,000 / 3,000,000 ₫</span>
                    <span class="badge bg-danger">107%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Card 3 -->
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <i class="fas fa-car text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Giao thông</h5>
                        <small class="text-muted">Tháng 1/2024</small>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 75%" aria-valuenow="75"
                        aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Đã chi 1,500,000 / 2,000,000 ₫</span>
                    <span class="badge bg-success">75%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Card 4 -->
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <i class="fas fa-gamepad text-secondary" style="font-size: 2rem;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Giải trí</h5>
                        <small class="text-muted">Tháng 1/2024</small>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: 60%" aria-valuenow="60"
                        aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Đã chi 1,200,000 / 2,000,000 ₫</span>
                    <span class="badge bg-info">60%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Card 5 -->
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <i class="fas fa-bolt text-warning" style="font-size: 2rem;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Tiện ích</h5>
                        <small class="text-muted">Tháng 1/2024</small>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100"
                        aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Đã chi 3,000,000 / 3,000,000 ₫</span>
                    <span class="badge bg-success">100%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Card 6 -->
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <i class="fas fa-home text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Nhà ở</h5>
                        <small class="text-muted">Tháng 1/2024</small>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 50%" aria-valuenow="50"
                        aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Đã chi 5,000,000 / 10,000,000 ₫</span>
                    <span class="badge bg-success">50%</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Budget Modal -->
<div class="modal fade" id="addBudgetModal" tabindex="-1" aria-labelledby="addBudgetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addBudgetModalLabel">Tạo Ngân Sách Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addBudgetForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Danh mục</label>
                            <select class="form-select" id="budgetCategory" required>
                                <option value="">Chọn danh mục</option>
                                <option value="food">Ăn uống</option>
                                <option value="shopping">Mua sắm</option>
                                <option value="transport">Giao thông</option>
                                <option value="entertainment">Giải trí</option>
                                <option value="utilities">Tiện ích</option>
                                <option value="housing">Nhà ở</option>
                                <option value="healthcare">Y tế</option>
                                <option value="education">Giáo dục</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số tiền ngân sách</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="budgetAmount" placeholder="Nhập số tiền"
                                    required min="0" step="1000">
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Loại kỳ hạn</label>
                            <select class="form-select" id="budgetPeriodType" required>
                                <option value="monthly">Hàng tháng</option>
                                <option value="weekly">Hàng tuần</option>
                                <option value="yearly">Hàng năm</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ngày bắt đầu</label>
                            <input type="date" class="form-control" id="budgetStartDate" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea class="form-control" id="budgetNote" rows="3"
                            placeholder="Nhập ghi chú về ngân sách này..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveBudget()">Tạo Ngân Sách</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize page
        document.addEventListener('DOMContentLoaded', function () {
            setDefaultDates();
        });

        // Set default dates
        function setDefaultDates() {
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

            document.getElementById('budgetStartDate').value = firstDay.toISOString().split('T')[0];
        }

        // Save budget
        function saveBudget() {
            const form = document.getElementById('addBudgetForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const budgetData = {
                category: document.getElementById('budgetCategory').value,
                amount: parseFloat(document.getElementById('budgetAmount').value),
                periodType: document.getElementById('budgetPeriodType').value,
                startDate: document.getElementById('budgetStartDate').value,
                note: document.getElementById('budgetNote').value
            };

            console.log('Budget data:', budgetData);

            // Here you would typically send the data to your server
            alert('Ngân sách đã được tạo thành công!');

            // Close modal and reset form
            const modal = bootstrap.Modal.getInstance(document.getElementById('addBudgetModal'));
            modal.hide();
            form.reset();
            setDefaultDates();
        }

        // Format currency
        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }
    </script>
}
