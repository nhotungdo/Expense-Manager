@page
@model MoneyTracker.Pages.Data.ImportModel
@{
    ViewData["Title"] = "Import Data";
}

<h2>Import Data</h2>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">CSV/Excel Import</h5>
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="Input.File" class="form-label">Select File</label>
                        <input asp-for="Input.File" type="file" class="form-control" accept=".csv,.xlsx,.xls" />
                        <span asp-validation-for="Input.File" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.AccountId" class="form-label">Default Account</label>
                        <select asp-for="Input.AccountId" class="form-select">
                            <option value="">Select Account</option>
                            @foreach (var account in Model.Accounts)
                            {
                                <option value="@account.Id">@account.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Input.AccountId" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Import</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">API Webhook</h5>
                <p class="text-muted">Use this webhook URL to receive transaction data from external services:</p>
                <div class="input-group">
                    <input type="text" class="form-control" value="@Model.WebhookUrl" readonly />
                    <button class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText('@Model.WebhookUrl')">Copy</button>
                </div>
                <div class="mt-3">
                    <small class="text-muted">
                        <strong>Format:</strong> POST JSON with fields: date, type, amount, description, account, category
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.ImportResult != null)
{
    <div class="alert alert-info mt-3">
        <strong>Import Result:</strong> @Model.ImportResult
    </div>
}
