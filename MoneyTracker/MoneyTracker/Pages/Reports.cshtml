@page
@model MoneyTracker.Pages.ReportsModel
@{
    ViewData["Title"] = "Báo Cáo";

}

@section Styles {
    <style>
        .reports-container {
            min-height: calc(100vh - 80px);
            padding: 2rem;
        }

        .report-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
        }

        .report-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .chart-container {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .filter-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .export-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 15px;
            padding: 0.75rem 1.5rem;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .export-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            color: white;
        }

        .period-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 0.5rem 1rem;
            color: white;
            transition: all 0.3s ease;
        }

        .period-btn:hover,
        .period-btn.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .stat-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: white;
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
        }

        .loading-skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
            border-radius: 20px;
            height: 300px;
            margin-bottom: 2rem;
        }

        @@keyframes loading {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
    </style>
}

<div class="reports-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-white">Báo Cáo & Thống Kê</h1>
            <p class="text-white-50 mb-0">Phân tích chi tiết tài chính của bạn</p>
        </div>
        <div class="d-flex gap-3">
            <button class="export-btn" onclick="exportReport('pdf')">
                <i class="fas fa-file-pdf me-2"></i>
                Xuất PDF
            </button>
            <button class="export-btn" onclick="exportReport('excel')">
                <i class="fas fa-file-excel me-2"></i>
                Xuất Excel
            </button>
        </div>
    </div>

    <!-- Period Selection -->
    <div class="filter-card">
        <h5 class="text-white mb-3">Chọn Kỳ Báo Cáo</h5>
        <div class="d-flex gap-2 flex-wrap">
            <button class="period-btn active" onclick="changePeriod('monthly')">
                <i class="fas fa-calendar-alt me-1"></i>
                Tháng này
            </button>
            <button class="period-btn" onclick="changePeriod('yearly')">
                <i class="fas fa-calendar me-1"></i>
                Năm này
            </button>
            <button class="period-btn" onclick="changePeriod('custom')">
                <i class="fas fa-calendar-week me-1"></i>
                Tùy chọn
            </button>
        </div>
        
        <!-- Custom Date Range -->
        <div id="customDateRange" class="mt-3" style="display: none;">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label text-white">Từ ngày</label>
                    <input type="date" class="form-control bg-transparent text-white border-secondary" id="customStartDate">
                </div>
                <div class="col-md-6">
                    <label class="form-label text-white">Đến ngày</label>
                    <input type="date" class="form-control bg-transparent text-white border-secondary" id="customEndDate">
                </div>
            </div>
            <div class="mt-3">
                <button class="period-btn" onclick="applyCustomDateRange()">
                    <i class="fas fa-check me-1"></i>
                    Áp dụng
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-success" id="totalIncome">0 VND</div>
                <div class="stat-label">Tổng Thu Nhập</div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-danger" id="totalExpense">0 VND</div>
                <div class="stat-label">Tổng Chi Tiêu</div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-info" id="netAmount">0 VND</div>
                <div class="stat-label">Số Dư</div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-warning" id="transactionCount">0</div>
                <div class="stat-label">Giao Dịch</div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-4">
            <div class="chart-container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="text-white mb-0">Xu Hướng Thu Chi</h5>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-light btn-sm active" onclick="changeChartType('line')">
                            <i class="fas fa-chart-line"></i>
                        </button>
                        <button type="button" class="btn btn-outline-light btn-sm" onclick="changeChartType('bar')">
                            <i class="fas fa-chart-bar"></i>
                        </button>
                    </div>
                </div>
                <div style="height: 400px;">
                    <canvas id="trendsChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="chart-container">
                <h5 class="text-white mb-4">Chi Tiêu Theo Danh Mục</h5>
                <div style="height: 400px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Analysis -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="chart-container">
                <h5 class="text-white mb-4">Top 5 Danh Mục Chi Tiêu</h5>
                <div id="topCategories">
                    <!-- Loading skeleton -->
                    <div class="loading-skeleton" style="height: 200px;"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="chart-container">
                <h5 class="text-white mb-4">So Sánh Kỳ Trước</h5>
                <div id="comparison">
                    <!-- Loading skeleton -->
                    <div class="loading-skeleton" style="height: 200px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Breakdown -->
    <div class="chart-container">
        <h5 class="text-white mb-4">Phân Tích Theo Tháng</h5>
        <div style="height: 300px;">
            <canvas id="monthlyChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global variables
        let currentPeriod = 'monthly';
        let currentChartType = 'line';
        let trendsChart, categoryChart, monthlyChart;

        // Initialize page
        document.addEventListener('DOMContentLoaded', function () {
            setupCharts();
            loadReportData();
        });

        // Setup charts
        function setupCharts() {
            setupTrendsChart();
            setupCategoryChart();
            setupMonthlyChart();
        }

        // Setup trends chart
        function setupTrendsChart() {
            const ctx = document.getElementById('trendsChart').getContext('2d');
            trendsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Thu nhập',
                        data: [],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        tension: 0.4,
                        fill: true
                    }, {
                        label: 'Chi tiêu',
                        data: [],
                        borderColor: '#ef4444',
                        backgroundColor: 'rgba(239, 68, 68, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: 'white'
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: 'white'
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            }
                        },
                        y: {
                            ticks: {
                                color: 'white',
                                callback: function (value) {
                                    return formatCurrency(value);
                                }
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            }
                        }
                    }
                }
            });
        }

        // Setup category chart
        function setupCategoryChart() {
            const ctx = document.getElementById('categoryChart').getContext('2d');
            categoryChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [],
                    datasets: [{
                        data: [],
                        backgroundColor: [
                            '#ef4444',
                            '#f97316',
                            '#eab308',
                            '#22c55e',
                            '#3b82f6',
                            '#8b5cf6',
                            '#ec4899',
                            '#6b7280'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: 'white',
                                padding: 20
                            }
                        }
                    }
                }
            });
        }

        // Setup monthly chart
        function setupMonthlyChart() {
            const ctx = document.getElementById('monthlyChart').getContext('2d');
            monthlyChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Thu nhập',
                        data: [],
                        backgroundColor: 'rgba(16, 185, 129, 0.8)',
                        borderColor: '#10b981',
                        borderWidth: 1
                    }, {
                        label: 'Chi tiêu',
                        data: [],
                        backgroundColor: 'rgba(239, 68, 68, 0.8)',
                        borderColor: '#ef4444',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: 'white'
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: 'white'
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            }
                        },
                        y: {
                            ticks: {
                                color: 'white',
                                callback: function (value) {
                                    return formatCurrency(value);
                                }
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            }
                        }
                    }
                }
            });
        }

        // Load report data
        async function loadReportData() {
            try {
                showLoadingState();
                
                let response;
                if (currentPeriod === 'monthly') {
                    response = await fetch('/api/reports/monthly');
                } else if (currentPeriod === 'yearly') {
                    response = await fetch('/api/reports/yearly');
                } else {
                    const startDate = document.getElementById('customStartDate').value;
                    const endDate = document.getElementById('customEndDate').value;
                    response = await fetch(`/api/reports/custom?startDate=${startDate}&endDate=${endDate}`);
                }

                if (response.ok) {
                    const data = await response.json();
                    updateReportData(data);
                } else {
                    // Use mock data
                    loadMockData();
                }
            } catch (error) {
                console.error('Error loading report data:', error);
                loadMockData();
            }
        }

        // Update report data
        function updateReportData(data) {
            // Update summary stats
            document.getElementById('totalIncome').textContent = formatCurrency(data.totalIncome || 0);
            document.getElementById('totalExpense').textContent = formatCurrency(data.totalExpense || 0);
            document.getElementById('netAmount').textContent = formatCurrency(data.netAmount || 0);
            document.getElementById('transactionCount').textContent = data.transactionCount?.total || 0;

            // Update charts
            updateCharts(data);
            
            // Update detailed analysis
            updateTopCategories(data.expenseByCategory || []);
            updateComparison(data);
        }

        // Update charts
        function updateCharts(data) {
            // Update trends chart
            if (trendsChart && data.dailySpending) {
                trendsChart.data.labels = data.dailySpending.map(d => d.date);
                trendsChart.data.datasets[0].data = data.dailySpending.map(d => d.income);
                trendsChart.data.datasets[1].data = data.dailySpending.map(d => d.expense);
                trendsChart.update();
            }

            // Update category chart
            if (categoryChart && data.expenseByCategory) {
                categoryChart.data.labels = data.expenseByCategory.map(c => c.category);
                categoryChart.data.datasets[0].data = data.expenseByCategory.map(c => c.amount);
                categoryChart.update();
            }

            // Update monthly chart
            if (monthlyChart && data.monthlyTrends) {
                monthlyChart.data.labels = data.monthlyTrends.map(m => m.monthName);
                monthlyChart.data.datasets[0].data = data.monthlyTrends.map(m => m.income);
                monthlyChart.data.datasets[1].data = data.monthlyTrends.map(m => m.expense);
                monthlyChart.update();
            }
        }

        // Update top categories
        function updateTopCategories(categories) {
            const container = document.getElementById('topCategories');
            container.innerHTML = '';

            const top5 = categories.slice(0, 5);
            const total = categories.reduce((sum, cat) => sum + cat.amount, 0);

            top5.forEach((category, index) => {
                const percentage = total > 0 ? (category.amount / total) * 100 : 0;
                const categoryElement = document.createElement('div');
                categoryElement.className = 'mb-3';
                categoryElement.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-white">${category.category}</span>
                        <span class="text-white-50">${formatCurrency(category.amount)}</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar" style="width: ${percentage}%; background: ${getCategoryColor(index)}"></div>
                    </div>
                    <small class="text-white-50">${percentage.toFixed(1)}%</small>
                `;
                container.appendChild(categoryElement);
            });
        }

        // Update comparison
        function updateComparison(data) {
            const container = document.getElementById('comparison');
            container.innerHTML = '';

            // Mock comparison data
            const comparisonData = [
                { label: 'Thu nhập', current: data.totalIncome || 0, previous: (data.totalIncome || 0) * 0.9, type: 'income' },
                { label: 'Chi tiêu', current: data.totalExpense || 0, previous: (data.totalExpense || 0) * 0.85, type: 'expense' },
                { label: 'Số dư', current: data.netAmount || 0, previous: (data.netAmount || 0) * 0.8, type: 'balance' }
            ];

            comparisonData.forEach(item => {
                const change = item.previous > 0 ? ((item.current - item.previous) / item.previous) * 100 : 0;
                const changeClass = change > 0 ? 'text-success' : change < 0 ? 'text-danger' : 'text-white-50';
                const changeIcon = change > 0 ? 'fa-arrow-up' : change < 0 ? 'fa-arrow-down' : 'fa-minus';

                const comparisonElement = document.createElement('div');
                comparisonElement.className = 'mb-3';
                comparisonElement.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white mb-1">${item.label}</h6>
                            <small class="text-white-50">Kỳ trước: ${formatCurrency(item.previous)}</small>
                        </div>
                        <div class="text-end">
                            <h6 class="text-white mb-1">${formatCurrency(item.current)}</h6>
                            <small class="${changeClass}">
                                <i class="fas ${changeIcon} me-1"></i>
                                ${Math.abs(change).toFixed(1)}%
                            </small>
                        </div>
                    </div>
                `;
                container.appendChild(comparisonElement);
            });
        }

        // Load mock data
        function loadMockData() {
            const mockData = {
                totalIncome: 15000000,
                totalExpense: 12000000,
                netAmount: 3000000,
                transactionCount: { total: 45 },
                dailySpending: [
                    { date: '01/01', income: 0, expense: 500000 },
                    { date: '02/01', income: 0, expense: 300000 },
                    { date: '03/01', income: 0, expense: 800000 },
                    { date: '04/01', income: 0, expense: 400000 },
                    { date: '05/01', income: 15000000, expense: 600000 },
                    { date: '06/01', income: 0, expense: 700000 },
                    { date: '07/01', income: 0, expense: 900000 }
                ],
                expenseByCategory: [
                    { category: 'Ăn uống', amount: 3000000 },
                    { category: 'Mua sắm', amount: 2500000 },
                    { category: 'Giao thông', amount: 1500000 },
                    { category: 'Nhà ở', amount: 2000000 },
                    { category: 'Giải trí', amount: 1000000 },
                    { category: 'Khác', amount: 2000000 }
                ],
                monthlyTrends: [
                    { monthName: 'T1', income: 15000000, expense: 12000000 },
                    { monthName: 'T2', income: 16000000, expense: 11000000 },
                    { monthName: 'T3', income: 14000000, expense: 13000000 },
                    { monthName: 'T4', income: 17000000, expense: 12500000 },
                    { monthName: 'T5', income: 15500000, expense: 13500000 },
                    { monthName: 'T6', income: 18000000, expense: 14000000 }
                ]
            };

            updateReportData(mockData);
        }

        // Change period
        function changePeriod(period) {
            currentPeriod = period;

            // Update button states
            document.querySelectorAll('.period-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            // Show/hide custom date range
            const customRange = document.getElementById('customDateRange');
            if (period === 'custom') {
                customRange.style.display = 'block';
            } else {
                customRange.style.display = 'none';
            }

            // Load data
            loadReportData();
        }

        // Apply custom date range
        function applyCustomDateRange() {
            loadReportData();
        }

        // Change chart type
        function changeChartType(type) {
            currentChartType = type;

            // Update button states
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            // Update chart type
            if (trendsChart) {
                trendsChart.config.type = type;
                trendsChart.update();
            }
        }

        // Export report
        async function exportReport(format) {
            try {
                const response = await fetch(`/api/reports/export/${format}?period=${currentPeriod}`);
                if (response.ok) {
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `report_${currentPeriod}_${new Date().toISOString().split('T')[0]}.${format}`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                } else {
                    showNotification('Có lỗi xảy ra khi xuất báo cáo!', 'error');
                }
            } catch (error) {
                console.error('Error exporting report:', error);
                showNotification('Có lỗi xảy ra khi xuất báo cáo!', 'error');
            }
        }

        // Show loading state
        function showLoadingState() {
            document.getElementById('topCategories').innerHTML = '<div class="loading-skeleton" style="height: 200px;"></div>';
            document.getElementById('comparison').innerHTML = '<div class="loading-skeleton" style="height: 200px;"></div>';
        }

        // Show notification
        function showNotification(message, type) {
            alert(message);
        }

        // Get category color
        function getCategoryColor(index) {
            const colors = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#3b82f6'];
            return colors[index % colors.length];
        }

        // Utility functions
        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }
    </script>
}