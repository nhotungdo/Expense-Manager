@page
@model MoneyTracker.Pages.Settings.ThemeModel
@{
    ViewData["Title"] = "Theme Settings";
}

<h2>Theme Settings</h2>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Dark Mode</h5>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="darkModeToggle" @(Model.IsDarkMode ? "checked" : "")>
                    <label class="form-check-label" for="darkModeToggle">
                        Enable Dark Mode
                    </label>
                </div>
                <p class="text-muted mt-2">Toggle between light and dark themes</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Language</h5>
                <select class="form-select" id="languageSelect">
                    <option value="en" @(Model.Language == "en" ? "selected" : "")>English</option>
                    <option value="vi" @(Model.Language == "vi" ? "selected" : "")>Tiếng Việt</option>
                    <option value="fr" @(Model.Language == "fr" ? "selected" : "")>Français</option>
                </select>
                <p class="text-muted mt-2">Choose your preferred language</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <button type="button" class="btn btn-primary" onclick="saveSettings()">Save Settings</button>
</div>

@section Scripts {
<script>
document.getElementById('darkModeToggle').addEventListener('change', function() {
    document.body.classList.toggle('dark-mode', this.checked);
    localStorage.setItem('darkMode', this.checked);
});

document.getElementById('languageSelect').addEventListener('change', function() {
    localStorage.setItem('language', this.value);
    // In a real app, you'd reload the page or use i18n framework
    alert('Language changed to: ' + this.value);
});

function saveSettings() {
    const darkMode = document.getElementById('darkModeToggle').checked;
    const language = document.getElementById('languageSelect').value;
    
    localStorage.setItem('darkMode', darkMode);
    localStorage.setItem('language', language);
    
    alert('Settings saved!');
}

// Load saved settings
document.addEventListener('DOMContentLoaded', function() {
    const darkMode = localStorage.getItem('darkMode') === 'true';
    const language = localStorage.getItem('language') || 'en';
    
    document.getElementById('darkModeToggle').checked = darkMode;
    document.getElementById('languageSelect').value = language;
    document.body.classList.toggle('dark-mode', darkMode);
});
</script>
}
