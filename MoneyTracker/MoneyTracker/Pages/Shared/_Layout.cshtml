<!DOCTYPE html>
<html lang="vi" class="h-full">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Money Tracker</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <style>
        /* User Dropdown Styling */
        .header-actions .dropdown-toggle {
            border: 1px solid #dee2e6;
            background: white;
            color: #495057;
            transition: all 0.2s ease;
        }

        .header-actions .dropdown-toggle:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
        }

        .header-actions .dropdown-toggle:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

        .dropdown-menu {
            border: 1px solid #dee2e6;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border-radius: 0.375rem;
            min-width: 200px;
        }

        .dropdown-header {
            padding: 0.75rem 1rem;
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        .dropdown-item {
            padding: 0.5rem 1rem;
            transition: all 0.2s ease;
        }

        .dropdown-item:hover {
            background: #f8f9fa;
        }

        .dropdown-item.text-danger:hover {
            background: #f8d7da;
            color: #721c24 !important;
        }

        .dropdown-item i {
            width: 16px;
            text-align: center;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .header-actions .dropdown-toggle span {
                display: none !important;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="h-full">
    <div class="min-h-full d-flex">
        <!-- Fixed Sidebar -->
        <div class="sidebar">
            <!-- Logo Section -->
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-wallet logo-icon"></i>
                    <span class="logo-text">Money Tracker</span>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">
                <a href="/Dashboard" class="nav-link">
                    <i class="fas fa-tachometer-alt nav-icon"></i>
                    <span class="nav-text">Trang chủ</span>
                </a>
                <a href="/Transactions" class="nav-link">
                    <i class="fas fa-exchange-alt nav-icon"></i>
                    <span class="nav-text">Giao dịch</span>
                </a>
                <a href="/Budgets" class="nav-link">
                    <i class="fas fa-wallet nav-icon"></i>
                    <span class="nav-text">Ngân sách</span>
                </a>
                <a href="/Categories" class="nav-link">
                    <i class="fas fa-tags nav-icon"></i>
                    <span class="nav-text">Danh mục</span>
                </a>
                <a href="/Reports" class="nav-link">
                    <i class="fas fa-chart-pie nav-icon"></i>
                    <span class="nav-text">Báo cáo</span>
                </a>
                <a href="/AiSuggestions" class="nav-link">
                    <i class="fas fa-robot nav-icon"></i>
                    <span class="nav-text">AI Gợi ý</span>
                </a>
            </nav>

            <!-- Profile Link at Bottom -->
            <div class="sidebar-footer">
                <a href="/Profile" class="nav-link profile-link">
                    <i class="fas fa-user-circle nav-icon"></i>
                    <span class="nav-text">Hồ sơ</span>
                </a>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Top Header Bar -->
            <div class="top-header">
                <div class="header-content">
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    <div class="header-actions">
                        <button class="btn btn-outline-secondary me-2" title="Thông báo">
                            <i class="fas fa-bell"></i>
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-2"></i>
                                <span class="d-none d-md-inline">@(User.Identity?.Name ?? "User")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">@(User.Identity?.Name ?? "User")</span>
                                        <small
                                            class="text-muted">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                                                                                        ?? "")</small>
                                    </div>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profile">
                                        <i class="fas fa-user me-2"></i>Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Settings">
                                        <i class="fas fa-cog me-2"></i>Cài đặt
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <form method="post" action="/Identity/Account/Logout" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"
                                            onclick="return confirm('Bạn có chắc chắn muốn đăng xuất?')">
                                            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
