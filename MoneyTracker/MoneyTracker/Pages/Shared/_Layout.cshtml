<!DOCTYPE html>
<html lang="vi" class="h-full">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Money Tracker</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Design System CSS -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="h-full" data-theme="light">
    <div class="min-h-full">
        <!-- Sidebar -->
        <div id="sidebar" class="sidebar">
            <div class="sidebar-content">
                <!-- Logo -->
                <div class="sidebar-header">
                    <div class="logo">
                        <div class="logo-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <span class="logo-text">Money Tracker</span>
                    </div>
                </div>

                <!-- Navigation -->
                <nav class="sidebar-nav">
                    <a href="/Dashboard" class="nav-link" data-page="dashboard">
                        <i class="fas fa-home nav-icon"></i>
                        <span class="nav-text">Dashboard</span>
                    </a>

                    <a href="/Transactions" class="nav-link" data-page="transactions">
                        <i class="fas fa-exchange-alt nav-icon"></i>
                        <span class="nav-text">Giao dịch</span>
                    </a>

                    <a href="/Budgets" class="nav-link" data-page="budgets">
                        <i class="fas fa-chart-pie nav-icon"></i>
                        <span class="nav-text">Ngân sách</span>
                    </a>

                    <a href="/Categories" class="nav-link" data-page="categories">
                        <i class="fas fa-tags nav-icon"></i>
                        <span class="nav-text">Danh mục</span>
                    </a>

                    <a href="/Reports" class="nav-link" data-page="reports">
                        <i class="fas fa-chart-bar nav-icon"></i>
                        <span class="nav-text">Báo cáo</span>
                    </a>

                    <a href="/AI" class="nav-link" data-page="ai">
                        <i class="fas fa-robot nav-icon"></i>
                        <span class="nav-text">AI Gợi ý</span>
                    </a>

                    <a href="/Profile" class="nav-link" data-page="profile">
                        <i class="fas fa-user nav-icon"></i>
                        <span class="nav-text">Hồ sơ</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="nav-divider"></div>
                        <a href="/Admin" class="nav-link" data-page="admin">
                            <i class="fas fa-cog nav-icon"></i>
                            <span class="nav-text">Quản trị</span>
                        </a>
                    }
                </nav>

                <!-- User Info -->
                <div class="sidebar-footer">
                    <div class="user-info">
                        <div class="user-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="user-details">
                            <div class="user-name">@User.Identity?.Name</div>
                            <div class="user-role">@User.FindFirst("Role")?.Value</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div class="top-bar-content">
                    <!-- Mobile menu button -->
                    <button id="sidebar-toggle" class="mobile-menu-btn">
                        <i class="fas fa-bars"></i>
                    </button>

                    <!-- Page Title -->
                    <div class="page-title">
                        <h1 class="page-title-text">@ViewData["Title"]</h1>
                    </div>

                    <!-- Right side -->
                    <div class="top-bar-actions">
                        <!-- Theme Toggle -->
                        <button id="theme-toggle" class="action-btn" title="Chuyển đổi chế độ">
                            <i class="fas fa-moon theme-icon"></i>
                        </button>

                        <!-- Notifications -->
                        <div class="notification-container">
                            <button id="notification-btn" class="action-btn notification-btn" title="Thông báo">
                                <i class="fas fa-bell"></i>
                                <span id="notification-badge" class="notification-badge">3</span>
                            </button>

                            <!-- Notification Dropdown -->
                            <div id="notification-dropdown" class="notification-dropdown">
                                <div class="notification-header">
                                    <h3 class="notification-title">Thông báo</h3>
                                </div>
                                <div class="notification-list">
                                    <div class="notification-item">
                                        <div class="notification-icon warning">
                                            <i class="fas fa-exclamation-triangle"></i>
                                        </div>
                                        <div class="notification-content">
                                            <div class="notification-message">Cảnh báo ngân sách</div>
                                            <div class="notification-detail">Chi tiêu ăn uống đã vượt 35% thu nhập</div>
                                        </div>
                                    </div>
                                    <div class="notification-item">
                                        <div class="notification-icon info">
                                            <i class="fas fa-lightbulb"></i>
                                        </div>
                                        <div class="notification-content">
                                            <div class="notification-message">Gợi ý AI</div>
                                            <div class="notification-detail">Nên giảm chi tiêu giải trí 10%</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- User Menu -->
                        <div class="user-menu-container">
                            <button id="user-menu-btn" class="user-menu-btn">
                                <div class="user-avatar-small">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span class="user-name-small">@User.Identity?.Name</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>

                            <!-- User Dropdown -->
                            <div id="user-dropdown" class="user-dropdown">
                                <div class="user-dropdown-content">
                                    <a href="/Profile" class="dropdown-item">
                                        <i class="fas fa-user"></i>
                                        <span>Hồ sơ</span>
                                    </a>
                                    <a href="/Settings" class="dropdown-item">
                                        <i class="fas fa-cog"></i>
                                        <span>Cài đặt</span>
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a href="#" onclick="window.logoutManager.logout(); return false;" class="dropdown-item logout">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span>Đăng xuất</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <main class="page-content">
                <div class="content-container">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toast-container" class="toast-container"></div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="loading-overlay">
        <div class="loading-content">
            <div class="loading-spinner"></div>
            <span class="loading-text">Đang tải...</span>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/design-system.js"></script>
    <script src="~/js/logout.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
