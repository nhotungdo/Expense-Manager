@page
@model MoneyTracker.Pages.Identity.Account.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất - Money Tracker";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h2>Đăng xuất</h2>
                    <p>Bạn có chắc chắn muốn đăng xuất?</p>
                    <form method="post">
                        <button type="submit" class="btn btn-danger">Đăng xuất</button>
                        <a href="/HomePage" class="btn btn-secondary">Hủy</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
