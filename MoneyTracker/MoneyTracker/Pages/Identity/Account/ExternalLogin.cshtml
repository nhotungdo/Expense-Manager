@page
@model MoneyTracker.Pages.Identity.Account.ExternalLoginModel
@{
    ViewData["Title"] = "Đăng nhập với Google - Money Tracker";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h2>Đang xử lý đăng nhập...</h2>
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3">Vui lòng đợi trong giây lát...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Auto submit form when page loads
    window.onload = function() {
        document.getElementById('external-login-form').submit();
    };
</script>

<form id="external-login-form" method="post" style="display: none;">
    <input type="hidden" name="provider" value="@Model.Provider" />
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
</form>
