@page
@model MoneyTracker.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories</h2>
    <div>
        <a asp-page="Create" class="btn btn-primary">Add Category</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Parent</th>
            <th>Icon</th>
            <th>Color</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        <tr>
            <td>@c.Name</td>
            <td>@(c.Type == 0 ? "Expense" : c.Type == 1 ? "Income" : c.Type.ToString())</td>
            <td>@c.ParentCategory?.Name</td>
            <td>@c.Icon</td>
            <td>
                @if (!string.IsNullOrWhiteSpace(c.Color))
                {
                    <span class="badge" style="background-color:@c.Color">@c.Color</span>
                }
            </td>
            <td>@(c.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-page="SetLimit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Set limit</a>
                <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>


