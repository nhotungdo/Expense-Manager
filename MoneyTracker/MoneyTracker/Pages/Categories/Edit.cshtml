@page "{id:long}"
@model MoneyTracker.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<h2>Edit Category</h2>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Type" class="form-label"></label>
                <select asp-for="Input.Type" class="form-select">
                    <option value="0">Expense</option>
                    <option value="1">Income</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ParentCategoryId" class="form-label"></label>
                <select asp-for="Input.ParentCategoryId" class="form-select" asp-items="Model.ParentOptions">
                    <option value="">(None)</option>
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.Icon" class="form-label"></label>
                <input asp-for="Input.Icon" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Color" class="form-label"></label>
                <input asp-for="Input.Color" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <input asp-for="Input.Description" class="form-control" />
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

<partial name="_ValidationScriptsPartial" />


