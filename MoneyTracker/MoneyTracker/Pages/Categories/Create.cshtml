@page
@model dynamic
@{
    ViewData["Title"] = "Thêm danh mục";
}

<h3 class="mb-3"><i class="fa-solid fa-plus me-2"></i>Thêm danh mục</h3>
<form class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Tên</label>
        <input class="form-control" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Loại</label>
        <select class="form-select"><option>Chi</option><option>Thu</option></select>
    </div>
    <div class="col-12">
        <label class="form-label">Mô tả</label>
        <textarea class="form-control" rows="3"></textarea>
    </div>
    <div class="col-12">
        <button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu</button>
        <a class="btn btn-outline-secondary" asp-page="/Categories/Index">Hủy</a>
    </div>
    </form>

