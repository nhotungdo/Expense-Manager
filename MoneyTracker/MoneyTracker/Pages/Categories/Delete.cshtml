@page "{id:long}"
@model MoneyTracker.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<h2>Delete Category</h2>
<div class="alert alert-danger">Are you sure you want to delete this category?</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Item?.Name</dd>
    <dt class="col-sm-2">Type</dt><dd class="col-sm-10">@(Model.Item?.Type == 0 ? "Expense" : "Income")</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>


