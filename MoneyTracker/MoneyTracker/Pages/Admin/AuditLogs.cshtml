@page
@model AdminAuditLogsModel
@{
    ViewData["Title"] = "Admin - Audit Logs";
}

<h2>Audit Logs</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input asp-for="Filter.From" type="date" class="form-control" /></div>
    <div class="col-auto"><input asp-for="Filter.To" type="date" class="form-control" /></div>
    <div class="col-auto"><input asp-for="Filter.Action" class="form-control" placeholder="Action" /></div>
    <div class="col-auto"><input asp-for="Filter.EntityType" class="form-control" placeholder="EntityType" /></div>
    <div class="col-auto"><button class="btn btn-secondary" type="submit">Filter</button></div>
 </form>

<table class="table table-sm">
    <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>EntityId</th><th>IP</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Items)
    {
        <tr>
            <td>@a.CreatedAt</td>
            <td>@a.UserId</td>
            <td>@a.Action</td>
            <td>@a.EntityType</td>
            <td>@a.EntityId</td>
            <td>@a.IpAddress</td>
        </tr>
    }
    </tbody>
 </table>


