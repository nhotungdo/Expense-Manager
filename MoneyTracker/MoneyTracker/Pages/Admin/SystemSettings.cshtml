@page
@model AdminSystemSettingsModel
@{
    ViewData["Title"] = "Admin - System Settings";
}

<h2>System Settings</h2>

<form method="post" class="row g-2 mb-3">
    <div class="col-md-2"><input asp-for="Upsert.SettingKey" class="form-control" placeholder="Key" /></div>
    <div class="col-md-3"><input asp-for="Upsert.SettingValue" class="form-control" placeholder="Value" /></div>
    <div class="col-md-2"><input asp-for="Upsert.SettingType" class="form-control" placeholder="Type" /></div>
    <div class="col-md-3"><input asp-for="Upsert.Description" class="form-control" placeholder="Description" /></div>
    <div class="col-md-2"><button class="btn btn-success" name="action" value="create" type="submit">Add</button></div>
 </form>

<table class="table">
    <thead><tr><th>Key</th><th>Value</th><th>Type</th><th>Description</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model.Items)
    {
        <tr>
            <td>@s.SettingKey</td>
            <td>@s.SettingValue</td>
            <td>@s.SettingType</td>
            <td>@s.Description</td>
            <td>@s.IsActive</td>
            <td>
                <form method="post" class="d-inline">
                    <input type="hidden" name="Id" value="@s.Id" />
                    <input type="hidden" name="Upsert.SettingKey" value="@s.SettingKey" />
                    <input type="hidden" name="Upsert.SettingValue" value="@s.SettingValue" />
                    <input type="hidden" name="Upsert.SettingType" value="@s.SettingType" />
                    <input type="hidden" name="Upsert.Description" value="@s.Description" />
                    <button class="btn btn-sm btn-primary" name="action" value="update" type="submit">Save</button>
                </form>
                <form method="post" class="d-inline" onsubmit="return confirm('Delete setting?')">
                    <input type="hidden" name="Id" value="@s.Id" />
                    <button class="btn btn-sm btn-danger" name="action" value="delete" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
 </table>


