@page
@model MoneyTracker.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .dashboard-container {
            min-height: calc(100vh - 80px);
            padding: 2rem;
        }

        .stat-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

        .chart-container {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .quick-action-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 15px;
            padding: 1rem 1.5rem;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .quick-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            color: white;
            text-decoration: none;
        }

        .recent-transaction {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 0.5rem;
            border-left: 4px solid;
            transition: all 0.3s ease;
        }

        .recent-transaction:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .income-border {
            border-left-color: #10b981;
        }

        .expense-border {
            border-left-color: #ef4444;
        }

        .pulse-animation {
            animation: pulse 2s infinite;
        }

        @@keyframes
        pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        .loading-skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
        }

        @@keyframes
        loading {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }
    </style>
}

<div class="dashboard-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-white">Dashboard</h1>
            <p class="text-white-50 mb-0">Tổng quan tài chính của bạn</p>
        </div>
        <div class="d-flex gap-3">
            <button class="quick-action-btn" onclick="refreshDashboard()">
                <i class="fas fa-sync-alt"></i>
                Làm mới
            </button>
            <a href="/Expenses" class="quick-action-btn">
                <i class="fas fa-plus"></i>
                Thêm giao dịch
            </a>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-white-50 mb-2">Tổng Thu Nhập</h6>
                        <h3 class="text-white mb-1" id="total-income">0 VND</h3>
                        <small class="text-success">
                            <i class="fas fa-arrow-up me-1"></i>
                            <span id="income-change">+12%</span> tháng này
                        </small>
                    </div>
                    <div class="bg-success bg-opacity-20 p-3 rounded-circle">
                        <i class="fas fa-coins text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-white-50 mb-2">Tổng Chi Tiêu</h6>
                        <h3 class="text-white mb-1" id="total-expense">0 VND</h3>
                        <small class="text-danger">
                            <i class="fas fa-arrow-up me-1"></i>
                            <span id="expense-change">+8%</span> tháng này
                        </small>
                    </div>
                    <div class="bg-danger bg-opacity-20 p-3 rounded-circle">
                        <i class="fas fa-credit-card text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-white-50 mb-2">Số Dư Hiện Tại</h6>
                        <h3 class="text-white mb-1" id="current-balance">0 VND</h3>
                        <small class="text-info">
                            <i class="fas fa-wallet me-1"></i>
                            Tài khoản chính
                        </small>
                    </div>
                    <div class="bg-info bg-opacity-20 p-3 rounded-circle">
                        <i class="fas fa-wallet text-info fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-white-50 mb-2">Giao Dịch Tháng</h6>
                        <h3 class="text-white mb-1" id="monthly-transactions">0</h3>
                        <small class="text-warning">
                            <i class="fas fa-chart-line me-1"></i>
                            <span id="transaction-change">+15%</span> so với tháng trước
                        </small>
                    </div>
                    <div class="bg-warning bg-opacity-20 p-3 rounded-circle">
                        <i class="fas fa-chart-line text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-4">
            <div class="chart-container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="text-white mb-0">Xu Hướng Thu Chi</h5>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-light btn-sm active"
                            onclick="changeChartPeriod('week')">Tuần</button>
                        <button type="button" class="btn btn-outline-light btn-sm"
                            onclick="changeChartPeriod('month')">Tháng</button>
                        <button type="button" class="btn btn-outline-light btn-sm"
                            onclick="changeChartPeriod('year')">Năm</button>
                    </div>
                </div>
                <div style="height: 300px;">
                    <canvas id="trendsChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="chart-container">
                <h5 class="text-white mb-4">Chi Tiêu Theo Danh Mục</h5>
                <div style="height: 300px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions and Quick Actions -->
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="chart-container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="text-white mb-0">Giao Dịch Gần Đây</h5>
                    <a href="/Expenses" class="btn btn-outline-light btn-sm">Xem tất cả</a>
                </div>
                <div id="recent-transactions">
                    <!-- Loading skeleton -->
                    <div class="recent-transaction loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                    <div class="recent-transaction loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                    <div class="recent-transaction loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="chart-container">
                <h5 class="text-white mb-4">Thao Tác Nhanh</h5>
                <div class="d-grid gap-3">
                    <a href="/Expenses" class="quick-action-btn text-center">
                        <i class="fas fa-plus-circle"></i>
                        Thêm Chi Tiêu
                    </a>
                    <a href="/Incomes" class="quick-action-btn text-center">
                        <i class="fas fa-coins"></i>
                        Thêm Thu Nhập
                    </a>
                    <a href="/Reports" class="quick-action-btn text-center">
                        <i class="fas fa-chart-bar"></i>
                        Xem Báo Cáo
                    </a>
                    <a href="/AI" class="quick-action-btn text-center">
                        <i class="fas fa-robot"></i>
                        AI Gợi Ý
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Goals and Insights -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="chart-container">
                <h5 class="text-white mb-4">Mục Tiêu Tài Chính</h5>
                <div id="financial-goals">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white">Tiết kiệm khẩn cấp</span>
                            <span class="text-white-50">2,500,000 / 5,000,000 VND</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: 50%"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white">Mua xe mới</span>
                            <span class="text-white-50">15,000,000 / 50,000,000 VND</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-info" style="width: 30%"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-white">Du lịch</span>
                            <span class="text-white-50">3,000,000 / 10,000,000 VND</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-warning" style="width: 30%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="chart-container">
                <h5 class="text-white mb-4">Thông Tin Thông Minh</h5>
                <div id="ai-insights">
                    <div class="alert alert-info bg-info bg-opacity-20 border-info text-white">
                        <i class="fas fa-lightbulb me-2"></i>
                        <strong>Gợi ý:</strong> Bạn đã chi tiêu nhiều hơn 20% so với tháng trước. Hãy xem xét cắt giảm
                        chi phí không cần thiết.
                    </div>
                    <div class="alert alert-success bg-success bg-opacity-20 border-success text-white">
                        <i class="fas fa-chart-line me-2"></i>
                        <strong>Tin tốt:</strong> Thu nhập của bạn đã tăng 15% so với tháng trước!
                    </div>
                    <div class="alert alert-warning bg-warning bg-opacity-20 border-warning text-white">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Lưu ý:</strong> Bạn sắp đạt giới hạn chi tiêu cho danh mục "Ăn uống" trong tháng này.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global variables
        let trendsChart, categoryChart;
        let currentPeriod = 'week';

        // Initialize dashboard
        document.addEventListener('DOMContentLoaded', function () {
            initializeDashboard();
            loadDashboardData();
            setupCharts();
        });

        // Initialize dashboard
        function initializeDashboard() {
            // Set current date
            const now = new Date();
            const dateOptions = {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            };
            document.getElementById('current-date').textContent = now.toLocaleDateString('vi-VN', dateOptions);
        }

        // Load dashboard data
        async function loadDashboardData() {
            try {
                // Show loading state
                showLoadingState();

                // Load stats
                await loadStats();

                // Load recent transactions
                await loadRecentTransactions();

                // Load charts data
                await loadChartsData();

            } catch (error) {
                console.error('Error loading dashboard data:', error);
                showErrorState();
            }
        }

        // Load statistics
        async function loadStats() {
            try {
                const response = await fetch('/api/dashboard/stats');
                if (response.ok) {
                    const data = await response.json();
                    updateStats(data);
                } else {
                    // Use mock data if API fails
                    updateStats({
                        totalIncome: 15000000,
                        totalExpense: 12000000,
                        currentBalance: 3000000,
                        monthlyTransactions: 45,
                        incomeChange: 12,
                        expenseChange: 8,
                        transactionChange: 15
                    });
                }
            } catch (error) {
                console.error('Error loading stats:', error);
                // Use mock data
                updateStats({
                    totalIncome: 15000000,
                    totalExpense: 12000000,
                    currentBalance: 3000000,
                    monthlyTransactions: 45,
                    incomeChange: 12,
                    expenseChange: 8,
                    transactionChange: 15
                });
            }
        }

        // Update statistics display
        function updateStats(data) {
            document.getElementById('total-income').textContent = formatCurrency(data.totalIncome);
            document.getElementById('total-expense').textContent = formatCurrency(data.totalExpense);
            document.getElementById('current-balance').textContent = formatCurrency(data.currentBalance);
            document.getElementById('monthly-transactions').textContent = data.monthlyTransactions;
            document.getElementById('income-change').textContent = `+${data.incomeChange}%`;
            document.getElementById('expense-change').textContent = `+${data.expenseChange}%`;
            document.getElementById('transaction-change').textContent = `+${data.transactionChange}%`;
        }

        // Load recent transactions
        async function loadRecentTransactions() {
            try {
                const response = await fetch('/api/dashboard/recent-transactions');
                if (response.ok) {
                    const transactions = await response.json();
                    displayRecentTransactions(transactions);
                } else {
                    // Use mock data
                    displayRecentTransactions([
                        { id: 1, type: 'expense', amount: 500000, description: 'Ăn trưa', category: 'Ăn uống', date: '2024-01-15' },
                        { id: 2, type: 'income', amount: 15000000, description: 'Lương tháng 1', category: 'Lương', date: '2024-01-14' },
                        { id: 3, type: 'expense', amount: 2000000, description: 'Mua sắm', category: 'Mua sắm', date: '2024-01-13' },
                        { id: 4, type: 'expense', amount: 300000, description: 'Xăng xe', category: 'Giao thông', date: '2024-01-12' },
                        { id: 5, type: 'expense', amount: 1500000, description: 'Tiền nhà', category: 'Nhà ở', date: '2024-01-11' }
                    ]);
                }
            } catch (error) {
                console.error('Error loading recent transactions:', error);
                // Use mock data
                displayRecentTransactions([
                    { id: 1, type: 'expense', amount: 500000, description: 'Ăn trưa', category: 'Ăn uống', date: '2024-01-15' },
                    { id: 2, type: 'income', amount: 15000000, description: 'Lương tháng 1', category: 'Lương', date: '2024-01-14' },
                    { id: 3, type: 'expense', amount: 2000000, description: 'Mua sắm', category: 'Mua sắm', date: '2024-01-13' }
                ]);
            }
        }

        // Display recent transactions
        function displayRecentTransactions(transactions) {
            const container = document.getElementById('recent-transactions');
            container.innerHTML = '';

            transactions.forEach(transaction => {
                const transactionElement = document.createElement('div');
                transactionElement.className = `recent-transaction ${transaction.type === 'income' ? 'income-border' : 'expense-border'}`;

                const icon = transaction.type === 'income' ? 'fa-arrow-up' : 'fa-arrow-down';
                const color = transaction.type === 'income' ? 'text-success' : 'text-danger';

                transactionElement.innerHTML = `
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <i class="fas ${icon} ${color}"></i>
                                    </div>
                                    <div>
                                        <h6 class="text-white mb-1">${transaction.description}</h6>
                                        <small class="text-white-50">${transaction.category} • ${formatDate(transaction.date)}</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <h6 class="mb-0 ${color}">${transaction.type === 'income' ? '+' : '-'}${formatCurrency(transaction.amount)}</h6>
                                </div>
                            </div>
                        `;

                container.appendChild(transactionElement);
            });
        }

        // Setup charts
        function setupCharts() {
            setupTrendsChart();
            setupCategoryChart();
        }

        // Setup trends chart
        function setupTrendsChart() {
            const ctx = document.getElementById('trendsChart').getContext('2d');
            trendsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
                    datasets: [{
                        label: 'Thu nhập',
                        data: [1200000, 1900000, 3000000, 5000000, 2000000, 3000000, 4500000],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        tension: 0.4,
                        fill: true
                    }, {
                        label: 'Chi tiêu',
                        data: [800000, 1200000, 1500000, 2000000, 1800000, 2200000, 1900000],
                        borderColor: '#ef4444',
                        backgroundColor: 'rgba(239, 68, 68, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: 'white'
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: 'white'
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            }
                        },
                        y: {
                            ticks: {
                                color: 'white',
                                callback: function (value) {
                                    return formatCurrency(value);
                                }
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            }
                        }
                    }
                }
            });
        }

        // Setup category chart
        function setupCategoryChart() {
            const ctx = document.getElementById('categoryChart').getContext('2d');
            categoryChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Ăn uống', 'Mua sắm', 'Giao thông', 'Nhà ở', 'Giải trí', 'Khác'],
                    datasets: [{
                        data: [30, 25, 15, 20, 5, 5],
                        backgroundColor: [
                            '#ef4444',
                            '#f97316',
                            '#eab308',
                            '#22c55e',
                            '#3b82f6',
                            '#8b5cf6'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: 'white',
                                padding: 20
                            }
                        }
                    }
                }
            });
        }

        // Load charts data
        async function loadChartsData() {
            try {
                const response = await fetch(`/api/dashboard/charts?period=${currentPeriod}`);
                if (response.ok) {
                    const data = await response.json();
                    updateCharts(data);
                }
            } catch (error) {
                console.error('Error loading charts data:', error);
            }
        }

        // Update charts
        function updateCharts(data) {
            if (trendsChart && data.trends) {
                trendsChart.data.labels = data.trends.labels;
                trendsChart.data.datasets[0].data = data.trends.income;
                trendsChart.data.datasets[1].data = data.trends.expense;
                trendsChart.update();
            }

            if (categoryChart && data.categories) {
                categoryChart.data.labels = data.categories.labels;
                categoryChart.data.datasets[0].data = data.categories.data;
                categoryChart.update();
            }
        }

        // Change chart period
        function changeChartPeriod(period) {
            currentPeriod = period;

            // Update button states
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            // Reload charts data
            loadChartsData();
        }

        // Refresh dashboard
        function refreshDashboard() {
            const refreshBtn = event.target;
            const icon = refreshBtn.querySelector('i');

            // Add loading animation
            icon.classList.add('fa-spin');
            refreshBtn.disabled = true;

            // Reload data
            loadDashboardData().finally(() => {
                // Remove loading animation
                icon.classList.remove('fa-spin');
                refreshBtn.disabled = false;
            });
        }

        // Show loading state
        function showLoadingState() {
            // Add pulse animation to stat cards
            document.querySelectorAll('.stat-card').forEach(card => {
                card.classList.add('pulse-animation');
            });
        }

        // Hide loading state
        function hideLoadingState() {
            document.querySelectorAll('.stat-card').forEach(card => {
                card.classList.remove('pulse-animation');
            });
        }

        // Show error state
        function showErrorState() {
            hideLoadingState();
            // You can add error notification here
            console.error('Failed to load dashboard data');
        }

        // Utility functions
        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('vi-VN');
        }
    </script>
}