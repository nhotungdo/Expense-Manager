@page
@model MoneyTracker.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";

}


<!-- Header Section -->
<div class="d-flex justify-content-between align-items-center mb-6">
    <div>
        <h1 class="h1 mb-2">Dashboard</h1>
        <p class="text-secondary mb-0">Tổng quan tài chính của bạn</p>
    </div>
    <div class="d-flex gap-3">
        <button class="btn btn-outline" onclick="refreshDashboard()">
            <i class="fas fa-sync-alt"></i>
            Làm mới
        </button>
        <a href="/Expenses" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Thêm giao dịch
        </a>
    </div>
</div>

<!-- Stats Cards Row -->
<div class="row mb-6">
    <div class="col-md-3 mb-4">
        <div class="stat-card">
            <div class="stat-value text-income" id="total-income">0 VND</div>
            <div class="stat-label">Tổng Thu Nhập</div>
            <div class="stat-change positive">
                <i class="fas fa-arrow-up"></i>
                <span id="income-change">+12%</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="stat-card">
            <div class="stat-value text-expense" id="total-expense">0 VND</div>
            <div class="stat-label">Tổng Chi Tiêu</div>
            <div class="stat-change negative">
                <i class="fas fa-arrow-up"></i>
                <span id="expense-change">+8%</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="stat-card">
            <div class="stat-value text-primary" id="current-balance">0 VND</div>
            <div class="stat-label">Số Dư Hiện Tại</div>
            <div class="stat-change positive">
                <i class="fas fa-wallet"></i>
                <span>Tài khoản chính</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="stat-card">
            <div class="stat-value text-primary" id="monthly-transactions">0</div>
            <div class="stat-label">Giao Dịch Tháng</div>
            <div class="stat-change positive">
                <i class="fas fa-arrow-up"></i>
                <span id="transaction-change">+15%</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-6">
    <div class="col-lg-8 mb-4">
        <div class="chart-container">
            <div class="chart-header">
                <h5 class="chart-title">Xu Hướng Thu Chi</h5>
                <div class="chart-actions">
                    <button type="button" class="chart-btn active" onclick="changeChartPeriod('week')">Tuần</button>
                    <button type="button" class="chart-btn" onclick="changeChartPeriod('month')">Tháng</button>
                    <button type="button" class="chart-btn" onclick="changeChartPeriod('year')">Năm</button>
                </div>
            </div>
            <div style="height: 300px;">
                <canvas id="trendsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="chart-container">
            <div class="chart-header">
                <h5 class="chart-title">Chi Tiêu Theo Danh Mục</h5>
            </div>
            <div style="height: 300px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions and Quick Actions -->
<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Giao Dịch Gần Đây</h5>
                <a href="/Transactions" class="btn btn-outline btn-sm">Xem tất cả</a>
            </div>
            <div class="card-body">
                <div id="recent-transactions">
                    <!-- Loading skeleton -->
                    <div class="loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                    <div class="loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                    <div class="loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Thao Tác Nhanh</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-3">
                    <a href="/Transactions" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus"></i>
                        Thêm Giao Dịch
                    </a>
                    <a href="/Budgets" class="btn btn-secondary btn-lg">
                        <i class="fas fa-chart-pie"></i>
                        Quản Lý Ngân Sách
                    </a>
                    <a href="/Reports" class="btn btn-outline btn-lg">
                        <i class="fas fa-chart-bar"></i>
                        Xem Báo Cáo
                    </a>
                    <a href="/AI" class="btn btn-outline btn-lg">
                        <i class="fas fa-robot"></i>
                        AI Gợi Ý
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Goals and Insights -->
<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Mục Tiêu Tài Chính</h5>
            </div>
            <div class="card-body">
                <div id="financial-goals">
                    <div class="budget-item">
                        <div class="budget-header">
                            <div class="budget-title">Tiết kiệm khẩn cấp</div>
                            <div class="budget-amount">2,500,000 / 5,000,000 VND</div>
                        </div>
                        <div class="budget-progress">
                            <div class="budget-progress-bar" style="width: 50%"></div>
                        </div>
                        <div class="budget-footer">
                            <div class="budget-remaining">Còn lại: 2,500,000 VND</div>
                            <div class="budget-percentage">50%</div>
                        </div>
                    </div>
                    <div class="budget-item">
                        <div class="budget-header">
                            <div class="budget-title">Mua xe mới</div>
                            <div class="budget-amount">15,000,000 / 50,000,000 VND</div>
                        </div>
                        <div class="budget-progress">
                            <div class="budget-progress-bar" style="width: 30%"></div>
                        </div>
                        <div class="budget-footer">
                            <div class="budget-remaining">Còn lại: 35,000,000 VND</div>
                            <div class="budget-percentage">30%</div>
                        </div>
                    </div>
                    <div class="budget-item">
                        <div class="budget-header">
                            <div class="budget-title">Du lịch</div>
                            <div class="budget-amount">3,000,000 / 10,000,000 VND</div>
                        </div>
                        <div class="budget-progress">
                            <div class="budget-progress-bar" style="width: 30%"></div>
                        </div>
                        <div class="budget-footer">
                            <div class="budget-remaining">Còn lại: 7,000,000 VND</div>
                            <div class="budget-percentage">30%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Thông Tin Thông Minh</h5>
            </div>
            <div class="card-body">
                <div id="ai-insights">
                    <div class="toast show">
                        <div class="toast-icon info">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <div class="toast-content">
                            <div class="toast-title">Gợi ý</div>
                            <div class="toast-message">Bạn đã chi tiêu nhiều hơn 20% so với tháng trước. Hãy xem xét cắt
                                giảm chi phí không cần thiết.</div>
                        </div>
                    </div>
                    <div class="toast show">
                        <div class="toast-icon success">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="toast-content">
                            <div class="toast-title">Tin tốt</div>
                            <div class="toast-message">Thu nhập của bạn đã tăng 15% so với tháng trước!</div>
                        </div>
                    </div>
                    <div class="toast show">
                        <div class="toast-icon warning">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="toast-content">
                            <div class="toast-title">Lưu ý</div>
                            <div class="toast-message">Bạn sắp đạt giới hạn chi tiêu cho danh mục "Ăn uống" trong tháng
                                này.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Global variables
        let trendsChart, categoryChart;
        let currentPeriod = 'week';

        // Initialize dashboard
        document.addEventListener('DOMContentLoaded', function () {
            initializeDashboard();
            loadDashboardData();
            setupCharts();
        });

        // Initialize dashboard
        function initializeDashboard() {
            // Set current date
            const now = new Date();
            const dateOptions = {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            };
            document.getElementById('current-date').textContent = now.toLocaleDateString('vi-VN', dateOptions);
        }

        // Load dashboard data
        async function loadDashboardData() {
            try {
                // Show loading state
                showLoadingState();

                // Load stats
                await loadStats();

                // Load recent transactions
                await loadRecentTransactions();

                // Load charts data
                await loadChartsData();

            } catch (error) {
                console.error('Error loading dashboard data:', error);
                showErrorState();
            }
        }

        // Load statistics
        async function loadStats() {
            try {
                const response = await fetch('/api/dashboard/stats');
                if (response.ok) {
                    const data = await response.json();
                    updateStats(data);
                } else {
                    // Use mock data if API fails
                    updateStats({
                        totalIncome: 15000000,
                        totalExpense: 12000000,
                        currentBalance: 3000000,
                        monthlyTransactions: 45,
                        incomeChange: 12,
                        expenseChange: 8,
                        transactionChange: 15
                    });
                }
            } catch (error) {
                console.error('Error loading stats:', error);
                // Use mock data
                updateStats({
                    totalIncome: 15000000,
                    totalExpense: 12000000,
                    currentBalance: 3000000,
                    monthlyTransactions: 45,
                    incomeChange: 12,
                    expenseChange: 8,
                    transactionChange: 15
                });
            }
        }

        // Update statistics display
        function updateStats(data) {
            document.getElementById('total-income').textContent = formatCurrency(data.totalIncome);
            document.getElementById('total-expense').textContent = formatCurrency(data.totalExpense);
            document.getElementById('current-balance').textContent = formatCurrency(data.currentBalance);
            document.getElementById('monthly-transactions').textContent = data.monthlyTransactions;
            document.getElementById('income-change').textContent = `+${data.incomeChange}%`;
            document.getElementById('expense-change').textContent = `+${data.expenseChange}%`;
            document.getElementById('transaction-change').textContent = `+${data.transactionChange}%`;
        }

        // Load recent transactions
        async function loadRecentTransactions() {
            try {
                const response = await fetch('/api/dashboard/recent-transactions');
                if (response.ok) {
                    const transactions = await response.json();
                    displayRecentTransactions(transactions);
                } else {
                    // Use mock data
                    displayRecentTransactions([
                        { id: 1, type: 'expense', amount: 500000, description: 'Ăn trưa', category: 'Ăn uống', date: '2024-01-15' },
                        { id: 2, type: 'income', amount: 15000000, description: 'Lương tháng 1', category: 'Lương', date: '2024-01-14' },
                        { id: 3, type: 'expense', amount: 2000000, description: 'Mua sắm', category: 'Mua sắm', date: '2024-01-13' },
                        { id: 4, type: 'expense', amount: 300000, description: 'Xăng xe', category: 'Giao thông', date: '2024-01-12' },
                        { id: 5, type: 'expense', amount: 1500000, description: 'Tiền nhà', category: 'Nhà ở', date: '2024-01-11' }
                    ]);
                }
            } catch (error) {
                console.error('Error loading recent transactions:', error);
                // Use mock data
                displayRecentTransactions([
                    { id: 1, type: 'expense', amount: 500000, description: 'Ăn trưa', category: 'Ăn uống', date: '2024-01-15' },
                    { id: 2, type: 'income', amount: 15000000, description: 'Lương tháng 1', category: 'Lương', date: '2024-01-14' },
                    { id: 3, type: 'expense', amount: 2000000, description: 'Mua sắm', category: 'Mua sắm', date: '2024-01-13' }
                ]);
            }
        }

        // Display recent transactions
        function displayRecentTransactions(transactions) {
            const container = document.getElementById('recent-transactions');
            container.innerHTML = '';

            transactions.forEach(transaction => {
                const transactionElement = document.createElement('div');
                transactionElement.className = 'transaction-item';

                const iconClass = transaction.type === 'income' ? 'income' : 'expense';
                const icon = transaction.type === 'income' ? 'fa-arrow-up' : 'fa-arrow-down';
                const amountClass = transaction.type === 'income' ? 'income' : 'expense';

                transactionElement.innerHTML = `
                            <div class="transaction-icon ${iconClass}">
                                <i class="fas ${icon}"></i>
                            </div>
                            <div class="transaction-details">
                                <div class="transaction-title">${transaction.description}</div>
                                <div class="transaction-meta">${transaction.category} • ${formatDate(transaction.date)}</div>
                            </div>
                            <div class="transaction-amount ${amountClass}">
                                ${transaction.type === 'income' ? '+' : '-'}${formatCurrency(transaction.amount)}
                            </div>
                        `;

                container.appendChild(transactionElement);
            });
        }

        // Setup charts
        function setupCharts() {
            setupTrendsChart();
            setupCategoryChart();
        }

        // Setup trends chart
        function setupTrendsChart() {
            const ctx = document.getElementById('trendsChart').getContext('2d');
            const data = {
                labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
                datasets: [{
                    label: 'Thu nhập',
                    data: [1200000, 1900000, 3000000, 5000000, 2000000, 3000000, 4500000],
                    borderColor: '#2ECC71',
                    backgroundColor: 'rgba(46, 204, 113, 0.1)',
                    tension: 0.4,
                    fill: true
                }, {
                    label: 'Chi tiêu',
                    data: [800000, 1200000, 1500000, 2000000, 1800000, 2200000, 1900000],
                    borderColor: '#E74C3C',
                    backgroundColor: 'rgba(231, 76, 60, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            };

            const options = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            font: {
                                family: 'Inter, sans-serif',
                                size: 12
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            font: {
                                family: 'Inter, sans-serif',
                                size: 11
                            }
                        }
                    },
                    y: {
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        },
                        ticks: {
                            font: {
                                family: 'Inter, sans-serif',
                                size: 11
                            },
                            callback: function (value) {
                                return formatCurrency(value);
                            }
                        }
                    }
                }
            };

            trendsChart = ChartUtils.createLineChart(ctx, data, options);
        }

        // Setup category chart
        function setupCategoryChart() {
            const ctx = document.getElementById('categoryChart').getContext('2d');
            const data = {
                labels: ['Ăn uống', 'Mua sắm', 'Giao thông', 'Nhà ở', 'Giải trí', 'Khác'],
                datasets: [{
                    data: [30, 25, 15, 20, 5, 5],
                    backgroundColor: [
                        '#E74C3C',
                        '#F39C12',
                        '#F1C40F',
                        '#2ECC71',
                        '#3498DB',
                        '#9B59B6'
                    ],
                    borderWidth: 0
                }]
            };

            const options = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            font: {
                                family: 'Inter, sans-serif',
                                size: 12
                            }
                        }
                    }
                }
            };

            categoryChart = ChartUtils.createDoughnutChart(ctx, data, options);
        }

        // Load charts data
        async function loadChartsData() {
            try {
                const response = await fetch(`/api/dashboard/charts?period=${currentPeriod}`);
                if (response.ok) {
                    const data = await response.json();
                    updateCharts(data);
                }
            } catch (error) {
                console.error('Error loading charts data:', error);
            }
        }

        // Update charts
        function updateCharts(data) {
            if (trendsChart && data.trends) {
                trendsChart.data.labels = data.trends.labels;
                trendsChart.data.datasets[0].data = data.trends.income;
                trendsChart.data.datasets[1].data = data.trends.expense;
                trendsChart.update();
            }

            if (categoryChart && data.categories) {
                categoryChart.data.labels = data.categories.labels;
                categoryChart.data.datasets[0].data = data.categories.data;
                categoryChart.update();
            }
        }

        // Change chart period
        function changeChartPeriod(period) {
            currentPeriod = period;

            // Update button states
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            // Reload charts data
            loadChartsData();
        }

        // Refresh dashboard
        function refreshDashboard() {
            const refreshBtn = event.target;
            const icon = refreshBtn.querySelector('i');

            // Add loading animation
            icon.classList.add('fa-spin');
            refreshBtn.disabled = true;

            // Reload data
            loadDashboardData().finally(() => {
                // Remove loading animation
                icon.classList.remove('fa-spin');
                refreshBtn.disabled = false;
            });
        }

        // Show loading state
        function showLoadingState() {
            // Add pulse animation to stat cards
            document.querySelectorAll('.stat-card').forEach(card => {
                card.classList.add('pulse-animation');
            });
        }

        // Hide loading state
        function hideLoadingState() {
            document.querySelectorAll('.stat-card').forEach(card => {
                card.classList.remove('pulse-animation');
            });
        }

        // Show error state
        function showErrorState() {
            hideLoadingState();
            // You can add error notification here
            console.error('Failed to load dashboard data');
        }

        // Utility functions
        function formatCurrency(amount) {
            return window.designSystem ? window.designSystem.formatCurrency(amount) : new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }

        function formatDate(dateString) {
            return window.designSystem ? window.designSystem.formatDate(dateString) : new Date(dateString).toLocaleDateString('vi-VN');
        }
    </script>
}