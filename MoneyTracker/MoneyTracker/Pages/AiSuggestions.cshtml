@page
@model MoneyTracker.Pages.AiSuggestionsModel
@{
    ViewData["Title"] = "AI Gợi ý Tài chính";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 mb-3">
                <i class="fas fa-robot text-primary me-2"></i>
                AI Gợi ý Tài chính
            </h1>
            <p class="text-muted lead">
                Nhận các gợi ý thông minh từ AI dựa trên phân tích thói quen chi tiêu gần đây của bạn.
            </p>
        </div>
    </div>

    <!-- Action Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center">
                    <button id="generate-suggestion-btn" class="btn btn-primary btn-lg">
                        <i class="fas fa-magic me-2"></i>
                        Phân tích & Đưa ra Gợi ý
                    </button>
                    <p class="text-muted mt-3 mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        AI sẽ phân tích các giao dịch trong 30 ngày gần đây để đưa ra gợi ý phù hợp
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Suggestions List -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-lightbulb text-warning me-2"></i>
                        Gợi ý từ AI
                    </h5>
                    <span class="badge bg-primary" id="suggestion-count">0 gợi ý</span>
                </div>
                <div class="card-body">
                    <div id="suggestions-list">
                        <div class="text-center text-muted py-5" id="empty-state">
                            <i class="fas fa-robot fa-3x mb-3 opacity-50"></i>
                            <h5>Chưa có gợi ý nào</h5>
                            <p>Nhấn nút ở trên để nhận gợi ý mới từ AI</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loading-overlay" class="loading-overlay" style="display: none;">
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">AI đang phân tích dữ liệu của bạn...</p>
    </div>
</div>

<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-spinner {
        background: white;
        padding: 2rem;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .suggestion-card {
        border-left: 4px solid #007bff;
        transition: all 0.3s ease;
        margin-bottom: 1rem;
    }

    .suggestion-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 123, 255, 0.1);
    }

    .suggestion-card.new {
        animation: slideInDown 0.5s ease;
    }

    @@keyframes slideInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .suggestion-content {
        white-space: pre-line;
        line-height: 1.6;
    }

    .suggestion-actions {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .suggestion-card:hover .suggestion-actions {
        opacity: 1;
    }

    .btn-loading {
        position: relative;
        pointer-events: none;
    }

    .btn-loading .btn-text {
        opacity: 0;
    }

    .btn-loading .btn-spinner {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 1;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const generateBtn = document.getElementById('generate-suggestion-btn');
        const suggestionsList = document.getElementById('suggestions-list');
        const emptyState = document.getElementById('empty-state');
        const loadingOverlay = document.getElementById('loading-overlay');
        const suggestionCount = document.getElementById('suggestion-count');

        // Load existing suggestions on page load
        loadSuggestions();

        // Event listener for generate button
        generateBtn.addEventListener('click', function () {
            generateSuggestion();
        });

        async function generateSuggestion() {
            // Set loading state
            setButtonLoading(true);
            showLoadingOverlay(true);

            try {
                const response = await fetch('/api/aisuggestions/generate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + getAuthToken()
                    }
                });

                if (response.ok) {
                    const suggestion = await response.json();
                    addSuggestionCard(suggestion);
                    updateSuggestionCount();
                    hideEmptyState();
                } else {
                    const errorData = await response.json();
                    showError('Không thể tạo gợi ý: ' + (errorData.message || 'Lỗi không xác định'));
                }
            } catch (error) {
                console.error('Error generating suggestion:', error);
                showError('Đã xảy ra lỗi khi kết nối đến server. Vui lòng thử lại.');
            } finally {
                setButtonLoading(false);
                showLoadingOverlay(false);
            }
        }

        async function loadSuggestions() {
            try {
                const response = await fetch('/api/aisuggestions?skip=0&take=20', {
                    headers: {
                        'Authorization': 'Bearer ' + getAuthToken()
                    }
                });

                if (response.ok) {
                    const suggestions = await response.json();
                    if (suggestions.length > 0) {
                        suggestions.forEach(suggestion => {
                            addSuggestionCard(suggestion, false);
                        });
                        updateSuggestionCount();
                        hideEmptyState();
                    }
                }
            } catch (error) {
                console.error('Error loading suggestions:', error);
            }
        }

        function addSuggestionCard(suggestion, isNew = true) {
            const cardHtml = `
                <div class="card suggestion-card ${isNew ? 'new' : ''}" data-id="${suggestion.id}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-robot text-primary me-2"></i>
                                <span class="text-muted small">${formatDateTime(suggestion.createdAt)}</span>
                            </div>
                            <div class="suggestion-actions">
                                <button class="btn btn-sm btn-outline-secondary" onclick="markAsRead(${suggestion.id})" title="Đánh dấu đã đọc">
                                    <i class="fas fa-check"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteSuggestion(${suggestion.id})" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="suggestion-content">${suggestion.suggestion}</div>
                        <div class="mt-2">
                            <span class="badge bg-info">${suggestion.suggestionType}</span>
                            ${suggestion.isRead ? '<span class="badge bg-success ms-1">Đã đọc</span>' : '<span class="badge bg-warning ms-1">Mới</span>'}
                        </div>
                    </div>
                </div>
            `;

            if (isNew) {
                suggestionsList.insertAdjacentHTML('afterbegin', cardHtml);
            } else {
                suggestionsList.insertAdjacentHTML('beforeend', cardHtml);
            }
        }

        function setButtonLoading(loading) {
            if (loading) {
                generateBtn.classList.add('btn-loading');
                generateBtn.innerHTML = `
                    <div class="btn-spinner">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <span class="btn-text">Đang phân tích...</span>
                `;
                generateBtn.disabled = true;
            } else {
                generateBtn.classList.remove('btn-loading');
                generateBtn.innerHTML = `
                    <i class="fas fa-magic me-2"></i>
                    Phân tích & Đưa ra Gợi ý
                `;
                generateBtn.disabled = false;
            }
        }

        function showLoadingOverlay(show) {
            loadingOverlay.style.display = show ? 'flex' : 'none';
        }

        function hideEmptyState() {
            if (emptyState) {
                emptyState.style.display = 'none';
            }
        }

        function updateSuggestionCount() {
            const cards = suggestionsList.querySelectorAll('.suggestion-card');
            suggestionCount.textContent = `${cards.length} gợi ý`;
        }

        function showError(message) {
            // Create a more elegant error notification
            const errorHtml = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            // Insert at the top of the suggestions list
            suggestionsList.insertAdjacentHTML('afterbegin', errorHtml);

            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                const alert = suggestionsList.querySelector('.alert');
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        function formatDateTime(dateString) {
            const date = new Date(dateString);
            return date.toLocaleString('vi-VN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function getAuthToken() {
            return localStorage.getItem('authToken') || '';
        }

        // Global functions for card actions
        window.markAsRead = async function (suggestionId) {
            try {
                const response = await fetch(`/api/aisuggestions/${suggestionId}/mark-read`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': 'Bearer ' + getAuthToken()
                    }
                });

                if (response.ok) {
                    const card = document.querySelector(`[data-id="${suggestionId}"]`);
                    if (card) {
                        const badge = card.querySelector('.badge.bg-warning');
                        if (badge) {
                            badge.textContent = 'Đã đọc';
                            badge.className = 'badge bg-success ms-1';
                        }
                    }
                }
            } catch (error) {
                console.error('Error marking as read:', error);
            }
        };

        window.deleteSuggestion = async function (suggestionId) {
            if (!confirm('Bạn có chắc chắn muốn xóa gợi ý này?')) {
                return;
            }

            try {
                const response = await fetch(`/api/aisuggestions/${suggestionId}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': 'Bearer ' + getAuthToken()
                    }
                });

                if (response.ok) {
                    const card = document.querySelector(`[data-id="${suggestionId}"]`);
                    if (card) {
                        card.remove();
                        updateSuggestionCount();

                        // Show empty state if no suggestions left
                        const remainingCards = suggestionsList.querySelectorAll('.suggestion-card');
                        if (remainingCards.length === 0) {
                            if (emptyState) {
                                emptyState.style.display = 'block';
                            }
                        }
                    }
                } else {
                    showError('Không thể xóa gợi ý. Vui lòng thử lại.');
                }
            } catch (error) {
                console.error('Error deleting suggestion:', error);
                showError('Đã xảy ra lỗi khi xóa gợi ý.');
            }
        };
    });
</script>