@page
@model DashboardIndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<div class="row mb-4">
    <div class="col">
        <div class="card"><div class="card-body"><strong>Total Income:</strong> @Model.TotalIncome</div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body"><strong>Total Expense:</strong> @Model.TotalExpense</div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body"><strong>Balance:</strong> @Model.Balance</div></div>
    </div>
 </div>

<h4>Category Summary</h4>
<table class="table table-sm">
    <thead><tr><th>Category</th><th class="text-end">Total</th></tr></thead>
    <tbody>
    @foreach (var c in Model.CategorySummary)
    {
        <tr><td>@c.CategoryName</td><td class="text-end">@c.TotalAmount</td></tr>
    }
    </tbody>
</table>


