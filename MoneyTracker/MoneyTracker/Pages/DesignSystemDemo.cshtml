@page
@model MoneyTracker.Pages.DesignSystemDemoModel
@{
    ViewData["Title"] = "Design System Demo";
}

<!-- Hero Section -->
<div class="mb-6">
    <h1 class="h1 mb-3">Money Tracker Design System</h1>
    <p class="text-secondary">Modern, professional design system for personal finance management</p>
</div>

<!-- Color Palette -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Color Palette</h3>
                <p class="card-subtitle">Professional color scheme for financial applications</p>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-4">
                        <div class="color-swatch" style="background: #1A3A5A; height: 80px; border-radius: var(--radius-lg);"></div>
                        <h6 class="mt-2">Primary Blue</h6>
                        <p class="text-secondary small">#1A3A5A</p>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="color-swatch" style="background: #2ECC71; height: 80px; border-radius: var(--radius-lg);"></div>
                        <h6 class="mt-2">Accent Green</h6>
                        <p class="text-secondary small">#2ECC71</p>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="color-swatch" style="background: #E74C3C; height: 80px; border-radius: var(--radius-lg);"></div>
                        <h6 class="mt-2">Expense Red</h6>
                        <p class="text-secondary small">#E74C3C</p>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="color-swatch" style="background: #F8F9FA; height: 80px; border-radius: var(--radius-lg); border: 1px solid var(--gray-300);"></div>
                        <h6 class="mt-2">Background</h6>
                        <p class="text-secondary small">#F8F9FA</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Typography -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Typography</h3>
                <p class="card-subtitle">Inter font family with clear hierarchy</p>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h1 class="h1">Heading 1 - 2.25rem</h1>
                    <h2 class="h2">Heading 2 - 1.875rem</h2>
                    <h3 class="h3">Heading 3 - 1.5rem</h3>
                    <h4 class="h4">Heading 4 - 1.25rem</h4>
                    <h5 class="h5">Heading 5 - 1.125rem</h5>
                    <h6 class="h6">Heading 6 - 1rem</h6>
                </div>
                <div class="mb-4">
                    <p class="text-primary">Primary text color</p>
                    <p class="text-secondary">Secondary text color</p>
                    <p class="text-success">Success text color</p>
                    <p class="text-warning">Warning text color</p>
                    <p class="text-error">Error text color</p>
                    <p class="text-info">Info text color</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Buttons -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Buttons</h3>
                <p class="card-subtitle">Interactive elements with hover effects</p>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h5 class="mb-3">Button Variants</h5>
                    <div class="d-flex gap-3 flex-wrap">
                        <button class="btn btn-primary">Primary</button>
                        <button class="btn btn-secondary">Secondary</button>
                        <button class="btn btn-outline">Outline</button>
                        <button class="btn btn-ghost">Ghost</button>
                    </div>
                </div>
                <div class="mb-4">
                    <h5 class="mb-3">Button Sizes</h5>
                    <div class="d-flex gap-3 align-items-center flex-wrap">
                        <button class="btn btn-primary btn-sm">Small</button>
                        <button class="btn btn-primary">Default</button>
                        <button class="btn btn-primary btn-lg">Large</button>
                        <button class="btn btn-primary btn-xl">Extra Large</button>
                    </div>
                </div>
                <div class="mb-4">
                    <h5 class="mb-3">Button with Icons</h5>
                    <div class="d-flex gap-3 flex-wrap">
                        <button class="btn btn-primary">
                            <i class="fas fa-plus"></i>
                            Add Transaction
                        </button>
                        <button class="btn btn-secondary">
                            <i class="fas fa-chart-pie"></i>
                            View Reports
                        </button>
                        <button class="btn btn-outline">
                            <i class="fas fa-sync-alt"></i>
                            Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cards -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Cards</h3>
                <p class="card-subtitle">Glassmorphism containers with subtle effects</p>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card card-interactive">
                            <div class="card-header">
                                <h5 class="card-title">Interactive Card</h5>
                                <p class="card-subtitle">Hover to see effect</p>
                            </div>
                            <div class="card-body">
                                <p>This card has hover effects and is clickable.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card card-elevated">
                            <div class="card-header">
                                <h5 class="card-title">Elevated Card</h5>
                                <p class="card-subtitle">Enhanced shadow</p>
                            </div>
                            <div class="card-body">
                                <p>This card has enhanced shadow for emphasis.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card card-flat">
                            <div class="card-header">
                                <h5 class="card-title">Flat Card</h5>
                                <p class="card-subtitle">Minimal styling</p>
                            </div>
                            <div class="card-body">
                                <p>This card has minimal styling for subtle content.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Statistics Cards</h3>
                <p class="card-subtitle">Financial data display components</p>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-4">
                        <div class="stat-card">
                            <div class="stat-value text-income">15,000,000 VND</div>
                            <div class="stat-label">Total Income</div>
                            <div class="stat-change positive">
                                <i class="fas fa-arrow-up"></i>
                                <span>+12%</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="stat-card">
                            <div class="stat-value text-expense">12,000,000 VND</div>
                            <div class="stat-label">Total Expense</div>
                            <div class="stat-change negative">
                                <i class="fas fa-arrow-up"></i>
                                <span>+8%</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="stat-card">
                            <div class="stat-value text-primary">3,000,000 VND</div>
                            <div class="stat-label">Current Balance</div>
                            <div class="stat-change positive">
                                <i class="fas fa-wallet"></i>
                                <span>Main Account</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="stat-card">
                            <div class="stat-value text-primary">45</div>
                            <div class="stat-label">Monthly Transactions</div>
                            <div class="stat-change positive">
                                <i class="fas fa-arrow-up"></i>
                                <span>+15%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Forms -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Form Elements</h3>
                <p class="card-subtitle">Clean, modern form components</p>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Transaction Amount</label>
                            <input type="text" class="form-control" placeholder="Enter amount">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Category</label>
                            <select class="form-control form-select">
                                <option>Select category</option>
                                <option>Food & Dining</option>
                                <option>Shopping</option>
                                <option>Transportation</option>
                                <option>Entertainment</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="3" placeholder="Enter description"></textarea>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Form Control Sizes</label>
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Small">
                            <input type="text" class="form-control mb-2" placeholder="Default">
                            <input type="text" class="form-control form-control-lg" placeholder="Large">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Disabled State</label>
                            <input type="text" class="form-control" placeholder="Disabled input" disabled>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Transaction Items -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Transaction Items</h3>
                <p class="card-subtitle">Financial transaction display components</p>
            </div>
            <div class="card-body">
                <div class="transaction-item">
                    <div class="transaction-icon income">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                    <div class="transaction-details">
                        <div class="transaction-title">Salary Payment</div>
                        <div class="transaction-meta">Salary • Jan 15, 2024</div>
                    </div>
                    <div class="transaction-amount income">+15,000,000 VND</div>
                </div>
                <div class="transaction-item">
                    <div class="transaction-icon expense">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                    <div class="transaction-details">
                        <div class="transaction-title">Grocery Shopping</div>
                        <div class="transaction-meta">Food & Dining • Jan 14, 2024</div>
                    </div>
                    <div class="transaction-amount expense">-500,000 VND</div>
                </div>
                <div class="transaction-item">
                    <div class="transaction-icon expense">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                    <div class="transaction-details">
                        <div class="transaction-title">Gas Station</div>
                        <div class="transaction-meta">Transportation • Jan 13, 2024</div>
                    </div>
                    <div class="transaction-amount expense">-300,000 VND</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Budget Components -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Budget Components</h3>
                <p class="card-subtitle">Budget tracking and progress indicators</p>
            </div>
            <div class="card-body">
                <div class="budget-item">
                    <div class="budget-header">
                        <div class="budget-title">Food & Dining</div>
                        <div class="budget-amount">2,500,000 / 5,000,000 VND</div>
                    </div>
                    <div class="budget-progress">
                        <div class="budget-progress-bar" style="width: 50%"></div>
                    </div>
                    <div class="budget-footer">
                        <div class="budget-remaining">Remaining: 2,500,000 VND</div>
                        <div class="budget-percentage">50%</div>
                    </div>
                </div>
                <div class="budget-item">
                    <div class="budget-header">
                        <div class="budget-title">Transportation</div>
                        <div class="budget-amount">1,800,000 / 2,000,000 VND</div>
                    </div>
                    <div class="budget-progress">
                        <div class="budget-progress-bar warning" style="width: 90%"></div>
                    </div>
                    <div class="budget-footer">
                        <div class="budget-remaining">Remaining: 200,000 VND</div>
                        <div class="budget-percentage">90%</div>
                    </div>
                </div>
                <div class="budget-item">
                    <div class="budget-header">
                        <div class="budget-title">Entertainment</div>
                        <div class="budget-amount">1,200,000 / 1,000,000 VND</div>
                    </div>
                    <div class="budget-progress">
                        <div class="budget-progress-bar danger" style="width: 120%"></div>
                    </div>
                    <div class="budget-footer">
                        <div class="budget-remaining">Over budget: 200,000 VND</div>
                        <div class="budget-percentage">120%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Chart Containers</h3>
                <p class="card-subtitle">Financial data visualization</p>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8 mb-4">
                        <div class="chart-container">
                            <div class="chart-header">
                                <h5 class="chart-title">Income vs Expense Trends</h5>
                                <div class="chart-actions">
                                    <button type="button" class="chart-btn active">Week</button>
                                    <button type="button" class="chart-btn">Month</button>
                                    <button type="button" class="chart-btn">Year</button>
                                </div>
                            </div>
                            <div style="height: 300px; background: var(--gray-100); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;">
                                <p class="text-secondary">Chart placeholder</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="chart-container">
                            <div class="chart-header">
                                <h5 class="chart-title">Expense Categories</h5>
                            </div>
                            <div style="height: 300px; background: var(--gray-100); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;">
                                <p class="text-secondary">Pie chart placeholder</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Notifications -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Notifications</h3>
                <p class="card-subtitle">Toast notifications and alerts</p>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h5 class="mb-3">Toast Notifications</h5>
                    <div class="toast show">
                        <div class="toast-icon success">
                            <i class="fas fa-check"></i>
                        </div>
                        <div class="toast-content">
                            <div class="toast-title">Success</div>
                            <div class="toast-message">Transaction added successfully!</div>
                        </div>
                    </div>
                    <div class="toast show">
                        <div class="toast-icon error">
                            <i class="fas fa-times"></i>
                        </div>
                        <div class="toast-content">
                            <div class="toast-title">Error</div>
                            <div class="toast-message">Failed to save transaction. Please try again.</div>
                        </div>
                    </div>
                    <div class="toast show">
                        <div class="toast-icon warning">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="toast-content">
                            <div class="toast-title">Warning</div>
                            <div class="toast-message">You're approaching your budget limit.</div>
                        </div>
                    </div>
                    <div class="toast show">
                        <div class="toast-icon info">
                            <i class="fas fa-info"></i>
                        </div>
                        <div class="toast-content">
                            <div class="toast-title">Info</div>
                            <div class="toast-message">New features available in the latest update.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading States -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Loading States</h3>
                <p class="card-subtitle">Loading indicators and skeletons</p>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h5 class="mb-3">Loading Spinner</h5>
                    <div class="d-flex align-items-center gap-3">
                        <div class="loading-spinner"></div>
                        <span>Loading data...</span>
                    </div>
                </div>
                <div class="mb-4">
                    <h5 class="mb-3">Loading Skeletons</h5>
                    <div class="loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                    <div class="loading-skeleton" style="height: 60px; margin-bottom: 10px;"></div>
                    <div class="loading-skeleton" style="height: 60px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Responsive Grid -->
<div class="row mb-6">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Responsive Grid</h3>
                <p class="card-subtitle">Flexible layout system</p>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="card card-flat">
                            <div class="card-body text-center">
                                <h6>Col 1</h6>
                                <p class="small text-secondary">Responsive column</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="card card-flat">
                            <div class="card-body text-center">
                                <h6>Col 2</h6>
                                <p class="small text-secondary">Responsive column</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-12 col-lg-4 mb-3">
                        <div class="card card-flat">
                            <div class="card-body text-center">
                                <h6>Col 3</h6>
                                <p class="small text-secondary">Responsive column</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Demo functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Add click handlers for demo buttons
            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    if (this.textContent.includes('Demo')) {
                        e.preventDefault();
                        showToast('Button clicked!', 'info', 'Demo');
                    }
                });
            });
            
            // Demo toast notifications
            function showToast(message, type, title) {
                if (window.designSystem) {
                    window.designSystem.showToast(message, type, title);
                } else {
                    alert(`${title}: ${message}`);
                }
            }
        });
    </script>
}
