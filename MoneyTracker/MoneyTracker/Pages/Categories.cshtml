    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCategoryModalLabel">Thêm Danh Mục Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addCategoryForm">
                    <div class="mb-3">
                        <label class="form-label">Tên danh mục</label>
                        <input type="text" class="form-control" id="categoryName" placeholder="Nhập tên danh mục"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Loại</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryType" id="expenseType"
                                    value="expense" checked>
                                <label class="form-check-label" for="expenseType">
                                    <i class="fas fa-arrow-down text-expense me-2"></i>
                                    Chi tiêu
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryType" id="incomeType"
                                    value="income">
                                <label class="form-check-label" for="incomeType">
                                    <i class="fas fa-arrow-up text-income me-2"></i>
                                    Thu nhập
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Biểu tượng</label>
                        <div class="row g-2" id="iconGrid">
                            <!-- Icons will be populated by JavaScript -->
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        <textarea class="form-control" id="categoryDescription" rows="2"
                            placeholder="Nhập mô tả cho danh mục này..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize page
        document.addEventListener('DOMContentLoaded', function () {
            populateIconGrid();
        });

        // Icon options for categories
        const iconOptions = [
            'fa-utensils', 'fa-car', 'fa-shopping-cart', 'fa-bolt', 'fa-gamepad',
            'fa-home', 'fa-heart', 'fa-graduation-cap', 'fa-plane', 'fa-music',
            'fa-briefcase', 'fa-gift', 'fa-chart-line', 'fa-laptop', 'fa-coins',
            'fa-piggy-bank', 'fa-credit-card', 'fa-wallet', 'fa-dollar-sign', 'fa-hand-holding-usd'
        ];

        // Populate icon grid
        function populateIconGrid() {
            const iconGrid = document.getElementById('iconGrid');
            iconGrid.innerHTML = '';

            iconOptions.forEach(icon => {
                const col = document.createElement('div');
                col.className = 'col-2';

                const iconBtn = document.createElement('button');
                iconBtn.type = 'button';
                iconBtn.className = 'btn btn-outline-secondary w-100 mb-2';
                iconBtn.innerHTML = `<i class="fas ${icon}"></i>`;
                iconBtn.onclick = function () {
                    selectIcon(icon, iconBtn);
                };

                col.appendChild(iconBtn);
                iconGrid.appendChild(col);
            });
        }

        // Select icon
        function selectIcon(icon, button) {
            // Remove active class from all icon buttons
            document.querySelectorAll('#iconGrid button').forEach(btn => {
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-outline-secondary');
            });

            // Add active class to selected button
            button.classList.remove('btn-outline-secondary');
            button.classList.add('btn-primary');

            // Store selected icon
            document.getElementById('selectedIcon').value = icon;
        }

        // Save category
        function saveCategory() {
            const form = document.getElementById('addCategoryForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const categoryData = {
                name: document.getElementById('categoryName').value,
                type: document.querySelector('input[name="categoryType"]:checked').value,
                icon: document.getElementById('selectedIcon').value || 'fa-tag',
                description: document.getElementById('categoryDescription').value
            };

            console.log('Category data:', categoryData);

            // Here you would typically send the data to your server
            alert('Danh mục đã được thêm thành công!');

            // Close modal and reset form
            const modal = bootstrap.Modal.getInstance(document.getElementById('addCategoryModal'));
            modal.hide();
            form.reset();
            populateIconGrid();
        }

        // Edit category
        function editCategory(id, type) {
            alert(`Chỉnh sửa danh mục ID: ${id}, Loại: ${type}`);
            // Here you would typically open an edit modal or navigate to edit page
        }

        // Delete category
        function deleteCategory(id) {
            if (confirm('Bạn có chắc chắn muốn xóa danh mục này?')) {
                alert(`Danh mục ID: ${id} đã được xóa`);
                // Here you would typically send delete request to server
            }
        }

        // Add hidden input for selected icon
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('addCategoryForm');
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.id = 'selectedIcon';
            hiddenInput.name = 'selectedIcon';
            form.appendChild(hiddenInput);
        });
    </script>
}
