                            <div>
                                <h6 class="mb-0">Tiện ích</h6>
                                <small class="text-muted">Điện, nước, internet</small>
                            </div>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-primary" onclick="editCategory(4, 'expense')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(4)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Expense Category 5 -->
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-gamepad text-secondary me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <h6 class="mb-0">Giải trí</h6>
                                <small class="text-muted">Phim, game, du lịch</small>
                            </div>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-primary" onclick="editCategory(5, 'expense')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(5)">
