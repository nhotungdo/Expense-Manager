                    </div>

                    <!-- Income Category 5 -->
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-coins text-secondary me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <h6 class="mb-0">Khác</h6>
                                <small class="text-muted">Thu nhập khác</small>
                            </div>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-primary" onclick="editCategory(10, 'income')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(10)">
                                <i class="fas fa-trash"></i>
                            </button>
