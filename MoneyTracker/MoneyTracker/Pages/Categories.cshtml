                                <small class="text-muted">Quần áo, đồ dùng cá nhân</small>
                            </div>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-primary" onclick="editCategory(3, 'expense')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(3)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
