                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-utensils text-warning me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <h6 class="mb-0">Ăn uống</h6>
                                <small class="text-muted">Thực phẩm và đồ uống</small>
                            </div>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-primary" onclick="editCategory(1, 'expense')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(1)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>

