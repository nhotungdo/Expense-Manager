@page
@model dynamic
@{
    ViewData["Title"] = "Register";
}

<div class="max-w-md mx-auto bg-white rounded-xl shadow p-8 space-y-6">
    <div class="text-center text-2xl font-semibold">Create your account</div>
    <div class="text-center text-slate-600">Use Google to quickly get started</div>
    <div class="pt-2">
        <a href="/login" class="w-full inline-flex items-center justify-center gap-2 bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-500">
            <i data-lucide="user-plus"></i>
            <span>Continue with Google</span>
        </a>
    </div>
    <div class="text-center text-sm text-slate-500">
        Already have an account?
        <a class="text-indigo-600 hover:underline" href="/Auth/Login">Login</a>
    </div>
</div>


