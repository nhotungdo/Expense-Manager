@page
@model dynamic
@{
    ViewData["Title"] = "Login";
}

<div class="max-w-md mx-auto bg-white rounded-xl shadow p-8 space-y-6">
    <div class="text-center text-2xl font-semibold">Login</div>
    <div class="text-center text-slate-600">Sign in to continue to MoneyTracker</div>
    <div class="pt-2">
        <a href="/login" class="w-full inline-flex items-center justify-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-500">
            <i data-lucide="log-in"></i>
            <span>Continue with Google</span>
        </a>
    </div>
    <div class="text-center text-sm text-slate-500">
        Don't have an account?
        <a class="text-indigo-600 hover:underline" href="/Auth/Register">Register</a>
    </div>
    <div class="text-xs text-slate-400 text-center">By continuing, you agree to our Terms and Privacy Policy.</div>
    
</div>


