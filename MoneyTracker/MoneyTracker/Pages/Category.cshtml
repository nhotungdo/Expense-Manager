@page
@model MoneyTracker.Pages.CategoryModel
@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 animate-fade-in">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white">Quản Lý Danh Mục</h2>
                <p class="text-gray-600 dark:text-gray-300">Tạo và quản lý các danh mục chi tiêu, thu nhập</p>
            </div>
            <button onclick="openModal('add-category-modal')" class="bg-gradient-to-r from-blue-500 to-purple-500 text-white px-6 py-3 rounded-xl hover:from-blue-600 hover:to-purple-600 transition-all duration-300 transform hover:-translate-y-1 shadow-lg">
                <i class="fas fa-plus mr-2"></i>
                Thêm Danh Mục
            </button>
        </div>
    </div>

    <!-- Category Type Tabs -->
    <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 animate-fade-in">
        <div class="flex space-x-1 bg-gray-100 dark:bg-gray-800 rounded-lg p-1">
            <button onclick="switchCategoryType('EXPENSE')" id="expense-tab" class="flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors bg-red-500 text-white">
                <i class="fas fa-credit-card mr-2"></i>
                Chi Tiêu
            </button>
            <button onclick="switchCategoryType('INCOME')" id="income-tab" class="flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700">
                <i class="fas fa-coins mr-2"></i>
                Thu Nhập
            </button>
        </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="categories-grid">
        <!-- Categories will be loaded here -->
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden bg-white/20 backdrop-blur-xl rounded-2xl p-12 shadow-lg border border-white/20 text-center animate-fade-in">
        <div class="w-24 h-24 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-tags text-3xl text-gray-400"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Chưa có danh mục nào</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">Hãy tạo danh mục đầu tiên để bắt đầu quản lý tài chính</p>
        <button onclick="openModal('add-category-modal')" class="bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition-colors">
            <i class="fas fa-plus mr-2"></i>
            Tạo Danh Mục
        </button>
    </div>
</div>

<!-- Add/Edit Category Modal -->
<div id="add-category-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white/90 backdrop-blur-xl rounded-2xl shadow-2xl max-w-md w-full p-6 animate-fade-in">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-semibold text-gray-800" id="modal-title">Thêm Danh Mục</h3>
                <button onclick="closeModal('add-category-modal')" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <i class="fas fa-times text-gray-500"></i>
                </button>
            </div>
            <form id="category-form">
                <input type="hidden" name="id" id="category-id">
                <input type="hidden" name="type" id="category-type" value="EXPENSE">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tên danh mục *</label>
                        <input type="text" name="name" id="category-name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Nhập tên danh mục">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Mô tả</label>
                        <textarea name="description" id="category-description" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Nhập mô tả (tùy chọn)"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Biểu tượng</label>
                        <div class="grid grid-cols-6 gap-2" id="icon-selector">
                            <!-- Icons will be loaded here -->
                        </div>
                        <input type="hidden" name="icon" id="selected-icon" value="fas fa-tag">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Màu sắc</label>
                        <div class="grid grid-cols-8 gap-2" id="color-selector">
                            <!-- Colors will be loaded here -->
                        </div>
                        <input type="hidden" name="color" id="selected-color" value="#3B82F6">
                    </div>
                </div>
                <div class="flex space-x-3 mt-6">
                    <button type="button" onclick="closeModal('add-category-modal')" class="flex-1 px-4 py-3 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors">
                        Hủy
                    </button>
                    <button type="submit" class="flex-1 px-4 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
                        <span id="submit-text">Thêm</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentCategoryType = 'EXPENSE';
        let categories = [];
        
        const categoryIcons = [
            'fas fa-utensils', 'fas fa-shopping-cart', 'fas fa-car', 'fas fa-home',
            'fas fa-gamepad', 'fas fa-heart', 'fas fa-graduation-cap', 'fas fa-briefcase',
            'fas fa-coins', 'fas fa-chart-line', 'fas fa-gift', 'fas fa-credit-card',
            'fas fa-plane', 'fas fa-music', 'fas fa-book', 'fas fa-dumbbell',
            'fas fa-tshirt', 'fas fa-mobile-alt', 'fas fa-laptop', 'fas fa-camera'
        ];
        
        const categoryColors = [
            '#EF4444', '#F97316', '#F59E0B', '#EAB308',
            '#84CC16', '#22C55E', '#10B981', '#14B8A6',
            '#06B6D4', '#0EA5E9', '#3B82F6', '#6366F1',
            '#8B5CF6', '#A855F7', '#D946EF', '#EC4899'
        ];
        
        document.addEventListener('DOMContentLoaded', function() {
            loadCategories();
            initializeIconSelector();
            initializeColorSelector();
        });
        
        function switchCategoryType(type) {
            currentCategoryType = type;
            
            // Update tab styles
            document.getElementById('expense-tab').className = type === 'EXPENSE' 
                ? 'flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors bg-red-500 text-white'
                : 'flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700';
                
            document.getElementById('income-tab').className = type === 'INCOME' 
                ? 'flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors bg-green-500 text-white'
                : 'flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700';
            
            document.getElementById('category-type').value = type;
            loadCategories();
        }
        
        async function loadCategories() {
            try {
                const data = await apiCall(`/api/category?type=${currentCategoryType}`);
                categories = data;
                renderCategories();
            } catch (error) {
                console.error('Error loading categories:', error);
                showToast('Có lỗi xảy ra khi tải danh mục', 'error');
            }
        }
        
        function renderCategories() {
            const grid = document.getElementById('categories-grid');
            const emptyState = document.getElementById('empty-state');
            
            if (categories.length === 0) {
                grid.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }
            
            grid.classList.remove('hidden');
            emptyState.classList.add('hidden');
            
            grid.innerHTML = categories.map(category => `
                <div class="bg-white/20 backdrop-blur-xl rounded-2xl p-6 shadow-lg border border-white/20 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 animate-fade-in">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background-color: ${category.color || '#3B82F6'}20">
                                <i class="${category.icon || 'fas fa-tag'} text-lg" style="color: ${category.color || '#3B82F6'}"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-800 dark:text-white">${category.name}</h3>
                                <p class="text-sm text-gray-600 dark:text-gray-300">${category.description || 'Không có mô tả'}</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="editCategory(${category.id})" class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors" title="Chỉnh sửa">
                                <i class="fas fa-edit"></i>
                            </button>
                            ${!category.isDefault ? `
                                <button onclick="deleteCategory(${category.id})" class="p-2 text-red-600 hover:bg-red-100 rounded-lg transition-colors" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            ` : `
                                <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-xs rounded-full">
                                    Mặc định
                                </span>
                            `}
                        </div>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-600 dark:text-gray-300">Giao dịch:</span>
                        <span class="font-medium text-gray-800 dark:text-white">${category.transactionCount || 0}</span>
                    </div>
                </div>
            `).join('');
        }
        
        function initializeIconSelector() {
            const selector = document.getElementById('icon-selector');
            selector.innerHTML = categoryIcons.map(icon => `
                <button type="button" onclick="selectIcon('${icon}')" class="w-10 h-10 border-2 border-gray-300 rounded-lg flex items-center justify-center hover:border-blue-500 transition-colors icon-option" data-icon="${icon}">
                    <i class="${icon} text-gray-600"></i>
                </button>
            `).join('');
            
            // Select first icon by default
            selectIcon(categoryIcons[0]);
        }
        
        function initializeColorSelector() {
            const selector = document.getElementById('color-selector');
            selector.innerHTML = categoryColors.map(color => `
                <button type="button" onclick="selectColor('${color}')" class="w-8 h-8 rounded-lg border-2 border-gray-300 hover:border-gray-400 transition-colors color-option" style="background-color: ${color}" data-color="${color}"></button>
            `).join('');
            
            // Select first color by default
            selectColor(categoryColors[0]);
        }
        
        function selectIcon(icon) {
            document.getElementById('selected-icon').value = icon;
            
            // Update visual selection
            document.querySelectorAll('.icon-option').forEach(btn => {
                btn.classList.remove('border-blue-500', 'bg-blue-50');
                btn.classList.add('border-gray-300');
            });
            
            document.querySelector(`[data-icon="${icon}"]`).classList.remove('border-gray-300');
            document.querySelector(`[data-icon="${icon}"]`).classList.add('border-blue-500', 'bg-blue-50');
        }
        
        function selectColor(color) {
            document.getElementById('selected-color').value = color;
            
            // Update visual selection
            document.querySelectorAll('.color-option').forEach(btn => {
                btn.classList.remove('border-gray-600');
                btn.classList.add('border-gray-300');
            });
            
            document.querySelector(`[data-color="${color}"]`).classList.remove('border-gray-300');
            document.querySelector(`[data-color="${color}"]`).classList.add('border-gray-600');
        }
        
        function editCategory(id) {
            const category = categories.find(c => c.id === id);
            if (!category) return;
            
            document.getElementById('modal-title').textContent = 'Chỉnh Sửa Danh Mục';
            document.getElementById('submit-text').textContent = 'Cập nhật';
            document.getElementById('category-id').value = category.id;
            document.getElementById('category-name').value = category.name;
            document.getElementById('category-description').value = category.description || '';
            document.getElementById('category-type').value = category.type;
            
            selectIcon(category.icon || 'fas fa-tag');
            selectColor(category.color || '#3B82F6');
            
            openModal('add-category-modal');
        }
        
        function deleteCategory(id) {
            const category = categories.find(c => c.id === id);
            if (!category) return;
            
            showConfirm(`Bạn có chắc chắn muốn xóa danh mục "${category.name}"?`, async (confirmed) => {
                if (confirmed) {
                    try {
                        await apiCall(`/api/category/${id}`, {
                            method: 'DELETE'
                        });
                        
                        showToast('Xóa danh mục thành công!', 'success');
                        loadCategories();
                    } catch (error) {
                        console.error('Error deleting category:', error);
                        showToast('Có lỗi xảy ra khi xóa danh mục', 'error');
                    }
                }
            });
        }
        
        // Form handling
        document.getElementById('category-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            if (!validateForm('category-form')) {
                showToast('Vui lòng điền đầy đủ thông tin', 'error');
                return;
            }
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            const categoryId = document.getElementById('category-id').value;
            
            try {
                if (categoryId) {
                    // Update existing category
                    await apiCall(`/api/category/${categoryId}`, {
                        method: 'PUT',
                        body: JSON.stringify(data)
                    });
                    showToast('Cập nhật danh mục thành công!', 'success');
                } else {
                    // Create new category
                    await apiCall('/api/category', {
                        method: 'POST',
                        body: JSON.stringify(data)
                    });
                    showToast('Thêm danh mục thành công!', 'success');
                }
                
                closeModal('add-category-modal');
                this.reset();
                loadCategories();
            } catch (error) {
                console.error('Error saving category:', error);
                showToast('Có lỗi xảy ra khi lưu dữ liệu', 'error');
            }
        });
        
        // Reset form when modal is closed
        document.getElementById('add-category-modal').addEventListener('hidden.bs.modal', function() {
            document.getElementById('category-form').reset();
            document.getElementById('modal-title').textContent = 'Thêm Danh Mục';
            document.getElementById('submit-text').textContent = 'Thêm';
            document.getElementById('category-id').value = '';
            document.getElementById('category-type').value = currentCategoryType;
            
            selectIcon(categoryIcons[0]);
            selectColor(categoryColors[0]);
        });
    </script>
}
