@page "{id?}"
@model MoneyTracker.Pages.Scheduled.EditModel
@{
    ViewData["Title"] = Model.Input.Id==0?"Add Scheduled":"Edit Scheduled";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.AccountId" class="form-label"></label>
                <select asp-for="Input.AccountId" class="form-select" asp-items="Model.AccountOptions"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.TransactionType" class="form-label"></label>
                <select asp-for="Input.TransactionType" class="form-select">
                    <option value="0">Expense</option>
                    <option value="1">Income</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Amount" class="form-label"></label>
                <input asp-for="Input.Amount" class="form-control" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.Frequency" class="form-label"></label>
                <select asp-for="Input.Frequency" class="form-select">
                    <option value="Daily">Daily</option>
                    <option value="Weekly">Weekly</option>
                    <option value="Monthly">Monthly</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Interval" class="form-label"></label>
                <input asp-for="Input.Interval" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.StartDate" class="form-label"></label>
                <input asp-for="Input.StartDate" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.IsActive" class="form-label"></label>
                <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Note" class="form-label"></label>
        <input asp-for="Input.Note" class="form-control" />
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>


