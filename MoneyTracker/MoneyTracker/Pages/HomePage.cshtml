@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Initialize AOS with optimized settings
        AOS.init({
            duration: 800,
            easing: 'ease-out-cubic',
            once: true,
            offset: 50,
            delay: 0,
            disable: 'mobile' // Disable on mobile for better performance
        });

        $(document).ready(function () {
            // ========================================
            // NAVBAR FUNCTIONALITY (Optimized)
            // ========================================

            // Throttled navbar scroll effect for better performance
            let scrollTimeout;
            $(window).on('scroll', function() {
                if (scrollTimeout) {
                    clearTimeout(scrollTimeout);
                }
                scrollTimeout = setTimeout(function() {
                    if ($(window).scrollTop() > 50) {
                        $('.navbar').addClass('scrolled');
                    } else {
                        $('.navbar').removeClass('scrolled');
                    }
                }, 10);
            });

            // Mobile menu close on link click (delegated event)
            $(document).on('click', '.navbar-nav .nav-link', function () {
                if ($(window).width() < 992) {
                    $('.navbar-collapse').collapse('hide');
                }
            });

            // ========================================
            // SMOOTH SCROLLING (Optimized)
            // ========================================

            // Smooth scrolling for anchor links with performance optimization
            $(document).on('click', 'a[href^="#"]', function (event) {
                const target = $(this.getAttribute('href'));
                if (target.length) {
                    event.preventDefault();
                    const targetOffset = target.offset().top - 80;
                    
                    $('html, body').stop().animate({
                        scrollTop: targetOffset
                    }, 800, 'easeOutCubic');
                }
            });

            // ========================================
            // ANIMATIONS (Optimized)
            // ========================================

            // Optimized number animation with throttling
            let numbersAnimated = false;
            function animateNumbers() {
                if (numbersAnimated) return;
                numbersAnimated = true;
                
                $('.stat-number').each(function () {
                    const $this = $(this);
                    const countTo = $this.attr('data-count');

                    if (countTo) {
                        $({ countNum: 0 }).animate({
                            countNum: countTo
                        }, {
                            duration: 1500,
                            easing: 'easeOutQuart',
                            step: function () {
                                $this.text(Math.floor(this.countNum));
                            },
                            complete: function () {
                                $this.text(countTo);
                            }
                        });
                    }
                });
            }

            // Add easing function
            $.easing.easeOutQuart = function (x, t, b, c, d) {
                return -c * ((t = t / d - 1) * t * t * t - 1) + b;
            };

            // Intersection Observer for animations
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver(function (entries) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animate-in');

                        // Animate numbers when stats section comes into view
                        if (entry.target.classList.contains('stats-section')) {
                            animateNumbers();
                        }
                    }
                });
            }, observerOptions);

            // Observe elements for animation
            document.querySelectorAll('.feature-card, .testimonial-card, .stat-box').forEach(el => {
                observer.observe(el);
            });

            // ========================================
            // INTERACTIVE ELEMENTS (Optimized)
            // ========================================

            // Optimized button loading animation with delegated events
            $(document).on('click', '.btn:not(.no-loading)', function () {
                const $btn = $(this);
                const originalText = $btn.html();

                $btn.html('<i class="fas fa-spinner fa-spin me-2"></i>Đang tải...');
                $btn.prop('disabled', true);

                // Re-enable after 1.5 seconds (reduced from 2s)
                setTimeout(function () {
                    $btn.html(originalText);
                    $btn.prop('disabled', false);
                }, 1500);
            });

            // Optimized parallax effect with throttling
            let parallaxTimeout;
            $(window).on('scroll', function() {
                if (parallaxTimeout) {
                    clearTimeout(parallaxTimeout);
                }
                parallaxTimeout = setTimeout(function() {
                    const scrolled = $(window).scrollTop();
                    const parallax = $('.hero-section');
                    const speed = scrolled * 0.3; // Reduced for better performance
                    parallax.css('transform', 'translateY(' + speed + 'px)');
                }, 16); // ~60fps
            });

            // Optimized card hover effects with CSS classes
            $(document).on('mouseenter', '.card', function () {
                $(this).addClass('card-hover');
            }).on('mouseleave', '.card', function () {
                $(this).removeClass('card-hover');
            });

            // Optimized card click effect
            $(document).on('click', '.card', function () {
                $(this).addClass('card-clicked');
                setTimeout(() => {
                    $(this).removeClass('card-clicked');
                }, 300);
            });

            // ========================================
            // USER AUTHENTICATION
            // ========================================

            // Check if user is already logged in
            const token = localStorage.getItem('authToken');
            if (token) {
                // Update navbar for logged in users
                updateNavbarForLoggedInUser();
                
                // Update hero actions for logged in users
                updateHeroActionsForLoggedInUser();
            }
        });

        // ========================================
        // USER MENU FUNCTIONS
        // ========================================

        function updateHeroActionsForLoggedInUser() {
            // Hide guest actions and show user actions
            $('#guestActions').hide();
            $('#userActions').show();
            
            // Update CTA section
            $('#guestCTA').hide();
            $('#userCTA').show();
            
            // Get user info for personalized greeting
            const userData = JSON.parse(localStorage.getItem('user') || '{}');
            const userName = userData.fullName || userData.username || 'Người dùng';
            
            // Update hero title for logged in user
            $('.hero-title').html(`
                <span class="text-gradient">Chào mừng trở lại,</span><br>
                <span class="text-primary">${userName}!</span>
            `);
            
            // Update hero subtitle
            $('.hero-subtitle').text('Tiếp tục quản lý tài chính của bạn một cách thông minh và hiệu quả.');
            
            // Update CTA section content
            $('.cta-section h2').text('Tiếp tục hành trình tài chính của bạn!');
            $('.cta-section p').text('Quản lý chi tiêu, theo dõi thu nhập và đạt được mục tiêu tài chính với MoneyTracker.');
        }

        function updateNavbarForLoggedInUser() {
            // Hide login/register buttons and show user menu
            $('.navbar-nav .nav-link[href="/Login"]').parent().hide();
            $('.navbar-nav .nav-link[href="/Register"]').parent().hide();

            // Get user info from localStorage
            const userData = JSON.parse(localStorage.getItem('user') || '{}');
            const userName = userData.fullName || userData.username || 'Người dùng';
            const userEmail = userData.email || '';
            const userRole = userData.role || 'USER';

            // Add user menu with enhanced UI
            var userMenu = `
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar me-2">
                                    ${userData.pictureUrl ? 
                                        `<img src="${userData.pictureUrl}" alt="${userName}" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;">` :
                                        `<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 14px;">
                                            <i class="fas fa-user"></i>
                                        </div>`
                                    }
                                </div>
                                <div class="user-info d-none d-lg-block">
                                    <div class="user-name">${userName}</div>
                                    <div class="user-role text-muted small">${userRole === 'ADMIN' ? 'Quản trị viên' : 'Người dùng'}</div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="min-width: 280px;">
                                <li class="dropdown-header">
                                    <div class="d-flex align-items-center">
                                        <div class="user-avatar me-3">
                                            ${userData.pictureUrl ? 
                                                `<img src="${userData.pictureUrl}" alt="${userName}" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;">` :
                                                `<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 20px;">
                                                    <i class="fas fa-user"></i>
                                                </div>`
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold">${userName}</div>
                                            <div class="text-muted small">${userEmail}</div>
                                            <span class="badge bg-${userRole === 'ADMIN' ? 'danger' : 'primary'} small">${userRole === 'ADMIN' ? 'Quản trị viên' : 'Người dùng'}</span>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Dashboard"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" href="/Profile"><i class="fas fa-user me-2 text-info"></i>Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item" href="/Expenses"><i class="fas fa-receipt me-2 text-warning"></i>Chi tiêu</a></li>
                                <li><a class="dropdown-item" href="/Incomes"><i class="fas fa-money-bill-wave me-2 text-success"></i>Thu nhập</a></li>
                                <li><a class="dropdown-item" href="/Reports"><i class="fas fa-chart-bar me-2 text-secondary"></i>Báo cáo</a></li>
                                ${userRole === 'ADMIN' ? '<li><a class="dropdown-item" href="/Admin"><i class="fas fa-cog me-2 text-danger"></i>Quản trị</a></li>' : ''}
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="#" onclick="logout(); return false;"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </li>
                    `;
            $('.navbar-nav').append(userMenu);
        }

        function logout() {
            if (window.logoutManager) {
                window.logoutManager.logout();
            } else {
                // Fallback for backward compatibility
                showLogoutConfirmation();
            }
        }

        function showLogoutConfirmation() {
            // Create a simple confirmation dialog
            if (confirm('Bạn có chắc chắn muốn đăng xuất?')) {
                // Clear user data
                localStorage.removeItem('authToken');
                localStorage.removeItem('user');
                localStorage.removeItem('userPreferences');
                localStorage.removeItem('dashboardData');
                sessionStorage.clear();
                
                // Show success message
                showLogoutSuccess();
                
                // Redirect after delay
                setTimeout(() => {
                    window.location.href = '/HomePage';
                }, 1500);
            }
        }

        function showLogoutSuccess() {
            // Create success toast
            const toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-success border-0';
            toast.style.position = 'fixed';
            toast.style.top = '20px';
            toast.style.right = '20px';
            toast.style.zIndex = '9999';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-check-circle me-2"></i>Đăng xuất thành công!
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.parentElement.parentElement.remove()"></button>
                </div>
            `;
            document.body.appendChild(toast);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                if (toast.parentElement) {
                    toast.remove();
                }
            }, 3000);
        }
    </script>
}