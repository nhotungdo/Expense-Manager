@page
@model dynamic
@{
    ViewData["Title"] = "Chi tiết giao dịch";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title"><i class="fa-solid fa-receipt me-2"></i>Chi tiết giao dịch</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label text-muted">Ngày</label>
                <div>2025-10-01</div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted">Loại</label>
                <div>Chi</div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted">Danh mục</label>
                <div>Ăn uống</div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted">Ví</label>
                <div>Tiền mặt</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Số tiền</label>
                <div class="text-danger">-50,000</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Ghi chú</label>
                <div>Bữa trưa</div>
            </div>
        </div>
        <div class="mt-3">
            <a class="btn btn-outline-secondary" asp-page="/Transactions/Index"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại</a>
        </div>
    </div>
    </div>

