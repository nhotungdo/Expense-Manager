@page "{id:long}"
@model MoneyTracker.Pages.Transactions.DeleteModel
@{
    ViewData["Title"] = "Delete Transaction";
}

<h2>Delete Transaction</h2>

<div class="alert alert-danger">Are you sure you want to delete this transaction?</div>

<dl class="row">
    <dt class="col-sm-2">Date</dt><dd class="col-sm-10">@Model.Item?.TransactionDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-2">Amount</dt><dd class="col-sm-10">@Model.Item?.Amount.ToString("N2") @Model.Item?.Currency</dd>
    <dt class="col-sm-2">Note</dt><dd class="col-sm-10">@Model.Item?.Note</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
  </form>


