@page
@model dynamic
@{
    ViewData["Title"] = "Xóa giao dịch";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Xóa giao dịch</h5>
        <p>Bạn có chắc muốn xóa giao dịch sau?</p>
        <ul>
            <li>Ngày: 2025-10-01</li>
            <li>Danh mục: Ăn uống</li>
            <li>Số tiền: 50,000</li>
        </ul>
        <button class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Xóa</button>
        <a class="btn btn-outline-secondary" asp-page="/Transactions/Index">Hủy</a>
    </div>
    </div>

