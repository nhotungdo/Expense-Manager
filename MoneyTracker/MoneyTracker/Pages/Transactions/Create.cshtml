@page
@model dynamic
@{
    ViewData["Title"] = "Thêm giao dịch";
}

<h3 class="mb-3"><i class="fa-solid fa-plus me-2"></i>Thêm giao dịch</h3>
<form class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Ngày</label>
        <input type="date" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Loại</label>
        <select class="form-select"><option>Chi</option><option>Thu</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Danh mục</label>
        <select class="form-select"><option>Ăn uống</option><option>Di chuyển</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Ví</label>
        <select class="form-select"><option>Tiền mặt</option><option>Ngân hàng</option></select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Số tiền</label>
        <input type="number" step="0.01" class="form-control" placeholder="0" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Ghi chú</label>
        <input type="text" class="form-control" placeholder="Ghi chú" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu</button>
        <a class="btn btn-outline-secondary" asp-page="/Transactions/Index">Hủy</a>
    </div>
    </form>

