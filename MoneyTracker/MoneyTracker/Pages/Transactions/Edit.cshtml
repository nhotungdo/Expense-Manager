@page
@model dynamic
@{
    ViewData["Title"] = "Chỉnh sửa giao dịch";
}

<h3 class="mb-3"><i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa giao dịch</h3>
<form class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Ngày</label>
        <input type="date" class="form-control" value="2025-10-01" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Loại</label>
        <select class="form-select"><option selected>Chi</option><option>Thu</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Danh mục</label>
        <select class="form-select"><option selected>Ăn uống</option><option>Di chuyển</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Ví</label>
        <select class="form-select"><option selected>Tiền mặt</option><option>Ngân hàng</option></select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Số tiền</label>
        <input type="number" step="0.01" class="form-control" value="50000" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Ghi chú</label>
        <input type="text" class="form-control" value="Bữa trưa" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Cập nhật</button>
        <a class="btn btn-outline-secondary" asp-page="/Transactions/Index">Hủy</a>
    </div>
    </form>

