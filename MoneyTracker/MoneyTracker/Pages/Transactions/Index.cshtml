@page
@model MoneyTracker.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Transactions</h2>
    <div>
        <a asp-page="ExportCsv" class="btn btn-outline-secondary me-2">Export CSV</a>
        <a asp-page="Create" class="btn btn-primary">Add Transaction</a>
    </div>
</div>

@if (Model.Alerts.Any())
{
    <div class="alert alert-warning">
        <strong>Budget alerts:</strong>
        <ul class="mb-0">
        @foreach (var a in Model.Alerts)
        {
            <li>@a.CategoryName: Spent @a.Spent.ToString("N2") / Limit @a.Limit.ToString("N2")</li>
        }
        </ul>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" asp-for="Filter.Query" placeholder="Search note..." />
    </div>
    <div class="col-md-3">
        <input class="form-control" asp-for="Filter.From" type="date" />
    </div>
    <div class="col-md-3">
        <input class="form-control" asp-for="Filter.To" type="date" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-secondary" type="submit">Filter</button>
    </div>
}</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Category</th>
            <th class="text-end">Amount</th>
            <th>Note</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var t in Model.Items)
    {
        <tr>
            <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
            <td>@t.TransactionType</td>
            <td>@t.Category?.Name</td>
            <td class="text-end">@t.Amount.ToString("N2") @t.Currency</td>
            <td>@t.Note</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-page="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>


