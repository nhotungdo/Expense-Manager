@page
@model TransactionsIndexModel
@{
    ViewData["Title"] = "Transactions";
}

<h2>Transactions</h2>

<form method="get" class="row g-2 mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col-auto">
        <input asp-for="Filter.From" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <input asp-for="Filter.To" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <select asp-for="Filter.Type" class="form-select">
            <option value="">All</option>
            <option value="Income">Income</option>
            <option value="Expense">Expense</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" type="submit">Filter</button>
    </div>
    <div class="col-auto ms-auto">
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createForm">Add</button>
    </div>
    <input type="hidden" name="page" value="@Model.Page" />
</form>

<div id="createForm" class="collapse">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row g-2 mb-3">
            <div class="col-md-2">
                <input asp-for="Create.Amount" type="number" step="0.01" class="form-control" placeholder="Amount" />
            </div>
            <div class="col-md-2">
                <select asp-for="Create.Type" class="form-select">
                    <option>Expense</option>
                    <option>Income</option>
                </select>
            </div>
            <div class="col-md-3">
                <select asp-for="Create.CategoryId" class="form-select">
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input asp-for="Create.TransactionDate" type="datetime-local" class="form-control" />
            </div>
            <div class="col-md-12 mt-2">
                <input asp-for="Create.Description" class="form-control" placeholder="Description" />
            </div>
            <div class="col-12 mt-2">
                <button class="btn btn-success" type="submit">Save</button>
            </div>
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="text-danger">@Model.Error</div>
    }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Category</th>
            <th class="text-end">Amount</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Items)
        {
            <tr>
                <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
                <td>@t.Type</td>
                <td>@(Model.CategoryNameMap.ContainsKey(t.CategoryId) ? Model.CategoryNameMap[t.CategoryId] : t.CategoryId.ToString())</td>
                <td class="text-end">@t.Amount</td>
                <td>@t.Description</td>
            </tr>
        }
    </tbody>
 </table>


