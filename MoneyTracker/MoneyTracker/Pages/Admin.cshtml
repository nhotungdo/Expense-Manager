@page
@model MoneyTracker.Pages.AdminModel
@{
    ViewData["Title"] = "Quản Trị";
 
}

@section Styles {
    <style>
        .admin-container {
            min-height: calc(100vh - 80px);
            padding: 2rem;
        }

        .admin-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
        }

        .admin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: white;
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
        }

        .user-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 1rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

        .user-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .action-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            color: white;
            transition: all 0.3s ease;
            font-size: 0.8rem;
        }

        .action-btn:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .action-btn.danger:hover {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }

        .action-btn.success:hover {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }

        .tab-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            color: white;
            transition: all 0.3s ease;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .tab-btn:hover,
        .tab-btn.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .loading-skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
            border-radius: 15px;
            height: 80px;
            margin-bottom: 1rem;
        }

        @@keyframes loading {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
    </style>
}

<div class="admin-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
            <h1 class="h2 mb-1 text-white">
                <i class="fas fa-cog me-3"></i>
                Quản Trị Hệ Thống
            </h1>
            <p class="text-white-50 mb-0">Quản lý người dùng và giám sát hệ thống</p>
        </div>
        <div class="d-flex gap-3">
            <button class="action-btn" onclick="refreshData()">
                <i class="fas fa-sync-alt me-2"></i>
                Làm mới
            </button>
        </div>
    </div>

        <!-- System Stats -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-primary" id="totalUsers">0</div>
                <div class="stat-label">Tổng Người Dùng</div>
            </div>
                    </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-success" id="activeUsers">0</div>
                <div class="stat-label">Người Dùng Hoạt Động</div>
            </div>
                    </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-warning" id="totalTransactions">0</div>
                <div class="stat-label">Tổng Giao Dịch</div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-value text-info" id="totalAmount">0 VND</div>
                <div class="stat-label">Tổng Số Tiền</div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="admin-card">
        <div class="d-flex flex-wrap mb-4">
            <button class="tab-btn active" onclick="showTab('users')">
                <i class="fas fa-users me-2"></i>
                Quản Lý Người Dùng
            </button>
            <button class="tab-btn" onclick="showTab('categories')">
                <i class="fas fa-tags me-2"></i>
                Danh Mục Hệ Thống
            </button>
            <button class="tab-btn" onclick="showTab('logs')">
                <i class="fas fa-list me-2"></i>
                Nhật Ký Hoạt Động
            </button>
            <button class="tab-btn" onclick="showTab('settings')">
                <i class="fas fa-cog me-2"></i>
                Cài Đặt Hệ Thống
                        </button>
    </div>

        <!-- Users Tab -->
        <div id="usersTab" class="tab-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white mb-0">Danh Sách Người Dùng</h5>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control bg-transparent text-white border-secondary" 
                           id="userSearch" placeholder="Tìm kiếm người dùng..." style="width: 250px;">
                    <button class="action-btn" onclick="searchUsers()">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
            <div id="usersList">
                <!-- Loading skeleton -->
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
        </div>
    </div>

        <!-- Categories Tab -->
        <div id="categoriesTab" class="tab-content" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white mb-0">Danh Mục Mặc Định</h5>
                <button class="action-btn" onclick="addDefaultCategory()">
                    <i class="fas fa-plus me-2"></i>
                    Thêm Danh Mục
                        </button>
            </div>
            <div id="categoriesList">
                <!-- Loading skeleton -->
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
        </div>
    </div>

        <!-- Logs Tab -->
        <div id="logsTab" class="tab-content" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white mb-0">Nhật Ký Hoạt Động</h5>
                <div class="d-flex gap-2">
                    <select class="form-select bg-transparent text-white border-secondary" id="logFilter" style="width: 150px;">
                        <option value="">Tất cả</option>
                        <option value="login">Đăng nhập</option>
                        <option value="create">Tạo mới</option>
                        <option value="update">Cập nhật</option>
                        <option value="delete">Xóa</option>
                    </select>
                    <button class="action-btn" onclick="filterLogs()">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
            </div>
            <div id="logsList">
                <!-- Loading skeleton -->
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
                </div>
            </div>

        <!-- Settings Tab -->
        <div id="settingsTab" class="tab-content" style="display: none;">
            <h5 class="text-white mb-4">Cài Đặt Hệ Thống</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="user-card">
                        <h6 class="text-white mb-3">Cài Đặt Email</h6>
                        <div class="mb-3">
                            <label class="form-label text-white">SMTP Host</label>
                            <input type="text" class="form-control bg-transparent text-white border-secondary" 
                                   value="smtp.gmail.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">SMTP Port</label>
                            <input type="number" class="form-control bg-transparent text-white border-secondary" 
                                   value="587">
                        </div>
                        <button class="action-btn success">
                            <i class="fas fa-save me-2"></i>
                            Lưu Cài Đặt
                    </button>
                    </div>
                        </div>
                <div class="col-md-6 mb-3">
                    <div class="user-card">
                        <h6 class="text-white mb-3">Cài Đặt AI</h6>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="aiEnabled" checked>
                                <label class="form-check-label text-white" for="aiEnabled">
                                    Bật gợi ý AI
                                </label>
                        </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Tần suất gợi ý</label>
                            <select class="form-select bg-transparent text-white border-secondary">
                                <option value="daily">Hàng ngày</option>
                                <option value="weekly">Hàng tuần</option>
                                <option value="monthly">Hàng tháng</option>
                            </select>
                        </div>
                        <button class="action-btn success">
                            <i class="fas fa-save me-2"></i>
                            Lưu Cài Đặt
                    </button>
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Global variables
        let currentTab = 'users';
        let users = [];
        let categories = [];
        let logs = [];

        // Initialize page
        document.addEventListener('DOMContentLoaded', function () {
            loadSystemStats();
            loadUsers();
        });

        // Load system stats
        async function loadSystemStats() {
            try {
                const response = await fetch('/api/admin/stats');
                if (response.ok) {
                    const stats = await response.json();
                    updateSystemStats(stats);
                } else {
                    // Use mock data
                    updateSystemStats({
                        totalUsers: 1250,
                        activeUsers: 980,
                        totalTransactions: 45600,
                        totalAmount: 1250000000
                    });
                }
            } catch (error) {
                console.error('Error loading system stats:', error);
                updateSystemStats({
                    totalUsers: 1250,
                    activeUsers: 980,
                    totalTransactions: 45600,
                    totalAmount: 1250000000
                });
            }
        }
        
        // Update system stats
        function updateSystemStats(stats) {
            document.getElementById('totalUsers').textContent = stats.totalUsers.toLocaleString();
            document.getElementById('activeUsers').textContent = stats.activeUsers.toLocaleString();
            document.getElementById('totalTransactions').textContent = stats.totalTransactions.toLocaleString();
            document.getElementById('totalAmount').textContent = formatCurrency(stats.totalAmount);
        }

        // Load users
        async function loadUsers() {
            try {
                showLoadingState('usersList');
                
                const response = await fetch('/api/admin/users');
                if (response.ok) {
                    users = await response.json();
                    displayUsers(users);
                } else {
                    // Use mock data
                    displayMockUsers();
                }
            } catch (error) {
                console.error('Error loading users:', error);
                displayMockUsers();
            }
        }

        // Display users
        function displayUsers(users) {
            const container = document.getElementById('usersList');
            container.innerHTML = '';

            if (users.length === 0) {
                container.innerHTML = `
                    <div class="text-center text-white-50 py-4">
                        <i class="fas fa-users fa-2x mb-3"></i>
                        <h6>Không có người dùng nào</h6>
                    </div>
                `;
                return;
            }

            users.forEach(user => {
                const userElement = document.createElement('div');
                userElement.className = 'user-card';
                
                const statusClass = user.enabled ? 'text-success' : 'text-danger';
                const statusText = user.enabled ? 'Hoạt động' : 'Bị khóa';
                const roleClass = user.role === 'ADMIN' ? 'text-warning' : 'text-info';

                userElement.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <img src="${user.pictureUrl || '/images/default-avatar.png'}" 
                                     alt="Avatar" class="rounded-circle" width="50" height="50">
                            </div>
                            <div>
                                <h6 class="text-white mb-1">${user.fullName || user.username}</h6>
                                <small class="text-white-50">${user.email}</small>
                                <br>
                                <small class="${roleClass}">${user.role}</small>
                                <span class="mx-2">•</span>
                                <small class="${statusClass}">${statusText}</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="action-btn" onclick="viewUser(${user.id})">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="action-btn" onclick="editUser(${user.id})">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="action-btn ${user.enabled ? 'danger' : 'success'}" 
                                    onclick="toggleUserStatus(${user.id}, ${user.enabled})">
                                <i class="fas fa-${user.enabled ? 'lock' : 'unlock'}"></i>
                            </button>
                        </div>
                    </div>
                `;

                container.appendChild(userElement);
            });
        }

        // Display mock users
        function displayMockUsers() {
            const mockUsers = [
                {
                    id: 1,
                    username: 'admin',
                    email: 'admin@moneytracker.com',
                    fullName: 'Administrator',
                    role: 'ADMIN',
                    enabled: true,
                    pictureUrl: null
                },
                {
                    id: 2,
                    username: 'user1',
                    email: 'user1@example.com',
                    fullName: 'Nguyễn Văn A',
                    role: 'USER',
                    enabled: true,
                    pictureUrl: null
                },
                {
                    id: 3,
                    username: 'user2',
                    email: 'user2@example.com',
                    fullName: 'Trần Thị B',
                    role: 'USER',
                    enabled: false,
                    pictureUrl: null
                },
                {
                    id: 4,
                    username: 'user3',
                    email: 'user3@example.com',
                    fullName: 'Lê Văn C',
                    role: 'USER',
                    enabled: true,
                    pictureUrl: null
                }
            ];

            displayUsers(mockUsers);
        }

        // Load categories
        async function loadCategories() {
            try {
                showLoadingState('categoriesList');
                
                const response = await fetch('/api/admin/categories');
                if (response.ok) {
                    categories = await response.json();
                    displayCategories(categories);
                } else {
                    // Use mock data
                    displayMockCategories();
                }
            } catch (error) {
                console.error('Error loading categories:', error);
                displayMockCategories();
            }
        }

        // Display categories
        function displayCategories(categories) {
            const container = document.getElementById('categoriesList');
            container.innerHTML = '';

            categories.forEach(category => {
                const categoryElement = document.createElement('div');
                categoryElement.className = 'user-card';
                categoryElement.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white mb-1">${category.name}</h6>
                            <small class="text-white-50">${category.type} • ${category.description || 'Không có mô tả'}</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="action-btn" onclick="editCategory(${category.id})">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="action-btn danger" onclick="deleteCategory(${category.id})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(categoryElement);
            });
        }

        // Display mock categories
        function displayMockCategories() {
            const mockCategories = [
                { id: 1, name: 'Ăn uống', type: 'Expense', description: 'Chi phí ăn uống hàng ngày' },
                { id: 2, name: 'Mua sắm', type: 'Expense', description: 'Chi phí mua sắm' },
                { id: 3, name: 'Lương', type: 'Income', description: 'Thu nhập từ lương' },
                { id: 4, name: 'Đầu tư', type: 'Income', description: 'Thu nhập từ đầu tư' }
            ];

            displayCategories(mockCategories);
        }

        // Load logs
        async function loadLogs() {
            try {
                showLoadingState('logsList');
                
                const response = await fetch('/api/admin/logs');
                if (response.ok) {
                    logs = await response.json();
                    displayLogs(logs);
                } else {
                    // Use mock data
                    displayMockLogs();
                }
            } catch (error) {
                console.error('Error loading logs:', error);
                displayMockLogs();
            }
        }

        // Display logs
        function displayLogs(logs) {
            const container = document.getElementById('logsList');
            container.innerHTML = '';

            logs.forEach(log => {
                const logElement = document.createElement('div');
                logElement.className = 'user-card';
                logElement.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white mb-1">${log.action}</h6>
                            <small class="text-white-50">${log.details} • ${formatDate(log.createdAt)}</small>
                            <br>
                            <small class="text-white-50">IP: ${log.ipAddress}</small>
                        </div>
                        <div>
                            <span class="badge bg-${getLogBadgeClass(log.action)}">${log.action}</span>
                        </div>
                    </div>
                `;
                container.appendChild(logElement);
            });
        }

        // Display mock logs
        function displayMockLogs() {
            const mockLogs = [
                {
                    action: 'LOGIN',
                    details: 'User admin logged in',
                    createdAt: new Date(),
                    ipAddress: '192.168.1.1'
                },
                {
                    action: 'CREATE',
                    details: 'User created new expense',
                    createdAt: new Date(Date.now() - 3600000),
                    ipAddress: '192.168.1.2'
                },
                {
                    action: 'UPDATE',
                    details: 'User updated profile',
                    createdAt: new Date(Date.now() - 7200000),
                    ipAddress: '192.168.1.3'
                }
            ];

            displayLogs(mockLogs);
        }

        // Show tab
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.style.display = 'none';
            });

            // Remove active class from all buttons
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            // Show selected tab
            document.getElementById(tabName + 'Tab').style.display = 'block';
            event.target.classList.add('active');

            currentTab = tabName;

            // Load data for the tab
            switch (tabName) {
                case 'users':
                    loadUsers();
                    break;
                case 'categories':
                    loadCategories();
                    break;
                case 'logs':
                    loadLogs();
                    break;
                case 'settings':
                    // Settings tab doesn't need to load data
                    break;
            }
        }

        // User actions
        function viewUser(userId) {
            showNotification(`Xem thông tin người dùng ${userId}`, 'info');
        }

        function editUser(userId) {
            showNotification(`Chỉnh sửa người dùng ${userId}`, 'info');
        }
        
        async function toggleUserStatus(userId, currentStatus) {
            try {
                const response = await fetch(`/api/admin/users/${userId}/toggle-status`, {
                    method: 'POST'
                });
                
                if (response.ok) {
                loadUsers();
                    showNotification(`Đã ${currentStatus ? 'khóa' : 'mở khóa'} người dùng`, 'success');
                } else {
                    showNotification('Có lỗi xảy ra!', 'error');
                }
            } catch (error) {
                console.error('Error toggling user status:', error);
                showNotification('Có lỗi xảy ra!', 'error');
            }
        }

        // Category actions
        function addDefaultCategory() {
            showNotification('Thêm danh mục mặc định', 'info');
        }

        function editCategory(categoryId) {
            showNotification(`Chỉnh sửa danh mục ${categoryId}`, 'info');
        }

        function deleteCategory(categoryId) {
            if (confirm('Bạn có chắc chắn muốn xóa danh mục này?')) {
                showNotification(`Đã xóa danh mục ${categoryId}`, 'success');
            }
        }

        // Log actions
        function filterLogs() {
            const filter = document.getElementById('logFilter').value;
            showNotification(`Lọc logs theo: ${filter || 'Tất cả'}`, 'info');
        }

        // Utility functions
        function showLoadingState(containerId) {
            const container = document.getElementById(containerId);
            container.innerHTML = `
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
                <div class="loading-skeleton"></div>
            `;
        }

        function showNotification(message, type) {
            alert(message);
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }

        function formatDate(date) {
            return new Date(date).toLocaleString('vi-VN');
        }

        function getLogBadgeClass(action) {
            switch (action) {
                case 'LOGIN': return 'success';
                case 'CREATE': return 'primary';
                case 'UPDATE': return 'warning';
                case 'DELETE': return 'danger';
                default: return 'secondary';
            }
        }

        function refreshData() {
            loadSystemStats();
            switch (currentTab) {
                case 'users':
                    loadUsers();
                    break;
                case 'categories':
                    loadCategories();
                    break;
                case 'logs':
                    loadLogs();
                    break;
            }
        }

        function searchUsers() {
            const searchTerm = document.getElementById('userSearch').value;
            showNotification(`Tìm kiếm: ${searchTerm}`, 'info');
        }
    </script>
}