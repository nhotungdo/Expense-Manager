@page
@model dynamic
@{
    ViewData["Title"] = "Tài khoản";
}

<div class="space-y-6">
    <!-- Summary: Total balance across accounts -->
    <div class="bg-white rounded-2xl shadow p-6">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-slate-500">Tổng số dư</div>
                <div class="mt-1 text-3xl md:text-4xl font-semibold tracking-tight">36,500,000đ</div>
            </div>
            <i data-lucide="wallet" class="h-10 w-10 text-indigo-600 hidden sm:block"></i>
        </div>
        <div class="mt-4 flex items-center gap-3">
            <button class="inline-flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-500">
                <i data-lucide="plus"></i>
                <span>Thêm tài khoản</span>
            </button>
            <button class="inline-flex items-center gap-2 border px-4 py-2 rounded-lg hover:bg-slate-50">
                <i data-lucide="arrow-right-left"></i>
                <span>Chuyển tiền</span>
            </button>
        </div>
    </div>

    <!-- Accounts list -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Account card: Cash -->
        <div class="bg-white rounded-2xl shadow p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-slate-100 grid place-items-center">
                    <i data-lucide="wallet" class="h-5 w-5 text-slate-700"></i>
                </div>
                <div class="flex-1">
                    <div class="font-medium">Ví tiền mặt</div>
                    <div class="text-sm text-slate-500">Số dư hiện tại</div>
                </div>
             
            </div>
        </div>

        <!-- Account card: Bank -->
        <div class="bg-white rounded-2xl shadow p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-slate-100 grid place-items-center">
                    <i data-lucide="building-2" class="h-5 w-5 text-slate-700"></i>
                </div>
                <div class="flex-1">
                    <div class="font-medium">Ngân hàng Techcombank</div>
                    <div class="text-sm text-slate-500">Số dư hiện tại</div>
                </div>
              
            </div>
        </div>

        <!-- Account card: Credit Card -->
        <div class="bg-white rounded-2xl shadow p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-slate-100 grid place-items-center">
                    <i data-lucide="credit-card" class="h-5 w-5 text-slate-700"></i>
                </div>
                <div class="flex-1">
                    <div class="font-medium">Thẻ VIB</div>
                    <div class="text-sm text-slate-500">Số dư hiện tại</div>
                </div>
              
            </div>
        </div>
    </div>
</div>
