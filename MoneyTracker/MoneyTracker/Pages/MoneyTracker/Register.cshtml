@page
@model dynamic
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="min-h-[70vh] grid place-items-center">
    <div class="w-full max-w-md bg-white rounded-xl shadow-md p-8">
        <h2 class="text-xl font-semibold text-center">Tạo tài khoản</h2>
        <p class="mt-1 text-center text-slate-500">Bắt đầu quản lý tài chính thông minh</p>

        <form class="mt-6 space-y-4" method="post">
            <div>
                <label class="block text-sm text-slate-600">Họ và tên</label>
                <input type="text" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
                <label class="block text-sm text-slate-600">Email</label>
                <input type="email" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
                <label class="block text-sm text-slate-600">Mật khẩu</label>
                <input type="password" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <button type="submit" class="w-full bg-indigo-600 text-white rounded-lg py-2 hover:bg-indigo-500">Đăng ký</button>
        </form>

        <p class="mt-4 text-center text-sm text-slate-500">Đã có tài khoản? <a class="text-indigo-600 hover:underline" asp-page="/MoneyTracker/Login">Đăng nhập</a></p>
    </div>
</div>
