@page
@model dynamic
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="min-h-[70vh] grid place-items-center">
    <div class="w-full max-w-md bg-white rounded-xl shadow-md p-8">
        <h2 class="text-xl font-semibold text-center">Chào mừng trở lại</h2>
        <p class="mt-1 text-center text-slate-500">Đăng nhập để tiếp tục</p>

        <form class="mt-6 space-y-4" method="post">
            <div>
                <label class="block text-sm text-slate-600">Email</label>
                <input type="email" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
                <label class="block text-sm text-slate-600">Mật khẩu</label>
                <input type="password" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <button type="submit" class="w-full bg-indigo-600 text-white rounded-lg py-2 hover:bg-indigo-500">Đăng nhập</button>
        </form>

        <div class="mt-4">
            <a href="/signin-google" class="w-full inline-flex items-center justify-center gap-2 bg-white border border-slate-300 text-slate-700 rounded-lg py-2 hover:bg-slate-50">
                <i data-lucide="mail"></i>
                <span>Đăng nhập với Google</span>
            </a>
        </div>

        <p class="mt-4 text-center text-sm text-slate-500">Chưa có tài khoản? <a class="text-indigo-600 hover:underline" asp-page="/MoneyTracker/Register">Đăng ký</a></p>
    </div>
</div>
