@page
@model dynamic
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="py-16">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
                <h1 class="text-4xl font-bold tracking-tight text-slate-900">Quản lý tài chính tối giản với MoneyTracker</h1>
                <p class="mt-4 text-slate-500">Theo dõi thu chi, lập ngân sách và xem báo cáo trực quan. Giao diện hiện đại, tập trung vào dữ liệu.</p>
                <div class="mt-6 flex gap-3">
                    <a href="/signin-google" class="inline-flex items-center gap-2 bg-indigo-600 text-white px-5 py-3 rounded-lg hover:bg-indigo-500">
                        <i data-lucide="log-in"></i>
                        <span>Đăng nhập với Google</span>
                    </a>
                    <a href="#features" class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 px-5 py-3 rounded-lg hover:bg-white/50">
                        <i data-lucide="info"></i>
                        <span>Tìm hiểu thêm</span>
                    </a>
                </div>
            </div>
            <div>
                <div class="bg-white rounded-xl shadow-md p-6">
                    <div class="h-48 bg-slate-100 rounded-lg grid place-items-center text-slate-400">Vector chart placeholder</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="features" class="py-12">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center">
            <h2 class="text-2xl font-semibold">Tính năng nổi bật</h2>
            <p class="mt-2 text-slate-500">Thiết kế tối giản, tập trung vào dữ liệu của bạn</p>
        </div>
        <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white rounded-xl shadow p-6">
                <i data-lucide="bar-chart-3" class="text-indigo-600"></i>
                <h3 class="mt-3 font-medium">Báo cáo trực quan</h3>
                <p class="mt-1 text-sm text-slate-500">So sánh thu chi, xem xu hướng theo thời gian.</p>
            </div>
            <div class="bg-white rounded-xl shadow p-6">
                <i data-lucide="bot" class="text-indigo-600"></i>
                <h3 class="mt-3 font-medium">Gợi ý thông minh</h3>
                <p class="mt-1 text-sm text-slate-500">Đề xuất tối ưu chi tiêu và tiết kiệm.</p>
            </div>
            <div class="bg-white rounded-xl shadow p-6">
                <i data-lucide="calendar" class="text-indigo-600"></i>
                <h3 class="mt-3 font-medium">Nhắc nhở định kỳ</h3>
                <p class="mt-1 text-sm text-slate-500">Đừng bỏ lỡ các khoản chi định kỳ.</p>
            </div>
            <div class="bg-white rounded-xl shadow p-6">
                <i data-lucide="wallet" class="text-indigo-600"></i>
                <h3 class="mt-3 font-medium">Quản lý ví & ngân sách</h3>
                <p class="mt-1 text-sm text-slate-500">Kiểm soát danh mục, tài khoản, hạn mức.</p>
            </div>
        </div>
    </div>
</section>

<footer class="py-10 border-t">
    <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4 text-slate-500">
        <div>© 2025 MoneyTracker</div>
        <div class="flex items-center gap-4">
            <a class="hover:text-slate-700" href="#">Chính sách</a>
            <a class="hover:text-slate-700" href="#">Điều khoản</a>
            <a class="hover:text-slate-700" href="#">Liên hệ</a>
        </div>
    </div>
</footer>
