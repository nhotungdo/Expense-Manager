@page
@model MoneyTracker.Pages.MoneyTracker.Transactions.IndexModel
@{
    ViewData["Title"] = "Giao dịch";
}

<div x-data="{ openAdd: false, txType: 'expense', amount: '', showCategory: false }" class="space-y-6">
    <!-- Header with title and filter/search icons -->
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold">Giao dịch</h1>
        <div class="flex items-center gap-2">
            <button class="h-10 w-10 grid place-items-center rounded-lg border hover:bg-slate-50" title="Tìm kiếm">
                <i data-lucide="search" class="h-5 w-5 text-slate-600"></i>
            </button>
            <button class="h-10 w-10 grid place-items-center rounded-lg border hover:bg-slate-50" title="Bộ lọc">
                <i data-lucide="sliders-horizontal" class="h-5 w-5 text-slate-600"></i>
            </button>
        </div>
    </div>

    <!-- Real grouped transactions -->
    @if (Model.Groups?.Count > 0)
    {
        foreach (var g in Model.Groups)
        {
            <div class="space-y-3">
                <div class="text-xs uppercase tracking-wide text-slate-500">@g.Label</div>
                @foreach (var t in g.Items)
                {
                    <div class="bg-white rounded-xl shadow hover:shadow-md transition-shadow">
                        <div class="px-4 py-3 flex items-center gap-3">
                            <div class="h-10 w-10 rounded-full bg-slate-100 grid place-items-center">
                                <i data-lucide="@t.CategoryIcon" class="h-5 w-5 text-slate-600"></i>
                            </div>
                            <div class="flex-1">
                                <div class="font-medium">@t.CategoryName</div>
                                <div class="text-xs text-slate-500">@t.Note</div>
                            </div>
                            @{
                                var isIncome = t.Type == 1; // adjust according to your schema
                                var amt = string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", t.Amount);
                            }
                            <div class="@(isIncome ? "text-emerald-600" : "text-red-500") font-medium">@(isIncome ? "+" : "-")@amt</div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="text-sm text-slate-500">Chưa có giao dịch.</div>
    }

    <!-- Full-screen Add New Transaction Modal -->
    <div x-show="openAdd" x-transition class="fixed inset-0 z-50">
        <div class="absolute inset-0 bg-black/40" x-on:click="openAdd = false"></div>
        <div class="absolute inset-x-0 bottom-0 top-0 bg-white rounded-t-2xl md:rounded-none md:inset-0 md:m-0 overflow-y-auto">
            <!-- Modal header: type toggle and close -->
            <div class="sticky top-0 z-10 bg-white border-b px-5 py-4 flex items-center justify-between">
                <div class="inline-flex rounded-lg p-1 bg-slate-100">
                    <button class="px-4 py-2 rounded-md text-sm"
                        :class="txType==='expense' ? 'bg-white shadow font-medium text-slate-900' : 'text-slate-600'"
                        x-on:click="txType='expense'">Chi tiêu</button>
                    <button class="px-4 py-2 rounded-md text-sm"
                        :class="txType==='income' ? 'bg-white shadow font-medium text-slate-900' : 'text-slate-600'"
                        x-on:click="txType='income'">Thu nhập</button>
                </div>
                <button class="h-10 w-10 grid place-items-center rounded-lg hover:bg-slate-50" x-on:click="openAdd=false">
                    <i data-lucide="x" class="h-5 w-5 text-slate-600"></i>
                </button>
            </div>

            <!-- Modal body -->
            <div class="px-6 pt-5 pb-24 space-y-6">
                <!-- Amount input with keypad -->
                <div>
                    <label class="block text-sm text-slate-600">Số tiền</label>
                    <div class="mt-2 flex items-center gap-3">
                        <div class="flex-1">
                            <input x-model="amount" inputmode="decimal" type="text" placeholder="0"
                                class="w-full text-3xl font-semibold tracking-tight rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                        </div>
                    </div>
                    <div class="mt-3 grid grid-cols-3 gap-2 select-none">
                        <template x-for="key in ['1','2','3','4','5','6','7','8','9','0','00','.']" :key="key">
                            <button x-on:click.prevent="amount = (amount||'') + key"
                                class="py-3 rounded-lg border bg-white hover:bg-slate-50 text-lg"> <span x-text="key"></span> </button>
                        </template>
                        <button x-on:click.prevent="amount = amount?.slice(0,-1) || ''"
                            class="py-3 rounded-lg border bg-white hover:bg-slate-50 text-lg col-span-3">
                            <i data-lucide="delete" class="h-5 w-5 inline-block align-[-2px]"></i>
                            <span class="ml-1">Xóa</span>
                        </button>
                    </div>
                </div>

                <!-- Category selector -->
                <div>
                    <label class="block text-sm text-slate-600">Danh mục</label>
                    <button x-on:click="showCategory = true"
                        class="mt-2 w-full flex items-center justify-between rounded-lg border border-slate-300 px-4 py-3 hover:bg-slate-50">
                        <div class="flex items-center gap-2 text-slate-700">
                            <i data-lucide="tags" class="h-5 w-5"></i>
                            <span>Chọn danh mục</span>
                        </div>
                        <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
                    </button>

                    <!-- Category grid modal -->
                    <div x-show="showCategory" x-transition class="fixed inset-0 z-50">
                        <div class="absolute inset-0 bg-black/40" x-on:click="showCategory=false"></div>
                        <div class="absolute inset-x-0 bottom-0 top-20 bg-white rounded-t-2xl overflow-y-auto">
                            <div class="sticky top-0 bg-white border-b px-5 py-4 flex items-center justify-between">
                                <div class="font-medium">Chọn danh mục</div>
                                <button class="h-10 w-10 grid place-items-center rounded-lg hover:bg-slate-50" x-on:click="showCategory=false">
                                    <i data-lucide="x" class="h-5 w-5 text-slate-600"></i>
                                </button>
                            </div>
                            <div class="p-5 grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-4">
                                <template x-for="icon in ['utensils','shopping-bag','bus','coffee','home','gamepad-2','book-open','cpu','pill','sparkles','gift','music']" :key="icon">
                                    <button class="flex flex-col items-center gap-2 p-3 rounded-lg border hover:bg-slate-50">
                                        <i :data-lucide="icon" class="h-6 w-6"></i>
                                        <span class="text-xs text-slate-600" x-text="icon"></span>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account selector -->
                <div>
                    <label class="block text-sm text-slate-600">Tài khoản</label>
                    <select class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3">
                        <option>Ví tiền mặt</option>
                        <option>Tài khoản ngân hàng</option>
                        <option>Thẻ VIB</option>
                    </select>
                </div>

                <!-- Date picker -->
                <div>
                    <label class="block text-sm text-slate-600">Ngày</label>
                    <input type="date" class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3" />
                </div>

                <!-- Note -->
                <div>
                    <label class="block text-sm text-slate-600">Ghi chú</label>
                    <input type="text" class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3" placeholder="Nhập ghi chú" />
                </div>
            </div>

            <!-- Modal footer: Save button -->
            <div class="fixed inset-x-0 bottom-0 bg-white border-t px-6 py-4">
                <button class="w-full inline-flex items-center justify-center gap-2 bg-indigo-600 text-white px-5 py-3 rounded-xl hover:bg-indigo-500">
                    <i data-lucide="save" class="h-5 w-5"></i>
                    <span>Lưu</span>
                </button>
            </div>
        </div>
    </div>

    <!-- FAB -->
    <button class="fixed bottom-6 right-6 h-14 w-14 rounded-full bg-indigo-600 text-white shadow-lg grid place-items-center hover:bg-indigo-500"
        title="Thêm giao dịch" x-on:click="openAdd = true">
        <i data-lucide="plus" class="h-6 w-6"></i>
    </button>
</div>
