@page
@model dynamic
@{
    ViewData["Title"] = "Báo cáo";
}

<div x-data="{ range: 'this_month', tab: 'expense' }" class="space-y-6">
    <!-- Time range control -->
    <div class="bg-white rounded-2xl shadow p-5">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div class="inline-flex rounded-xl p-1 bg-slate-100 w-full md:w-auto">
                <button class="px-4 py-2 rounded-lg text-sm w-1/3 md:w-auto"
                    :class="range==='this_month' ? 'bg-white shadow font-medium text-slate-900' : 'text-slate-600'"
                    x-on:click="range='this_month'">Tháng này</button>
                <button class="px-4 py-2 rounded-lg text-sm w-1/3 md:w-auto"
                    :class="range==='last_month' ? 'bg-white shadow font-medium text-slate-900' : 'text-slate-600'"
                    x-on:click="range='last_month'">Tháng trước</button>
                <button class="px-4 py-2 rounded-lg text-sm w-1/3 md:w-auto"
                    :class="range==='this_year' ? 'bg-white shadow font-medium text-slate-900' : 'text-slate-600'"
                    x-on:click="range='this_year'">Năm nay</button>
            </div>
            <div class="text-sm text-slate-500">Khoảng thời gian: <span x-text="range==='this_month' ? 'Tháng này' : (range==='last_month' ? 'Tháng trước' : 'Năm nay')"></span></div>
        </div>
    </div>

    <!-- Tabs: Tổng quan / Chi tiêu / Thu nhập -->
    <div class="bg-white rounded-2xl shadow">
        <div class="border-b">
            <nav class="flex gap-4 px-5 pt-4">
                <button class="px-3 py-2 border-b-2 -mb-px"
                    :class="tab==='overview' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500'"
                    x-on:click="tab='overview'">Tổng quan</button>
                <button class="px-3 py-2 border-b-2 -mb-px"
                    :class="tab==='expense' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500'"
                    x-on:click="tab='expense'">Chi tiêu</button>
                <button class="px-3 py-2 border-b-2 -mb-px"
                    :class="tab==='income' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500'"
                    x-on:click="tab='income'">Thu nhập</button>
            </nav>
        </div>

        <!-- Chi tiêu (default active) -->
        <div x-show="tab==='expense'" x-transition class="p-6 grid lg:grid-cols-2 gap-8">
            <!-- Donut chart -->
            <div class="flex items-center justify-center">
                <div class="relative h-64 w-64">
                    <!-- Background circle -->
                    <svg viewBox="0 0 100 100" class="h-64 w-64 -rotate-90">
                        <circle cx="50" cy="50" r="40" fill="transparent" stroke="#e5e7eb" stroke-width="12"></circle>
                        <!-- Segments (hard-coded sample distribution) -->
                        <circle cx="50" cy="50" r="40" fill="transparent" stroke="#6366f1" stroke-width="12"
                            stroke-dasharray="35 65" stroke-dashoffset="0"></circle>
                        <circle cx="50" cy="50" r="40" fill="transparent" stroke="#f43f5e" stroke-width="12"
                            stroke-dasharray="25 75" stroke-dashoffset="35"></circle>
                        <circle cx="50" cy="50" r="40" fill="transparent" stroke="#10b981" stroke-width="12"
                            stroke-dasharray="15 85" stroke-dashoffset="60"></circle>
                        <circle cx="50" cy="50" r="40" fill="transparent" stroke="#f59e0b" stroke-width="12"
                            stroke-dasharray="10 90" stroke-dashoffset="75"></circle>
                    </svg>
                    <!-- Center label -->
                    <div class="absolute inset-0 grid place-items-center rotate-90">
                        <div class="text-center">
                            <div class="text-xs text-slate-500">Chi tiêu</div>
                            <div class="text-2xl font-semibold">9,300,000đ</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category list -->
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-indigo-500"></span>
                        <div>
                            <div class="font-medium">Ăn uống</div>
                            <div class="text-xs text-slate-500">3,255,000đ</div>
                        </div>
                    </div>
                    <div class="text-slate-600">35%</div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-rose-500"></span>
                        <div>
                            <div class="font-medium">Mua sắm</div>
                            <div class="text-xs text-slate-500">2,325,000đ</div>
                        </div>
                    </div>
                    <div class="text-slate-600">25%</div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-emerald-500"></span>
                        <div>
                            <div class="font-medium">Di chuyển</div>
                            <div class="text-xs text-slate-500">1,395,000đ</div>
                        </div>
                    </div>
                    <div class="text-slate-600">15%</div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-amber-500"></span>
                        <div>
                            <div class="font-medium">Giải trí</div>
                            <div class="text-xs text-slate-500">930,000đ</div>
                        </div>
                    </div>
                    <div class="text-slate-600">10%</div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-slate-400"></span>
                        <div>
                            <div class="font-medium">Khác</div>
                            <div class="text-xs text-slate-500">1,395,000đ</div>
                        </div>
                    </div>
                    <div class="text-slate-600">15%</div>
                </div>
            </div>
        </div>

        <!-- Tổng quan -->
        <div x-show="tab==='overview'" x-transition class="p-6">
            <div class="text-slate-500">Tổng quan (đang thiết kế)</div>
        </div>

        <!-- Thu nhập -->
        <div x-show="tab==='income'" x-transition class="p-6">
            <div class="text-slate-500">Thu nhập (đang thiết kế)</div>
        </div>
    </div>
</div>
