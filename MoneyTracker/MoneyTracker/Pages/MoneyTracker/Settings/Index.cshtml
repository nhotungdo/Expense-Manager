@page
@model dynamic
@{
    ViewData["Title"] = "Cài đặt";
}

<div x-data="{ pinEnabled: false, autoBackup: true, notifications: true }" class="space-y-6">
    <!-- Group: Account -->
    <div class="bg-white rounded-2xl shadow">
        <div class="px-5 py-3 border-b text-xs font-medium tracking-wide text-slate-500">Tài khoản</div>
        <div class="divide-y">
            <!-- Thong tin ca nhan -->
            <button class="w-full text-left px-5 py-4 hover:bg-slate-50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i data-lucide="user" class="h-5 w-5 text-slate-500"></i>
                    <div>
                        <div class="font-medium">Thông tin cá nhân</div>
                        <div class="text-xs text-slate-500">Tên, email và ảnh đại diện</div>
                    </div>
                </div>
                <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
            </button>
            <!-- Don vi tien te -->
            <button class="w-full text-left px-5 py-4 hover:bg-slate-50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i data-lucide="banknote" class="h-5 w-5 text-slate-500"></i>
                    <div>
                        <div class="font-medium">Đơn vị tiền tệ</div>
                        <div class="text-xs text-slate-500">Hiện tại: VND</div>
                    </div>
                </div>
                <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
            </button>
        </div>
    </div>

    <!-- Group: Security -->
    <div class="bg-white rounded-2xl shadow">
        <div class="px-5 py-3 border-b text-xs font-medium tracking-wide text-slate-500">Bảo mật</div>
        <div class="divide-y">
            <!-- Doi mat khau -->
            <button class="w-full text-left px-5 py-4 hover:bg-slate-50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i data-lucide="lock" class="h-5 w-5 text-slate-500"></i>
                    <div>
                        <div class="font-medium">Đổi mật khẩu</div>
                        <div class="text-xs text-slate-500">Cập nhật mật khẩu tài khoản</div>
                    </div>
                </div>
                <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
            </button>
            <!-- Dat ma PIN (toggle) -->
            <div class="px-5 py-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i data-lucide="shield" class="h-5 w-5 text-slate-500"></i>
                    <div>
                        <div class="font-medium">Đặt mã PIN</div>
                        <div class="text-xs text-slate-500">Yêu cầu PIN khi mở ứng dụng</div>
                    </div>
                </div>
                <label class="inline-flex items-center cursor-pointer">
                    <input type="checkbox" class="peer sr-only" x-model="pinEnabled">
                    <span class="peer-checked:bg-indigo-600 bg-slate-300 relative inline-block h-6 w-11 rounded-full transition-all">
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition-all peer-checked:translate-x-5"></span>
                    </span>
                </label>
            </div>
            <!-- Thong bao (toggle) -->
            <div class="px-5 py-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i data-lucide="bell" class="h-5 w-5 text-slate-500"></i>
                    <div>
                        <div class="font-medium">Thông báo</div>
                        <div class="text-xs text-slate-500">Nhận thông báo giao dịch và báo cáo</div>
                    </div>
                </div>
                <label class="inline-flex items-center cursor-pointer">
                    <input type="checkbox" class="peer sr-only" x-model="notifications">
                    <span class="peer-checked:bg-indigo-600 bg-slate-300 relative inline-block h-6 w-11 rounded-full transition-all">
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition-all peer-checked:translate-x-5"></span>
                    </span>
                </label>
            </div>
        </div>
    </div>

    <!-- Group: Data -->
    <div class="bg-white rounded-2xl shadow">
        <div class="px-5 py-3 border-b text-xs font-medium tracking-wide text-slate-500">Dữ liệu</div>
        <div class="divide-y">
            <!-- Sao luu & Khoi phuc -->
            <button class="w-full text-left px-5 py-4 hover:bg-slate-50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i data-lucide="database" class="h-5 w-5 text-slate-500"></i>
                    <div>
                        <div class="font-medium">Sao lưu & Khôi phục</div>
                        <div class="text-xs text-slate-500">Xuất/nhập dữ liệu dưới dạng tệp</div>
                    </div>
                </div>
                <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
            </button>
            <!-- Auto backup toggle -->
            <div class="px-5 py-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <i data-lucide="refresh-cw" class="h-5 w-5 text-slate-500"></i>
                    <div>
                        <div class="font-medium">Sao lưu tự động</div>
                        <div class="text-xs text-slate-500">Sao lưu hàng tuần</div>
                    </div>
                </div>
                <label class="inline-flex items-center cursor-pointer">
                    <input type="checkbox" class="peer sr-only" x-model="autoBackup">
                    <span class="peer-checked:bg-indigo-600 bg-slate-300 relative inline-block h-6 w-11 rounded-full transition-all">
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition-all peer-checked:translate-x-5"></span>
                    </span>
                </label>
            </div>
        </div>
    </div>

    <!-- Logout -->
    <div class="bg-white rounded-2xl shadow">
        <div class="divide-y">
            <a href="/logout" class="block px-5 py-4 hover:bg-slate-50 flex items-center gap-3 text-red-600">
                <i data-lucide="log-out" class="h-5 w-5"></i>
                <span class="font-medium">Đăng xuất</span>
            </a>
        </div>
    </div>
</div>
