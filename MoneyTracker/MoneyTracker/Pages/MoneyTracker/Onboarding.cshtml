@page
@model dynamic
@{
    ViewData["Title"] = "Chào mừng";
}

<div x-data="onboard()" class="max-w-2xl mx-auto bg-white rounded-2xl shadow">
    <div class="px-6 py-5 border-b">
        <div class="text-2xl font-semibold">👋 Chào mừng đến Money Tracker</div>
        <div class="text-slate-500 mt-1">Thiết lập nhanh để bắt đầu quản lý chi tiêu</div>
    </div>

    <div class="p-6 space-y-6">
        <!-- 💼 Tên ví mặc định -->
        <div>
            <label class="block text-sm text-slate-600">💼 Tên ví mặc định</label>
            <input x-model="defaultWallet" type="text" class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3" placeholder="Ví tiền mặt" />
        </div>

        <!-- 🎯 Mục tiêu tiết kiệm / tháng -->
        <div>
            <label class="block text-sm text-slate-600">🎯 Mục tiêu tiết kiệm / tháng</label>
            <div class="mt-2 flex items-center gap-3">
                <input x-model.number="savingGoal" type="number" min="0" step="10000" class="flex-1 rounded-lg border border-slate-300 px-4 py-3" placeholder="1,000,000" />
                <span class="text-slate-500">VND</span>
            </div>
        </div>

        <!-- 🤖 Bật/tắt gợi ý AI chi tiêu -->
        <div class="flex items-center justify-between">
            <div>
                <div class="font-medium">🤖 Gợi ý AI chi tiêu</div>
                <div class="text-sm text-slate-500">Nhận đề xuất tối ưu chi tiêu dựa trên giao dịch gần đây</div>
            </div>
            <label class="inline-flex items-center cursor-pointer">
                <input type="checkbox" class="peer sr-only" x-model="enableAi">
                <span class="peer-checked:bg-indigo-600 bg-slate-300 relative inline-block h-6 w-11 rounded-full transition-all">
                    <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition-all peer-checked:translate-x-5"></span>
                </span>
            </label>
        </div>
    </div>

    <div class="px-6 py-5 border-t flex justify-end">
        <button x-on:click="submit" class="inline-flex items-center gap-2 bg-indigo-600 text-white px-5 py-3 rounded-xl hover:bg-indigo-500">
            <i data-lucide="rocket"></i>
            <span>🚀 Bắt đầu sử dụng Money Tracker</span>
        </button>
    </div>
</div>

<script>
function onboard(){
    return {
        defaultWallet: 'Ví tiền mặt',
        savingGoal: 1000000,
        enableAi: true,
        async submit(){
            try{
                const payload = {
                    defaultWallet: this.defaultWallet,
                    savingGoal: this.savingGoal,
                    enableAi: this.enableAi
                };
                const res = await fetch('/api/onboarding/complete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if(res.ok){
                    try { localStorage.setItem('mt_onboarding', JSON.stringify(payload)); } catch(e) {}
                    window.location.href = '/MoneyTracker/Dashboard';
                }
            }catch(e){
                alert('Không thể lưu onboarding.');
            }
        }
    }
}
</script>
