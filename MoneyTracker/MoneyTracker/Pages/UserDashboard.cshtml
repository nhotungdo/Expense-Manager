@page
@model MoneyTracker.Pages.UserDashboardModel
@{
    ViewData["Title"] = "Dashboard - Money Tracker";
}

<link rel="stylesheet" href="~/css/modern-dashboard.css" />

<div class="dashboard-layout">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h1>💰 MoneyTracker</h1>
        </div>
        <nav class="sidebar-nav">
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="/UserDashboard" class="nav-link active">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Expenses" class="nav-link">
                        <i class="fas fa-shopping-cart"></i>
                        <span>Chi tiêu</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Incomes" class="nav-link">
                        <i class="fas fa-money-bill-wave"></i>
                        <span>Thu nhập</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Categories" class="nav-link">
                        <i class="fas fa-tags"></i>
                        <span>Danh mục</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/AiSuggestions" class="nav-link">
                        <i class="fas fa-robot"></i>
                        <span>AI Insights</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Profile" class="nav-link">
                        <i class="fas fa-user"></i>
                        <span>Hồ sơ</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <button class="menu-toggle" id="menuToggle">
                <i class="fas fa-bars"></i>
            </button>
            <div class="search-container">
                <i class="fas fa-search search-icon"></i>
                <input type="text" placeholder="Tìm kiếm giao dịch..." class="search-input">
            </div>
        </div>
        <div class="header-right">
            <button class="notification-btn" id="notificationBtn">
                <i class="fas fa-bell"></i>
                <span class="notification-badge" id="notificationBadge">3</span>
            </button>
            <button class="settings-btn">
                <i class="fas fa-cog"></i>
            </button>
            <div class="user-profile">
                <div class="user-avatar" id="userAvatar">U</div>
                <span id="userName">User</span>
                <i class="fas fa-chevron-down"></i>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Stats Cards -->
        <div class="dashboard-grid">
            <div class="stats-card income animate-fade-in-up">
                <div class="stats-header">
                    <div class="stats-title">Thu nhập tháng này</div>
                    <div class="stats-icon">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                </div>
                <div class="stats-value" id="monthlyIncome">0 ₫</div>
                <div class="stats-change positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+12.5% so với tháng trước</span>
                </div>
            </div>

            <div class="stats-card expense animate-fade-in-up">
                <div class="stats-header">
                    <div class="stats-title">Chi tiêu tháng này</div>
                    <div class="stats-icon">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                </div>
                <div class="stats-value" id="monthlyExpenses">0 ₫</div>
                <div class="stats-change negative">
                    <i class="fas fa-arrow-up"></i>
                    <span>+8.2% so với tháng trước</span>
                </div>
            </div>

            <div class="stats-card savings animate-fade-in-up">
                <div class="stats-header">
                    <div class="stats-title">Tiết kiệm</div>
                    <div class="stats-icon">
                        <i class="fas fa-piggy-bank"></i>
                    </div>
                </div>
                <div class="stats-value" id="netSavings">0 ₫</div>
                <div class="stats-change positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+15.3% so với tháng trước</span>
                </div>
            </div>

            <div class="stats-card animate-fade-in-up">
                <div class="stats-header">
                    <div class="stats-title">Tổng số dư</div>
                    <div class="stats-icon">
                        <i class="fas fa-wallet"></i>
                    </div>
                </div>
                <div class="stats-value" id="totalBalance">0 ₫</div>
                <div class="stats-change positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+5.7% so với tháng trước</span>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="dashboard-grid">
            <div class="chart-container animate-slide-in-left">
                <div class="chart-header">
                    <div class="chart-title">Xu hướng hàng tháng</div>
                    <div class="chart-actions">
                        <button class="chart-btn active">6T</button>
                        <button class="chart-btn">1N</button>
                        <button class="chart-btn">Tất cả</button>
                    </div>
                </div>
                <div class="chart-area">
                    <canvas id="monthlyTrendsChart"></canvas>
                </div>
            </div>

            <div class="chart-container animate-slide-in-left">
                <div class="chart-header">
                    <div class="chart-title">Chi tiêu theo danh mục</div>
                    <div class="chart-actions">
                        <button class="chart-btn active">Tháng này</button>
                        <button class="chart-btn">Tháng trước</button>
                    </div>
                </div>
                <div class="chart-area">
                    <canvas id="expensesByCategoryChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Bottom Row -->
        <div class="dashboard-grid">
            <!-- Recent Transactions -->
            <div class="transactions-container animate-fade-in-up">
                <div class="transactions-header">
                    <div class="transactions-title">Giao dịch gần đây</div>
                    <button class="view-all-btn">
                        Xem tất cả
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
                <div id="recentTransactionsList">
                    <div class="loading">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>

            <!-- AI Suggestions -->
            <div class="ai-suggestions animate-fade-in-up">
                <div class="ai-suggestions-header">
                    <div class="ai-icon">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div class="ai-title">AI Insights</div>
                </div>
                <div id="aiSuggestionsList">
                    <div class="loading">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
                <button class="view-all-btn" onclick="generateAISuggestion()">
                    <i class="fas fa-sync-alt"></i>
                    Tạo gợi ý mới
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let monthlyTrendsChart;
        let expensesByCategoryChart;
        let dashboardData = null;

        // Load dashboard data
        async function loadDashboardData() {
            try {
                const response = await fetch('/api/dashboard', {
                    headers: {
                        'Authorization': 'Bearer ' + getToken()
                    }
                });

                if (response.ok) {
                    dashboardData = await response.json();
                    updateDashboardUI(dashboardData);
                    updateCharts(dashboardData);
                    updateRecentTransactions(dashboardData.recentTransactions);
                    updateAISuggestions(dashboardData.aiSuggestions);
                } else if (response.status === 401) {
                    window.location.href = '/Login';
                }
            } catch (error) {
                console.error('Error loading dashboard data:', error);
                // Use mock data as fallback
                const mockData = {
                    monthlyIncome: 8500000,
                    monthlyExpenses: 6200000,
                    netWorth: 14231000,
                    totalIncome: 45000000,
                    totalExpenses: 30769000,
                    monthlyTrends: [
                        { year: 2024, month: 1, income: 4500000, expenses: 3800000, savings: 700000 },
                        { year: 2024, month: 2, income: 4800000, expenses: 4200000, savings: 600000 },
                        { year: 2024, month: 3, income: 5200000, expenses: 4500000, savings: 700000 },
                        { year: 2024, month: 4, income: 5000000, expenses: 4000000, savings: 1000000 },
                        { year: 2024, month: 5, income: 5500000, expenses: 4800000, savings: 700000 },
                        { year: 2024, month: 6, income: 8500000, expenses: 6200000, savings: 2300000 }
                    ],
                    expensesByCategory: {
                        "Ăn uống": 1800000,
                        "Giao thông": 1200000,
                        "Giải trí": 800000,
                        "Mua sắm": 600000,
                        "Hóa đơn": 1000000,
                        "Y tế": 400000,
                        "Khác": 400000
                    },
                    recentTransactions: [
                        { type: "Expense", category: "Ăn uống", amount: 450000, date: new Date('2024-06-15'), note: "Ăn trưa tại nhà hàng" },
                        { type: "Income", category: "Lương", amount: 8500000, date: new Date('2024-06-14'), note: "Lương tháng 6" },
                        { type: "Expense", category: "Giao thông", amount: 250000, date: new Date('2024-06-13'), note: "Đổ xăng" },
                        { type: "Expense", category: "Giải trí", amount: 1200000, date: new Date('2024-06-12'), note: "Vé xem phim" },
                        { type: "Expense", category: "Mua sắm", amount: 899000, date: new Date('2024-06-11'), note: "Mua hàng online" }
                    ],
                    aiSuggestions: [
                        { suggestion: "💡 Chi phí ăn uống của bạn chiếm 29% tổng chi tiêu. Hãy cân nhắc lập kế hoạch bữa ăn để giảm chi phí.", createdAt: new Date('2024-06-15') },
                        { suggestion: "📊 Tuyệt vời! Bạn đã tiết kiệm được 27% thu nhập tháng này. Hãy cân nhắc đầu tư số tiền này.", createdAt: new Date('2024-06-14') },
                        { suggestion: "⚠️ Chi tiêu giải trí của bạn tăng 15% so với tháng trước. Hãy xem xét lại ngân sách.", createdAt: new Date('2024-06-13') }
                    ]
                };
                dashboardData = mockData;
                updateDashboardUI(mockData);
                updateCharts(mockData);
                updateRecentTransactions(mockData.recentTransactions);
                updateAISuggestions(mockData.aiSuggestions);
            }
        }

        function updateDashboardUI(data) {
            document.getElementById('monthlyIncome').textContent = formatCurrency(data.monthlyIncome);
            document.getElementById('monthlyExpenses').textContent = formatCurrency(data.monthlyExpenses);
            document.getElementById('netSavings').textContent = formatCurrency(data.monthlyIncome - data.monthlyExpenses);
            document.getElementById('totalBalance').textContent = formatCurrency(data.netWorth);
        }

        function updateCharts(data) {
            // Monthly Trends Chart
            const monthlyTrendsCtx = document.getElementById('monthlyTrendsChart').getContext('2d');
            if (monthlyTrendsChart) {
                monthlyTrendsChart.destroy();
            }

            monthlyTrendsChart = new Chart(monthlyTrendsCtx, {
                type: 'line',
                data: {
                    labels: data.monthlyTrends.map(t => `${t.year}-${t.month.toString().padStart(2, '0')}`),
                    datasets: [{
                        label: 'Thu nhập',
                        data: data.monthlyTrends.map(t => t.income),
                        borderColor: '#4facfe',
                        backgroundColor: 'rgba(79, 172, 254, 0.1)',
                        tension: 0.4,
                        fill: true
                    }, {
                        label: 'Chi tiêu',
                        data: data.monthlyTrends.map(t => t.expenses),
                        borderColor: '#fa709a',
                        backgroundColor: 'rgba(250, 112, 154, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: '#4a5568',
                                usePointStyle: true
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            },
                            ticks: {
                                color: '#718096'
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            },
                            ticks: {
                                color: '#718096',
                                callback: function (value) {
                                    return formatCurrency(value);
                                }
                            }
                        }
                    }
                }
            });

            // Expenses by Category Chart
            const expensesByCategoryCtx = document.getElementById('expensesByCategoryChart').getContext('2d');
            if (expensesByCategoryChart) {
                expensesByCategoryChart.destroy();
            }

            const categoryData = Object.entries(data.expensesByCategory);
            expensesByCategoryChart = new Chart(expensesByCategoryCtx, {
                type: 'doughnut',
                data: {
                    labels: categoryData.map(([name]) => name),
                    datasets: [{
                        data: categoryData.map(([, value]) => value),
                        backgroundColor: [
                            '#667eea',
                            '#764ba2',
                            '#f093fb',
                            '#f5576c',
                            '#4facfe',
                            '#00f2fe',
                            '#43e97b'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#4a5568',
                                usePointStyle: true,
                                padding: 20
                            }
                        }
                    }
                }
            });
        }

        function updateRecentTransactions(transactions) {
            const container = document.getElementById('recentTransactionsList');
            if (!transactions || transactions.length === 0) {
                container.innerHTML = '<div class="text-center text-muted">Không có giao dịch gần đây</div>';
                return;
            }

            container.innerHTML = transactions.map(transaction => `
                    <div class="transaction-item">
                        <div class="transaction-icon ${transaction.type.toLowerCase()}">
                            <i class="fas fa-${transaction.type === 'Income' ? 'arrow-up' : 'arrow-down'}"></i>
                        </div>
                        <div class="transaction-details">
                            <div class="transaction-category">${transaction.category}</div>
                            <div class="transaction-note">${transaction.note || 'Không có ghi chú'}</div>
                        </div>
                        <div class="transaction-amount ${transaction.type.toLowerCase()}">
                            ${transaction.type === 'Income' ? '+' : '-'}${formatCurrency(transaction.amount)}
                        </div>
                        <div class="transaction-date">
                            ${formatDate(transaction.date)}
                        </div>
                    </div>
                `).join('');
        }

        function updateAISuggestions(suggestions) {
            const container = document.getElementById('aiSuggestionsList');
            if (!suggestions || suggestions.length === 0) {
                container.innerHTML = '<div class="text-center text-muted">Không có gợi ý AI nào</div>';
                return;
            }

            container.innerHTML = suggestions.map(suggestion => `
                    <div class="suggestion-item">
                        <div class="suggestion-text">${suggestion.suggestion}</div>
                        <div class="suggestion-time">${formatDate(suggestion.createdAt)}</div>
                    </div>
                `).join('');
        }

        async function generateAISuggestion() {
            try {
                const response = await fetch('/api/dashboard/generate-ai-suggestion', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + getToken(),
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const result = await response.json();
                    // Add new suggestion to the list
                    const newSuggestion = {
                        suggestion: result.suggestion,
                        createdAt: new Date()
                    };

                    if (dashboardData && dashboardData.aiSuggestions) {
                        dashboardData.aiSuggestions.unshift(newSuggestion);
                        updateAISuggestions(dashboardData.aiSuggestions.slice(0, 3));
                    }
                }
            } catch (error) {
                console.error('Error generating AI suggestion:', error);
            }
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        }

        function formatDate(date) {
            return new Date(date).toLocaleDateString('vi-VN', {
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function getToken() {
            return localStorage.getItem('authToken') || '';
        }

        // Mobile menu toggle
        document.getElementById('menuToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
        });

        // Initialize dashboard
        $(document).ready(function () {
            loadDashboardData();

            // Auto-refresh every 5 minutes
            setInterval(loadDashboardData, 5 * 60 * 1000);
        });
    </script>
}