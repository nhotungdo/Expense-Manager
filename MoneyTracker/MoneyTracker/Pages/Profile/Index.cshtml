@page "/Profile"
@model MoneyTracker.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="d-flex justify-content-center">
    <div class="card border-0 shadow-sm" style="max-width: 540px; width: 100%;">
        <div class="card-body text-center">
            <img src="https://www.gravatar.com/avatar/?d=mp" class="rounded-circle mb-3" width="96" height="96"
                alt="avatar" />
            <h4 class="card-title">@User?.Identity?.Name ?? "Tên người dùng"</h4>
            <p class="text-muted">email@example.com</p>
            <p>Tham gia: 2025-01-01</p>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal"><i
                    class="fa-solid fa-pen-to-square me-1"></i>Chỉnh sửa hồ sơ</button>
        </div>
    </div>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh sửa hồ sơ</h5><button type="button" class="btn-close"
                    data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Tên hiển thị</label><input class="form-control"
                        value="Tên người dùng" /></div>
                <div class="mb-3"><label class="form-label">Email</label><input class="form-control"
                        value="email@example.com" /></div>
            </div>
            <div class="modal-footer"><button class="btn btn-primary">Lưu</button><button
                    class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button></div>
        </div>
    </div>
</div>
