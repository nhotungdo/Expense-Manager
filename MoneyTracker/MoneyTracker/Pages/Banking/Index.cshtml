@page
@model MoneyTracker.Pages.Banking.IndexModel
@{
    ViewData["Title"] = "Banking Connections";
}

<h2>Banking Connections</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted">Connect your bank accounts for automatic transaction sync</p>
    <a asp-page="Connect" class="btn btn-primary">Connect Bank</a>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Provider</th><th>Account</th><th>Status</th><th>Last Sync</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var conn in Model.Connections)
    {
        <tr>
            <td>@conn.Provider</td>
            <td>@conn.Account?.Name</td>
            <td>
                <span class="badge @(conn.SyncStatus == "Success" ? "bg-success" : "bg-warning")">
                    @conn.SyncStatus
                </span>
            </td>
            <td>@conn.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="text-end">
                <a asp-page="Sync" asp-route-id="@conn.Id" class="btn btn-sm btn-outline-primary">Sync Now</a>
                <a asp-page="Disconnect" asp-route-id="@conn.Id" class="btn btn-sm btn-outline-danger">Disconnect</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.SyncResult != null)
{
    <div class="alert alert-info">
        <strong>Sync Result:</strong> @Model.SyncResult
    </div>
}
