@page
@model MoneyTrackerApp.Pages.Shopping.IndexModel
@{
    ViewData["Title"] = "Danh sách Mua sắm";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold"><i class="fas fa-shopping-basket text-success me-2"></i>Danh sách Mua sắm</h2>
            <p class="text-muted">Lên kế hoạch mua sắm thông minh.</p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-success rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createListModal">
                <i class="fas fa-plus me-2"></i>Tạo danh sách
            </button>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var list in Model.Lists)
        {
            var totalItems = list.ShoppingItems.Count;
            var purchasedItems = list.ShoppingItems.Count(i => i.IsPurchased);
            var progress = totalItems > 0 ? (int)((double)purchasedItems / totalItems * 100) : 0;

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 hover:shadow-md transition-all">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title fw-bold">
                                <a href="/Shopping/Details?id=@list.Id" class="text-decoration-none text-dark stretched-link">@list.Name</a>
                            </h5>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@list.Id" onsubmit="return confirm('Xóa danh sách này?');" style="z-index: 10; position: relative;">
                                <button class="btn btn-link text-muted p-0 hover:text-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                        
                        <div class="d-flex justify-content-between text-xs text-muted mb-1">
                            <span>Đã mua: @purchasedItems/@totalItems</span>
                            <span>@progress%</span>
                        </div>
                        <div class="progress h-1.5 bg-slate-100 rounded-full">
                            <div class="progress-bar bg-success" style="width: @progress%"></div>
                        </div>

                        <div class="mt-3 text-end">
                             <small class="text-muted">@list.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @if (!Model.Lists.Any())
        {
             <div class="col-12 text-center py-5 text-muted">
                <i class="fas fa-clipboard-list text-4xl mb-3 opacity-25"></i>
                <p>Chưa có danh sách nào. Hãy tạo mới!</p>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="createListModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Tạo Danh sách Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Tên danh sách</label>
                <input asp-for="NewListName" class="form-control" placeholder="Ví dụ: Siêu thị cuối tuần" required />
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-success">Tạo</button>
            </div>
        </form>
    </div>
</div>
