@page
@model MoneyTrackerApp.Pages.Shopping.DetailsModel
@{
    ViewData["Title"] = Model.ShoppingList?.Name;
}

<div class="container py-4">
    <div class="mb-4">
        <a href="/Shopping/Index" class="text-decoration-none text-muted mb-2 d-inline-block"><i class="fas fa-arrow-left me-1"></i> Trở về</a>
        <h2 class="fw-bold">@Model.ShoppingList?.Name</h2>
        <p class="text-muted small">@Model.ShoppingList?.CreatedAt.ToString("D")</p>
    </div>

    <!-- Items -->
    <div class="card border-0 shadow-sm rounded-3xl mb-4">
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                @foreach (var item in Model.ShoppingList.ShoppingItems)
                {
                    <div class="list-group-item px-4 py-3 d-flex align-items-center justify-content-between hover:bg-slate-50">
                        <div class="d-flex align-items-center">
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@Model.ShoppingList.Id" asp-route-itemId="@item.Id" class="me-3">
                                <button class="btn p-0 @(item.IsPurchased ? "text-success" : "text-slate-300 hover:text-success")">
                                    <i class="fas @(item.IsPurchased ? "fa-check-circle" : "fa-circle") fa-lg"></i>
                                </button>
                            </form>
                            <div>
                                <span class="@(item.IsPurchased ? "text-decoration-line-through text-muted" : "fw-medium")">@item.Name</span>
                                @if (item.EstimatedPrice.HasValue)
                                {
                                    <small class="text-muted d-block text-xs">@item.EstimatedPrice.Value.ToString("N0") ₫</small>
                                }
                            </div>
                        </div>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.ShoppingList.Id" asp-route-itemId="@item.Id">
                             <button class="btn btn-sm text-slate-400 hover:text-danger"><i class="fas fa-times"></i></button>
                        </form>
                    </div>
                }
                
                <!-- Add Item Form inside List -->
                <div class="list-group-item px-4 py-3 bg-slate-50">
                    <form method="post" asp-page-handler="Add" asp-route-id="@Model.ShoppingList.Id" class="row g-2 align-items-center">
                        <div class="col-6">
                            <input asp-for="ItemName" class="form-control form-control-sm border-0 shadow-none bg-white" placeholder="+ Thêm món đồ..." required />
                        </div>
                        <div class="col-3">
                            <input asp-for="ItemPrice" type="number" class="form-control form-control-sm border-0 shadow-none bg-white" placeholder="Giá (tùy chọn)" />
                        </div>
                        <div class="col-3 text-end">
                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Thêm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
