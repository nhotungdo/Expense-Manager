@using MoneyTrackerApp.DTOs
@model List<TransactionResponseDto>

<div class="table-responsive">
    <table class="table table-hover align-middle custom-table">
        <thead class="bg-light text-secondary">
            <tr style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                <th class="border-0 rounded-start-2 py-3 ps-4" style="width: 20%;">Thời gian</th>
                <th class="border-0 py-3" style="width: 35%;">Mô tả</th>
                <th class="border-0 py-3" style="width: 20%;">Số tiền</th>
                <th class="border-0 py-3" style="width: 15%;">Trạng thái</th>
                <th class="border-0 rounded-end-2 py-3 text-center" style="width: 10%;">Hóa đơn</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var transaction in Model)
                {
                    <tr>
                        <td class="border-bottom-0 py-3 ps-4">
                            <span class="fw-bold d-block text-dark">@transaction.TransactionDate.ToString("dd/MM/yyyy")</span>
                            <small class="text-muted">@transaction.TransactionDate.ToString("HH:mm")</small>
                        </td>
                        <td class="border-bottom-0 py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-box-sm flex-shrink-0 me-3 d-flex align-items-center justify-content-center rounded-circle" 
                                     style="background-color: @(transaction.CategoryColor ?? "#f3f4f6"); color: white; width: 36px; height: 36px;">
                                     <span style="font-size: 1.1rem;">@(transaction.CategoryIcon ?? "📄")</span>
                                </div>
                                <div>
                                    <span class="fw-semibold text-dark d-block">@(transaction.CategoryName ?? "Giao dịch")</span>
                                    <small class="text-muted text-truncate d-block" style="max-width: 200px;">
                                        @(string.IsNullOrEmpty(transaction.Note) ? transaction.Description : transaction.Note)
                                    </small>
                                </div>
                            </div>
                        </td>
                        <td class="border-bottom-0 py-3">
                            @if (transaction.TransactionType == 1) // Income
                            {
                                <span class="fw-bold text-success">+@transaction.Amount.ToString("N0") @transaction.Currency</span>
                            }
                            else if (transaction.TransactionType == 2) // Expense
                            {
                                <span class="fw-bold text-danger">-@transaction.Amount.ToString("N0") @transaction.Currency</span>
                            }
                            else // Transfer
                            {
                                <span class="fw-bold text-primary">@transaction.Amount.ToString("N0") @transaction.Currency</span>
                            }
                        </td>
                        <td class="border-bottom-0 py-3">
                            <span class="badge bg-success-light text-success rounded-pill px-3 py-2 border border-success-subtle">
                                <i class="fas fa-check-circle me-1"></i> Thành công
                            </span>
                        </td>
                        <td class="border-bottom-0 py-3 text-center">
                            <button class="btn btn-sm btn-light rounded-circle text-muted hover-primary" title="Tải hóa đơn">
                                <i class="fas fa-download"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5 border-bottom-0">
                        <div class="py-4">
                            <i class="fas fa-inbox fa-3x text-muted mb-3 opacity-50"></i>
                            <p class="text-muted fw-medium">Chưa có giao dịch nào gần đây</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .custom-table tbody tr {
        transition: background-color 0.2s;
    }
    .custom-table tbody tr:hover {
        background-color: #f8fafc;
    }
    .hover-primary:hover {
        color: var(--primary) !important;
        background-color: rgba(79, 70, 229, 0.1) !important;
    }
    .bg-success-light {
        background-color: rgba(16, 185, 129, 0.1);
    }
</style>
