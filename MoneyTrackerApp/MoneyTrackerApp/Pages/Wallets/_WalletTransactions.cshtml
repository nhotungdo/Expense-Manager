@using MoneyTrackerApp.DTOs
@model List<TransactionResponseDto>

<div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="text-xs uppercase tracking-wider text-gray-400 border-b border-gray-100 dark:border-gray-700">
                <th class="py-3 pl-4 font-medium">Thời gian</th>
                <th class="py-3 font-medium">Mô tả</th>
                <th class="py-3 font-medium">Số tiền</th>
                <th class="py-3 font-medium">Trạng thái</th>
                <th class="py-3 pr-4 text-center font-medium">Hóa đơn</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            @if (Model != null && Model.Any())
            {
                foreach (var transaction in Model)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors group">
                        <td class="py-4 pl-4">
                            <span class="block font-bold text-gray-900 dark:text-white text-sm">@transaction.TransactionDate.ToString("dd/MM/yyyy")</span>
                            <small class="text-gray-500 dark:text-gray-400 text-xs">@transaction.TransactionDate.ToString("HH:mm")</small>
                        </td>
                        <td class="py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg shrink-0" 
                                     style="background-color: @(transaction.CategoryColor ?? "#f3f4f6"); color: #fff;">
                                     <span class="drop-shadow-sm">@(transaction.CategoryIcon ?? "📄")</span>
                                </div>
                                <div class="min-w-0">
                                    <span class="block font-semibold text-gray-900 dark:text-white text-sm truncate">@(transaction.CategoryName ?? "Giao dịch")</span>
                                    <div class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-[200px]">
                                        @(string.IsNullOrEmpty(transaction.Note) ? transaction.Description : transaction.Note)
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="py-4 font-mono font-medium">
                            @if (transaction.TransactionType == 1) // Income
                            {
                                <span class="text-emerald-600 dark:text-emerald-400">+@transaction.Amount.ToString("N0") @transaction.Currency</span>
                            }
                            else if (transaction.TransactionType == 2) // Expense
                            {
                                <span class="text-rose-600 dark:text-rose-400">-@transaction.Amount.ToString("N0") @transaction.Currency</span>
                            }
                            else // Transfer
                            {
                                <span class="text-blue-600 dark:text-blue-400">@transaction.Amount.ToString("N0") @transaction.Currency</span>
                            }
                        </td>
                        <td class="py-4">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-100 dark:border-emerald-800">
                                <i class="fas fa-check-circle"></i> Thành công
                            </span>
                        </td>
                        <td class="py-4 pr-4 text-center">
                            <button class="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors inline-flex items-center justify-center" title="Tải hóa đơn">
                                <i class="fas fa-download text-xs"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="py-12 text-center">
                        <div class="flex flex-col items-center justify-center">
                            <div class="w-16 h-16 bg-gray-50 dark:bg-gray-800 rounded-full flex items-center justify-center mb-3">
                                <i class="fas fa-inbox text-2xl text-gray-300 dark:text-gray-600"></i>
                            </div>
                            <p class="text-gray-500 dark:text-gray-400 font-medium text-sm">Chưa có giao dịch nào gần đây</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
