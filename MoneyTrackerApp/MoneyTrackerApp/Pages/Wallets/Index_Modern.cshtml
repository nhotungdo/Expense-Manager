@page
@model MoneyTrackerApp.Pages.Wallets.IndexModel
@{
    ViewData["Title"] = "My Wallets";
}

<!-- Modern Wallets Page -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">My Wallets</h1>
            <p class="text-slate-500 mt-1">Manage your accounts and track balances</p>
        </div>
        <button onclick="openAddWallet()" class="flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-xl font-semibold hover:shadow-lg hover:scale-105 transition-all">
            <i class="fas fa-plus"></i>
            <span>Add New Wallet</span>
        </button>
    </div>

    <!-- Wallet Cards Grid (Bank Card Style) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="walletsGrid">
        <!-- Wallet Card 1 - Gradient Blue -->
        <div class="relative group">
            <div class="wallet-card bg-gradient-to-br from-blue-500 via-blue-600 to-indigo-700 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer">
                <!-- Card Header -->
                <div class="flex items-start justify-between mb-8">
                    <div>
                        <p class="text-blue-100 text-sm font-medium">Main Wallet</p>
                        <p class="text-xs text-blue-200 mt-1">Checking Account</p>
                    </div>
                    <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                        <i class="fas fa-university text-xl"></i>
                    </div>
                </div>

                <!-- Chip Decoration -->
                <div class="mb-8">
                    <div class="w-12 h-10 bg-gradient-to-br from-yellow-300 to-yellow-500 rounded-lg opacity-80"></div>
                </div>

                <!-- Card Number (Masked) -->
                <div class="mb-6">
                    <p class="text-sm font-mono tracking-wider">**** **** **** 1234</p>
                </div>

                <!-- Balance -->
                <div>
                    <p class="text-blue-100 text-xs mb-1">Current Balance</p>
                    <h3 class="text-3xl font-bold">$12,450.00</h3>
                </div>
            </div>

            <!-- Hover Overlay Actions -->
            <div class="absolute inset-0 bg-black/60 backdrop-blur-sm rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3">
                <button class="px-4 py-2 bg-white text-slate-900 rounded-lg font-semibold hover:bg-slate-100 transition-colors">
                    <i class="fas fa-edit mr-2"></i>Edit
                </button>
                <button class="px-4 py-2 bg-white text-slate-900 rounded-lg font-semibold hover:bg-slate-100 transition-colors">
                    <i class="fas fa-history mr-2"></i>View History
                </button>
            </div>
        </div>

        <!-- Wallet Card 2 - Gradient Purple -->
        <div class="relative group">
            <div class="wallet-card bg-gradient-to-br from-purple-500 via-purple-600 to-pink-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer">
                <div class="flex items-start justify-between mb-8">
                    <div>
                        <p class="text-purple-100 text-sm font-medium">Savings Account</p>
                        <p class="text-xs text-purple-200 mt-1">High Yield Savings</p>
                    </div>
                    <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                        <i class="fas fa-piggy-bank text-xl"></i>
                    </div>
                </div>

                <div class="mb-8">
                    <div class="w-12 h-10 bg-gradient-to-br from-yellow-300 to-yellow-500 rounded-lg opacity-80"></div>
                </div>

                <div class="mb-6">
                    <p class="text-sm font-mono tracking-wider">**** **** **** 5678</p>
                </div>

                <div>
                    <p class="text-purple-100 text-xs mb-1">Current Balance</p>
                    <h3 class="text-3xl font-bold">$8,750.50</h3>
                </div>
            </div>

            <div class="absolute inset-0 bg-black/60 backdrop-blur-sm rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3">
                <button class="px-4 py-2 bg-white text-slate-900 rounded-lg font-semibold hover:bg-slate-100 transition-colors">
                    <i class="fas fa-edit mr-2"></i>Edit
                </button>
                <button class="px-4 py-2 bg-white text-slate-900 rounded-lg font-semibold hover:bg-slate-100 transition-colors">
                    <i class="fas fa-history mr-2"></i>View History
                </button>
            </div>
        </div>

        <!-- Wallet Card 3 - Gradient Green -->
        <div class="relative group">
            <div class="wallet-card bg-gradient-to-br from-emerald-500 via-green-600 to-teal-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer">
                <div class="flex items-start justify-between mb-8">
                    <div>
                        <p class="text-emerald-100 text-sm font-medium">Cash Wallet</p>
                        <p class="text-xs text-emerald-200 mt-1">Physical Cash</p>
                    </div>
                    <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                        <i class="fas fa-wallet text-xl"></i>
                    </div>
                </div>

                <div class="mb-8">
                    <div class="w-12 h-10 bg-gradient-to-br from-yellow-300 to-yellow-500 rounded-lg opacity-80"></div>
                </div>

                <div class="mb-6">
                    <p class="text-sm font-mono tracking-wider">**** **** **** 9012</p>
                </div>

                <div>
                    <p class="text-emerald-100 text-xs mb-1">Current Balance</p>
                    <h3 class="text-3xl font-bold">$1,250.00</h3>
                </div>
            </div>

            <div class="absolute inset-0 bg-black/60 backdrop-blur-sm rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3">
                <button class="px-4 py-2 bg-white text-slate-900 rounded-lg font-semibold hover:bg-slate-100 transition-colors">
                    <i class="fas fa-edit mr-2"></i>Edit
                </button>
                <button class="px-4 py-2 bg-white text-slate-900 rounded-lg font-semibold hover:bg-slate-100 transition-colors">
                    <i class="fas fa-history mr-2"></i>View History
                </button>
            </div>
        </div>

        <!-- Add New Wallet Card (Dashed Border) -->
        <div class="border-2 border-dashed border-slate-300 rounded-2xl p-6 flex flex-col items-center justify-center min-h-[280px] hover:border-blue-500 hover:bg-blue-50 transition-all cursor-pointer group" onclick="openAddWallet()">
            <div class="w-16 h-16 bg-slate-100 group-hover:bg-blue-100 rounded-full flex items-center justify-center mb-4 transition-colors">
                <i class="fas fa-plus text-2xl text-slate-400 group-hover:text-blue-600"></i>
            </div>
            <h3 class="text-lg font-semibold text-slate-700 group-hover:text-blue-600 transition-colors">Add New Wallet</h3>
            <p class="text-sm text-slate-500 mt-2 text-center">Create a new account to track</p>
        </div>
    </div>

    <!-- Wallet Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Total Assets -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-slate-900">Total Assets</h3>
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-chart-line text-blue-600"></i>
                </div>
            </div>
            <h2 class="text-4xl font-bold text-slate-900 mb-2">$22,450.50</h2>
            <p class="text-sm text-emerald-600 font-semibold">
                <i class="fas fa-arrow-up"></i> +5.2% from last month
            </p>
            <div class="mt-6 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-600">Checking Accounts</span>
                    <span class="text-sm font-semibold text-slate-900">$12,450.00</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-600">Savings Accounts</span>
                    <span class="text-sm font-semibold text-slate-900">$8,750.50</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-600">Cash</span>
                    <span class="text-sm font-semibold text-slate-900">$1,250.00</span>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-slate-900">Recent Activity</h3>
                <a href="/Transactions" class="text-sm text-blue-600 hover:text-blue-700 font-semibold">View All</a>
            </div>
            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-arrow-down text-emerald-600"></i>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm font-semibold text-slate-900">Salary Deposit</p>
                        <p class="text-xs text-slate-500">Main Wallet • Today</p>
                    </div>
                    <span class="text-sm font-bold text-emerald-600">+$3,500</span>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-arrow-up text-red-600"></i>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm font-semibold text-slate-900">Rent Payment</p>
                        <p class="text-xs text-slate-500">Main Wallet • Yesterday</p>
                    </div>
                    <span class="text-sm font-bold text-red-600">-$1,200</span>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-exchange-alt text-blue-600"></i>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm font-semibold text-slate-900">Transfer to Savings</p>
                        <p class="text-xs text-slate-500">Main → Savings • 2 days ago</p>
                    </div>
                    <span class="text-sm font-bold text-blue-600">$500</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/wallets.js"></script>
}
