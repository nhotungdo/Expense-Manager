@page
@model MoneyTrackerApp.Pages.Wallets.IndexModel
@{
    ViewData["Title"] = "Ví của tôi";
}

<div class="wallets-page modern-page">
    <!-- Hero Balance Section -->
    <div class="balance-hero">
        <div class="balance-hero-content">
            <div class="balance-header">
                <div>
                    <p class="balance-label">
                        <i class="fas fa-wallet"></i>
                        Tổng tài sản
                    </p>
                    <h1 class="balance-amount" id="totalBalance">
                        <span class="amount-value">0</span>
                        <span class="currency">₫</span>
                    </h1>
                    <div class="balance-change">
                        <span class="change-badge positive" id="balanceChange">
                            <i class="fas fa-arrow-up"></i>
                            +2.5% so với tháng trước
                        </span>
                    </div>
                </div>
                <div class="balance-actions">
                    <button class="action-btn transfer" onclick="openTransfer()">
                        <div class="action-icon">
                            <i class="fas fa-exchange-alt"></i>
                        </div>
                        <span>Chuyển tiền</span>
                    </button>
                    <button class="action-btn receive" onclick="openReceive()">
                        <div class="action-icon">
                            <i class="fas fa-arrow-down"></i>
                        </div>
                        <span>Nhận tiền</span>
                    </button>
                    <button class="action-btn scan" onclick="openScan()">
                        <div class="action-icon">
                            <i class="fas fa-qrcode"></i>
                        </div>
                        <span>Quét mã</span>
                    </button>
                </div>
            </div>
            
            <div class="balance-chart-container">
                <canvas id="balanceDistributionChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="quick-stats">
        <div class="stat-card income">
            <div class="stat-icon">
                <i class="fas fa-arrow-down"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Thu nhập tháng này</p>
                <h3 class="stat-value" id="monthlyIncome">0 ₫</h3>
            </div>
        </div>
        <div class="stat-card expense">
            <div class="stat-icon">
                <i class="fas fa-arrow-up"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Chi tiêu tháng này</p>
                <h3 class="stat-value" id="monthlyExpense">0 ₫</h3>
            </div>
        </div>
        <div class="stat-card accounts">
            <div class="stat-icon">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Tài khoản</p>
                <h3 class="stat-value" id="accountCount">0</h3>
            </div>
        </div>
    </div>

    <!-- Section Header -->
    <div class="section-header">
        <div>
            <h2 class="section-title">Tài khoản của bạn</h2>
            <p class="section-subtitle">Quản lý tất cả tài khoản và ví</p>
        </div>
        <div class="section-actions">
            <button class="btn btn-outline btn-sm" onclick="connectBank()">
                <i class="fas fa-link"></i>
                Liên kết ngân hàng
            </button>
            <button class="btn btn-primary btn-sm" onclick="openAddAccount()">
                <i class="fas fa-plus"></i>
                Thêm tài khoản
            </button>
        </div>
    </div>

    <!-- Account Type Filter -->
    <div class="filter-chips">
        <button class="chip active" data-type="all" onclick="filterByType('all')">
            <i class="fas fa-th"></i>
            Tất cả
        </button>
        <button class="chip" data-type="cash" onclick="filterByType('cash')">
            <i class="fas fa-money-bill-wave"></i>
            Tiền mặt
        </button>
        <button class="chip" data-type="bank" onclick="filterByType('bank')">
            <i class="fas fa-university"></i>
            Ngân hàng
        </button>
        <button class="chip" data-type="ewallet" onclick="filterByType('ewallet')">
            <i class="fas fa-wallet"></i>
            Ví điện tử
        </button>
        <button class="chip" data-type="credit" onclick="filterByType('credit')">
            <i class="fas fa-credit-card"></i>
            Thẻ tín dụng
        </button>
        <button class="chip" data-type="investment" onclick="filterByType('investment')">
            <i class="fas fa-chart-line"></i>
            Đầu tư
        </button>
    </div>

    <!-- Accounts Grid -->
    <div class="accounts-grid" id="accountsGrid">
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Đang tải tài khoản...</p>
        </div>
    </div>
</div>

<!-- Add/Edit Account Modal -->
<div class="modal fade" id="accountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm tài khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="accountForm">
                    <div class="form-group">
                        <label>Tên tài khoản *</label>
                        <input type="text" class="form-control" id="accountName" required>
                    </div>

                    <div class="form-group">
                        <label>Loại tài khoản *</label>
                        <select class="form-select" id="accountType" required>
                            <option value="Cash">Tiền mặt</option>
                            <option value="Bank">Ngân hàng</option>
                            <option value="EWallet">Ví điện tử</option>
                            <option value="Credit">Thẻ tín dụng</option>
                            <option value="Investment">Đầu tư</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Số dư hiện tại *</label>
                        <div class="input-with-icon">
                            <span class="currency-symbol">₫</span>
                            <input type="number" class="form-control amount-input" id="currentBalance" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Tiền tệ</label>
                        <select class="form-select" id="currency">
                            <option value="VND">VND - Việt Nam Đồng</option>
                            <option value="USD">USD - US Dollar</option>
                            <option value="EUR">EUR - Euro</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Biểu tượng</label>
                        <div class="icon-selector" id="iconSelector">
                            <button type="button" class="icon-btn active" data-icon="fas fa-wallet">
                                <i class="fas fa-wallet"></i>
                            </button>
                            <button type="button" class="icon-btn" data-icon="fas fa-university">
                                <i class="fas fa-university"></i>
                            </button>
                            <button type="button" class="icon-btn" data-icon="fas fa-credit-card">
                                <i class="fas fa-credit-card"></i>
                            </button>
                            <button type="button" class="icon-btn" data-icon="fas fa-money-bill-wave">
                                <i class="fas fa-money-bill-wave"></i>
                            </button>
                            <button type="button" class="icon-btn" data-icon="fas fa-piggy-bank">
                                <i class="fas fa-piggy-bank"></i>
                            </button>
                        </div>
                        <input type="hidden" id="icon" value="fas fa-wallet">
                    </div>

                    <div class="form-group">
                        <label>Màu sắc</label>
                        <div class="color-selector" id="colorSelector">
                            <button type="button" class="color-btn active" data-color="#22c55e" style="background: #22c55e;"></button>
                            <button type="button" class="color-btn" data-color="#3b82f6" style="background: #3b82f6;"></button>
                            <button type="button" class="color-btn" data-color="#8b5cf6" style="background: #8b5cf6;"></button>
                            <button type="button" class="color-btn" data-color="#ef4444" style="background: #ef4444;"></button>
                            <button type="button" class="color-btn" data-color="#f59e0b" style="background: #f59e0b;"></button>
                            <button type="button" class="color-btn" data-color="#ec4899" style="background: #ec4899;"></button>
                        </div>
                        <input type="hidden" id="color" value="#22c55e">
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="includeInTotal" checked>
                        <label class="form-check-label" for="includeInTotal">
                            Tính vào tổng số dư
                        </label>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="isActive" checked>
                        <label class="form-check-label" for="isActive">
                            Kích hoạt
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveAccount()">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/wallets.css">
    <script src="~/js/wallets.js"></script>
}
