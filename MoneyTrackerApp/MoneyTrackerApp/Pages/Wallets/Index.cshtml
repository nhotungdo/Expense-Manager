@page
@model MoneyTrackerApp.Pages.Wallets.IndexModel
@{
    ViewData["Title"] = "Ví của tôi";
}

<!-- My Wallet Page - Redesigned -->
<div class="wallet-page">
    <div class="bento-grid">
        <!-- Header Section -->
        <div class="page-header bento-col-span-12">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-wallet"></i> Ví của tôi
                </h1>
                <p class="page-subtitle">Quản lý tài khoản và theo dõi số dư của bạn</p>
            </div>
            <div class="header-actions">
                <button class="btn-filter" id="periodFilter">
                    <i class="far fa-calendar"></i>
                    <span id="selectedPeriod">Tháng này</span>
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
        </div>

        <!-- Balance Overview Card -->
        <div class="balance-overview-card bento-col-span-8">
            <div class="balance-gradient-bg"></div>
            <div class="balance-content">
                <div class="balance-main">
                    <div class="balance-info">
                        <span class="balance-label">
                            <i class="fas fa-coins"></i> Tổng số dư
                        </span>
                        <h2 class="balance-amount" id="totalBalance">
                            @Model.TotalBalance.ToString("N0") <span class="currency">VND</span>
                        </h2>
                        <div class="balance-change positive">
                            <i class="fas fa-arrow-up"></i>
                            <span>+12.5% so với tháng trước</span>
                        </div>
                    </div>
                    
                    <div class="quick-actions">
                        <button class="action-btn deposit" onclick="openTransactionModal(1)">
                            <div class="action-icon">
                                <i class="fas fa-plus"></i>
                            </div>
                            <span>Nạp tiền</span>
                        </button>
                        <button class="action-btn withdraw" onclick="openTransactionModal(2)">
                            <div class="action-icon">
                                <i class="fas fa-minus"></i>
                            </div>
                            <span>Rút tiền</span>
                        </button>
                        <button class="action-btn transfer" onclick="openTransactionModal(3)">
                            <div class="action-icon">
                                <i class="fas fa-exchange-alt"></i>
                            </div>
                            <span>Chuyển khoản</span>
                        </button>
                    </div>
                </div>

                <!-- Balance Distribution Chart -->
                <div class="balance-chart-section">
                    <h6 class="chart-title">Phân bổ số dư</h6>
                    <div class="chart-container">
                        <canvas id="balanceDistributionChart"></canvas>
                    </div>
                    <div id="chartLegend" class="chart-legend"></div>
                </div>
            </div>
        </div>

        <!-- Accounts Section -->
        <div class="accounts-section bento-col-span-4">
            <div class="section-header">
                <h5 class="section-title">
                    <i class="fas fa-credit-card"></i> Tài khoản của tôi
                </h5>
                <button class="btn-add" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                    <i class="fas fa-plus"></i> Thêm tài khoản
                </button>
            </div>

            <div class="accounts-grid">
                @if (Model.Wallets != null && Model.Wallets.Any())
                {
                    foreach (var wallet in Model.Wallets)
                    {
                        <div class="account-card" data-account-id="@wallet.Id">
                            <div class="account-header">
                                <div class="account-icon">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <div class="account-menu">
                                    <button class="menu-btn">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="account-info">
                                <h6 class="account-name">@wallet.Name</h6>
                                <p class="account-type">@wallet.AccountType</p>
                            </div>
                            <div class="account-balance">
                                <span class="balance-label">Số dư</span>
                                <span class="balance-value">@wallet.CurrentBalance.ToString("N0") VND</span>
                            </div>
                            <div class="account-footer">
                                <span class="account-status active">
                                    <i class="fas fa-check-circle"></i> Hoạt động
                                </span>
                            </div>
                        </div>
                    }
                }
                
                <!-- Add New Account Card -->
                <div class="account-card add-new" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                    <div class="add-icon">
                        <i class="fas fa-plus"></i>
                    </div>
                    <h6>Thêm tài khoản mới</h6>
                    <p>Liên kết tài khoản ngân hàng hoặc ví</p>
                </div>
            </div>
        </div>

        <!-- Transaction Analysis Cards -->
        <!-- Transaction Type Breakdown -->
        <div class="analysis-card bento-col-span-6">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-chart-pie"></i> Loại giao dịch
                </h5>
                <select class="period-select" id="transactionTypePeriod">
                    <option value="month">Tháng này</option>
                    <option value="week">Tuần này</option>
                    <option value="year">Năm nay</option>
                </select>
            </div>
            <div class="chart-wrapper">
                <canvas id="transactionTypeChart"></canvas>
            </div>
            <div class="stats-summary">
                <div class="stat-item income">
                    <span class="stat-label">Thu nhập</span>
                    <span class="stat-value" id="incomeAmount">0</span>
                </div>
                <div class="stat-item expense">
                    <span class="stat-label">Chi tiêu</span>
                    <span class="stat-value" id="expenseAmount">0</span>
                </div>
            </div>
        </div>

        <!-- Category Breakdown -->
        <div class="analysis-card bento-col-span-6">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-layer-group"></i> Chi tiêu theo danh mục
                </h5>
                <select class="period-select" id="categoryPeriod">
                    <option value="month">Tháng này</option>
                    <option value="week">Tuần này</option>
                    <option value="year">Năm nay</option>
                </select>
            </div>
            <div class="chart-wrapper">
                <canvas id="categoryBreakdownChart"></canvas>
            </div>
            <div class="category-list" id="categoryList">
                <!-- Dynamic category items -->
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class="transactions-section bento-col-span-12">
            <div class="section-header">
                <h5 class="section-title">
                    <i class="fas fa-history"></i> Giao dịch gần đây
                </h5>
                <a href="/Transactions" class="btn-view-all">
                    Xem tất cả <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="transactions-list" id="recentTransactions">
                <!-- Dynamic transaction items -->
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
@await Html.PartialAsync("_WalletModals")

@section Styles {
    <link rel="stylesheet" href="~/css/wallet-page.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/wallet-page.js" asp-append-version="true"></script>
}
