@page
@model MoneyTrackerApp.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<div class="container py-4">
    <div class="row">
        <!-- Sidebar / Tabs -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="position-relative d-inline-block mb-3">
                        <img id="profileAvatar" src="/uploads/profiles/default.png" class="rounded-circle img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" alt="User Avatar">
                        <button class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle" onclick="document.getElementById('avatarUpload').click()">
                            <i class="bi bi-camera">📷</i>
                        </button>
                        <input type="file" id="avatarUpload" hidden accept="image/*" onchange="uploadAvatar(this)">
                    </div>
                    <h5 class="card-title mb-1" id="profileName">Đang tải...</h5>
                    <p class="text-muted small mb-3" id="profileEmail">đang tải...</p>
                </div>
                <div class="list-group list-group-flush">
                    <a href="#general" class="list-group-item list-group-item-action active" data-bs-toggle="list">
                        <i class="bi bi-person me-2">👤</i> Thông tin chung
                    </a>
                    <a href="#security" class="list-group-item list-group-item-action" data-bs-toggle="list">
                        <i class="bi bi-shield-lock me-2">🔒</i> Bảo mật
                    </a>
                    <a href="#sessions" class="list-group-item list-group-item-action" data-bs-toggle="list">
                        <i class="bi bi-laptop me-2">💻</i> Phiên hoạt động
                    </a>
                    <a href="#subscription" class="list-group-item list-group-item-action" data-bs-toggle="list">
                        <i class="bi bi-crown me-2">👑</i> Gói dịch vụ
                    </a>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="col-md-9">
            <div class="tab-content">
                <!-- General Information Tab -->
                <div class="tab-pane fade show active" id="general">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Thông tin chung</h5>
                        </div>
                        <div class="card-body">
                            <form id="profileForm" onsubmit="updateProfile(event)">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Họ tên</label>
                                        <input type="text" class="form-control" id="fullName" name="fullName">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Số điện thoại</label>
                                        <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber">
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Ngày sinh</label>
                                        <input type="date" class="form-control" id="dateOfBirth" name="dateOfBirth">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Giới tính</label>
                                        <select class="form-select" id="gender" name="gender">
                                            <option value="">Chọn giới tính</option>
                                            <option value="Male">Nam</option>
                                            <option value="Female">Nữ</option>
                                            <option value="Other">Khác</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Địa chỉ</label>
                                    <textarea class="form-control" id="address" name="address" rows="2"></textarea>
                                </div>
                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Security Tab -->
                <div class="tab-pane fade" id="security">
                    <!-- Change Password -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Đổi mật khẩu</h5>
                        </div>
                        <div class="card-body">
                            <form id="passwordForm" onsubmit="changePassword(event)">
                                <div class="mb-3">
                                    <label class="form-label">Mật khẩu hiện tại</label>
                                    <input type="password" class="form-control" id="currentPassword" required>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Mật khẩu mới</label>
                                        <input type="password" class="form-control" id="newPassword" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Xác nhận mật khẩu mới</label>
                                        <input type="password" class="form-control" id="confirmPassword" required>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <button type="submit" class="btn btn-warning">Cập nhật mật khẩu</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Two-Factor Authentication -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Xác thực hai yếu tố (2FA)</h5>
                            <span id="2faStatus" class="badge bg-secondary">Đang tải...</span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Thêm một lớp bảo mật cho tài khoản của bạn bằng cách bật 2FA.</p>
                            <div id="2faActions">
                                <button class="btn btn-outline-primary" onclick="enable2FA()">Bật 2FA</button>
                            </div>
                            
                            <!-- 2FA Setup Modal -->
                            <div id="2faSetupArea" class="d-none mt-3 p-3 border rounded bg-light">
                                <h6>Quét mã QR</h6>
                                <p class="small text-muted">Sử dụng ứng dụng xác thực (Google Authenticator, Authy) để quét mã này.</p>
                                <div class="text-center mb-3">
                                    <img id="qrCodeImage" src="" alt="QR Code" class="img-fluid border p-2 bg-white">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nhập mã xác thực</label>
                                    <input type="text" class="form-control" id="verifyCode" placeholder="000000" maxlength="6">
                                </div>
                                <button class="btn btn-success w-100" onclick="verify2FA()">Xác thực & Bật</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sessions Tab -->
                <div class="tab-pane fade" id="sessions">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Phiên hoạt động</h5>
                            <button class="btn btn-sm btn-outline-danger" onclick="revokeAllSessions()">Thu hồi tất cả các phiên khác</button>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush" id="sessionsList">
                                <div class="text-center p-4">Đang tải phiên...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Subscription Tab -->
                <div class="tab-pane fade" id="subscription">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Gói dịch vụ hiện tại</h5>
                        </div>
                        <div class="card-body">
                            <div id="subscriptionLoading" class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-3 text-muted">Đang tải thông tin gói dịch vụ...</p>
                            </div>
                            
                            <div id="subscriptionContent" class="d-none">
                                <!-- Active Subscription -->
                                <div id="activeSubscription" class="d-none">
                                    <div class="row align-items-center mb-4">
                                        <div class="col-md-8">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="subscription-icon">
                                                    <i class="fas fa-crown" style="font-size: 2.5rem; color: #f59e0b;"></i>
                                                </div>
                                                <div>
                                                    <h3 class="mb-1" id="packageName">-</h3>
                                                    <p class="text-muted mb-0" id="packageDescription">-</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 text-md-end">
                                            <div class="badge bg-success px-3 py-2 fs-6" id="subscriptionStatus">Đang hoạt động</div>
                                        </div>
                                    </div>

                                    <div class="row mb-4">
                                        <div class="col-md-4">
                                            <div class="p-3 bg-light rounded">
                                                <small class="text-muted d-block mb-1">Giá gói</small>
                                                <h5 class="mb-0" id="packagePrice">-</h5>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-3 bg-light rounded">
                                                <small class="text-muted d-block mb-1">Ngày bắt đầu</small>
                                                <h6 class="mb-0" id="startDate">-</h6>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-3 bg-light rounded">
                                                <small class="text-muted d-block mb-1">Ngày hết hạn</small>
                                                <h6 class="mb-0" id="endDate">-</h6>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <h6 class="mb-3">Tính năng của gói</h6>
                                        <div class="row g-2" id="packageFeatures">
                                            <!-- Features will be loaded here -->
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="/ServicePackages" class="btn btn-primary">
                                            <i class="fas fa-arrow-up"></i> Nâng cấp gói
                                        </a>
                                        <button class="btn btn-outline-danger" onclick="cancelSubscription()">
                                            <i class="fas fa-times"></i> Hủy gói
                                        </button>
                                    </div>
                                </div>

                                <!-- No Subscription -->
                                <div id="noSubscription" class="d-none text-center py-5">
                                    <i class="fas fa-box-open" style="font-size: 4rem; color: #cbd5e1;"></i>
                                    <h4 class="mt-3 mb-2">Chưa có gói dịch vụ</h4>
                                    <p class="text-muted mb-4">Bạn đang sử dụng gói miễn phí với tính năng cơ bản</p>
                                    <a href="/ServicePackages" class="btn btn-primary">
                                        <i class="fas fa-crown"></i> Nâng cấp ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container for Notifications -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Thông báo</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage"></div>
    </div>
</div>

@section Scripts {
    <script>
        // Load Profile Data
        async function loadProfile() {
            try {
                const response = await fetch('/api/profile');
                if (response.ok) {
                    const data = await response.json();
                    document.getElementById('profileName').textContent = data.fullName || data.userName;
                    document.getElementById('profileEmail').textContent = data.email;
                    if (data.profilePictureUrl) {
                        document.getElementById('profileAvatar').src = data.profilePictureUrl;
                    }
                    
                    // Fill form
                    document.getElementById('fullName').value = data.fullName || '';
                    document.getElementById('phoneNumber').value = data.phoneNumber || '';
                    if (data.dateOfBirth) {
                        document.getElementById('dateOfBirth').value = data.dateOfBirth.split('T')[0];
                    }
                    document.getElementById('gender').value = data.gender || '';
                    document.getElementById('address').value = data.address || '';
                }
            } catch (error) {
                console.error('Error loading profile:', error);
            }
        }

        // Update Profile
        async function updateProfile(e) {
            e.preventDefault();
            const formData = {
                fullName: document.getElementById('fullName').value,
                phoneNumber: document.getElementById('phoneNumber').value,
                dateOfBirth: document.getElementById('dateOfBirth').value,
                gender: document.getElementById('gender').value,
                address: document.getElementById('address').value
            };

            try {
                const response = await fetch('/api/profile', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
                    showToast('Cập nhật hồ sơ thành công!', 'success');
                    loadProfile(); // Refresh UI
                } else {
                    showToast('Không thể cập nhật hồ sơ.', 'danger');
                }
            } catch (error) {
                showToast('Lỗi cập nhật hồ sơ.', 'danger');
            }
        }

        // Upload Avatar
        async function uploadAvatar(input) {
            if (input.files && input.files[0]) {
                const formData = new FormData();
                formData.append('file', input.files[0]);

                try {
                    const response = await fetch('/api/profile/picture', {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        const data = await response.json();
                        document.getElementById('profileAvatar').src = data.url;
                        showToast('Đã cập nhật ảnh đại diện!', 'success');
                    } else {
                        showToast('Không thể tải lên ảnh.', 'danger');
                    }
                } catch (error) {
                    showToast('Lỗi tải lên ảnh.', 'danger');
                }
            }
        }

        // Change Password
        async function changePassword(e) {
            e.preventDefault();
            const currentPassword = document.getElementById('currentPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (newPassword !== confirmPassword) {
                showToast('Mật khẩu mới không khớp.', 'warning');
                return;
            }

            try {
                const response = await fetch('/api/profile/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword, newPassword, confirmNewPassword: confirmPassword })
                });

                if (response.ok) {
                    showToast('Đổi mật khẩu thành công!', 'success');
                    document.getElementById('passwordForm').reset();
                } else {
                    const data = await response.json();
                    showToast(data.message || 'Không thể đổi mật khẩu.', 'danger');
                }
            } catch (error) {
                showToast('Lỗi đổi mật khẩu.', 'danger');
            }
        }

        // Load 2FA Status
        async function load2FAStatus() {
            try {
                const response = await fetch('/api/security/2fa/status');
                if (response.ok) {
                    const data = await response.json();
                    const statusBadge = document.getElementById('2faStatus');
                    const actionsDiv = document.getElementById('2faActions');
                    
                    if (data.enabled) {
                        statusBadge.className = 'badge bg-success';
                        statusBadge.textContent = 'Đã bật';
                        actionsDiv.innerHTML = '<button class="btn btn-outline-danger" onclick="disable2FA()">Tắt 2FA</button>';
                    } else {
                        statusBadge.className = 'badge bg-secondary';
                        statusBadge.textContent = 'Đã tắt';
                        actionsDiv.innerHTML = '<button class="btn btn-outline-primary" onclick="enable2FA()">Bật 2FA</button>';
                    }
                }
            } catch (error) {
                console.error('Error loading 2FA status:', error);
            }
        }

        // Enable 2FA
        async function enable2FA() {
            try {
                const response = await fetch('/api/security/2fa/enable', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ method: 'totp' })
                });

                if (response.ok) {
                    const data = await response.json();
                    document.getElementById('qrCodeImage').src = data.qrCodeUrl;
                    document.getElementById('2faSetupArea').classList.remove('d-none');
                    document.getElementById('2faActions').classList.add('d-none');
                }
            } catch (error) {
                showToast('Lỗi bắt đầu thiết lập 2FA.', 'danger');
            }
        }

        // Verify 2FA
        async function verify2FA() {
            const code = document.getElementById('verifyCode').value;
            try {
                const response = await fetch('/api/security/2fa/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });

                if (response.ok) {
                    showToast('Đã bật 2FA thành công!', 'success');
                    document.getElementById('2faSetupArea').classList.add('d-none');
                    document.getElementById('2faActions').classList.remove('d-none');
                    load2FAStatus();
                } else {
                    showToast('Mã xác thực không hợp lệ.', 'warning');
                }
            } catch (error) {
                showToast('Lỗi xác thực mã.', 'danger');
            }
        }

        // Disable 2FA
        async function disable2FA() {
            const password = prompt("Vui lòng nhập mật khẩu để tắt 2FA:");
            if (!password) return;

            try {
                const response = await fetch('/api/security/2fa/disable', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password })
                });

                if (response.ok) {
                    showToast('Đã tắt 2FA thành công.', 'success');
                    load2FAStatus();
                } else {
                    showToast('Không thể tắt 2FA. Kiểm tra lại mật khẩu.', 'danger');
                }
            } catch (error) {
                showToast('Lỗi tắt 2FA.', 'danger');
            }
        }

        // Load Sessions
        async function loadSessions() {
            try {
                const response = await fetch('/api/security/sessions');
                if (response.ok) {
                    const sessions = await response.json();
                    const list = document.getElementById('sessionsList');
                    list.innerHTML = '';

                    if (sessions.length === 0) {
                        list.innerHTML = '<div class="text-center p-4 text-muted">Không tìm thấy phiên hoạt động nào.</div>';
                        return;
                    }

                    sessions.forEach(session => {
                        const item = document.createElement('div');
                        item.className = 'list-group-item d-flex justify-content-between align-items-center';
                        item.innerHTML = `
                            <div>
                                <div class="fw-bold">${session.deviceInfo}</div>
                                <small class="text-muted">Hoạt động lần cuối: ${new Date(session.lastUsed).toLocaleString('vi-VN')}</small>
                                ${session.isCurrent ? '<span class="badge bg-info ms-2">Hiện tại</span>' : ''}
                            </div>
                            ${!session.isCurrent ? `<button class="btn btn-sm btn-outline-danger" onclick="revokeSession('${session.id}')">Thu hồi</button>` : ''}
                        `;
                        list.appendChild(item);
                    });
                }
            } catch (error) {
                console.error('Error loading sessions:', error);
            }
        }

        // Revoke Session
        async function revokeSession(deviceId) {
            if (!confirm('Bạn có chắc chắn muốn thu hồi phiên này không?')) return;
            try {
                const response = await fetch(`/api/security/sessions/${deviceId}`, { method: 'DELETE' });
                if (response.ok) {
                    showToast('Đã thu hồi phiên.', 'success');
                    loadSessions();
                }
            } catch (error) {
                showToast('Lỗi thu hồi phiên.', 'danger');
            }
        }

        // Revoke All Sessions
        async function revokeAllSessions() {
            if (!confirm('Bạn có chắc chắn muốn đăng xuất khỏi tất cả các thiết bị khác không?')) return;
            try {
                const response = await fetch('/api/security/sessions/revoke-all', { method: 'POST' });
                if (response.ok) {
                    showToast('Đã thu hồi tất cả các phiên khác.', 'success');
                    loadSessions();
                }
            } catch (error) {
                showToast('Lỗi thu hồi các phiên.', 'danger');
            }
        }

        // Load Subscription Info
        async function loadSubscription() {
            const loadingEl = document.getElementById('subscriptionLoading');
            const contentEl = document.getElementById('subscriptionContent');
            const activeEl = document.getElementById('activeSubscription');
            const noSubEl = document.getElementById('noSubscription');

            try {
                const response = await fetch('/api/Subscription/my-subscription');
                
                loadingEl.classList.add('d-none');
                contentEl.classList.remove('d-none');

                if (response.status === 404 || !response.ok) {
                    // No active subscription
                    noSubEl.classList.remove('d-none');
                    activeEl.classList.add('d-none');
                    return;
                }

                const subscription = await response.json();
                
                // Show active subscription
                activeEl.classList.remove('d-none');
                noSubEl.classList.add('d-none');

                // Populate subscription details
                document.getElementById('packageName').textContent = subscription.packageName || '-';
                document.getElementById('packageDescription').textContent = subscription.packageDescription || 'Gói dịch vụ cao cấp';
                
                // Format price
                const price = subscription.price || 0;
                document.getElementById('packagePrice').textContent = price === 0 ? 'Miễn phí' : `${price.toLocaleString('vi-VN')} ₫`;
                
                // Format dates
                if (subscription.startDate) {
                    document.getElementById('startDate').textContent = new Date(subscription.startDate).toLocaleDateString('vi-VN');
                }
                if (subscription.endDate) {
                    document.getElementById('endDate').textContent = new Date(subscription.endDate).toLocaleDateString('vi-VN');
                }

                // Update status badge
                const statusBadge = document.getElementById('subscriptionStatus');
                if (subscription.status === 'Active') {
                    statusBadge.className = 'badge bg-success px-3 py-2 fs-6';
                    statusBadge.textContent = 'Đang hoạt động';
                } else if (subscription.status === 'Expired') {
                    statusBadge.className = 'badge bg-danger px-3 py-2 fs-6';
                    statusBadge.textContent = 'Đã hết hạn';
                } else if (subscription.status === 'Cancelled') {
                    statusBadge.className = 'badge bg-secondary px-3 py-2 fs-6';
                    statusBadge.textContent = 'Đã hủy';
                }

                // Render features
                const featuresContainer = document.getElementById('packageFeatures');
                featuresContainer.innerHTML = '';
                
                const features = [
                    { icon: 'fa-wallet', text: `Tối đa ${subscription.maxWallets || 'Không giới hạn'} ví`, enabled: true },
                    { icon: 'fa-exchange-alt', text: `${subscription.maxTransactions || 'Không giới hạn'} giao dịch`, enabled: true },
                    { icon: 'fa-chart-line', text: 'Báo cáo nâng cao', enabled: subscription.hasAdvancedReports },
                    { icon: 'fa-robot', text: 'Tư vấn AI', enabled: subscription.hasAiAdvisor },
                    { icon: 'fa-users', text: 'Chi tiêu nhóm', enabled: subscription.hasGroupExpense },
                    { icon: 'fa-headset', text: 'Hỗ trợ ưu tiên', enabled: subscription.hasPrioritySupport }
                ];

                features.forEach(feature => {
                    if (feature.enabled) {
                        const featureEl = document.createElement('div');
                        featureEl.className = 'col-md-6';
                        featureEl.innerHTML = `
                            <div class="d-flex align-items-center gap-2 p-2 bg-light rounded">
                                <i class="fas ${feature.icon} text-success"></i>
                                <span class="small">${feature.text}</span>
                            </div>
                        `;
                        featuresContainer.appendChild(featureEl);
                    }
                });

            } catch (error) {
                console.error('Error loading subscription:', error);
                loadingEl.classList.add('d-none');
                contentEl.classList.remove('d-none');
                noSubEl.classList.remove('d-none');
                activeEl.classList.add('d-none');
            }
        }

        // Cancel Subscription
        async function cancelSubscription() {
            const reason = prompt('Vui lòng cho biết lý do hủy gói (tùy chọn):');
            if (reason === null) return; // User cancelled

            if (!confirm('Bạn có chắc chắn muốn hủy gói dịch vụ hiện tại không?')) return;

            try {
                const response = await fetch('/api/Subscription/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: reason || 'Không có lý do' })
                });

                if (response.ok) {
                    showToast('Đã hủy gói dịch vụ thành công.', 'success');
                    loadSubscription(); // Reload subscription info
                } else {
                    const data = await response.json();
                    showToast(data.message || 'Không thể hủy gói dịch vụ.', 'danger');
                }
            } catch (error) {
                showToast('Lỗi khi hủy gói dịch vụ.', 'danger');
            }
        }

        function showToast(message, type = 'info') {
            const toastEl = document.getElementById('liveToast');
            const toastBody = document.getElementById('toastMessage');
            toastBody.textContent = message;
            toastEl.className = `toast align-items-center text-white bg-${type} border-0`;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            loadProfile();
            load2FAStatus();
            loadSessions();
            loadSubscription();
        });
    </script>
}
