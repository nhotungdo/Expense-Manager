@using MoneyTrackerApp.DTOs
@model List<TransactionResponseDto>

@if (Model != null && Model.Any())
{
    <div class="list-group list-group-flush">
        @foreach (var transaction in Model)
        {
            <div class="list-group-item border-0 px-0 py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="icon-box rounded-circle d-flex align-items-center justify-content-center me-3" 
                             style="width: 45px; height: 45px; background-color: @(transaction.CategoryColor ?? "#eee"); color: white; font-size: 1.2rem;">
                            @(transaction.CategoryIcon ?? "📄")
                        </div>
                        <div>
                            <h6 class="mb-0 fw-semibold">@(transaction.CategoryName ?? transaction.Note ?? "Giao dịch")</h6>
                            <small class="text-muted">@transaction.TransactionDate.ToString("dd/MM/yyyy HH:mm")</small>
                            @if (!string.IsNullOrEmpty(transaction.Note) && transaction.CategoryName != null)
                            {
                                <div class="small text-muted text-truncate" style="max-width: 200px;">@transaction.Note</div>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        @if (transaction.TransactionType == 1) // Income
                        {
                            <h6 class="mb-0 fw-bold text-success">+@transaction.Amount.ToString("N0") @transaction.Currency</h6>
                        }
                        else if (transaction.TransactionType == 2) // Expense
                        {
                            <h6 class="mb-0 fw-bold text-danger">-@transaction.Amount.ToString("N0") @transaction.Currency</h6>
                        }
                        else // Transfer
                        {
                            <h6 class="mb-0 fw-bold text-primary">@transaction.Amount.ToString("N0") @transaction.Currency</h6>
                            <small class="d-block text-muted" style="font-size: 0.7rem;">Chuyển khoản</small>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="text-muted mb-3" style="font-size: 3rem;">
            <i class="fas fa-receipt"></i>
        </div>
        <p class="text-muted">Chưa có giao dịch nào gần đây</p>
    </div>
}
