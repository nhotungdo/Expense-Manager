@page
@model MoneyTrackerApp.Pages.Profile.MyWalletModel
@{
    ViewData["Title"] = "Ví của tôi";
}

<div class="my-wallet-page">
    <!-- Overview Section -->
    <div class="overview-section mb-5">
        <div class="row g-4">
            <!-- Balance Card -->
            <div class="col-lg-8">
                <div class="card balance-card h-100 border-0 shadow-lg position-relative overflow-hidden text-white">
                    <div class="card-body p-4 position-relative z-1 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-white-50 mb-1 text-uppercase ls-1">Tổng số dư</h6>
                                <h1 class="display-4 fw-bold mb-0">@Model.TotalBalance.ToString("N0") <span class="fs-4">@Model.DefaultCurrency</span></h1>
                                <div class="mt-2">
                                    <span class="badge bg-white text-success rounded-pill px-3 py-2 fw-bold">
                                        <i class="fas fa-check-circle me-1"></i> Đang hoạt động
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#topUpModal">
                                    <i class="fas fa-plus me-2"></i> Nạp tiền
                                </button>
                                <button class="btn btn-outline-light rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                                    <i class="fas fa-arrow-down me-2"></i> Rút tiền
                                </button>
                            </div>
                        </div>
                        
                        <div class="mt-4 pt-3 border-top border-white-10">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-white-50">Hạn mức chi tiêu tháng này</span>
                                <div>
                                    <span class="fw-bold fs-5">2,000,000 VND</span>
                                    <button class="btn btn-sm btn-link text-white text-decoration-none ms-2" data-bs-toggle="modal" data-bs-target="#limitModal">
                                        <i class="fas fa-cog"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="progress mt-2" style="height: 6px; background-color: rgba(255,255,255,0.2);">
                                <div class="progress-bar bg-white" role="progressbar" style="width: 45%"></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Decorative Circles -->
                    <div class="decoration-circle circle-1"></div>
                    <div class="decoration-circle circle-2"></div>
                </div>
            </div>

            <!-- Subscription Section -->
            <div class="col-lg-4">
                <div class="card p-4 h-100 border-0 shadow-sm bg-white rounded-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-secondary fw-bold mb-0">Gói hiện tại</h6>
                        <span class="badge bg-primary-light text-primary rounded-pill">Pro</span>
                    </div>
                    
                    @if (Model.CurrentSubscription != null)
                    {
                        <div class="text-center py-3">
                            <div class="mb-3">
                                <i class="fas fa-crown fa-3x text-warning mb-3"></i>
                                <h4 class="fw-bold">@Model.CurrentSubscription.PackageName</h4>
                                <p class="text-muted small">Tự động gia hạn: @(Model.CurrentSubscription.AutoRenew ? "Bật" : "Tắt")</p>
                            </div>
                            
                            <div class="d-flex justify-content-between text-sm mb-2">
                                <span class="text-muted">Hết hạn trong</span>
                                <span class="fw-bold">@Model.CurrentSubscription.DaysRemaining ngày</span>
                            </div>
                            <div class="progress mb-4" style="height: 8px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 75%"></div>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary rounded-pill">Đổi gói</button>
                                <button class="btn btn-link text-danger text-decoration-none btn-sm">Hủy gia hạn</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Bạn chưa đăng ký gói nào</p>
                             <button class="btn btn-primary rounded-pill w-100 mt-2">Nâng cấp ngay</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Methods -->
    <div class="payment-methods mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-dark">Phương thức thanh toán đã lưu</h5>
            <button class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="fas fa-plus me-1"></i> Thêm mới
            </button>
        </div>

        <div class="row g-4">
            @if (Model.Wallets.Any())
            {
                foreach (var wallet in Model.Wallets)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="card payment-card border-0 shadow-sm p-3 h-100 position-relative">
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-box bg-light text-primary rounded-3 me-3">
                                    <i class="fas fa-wallet fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">@wallet.Name</h6>
                                    <small class="text-muted">**** @(wallet.Id % 10000)</small>
                                </div>
                                <div class="ms-auto dropdown">
                                    <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                        <li><a class="dropdown-item" href="#">Đặt làm mặc định</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#">Xóa</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-end mt-auto">
                                <div>
                                    <span class="badge bg-success-light text-success rounded-pill">Mặc định</span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block">Hết hạn</small>
                                    <span class="fw-bold">12/28</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            
            <!-- Generate Fake Cards for Demo if empty or to show variety -->
            <div class="col-md-4 col-sm-6">
                 <div class="card payment-card border-0 shadow-sm p-3 h-100 bg-light border-dashed d-flex align-items-center justify-content-center text-center cursor-pointer hover-shadow">
                     <i class="fas fa-plus-circle fa-2x text-primary mb-2"></i>
                     <span class="text-primary fw-bold">Liên kết thẻ mới</span>
                 </div>
            </div>
        </div>
    </div>

    <!-- Transaction History -->
    <div class="transactions-section bg-white p-4 rounded-4 shadow-sm">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <h5 class="fw-bold mb-0">Lịch sử giao dịch</h5>
            
            <div class="d-flex gap-3 flex-wrap">
                <select class="form-select border-0 bg-light rounded-pill px-4 py-2" style="width: auto;" onchange="loadTransactions(this.value)">
                    <option value="All">Tất cả</option>
                    <option value="Topup">Nạp tiền</option>
                    <option value="Payment">Thanh toán gói</option>
                    <option value="Refund">Hoàn tiền</option>
                </select>
                
                <div class="input-group" style="width: auto;">
                    <span class="input-group-text bg-light border-0 rounded-start-pill ps-3"><i class="far fa-calendar-alt"></i></span>
                    <input type="text" class="form-control border-0 bg-light rounded-end-pill" placeholder="Chọn thời gian" style="max-width: 150px;">
                </div>
            </div>
        </div>

        <div id="transaction-table-container">
            <partial name="_WalletTransactions" model="Model.RecentTransactions" />
        </div>
        
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item disabled"><a class="page-link border-0 rounded-circle mx-1" href="#"><i class="fas fa-chevron-left"></i></a></li>
                    <li class="page-item active"><a class="page-link border-0 rounded-circle mx-1" href="#">1</a></li>
                    <li class="page-item"><a class="page-link border-0 rounded-circle mx-1" href="#">2</a></li>
                    <li class="page-item"><a class="page-link border-0 rounded-circle mx-1" href="#">3</a></li>
                    <li class="page-item"><a class="page-link border-0 rounded-circle mx-1" href="#"><i class="fas fa-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- AI Assistant Widget -->
<div class="ai-widget-container">
    <button class="ai-fab shadow-lg" id="aiFab" onclick="toggleAiChat()">
        <i class="fas fa-robot"></i>
        <span class="notification-dot"></span>
    </button>
    
    <div class="ai-chat-window shadow-lg" id="aiChatWindow">
        <div class="chat-header">
            <div class="d-flex align-items-center">
                <div class="ai-avatar me-2">
                    <i class="fas fa-robot text-white"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Trợ lý tài chính</h6>
                    <small class="text-white-50">Sẵn sàng hỗ trợ</small>
                </div>
            </div>
            <button class="btn btn-sm text-white" onclick="toggleAiChat()"><i class="fas fa-times"></i></button>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="message ai">
                Xin chào! Tôi có thể giúp gì cho bạn về chi tiêu hôm nay?
            </div>
        </div>
        <div class="chat-suggestions">
            <div class="chip" onclick="askAi('Tổng chi tiêu tháng này?')">Tổng chi tiêu tháng này?</div>
            <div class="chip" onclick="askAi('So sánh với tháng trước?')">So sánh tháng trước?</div>
            <div class="chip" onclick="askAi('Tại sao bị trừ 50k?')">Tại sao trừ 50k?</div>
        </div>
        <div class="chat-input-area">
            <input type="text" class="form-control border-0 bg-light rounded-pill" placeholder="Hỏi tôi..." id="aiInput" onkeypress="handleEnter(event)">
            <button class="btn btn-primary rounded-circle ms-2" onclick="sendAiMessage()">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="topUpModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Nạp tiền vào ví</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <label class="form-label text-muted">Nhập số tiền</label>
                    <div class="input-group input-group-lg">
                        <input type="text" class="form-control fw-bold fs-4 border-end-0" placeholder="0">
                        <span class="input-group-text bg-white border-start-0 fw-bold text-muted">VND</span>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                         <button class="btn btn-sm btn-outline-secondary rounded-pill">100.000</button>
                         <button class="btn btn-sm btn-outline-secondary rounded-pill">500.000</button>
                         <button class="btn btn-sm btn-outline-secondary rounded-pill">1.000.000</button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Nguồn tiền</label>
                    <select class="form-select form-select-lg">
                        <option>Thẻ ngân hàng (**** 4242)</option>
                        <option>Momo Wallet</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-primary w-100 rounded-pill py-3 fw-bold">Xác nhận nạp tiền</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Page Specific Styles */
    .balance-card {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.4);
    }
    
    .decoration-circle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        z-index: 0;
    }
    
    .circle-1 { width: 300px; height: 300px; top: -100px; right: -100px; }
    .circle-2 { width: 200px; height: 200px; bottom: -50px; left: -50px; }
    
    .border-white-10 { border-color: rgba(255, 255, 255, 0.1) !important; }
    
    .payment-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .payment-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    
    .icon-box {
        width: 48px; height: 48px;
        display: flex; align-items: center; justify-content: center;
    }
    
    .border-dashed { border-style: dashed !important; border-width: 2px !important; }
    
    /* AI Widget Styles */
    .ai-widget-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 1000;
        font-family: 'Inter', sans-serif;
    }
    
    .ai-fab {
        width: 60px; height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white;
        border: none;
        font-size: 24px;
        display: flex; align-items: center; justify-content: center;
        transition: transform 0.3s;
        cursor: pointer;
    }
    
    .ai-fab:hover { transform: scale(1.1) rotate(10deg); }
    
    .notification-dot {
        position: absolute; top: 0; right: 0;
        width: 15px; height: 15px;
        background: #ef4444; border-radius: 50%;
        border: 2px solid white;
    }
    
    .ai-chat-window {
        position: absolute;
        bottom: 80px; right: 0;
        width: 350px;
        height: 500px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        display: flex; flex-direction: column;
        display: none; /* Initially hidden */
        animation: slideUp 0.3s ease-out;
    }
    
    .ai-chat-window.active { display: flex; }
    
    .chat-header {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        padding: 15px; color: white;
        display: flex; justify-content: space-between; align-items: center;
    }
    
    .ai-avatar {
        width: 35px; height: 35px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    
    .chat-body {
        flex: 1;
        padding: 15px;
        overflow-y: auto;
        background: #f8f9fa;
    }
    
    .message {
        margin-bottom: 10px;
        padding: 10px 15px;
        border-radius: 15px;
        max-width: 80%;
        font-size: 0.9rem;
    }
    
    .message.ai {
        background: white;
        color: #1f2937;
        align-self: flex-start;
        border-bottom-left-radius: 2px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    
    .message.user {
        background: #2563eb;
        color: white;
        align-self: flex-end;
        border-bottom-right-radius: 2px;
        margin-left: auto;
    }
    
    .chat-suggestions {
        padding: 10px 15px;
        display: flex; gap: 5px;
        overflow-x: auto;
        scrollbar-width: none;
    }
    
    .chip {
        background: #e0e7ff;
        color: #3730a3;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.75rem;
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.2s;
    }
    .chip:hover { background: #c7d2fe; }
    
    .chat-input-area {
        padding: 15px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        background: white;
    }
    
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@section Scripts {
    <script>
        function toggleAiChat() {
            var chat = document.getElementById('aiChatWindow');
            chat.classList.toggle('active');
        }
        
        function handleEnter(e) {
            if (e.key === 'Enter') sendAiMessage();
        }
        
        function sendAiMessage() {
            var input = document.getElementById('aiInput');
            var text = input.value.trim();
            if (!text) return;
            
            // Add user message
            addMessage(text, 'user');
            input.value = '';
            
            // Simulate AI response
            setTimeout(() => {
                var response = "Tôi đã tìm thấy thông tin. Đây là các giao dịch liên quan.";
                addMessage(response, 'ai');
                highlightTransactions();
            }, 1000);
        }
        
        function askAi(question) {
            addMessage(question, 'user');
            setTimeout(() => {
                var response = "Dựa trên dữ liệu tháng này, tổng chi tiêu của bạn là 12.500.000 VND.";
                addMessage(response, 'ai');
            }, 1000);
        }
        
        function addMessage(text, type) {
            var body = document.getElementById('chatBody');
            var div = document.createElement('div');
            div.className = 'message ' + type;
            div.textContent = text;
            body.appendChild(div);
            body.scrollTop = body.scrollHeight;
        }
        
        function highlightTransactions() {
            // Find rows and add highlight effect
            var rows = document.querySelectorAll('#transaction-table-container tbody tr');
            console.log("Transactions found: " + rows.length);
            if(rows.length > 0) {
                 rows[0].style.backgroundColor = '#fffbeb'; // Yellow highlight
                 rows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                 setTimeout(() => {
                     rows[0].style.backgroundColor = '';
                 }, 3000);
            }
        }
        
        function loadTransactions(filterType) {
             console.log("Filtering by: " + filterType);
             // Implement AJAX fetch similar to old code
        }
    </script>
}
