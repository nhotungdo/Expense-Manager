@page
@model MoneyTrackerApp.Pages.IndexModel
@using System.Linq
@using MoneyTrackerApp.DTOs
@{
    ViewData["Title"] = User.Identity?.IsAuthenticated == true ? "Tổng quan" : "Trang chủ";
}

@if (User.Identity?.IsAuthenticated == true && Model.DashboardData != null)
{
    <div class="page-header">
        <div class="page-title">
            <div class="icon-box icon-box-lg bg-primary text-white shadow-sm">
                <i class="fas fa-chart-pie"></i>
            </div>
            <div>
                Tổng quan tài chính
                <div class="text-sm text-muted fw-normal">Chào mừng trở lại, hãy kiểm soát tài chính của bạn!</div>
            </div>
        </div>
        <div class="user-actions">
             <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#quickAddModal">
                <i class="fas fa-plus"></i> Thêm giao dịch
            </button>
        </div>
    </div>

    <div class="bento-container">
        <!-- Total Balance -->
        <div class="bento-card bento-col-1">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="icon-box icon-box-sm bg-primary-subtle text-primary">
                    <i class="fas fa-wallet"></i>
                </div>
                <span class="badge badge-primary">VND</span>
            </div>
            <div class="stat-label text-muted">Tổng số dư</div>
            <div class="stat-value text-primary">@Model.DashboardData.CurrentBalance.ToString("N0") ₫</div>
        </div>

        <!-- Monthly Savings -->
        <div class="bento-card bento-col-1">
             <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="icon-box icon-box-sm bg-success-subtle text-success">
                    <i class="fas fa-piggy-bank"></i>
                </div>
                <span class="badge @(Model.DashboardData.MonthlySavings >= 0 ? "badge-success" : "badge-danger")">
                    @(Model.DashboardData.SavingsRate.ToString("F1"))%
                </span>
            </div>
            <div class="stat-label text-muted">Tiết kiệm tháng này</div>
            <div class="stat-value @(Model.DashboardData.MonthlySavings >= 0 ? "text-success" : "text-danger")">
                @Model.DashboardData.MonthlySavings.ToString("N0") ₫
            </div>
        </div>

        <!-- Income -->
        <div class="bento-card bento-col-1">
             <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="icon-box icon-box-sm bg-info-subtle text-info">
                    <i class="fas fa-arrow-down"></i>
                </div>
            </div>
             <div class="stat-label text-muted">Tổng thu nhập</div>
            <div class="stat-value text-info">@Model.DashboardData.MonthlyIncome.ToString("N0") ₫</div>
        </div>

        <!-- Expense -->
        <div class="bento-card bento-col-1">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="icon-box icon-box-sm bg-danger-subtle text-danger">
                    <i class="fas fa-arrow-up"></i>
                </div>
            </div>
            <div class="stat-label text-muted">Tổng chi tiêu</div>
            <div class="stat-value text-danger">@Model.DashboardData.MonthlyExpense.ToString("N0") ₫</div>
        </div>

        <!-- Cash Flow Chart -->
        <div class="bento-card bento-col-3 bento-row-2">
            <div class="card-header-clean">
                <h3 class="card-title">Dòng tiền (6 tháng)</h3>
                 <button class="btn btn-sm btn-outline"><i class="fas fa-ellipsis-h"></i></button>
            </div>
            <div style="height: 300px; width: 100%;">
                <canvas id="cashFlowChart"></canvas>
            </div>
        </div>

        <!-- Expense Breakdown -->
        <div class="bento-card bento-col-1 bento-row-2">
            <div class="card-header-clean">
                <h3 class="card-title">Top Chi tiêu</h3>
            </div>
            <div style="height: 200px; position:relative;">
                 <canvas id="expensePieChart"></canvas>
            </div>
            <div class="mt-4">
                @foreach(var item in Model.DashboardData.ExpensePieChart)
                {
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span style="width: 10px; height: 10px; border-radius: 50%; background-color: @item.Color;"></span>
                            <span class="text-sm fw-medium">@item.Label</span>
                        </div>
                        <span class="text-sm text-muted">@item.Value.ToString("N0") ₫</span>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class="bento-card bento-col-2">
            <div class="card-header-clean">
                <h3 class="card-title">Giao dịch gần đây</h3>
                <a href="/Transactions" class="text-sm text-primary fw-medium">Xem tất cả</a>
            </div>
            <table class="clean-table">
                @if (Model.DashboardData.RecentTransactions.Any())
                {
                    @foreach (var tran in Model.DashboardData.RecentTransactions)
                    {
                        <tr>
                            <td style="width: 50px;">
                                <div class="cat-icon" style="background: @(tran.CategoryColor ?? "#eee"); color: #fff;">
                                    <i class="@(tran.CategoryIcon ?? "fas fa-money-bill")"></i>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold">@tran.Description</div>
                                <div class="text-xs text-muted">@tran.Date.ToString("dd/MM/yyyy") • @tran.AccountName</div>
                            </td>
                            <td class="text-end">
                                <span class="@(tran.Type == "Income" ? "amount-inc" : (tran.Type == "Expense" ? "amount-exp" : "text-primary"))">
                                    @(tran.Type == "Expense" ? "-" : "+")@tran.Amount.ToString("N0") ₫
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">Chưa có giao dịch nào</td>
                    </tr>
                }
            </table>
        </div>

        <!-- Financial Alerts & AI Suggestions -->
        <div class="bento-card bento-col-2">
             <div class="card-header-clean">
                <h3 class="card-title">Gợi ý & Cảnh báo</h3>
            </div>
            @if (Model.DashboardData.BudgetAlerts.Any())
            {
                @foreach (var alert in Model.DashboardData.BudgetAlerts)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-2 p-2 rounded-3 border-warning border-opacity-25 bg-warning-subtle text-warning-emphasis">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div class="text-sm">@alert.Message</div>
                    </div>
                }
            }

            <div class="p-3 bg-primary-subtle rounded-3 mt-2">
                <div class="d-flex gap-2 mb-2 text-primary fw-bold">
                    <i class="fas fa-robot"></i> AI Gợi ý
                </div>
                <p class="text-sm text-primary-emphasis mb-0">
                    Dựa trên chi tiêu tháng này, bạn nên giảm bớt chi phí ăn ngoài để đạt mục tiêu tiết kiệm.
                </p>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            // Cash Flow Chart
            const ctxFlow = document.getElementById('cashFlowChart').getContext('2d');
            new Chart(ctxFlow, {
                type: 'bar',
                data: {
                    labels: @Json.Serialize(Model.DashboardData.CashFlowChart.Labels),
                    datasets: [
                        {
                            label: 'Thu nhập',
                            data: @Json.Serialize(Model.DashboardData.CashFlowChart.IncomeData),
                            backgroundColor: '#10b981',
                            borderRadius: 4
                        },
                        {
                            label: 'Chi tiêu',
                            data: @Json.Serialize(Model.DashboardData.CashFlowChart.ExpenseData),
                            backgroundColor: '#ef4444',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { display: false }
                        },
                        x: {
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Expense Pie Chart
            const ctxPie = document.getElementById('expensePieChart').getContext('2d');
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: @Json.Serialize(Model.DashboardData.ExpensePieChart.Select(x => x.Label)),
                    datasets: [{
                        data: @Json.Serialize(Model.DashboardData.ExpensePieChart.Select(x => x.Value)),
                        backgroundColor: @Json.Serialize(Model.DashboardData.ExpensePieChart.Select(x => x.Color)),
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        </script>
    }
}
else
{
    <!-- Public Landing Page -->
    <section class="hero">
      <div class="hero-content">
        <div class="badge">MoneyTrackerApp</div>
        <h1>Quản lý chi tiêu thông minh cho mọi người</h1>
        <p class="subtitle">Theo dõi thu chi, lập ngân sách, mục tiêu tiết kiệm và báo cáo trực quan – tất cả trong một nền
          tảng duy nhất.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href="/Auth/Register">Bắt đầu miễn phí</a>
          <a class="btn btn-outline btn-lg" href="/Auth/Login">Đăng nhập</a>
        </div>
        <div class="stats">
          <div class="stat"><span>50K+</span> giao dịch</div>
          <div class="stat"><span>1K+</span> người dùng</div>
          <div class="stat"><span>24/7</span> bảo mật</div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="card demo-card">
          <div class="card-header">
            <div class="dot red"></div>
            <div class="dot yellow"></div>
            <div class="dot green"></div>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col">
                <div class="metric">
                  <div class="label">Tổng chi tiêu</div>
                  <div class="value">-12.500.000₫</div>
                  <div class="trend down">▼ 8% MoM</div>
                </div>
              </div>
              <div class="col">
                <div class="metric">
                  <div class="label">Tổng thu nhập</div>
                  <div class="value">+25.000.000₫</div>
                  <div class="trend up">▲ 5% MoM</div>
                </div>
              </div>
            </div>
            <div class="sparkline">
              <div class="bar" style="height:30%"></div>
              <div class="bar" style="height:65%"></div>
              <div class="bar" style="height:40%"></div>
              <div class="bar" style="height:80%"></div>
              <div class="bar" style="height:55%"></div>
              <div class="bar" style="height:90%"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-shape"></div>
    </section>

    <section class="features">
      <div class="section-header">
        <h2>Tính năng chính</h2>
        <p>Tập trung vào điều quan trọng: kiểm soát tài chính cá nhân.</p>
      </div>
      <div class="grid">
        <div class="feature">
          <div class="icon gradient-blue"></div>
          <h3>Theo dõi giao dịch</h3>
          <p>Ghi chép nhanh, phân loại tự động, đính kèm hoá đơn.</p>
        </div>
        <div class="feature">
          <div class="icon gradient-green"></div>
          <h3>Ngân sách & cảnh báo</h3>
          <p>Thiết lập ngân sách, cảnh báo vượt ngưỡng theo thời gian thực.</p>
        </div>
        <div class="feature">
          <div class="icon gradient-purple"></div>
          <h3>Mục tiêu tiết kiệm</h3>
          <p>Theo dõi tiến độ, trực quan hoá và nhắc nhở thông minh.</p>
        </div>
        <div class="feature">
          <div class="icon gradient-orange"></div>
          <h3>Báo cáo nâng cao</h3>
          <p>Biểu đồ thu/chi, top danh mục, xu hướng theo tháng/quý.</p>
        </div>
      </div>
    </section>

    <style>
      :root {
        --bg: #0b1220;
        --text: #0f172a;
        --muted: #64748b;
        --white: #fff;
        --blue: #0ea5e9;
        --green: #22c55e;
        --purple: #22c55e;
        --orange: #f59e0b;
      }

      .hero {
        position: relative;
        display: flex;
        align-items: center;
        gap: 40px;
        min-height: 60vh;
        padding: 40px 0
      }

      .hero-content {
        flex: 1
      }

      .badge {
        display: inline-block;
        background: linear-gradient(90deg, var(--blue), var(--green));
        color: #fff;
        padding: 8px 12px;
        border-radius: 999px;
        font-weight: 600;
        margin-bottom: 16px
      }

      .hero h1 {
        font-size: 40px;
        line-height: 1.1;
        margin: 0 0 16px 0
      }

      .subtitle {
        color: #475569;
        font-size: 16px;
        margin-bottom: 20px
      }

      .cta .btn {
        margin-right: 12px
      }

      .btn-outline {
        border: 1px solid #e5e7eb;
        color: #0f172a;
        background: #fff
      }

      .stats {
        display: flex;
        gap: 20px;
        margin-top: 20px;
        color: #64748b
      }

      .stats .stat {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 16px
      }

      .stats .stat span {
        color: #0f172a;
        font-weight: 700;
        margin-right: 6px
      }

      .hero-visual {
        flex: 1;
        display: flex;
        justify-content: center
      }

      .demo-card {
        width: 100%;
        max-width: 460px;
        background: #0f172a;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, .15);
        overflow: hidden;
        color: #fff
      }

      .card-header {
        display: flex;
        gap: 6px;
        padding: 10px 12px;
        background: #111827
      }

      .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%
      }

      .dot.red {
        background: #ef4444
      }

      .dot.yellow {
        background: #f59e0b
      }

      .dot.green {
        background: #22c55e
      }

      .card-body {
        padding: 16px
      }

      .row {
        display: flex;
        gap: 12px;
        margin-bottom: 14px
      }

      .col {
        flex: 1
      }

      .metric .label {
        color: #9ca3af;
        font-size: 12px
      }

      .metric .value {
        font-size: 22px;
        font-weight: 700;
        margin-top: 4px
      }

      .metric .trend {
        font-size: 12px;
        margin-top: 4px
      }

      .trend.up {
        color: #22c55e
      }

      .trend.down {
        color: #ef4444
      }

      .sparkline {
        display: flex;
        align-items: flex-end;
        gap: 6px;
        height: 100px
      }

      .sparkline .bar {
        width: 10px;
        background: linear-gradient(180deg, #22c55e, #0ea5e9);
        border-radius: 10px
      }

      .bg-shape {
        position: absolute;
        right: -120px;
        top: -60px;
        width: 300px;
        height: 300px;
        background: radial-gradient(closest-side, rgba(14, 165, 233, .25), transparent);
        filter: blur(20px);
        z-index: -1
      }

      .features {
        padding: 36px 0
      }

      .section-header {
        text-align: center;
        margin-bottom: 20px
      }

      .section-header h2 {
        font-size: 28px;
        margin-bottom: 8px
      }

      .section-header p {
        color: #64748b
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px
      }

      .feature {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px
      }

      .icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        margin-bottom: 10px
      }

      .gradient-blue {
        background: linear-gradient(135deg, #38bdf8, #0ea5e9)
      }

      .gradient-green {
        background: linear-gradient(135deg, #38bdf8c, #22c55e)
      }

      .gradient-purple {
        background: linear-gradient(135deg, #c084fc, #22c55e)
      }

      .gradient-orange {
        background: linear-gradient(135deg, #fcd34d, #f59e0b)
      }

      @@media (max-width:992px) {
        .grid {
          grid-template-columns: repeat(2, 1fr)
        }

        .cards {
          grid-template-columns: repeat(1, 1fr)
        }

        .hero {
          flex-direction: column
        }
      }
    </style>
}