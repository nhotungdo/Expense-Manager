@page
@model MoneyTrackerApp.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Public Landing Page -->
<section class="hero">
  <div class="hero-content">
    <div class="badge">MoneyTrackerApp</div>
    <h1>Quản lý chi tiêu thông minh cho mọi người</h1>
    <p class="subtitle">Theo dõi thu chi, lập ngân sách, mục tiêu tiết kiệm và báo cáo trực quan – tất cả trong một nền
      tảng duy nhất.</p>
    <div class="cta">
      <a class="btn btn-primary btn-lg" href="/Auth/Register">Bắt đầu miễn phí</a>
      <a class="btn btn-outline btn-lg" href="/Auth/Login">Đăng nhập</a>
    </div>
    <div class="stats">
      <div class="stat"><span>50K+</span> giao dịch</div>
      <div class="stat"><span>1K+</span> người dùng</div>
      <div class="stat"><span>24/7</span> bảo mật</div>
    </div>
  </div>
  <div class="hero-visual">
    <div class="card demo-card">
      <div class="card-header">
        <div class="dot red"></div>
        <div class="dot yellow"></div>
        <div class="dot green"></div>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col">
            <div class="metric">
              <div class="label">Tổng chi tiêu</div>
              <div class="value">-12.500.000₫</div>
              <div class="trend down">▼ 8% MoM</div>
            </div>
          </div>
          <div class="col">
            <div class="metric">
              <div class="label">Tổng thu nhập</div>
              <div class="value">+25.000.000₫</div>
              <div class="trend up">▲ 5% MoM</div>
            </div>
          </div>
        </div>
        <div class="sparkline">
          <div class="bar" style="height:30%"></div>
          <div class="bar" style="height:65%"></div>
          <div class="bar" style="height:40%"></div>
          <div class="bar" style="height:80%"></div>
          <div class="bar" style="height:55%"></div>
          <div class="bar" style="height:90%"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-shape"></div>
</section>

<section class="features">
  <div class="section-header">
    <h2>Tính năng chính</h2>
    <p>Tập trung vào điều quan trọng: kiểm soát tài chính cá nhân.</p>
  </div>
  <div class="grid">
    <div class="feature">
      <div class="icon gradient-blue"></div>
      <h3>Theo dõi giao dịch</h3>
      <p>Ghi chép nhanh, phân loại tự động, đính kèm hoá đơn.</p>
    </div>
    <div class="feature">
      <div class="icon gradient-green"></div>
      <h3>Ngân sách & cảnh báo</h3>
      <p>Thiết lập ngân sách, cảnh báo vượt ngưỡng theo thời gian thực.</p>
    </div>
    <div class="feature">
      <div class="icon gradient-purple"></div>
      <h3>Mục tiêu tiết kiệm</h3>
      <p>Theo dõi tiến độ, trực quan hoá và nhắc nhở thông minh.</p>
    </div>
    <div class="feature">
      <div class="icon gradient-orange"></div>
      <h3>Báo cáo nâng cao</h3>
      <p>Biểu đồ thu/chi, top danh mục, xu hướng theo tháng/quý.</p>
    </div>
  </div>
</section>

<style>
  :root {
    --bg: #0b1220;
    --text: #0f172a;
    --muted: #64748b;
    --white: #fff;
    --blue: #0ea5e9;
    --green: #22c55e;
    --purple: #22c55e;
    --orange: #f59e0b;
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    gap: 40px;
    min-height: 60vh;
    padding: 40px 0
  }

  .hero-content {
    flex: 1
  }

  .badge {
    display: inline-block;
    background: linear-gradient(90deg, var(--blue), var(--green));
    color: #fff;
    padding: 8px 12px;
    border-radius: 999px;
    font-weight: 600;
    margin-bottom: 16px
  }

  .hero h1 {
    font-size: 40px;
    line-height: 1.1;
    margin: 0 0 16px 0
  }

  .subtitle {
    color: #475569;
    font-size: 16px;
    margin-bottom: 20px
  }

  .cta .btn {
    margin-right: 12px
  }

  .btn-outline {
    border: 1px solid #e5e7eb;
    color: #0f172a;
    background: #fff
  }

  .stats {
    display: flex;
    gap: 20px;
    margin-top: 20px;
    color: #64748b
  }

  .stats .stat {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 10px 16px
  }

  .stats .stat span {
    color: #0f172a;
    font-weight: 700;
    margin-right: 6px
  }

  .hero-visual {
    flex: 1;
    display: flex;
    justify-content: center
  }

  .demo-card {
    width: 100%;
    max-width: 460px;
    background: #0f172a;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, .15);
    overflow: hidden;
    color: #fff
  }

  .card-header {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    background: #111827
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%
  }

  .dot.red {
    background: #ef4444
  }

  .dot.yellow {
    background: #f59e0b
  }

  .dot.green {
    background: #22c55e
  }

  .card-body {
    padding: 16px
  }

  .row {
    display: flex;
    gap: 12px;
    margin-bottom: 14px
  }

  .col {
    flex: 1
  }

  .metric .label {
    color: #9ca3af;
    font-size: 12px
  }

  .metric .value {
    font-size: 22px;
    font-weight: 700;
    margin-top: 4px
  }

  .metric .trend {
    font-size: 12px;
    margin-top: 4px
  }

  .trend.up {
    color: #22c55e
  }

  .trend.down {
    color: #ef4444
  }

  .sparkline {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 100px
  }

  .sparkline .bar {
    width: 10px;
    background: linear-gradient(180deg, #22c55e, #0ea5e9);
    border-radius: 10px
  }

  .bg-shape {
    position: absolute;
    right: -120px;
    top: -60px;
    width: 300px;
    height: 300px;
    background: radial-gradient(closest-side, rgba(14, 165, 233, .25), transparent);
    filter: blur(20px);
    z-index: -1
  }

  .features {
    padding: 36px 0
  }

  .section-header {
    text-align: center;
    margin-bottom: 20px
  }

  .section-header h2 {
    font-size: 28px;
    margin-bottom: 8px
  }

  .section-header p {
    color: #64748b
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px
  }

  .feature {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 18px
  }

  .icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    margin-bottom: 10px
  }

  .gradient-blue {
    background: linear-gradient(135deg, #38bdf8, #0ea5e9)
  }

  .gradient-green {
    background: linear-gradient(135deg, #38bdf8c, #22c55e)
  }

  .gradient-purple {
    background: linear-gradient(135deg, #c084fc, #22c55e)
  }

  .gradient-orange {
    background: linear-gradient(135deg, #fcd34d, #f59e0b)
  }

  @@media (max-width:992px) {
    .grid {
      grid-template-columns: repeat(2, 1fr)
    }

    .cards {
      grid-template-columns: repeat(1, 1fr)
    }

    .hero {
      flex-direction: column
    }
  }
</style>