@page
@model MoneyTrackerApp.Pages.Debts.IndexModel
@{
    ViewData["Title"] = "Quản lý Nợ | Money Tracker";
}

<div id="debts-app" class="debts-container" v-cloak>
    
    <!-- Header -->
    <header class="page-header d-flex justify-content-between align-items-end mb-5">
        <div>
            <h1 class="text-gradient">Sổ Nợ</h1>
            <p>Quản lý các khoản vay và cho vay hiệu quả</p>
        </div>
        <button class="btn btn-modern btn-modern-primary d-none d-md-flex align-items-center gap-2" @@click="openAddModal">
            <i class="fas fa-plus"></i>
            <span>Thêm Khoản Nợ</span>
        </button>
    </header>

    <!-- Loading -->
    <div v-if="isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted">Đang tải dữ liệu...</p>
    </div>

    <div v-else class="animate-fade-in">
        <!-- Stats Grid -->
        <div class="summary-grid">
            <!-- Net Position -->
            <div class="stat-card primary">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Vị thế ròng</div>
                        <div class="stat-value">{{ formatCurrency(Math.abs(summary.netDebt)) }}</div>
                        <div class="badge bg-white bg-opacity-25 rounded-pill fw-normal px-3 py-1">
                            {{ summary.netDebt >= 0 ? 'Bạn đang dương' : 'Bạn đang âm' }}
                        </div>
                    </div>
                    <i class="fas fa-wallet stat-icon"></i>
                </div>
            </div>

            <!-- I Owe (Payable) -->
            <div class="stat-card danger">
                 <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Tôi đi vay (Phải trả)</div>
                        <div class="stat-value">{{ formatCurrency(summary.totalIOwe) }}</div>
                        <div class="mt-2 text-white text-opacity-75 small">
                            {{ summary.iOweThem.length }} khoản đang nợ
                        </div>
                    </div>
                    <i class="fas fa-arrow-down stat-icon"></i>
                </div>
            </div>

            <!-- They Owe (Receivable) -->
            <div class="stat-card success">
                 <div class="d-flex justify-content-between align-items-start">
                     <div>
                        <div class="stat-label">Cho vay (Phải thu)</div>
                        <div class="stat-value">{{ formatCurrency(summary.totalTheyOweMe) }}</div>
                        <div class="mt-2 text-white text-opacity-75 small">
                            {{ summary.theyOweMe.length }} khoản cần thu
                        </div>
                     </div>
                     <i class="fas fa-arrow-up stat-icon"></i>
                 </div>
            </div>
        </div>

        <!-- Filters & Search -->
        <div class="actions-bar">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <button class="nav-link" :class="{ active: currentTab === 'all' }" @@click="currentTab = 'all'">Tất cả</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" :class="{ active: currentTab === 'borrow' }" @@click="currentTab = 'borrow'">Đi vay</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" :class="{ active: currentTab === 'lend' }" @@click="currentTab = 'lend'">Cho vay</button>
                </li>
            </ul>

            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" v-model="searchQuery" placeholder="Tìm kiếm khoản nợ...">
            </div>
        </div>

        <!-- List -->
        <div class="debts-list">
            <div v-if="filteredDebts.length === 0" class="empty-state">
                <div class="mb-3 text-muted opacity-50">
                    <i class="fas fa-clipboard-list fa-3x"></i>
                </div>
                <h5 class="text-muted">Không tìm thấy dữ liệu</h5>
                <p class="text-muted small">Hãy thử thay đổi bộ lọc hoặc thêm khoản nợ mới.</p>
            </div>

            <div v-for="debt in filteredDebts" :key="debt.id" class="debt-card cursor-pointer" @@click="viewDebtDetails(debt)">
                <!-- Icon -->
                <div class="debt-icon" :class="debt.debtType === 1 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'">
                    <i class="fas" :class="debt.debtType === 1 ? 'fa-arrow-down' : 'fa-arrow-up'"></i>
                </div>

                <!-- Info -->
                <div class="debt-info">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="debt-name">{{ debt.name }}</h5>
                            <div class="debt-meta">
                                <span><i class="fas fa-user me-1"></i> {{ debt.personName || 'Không tên' }}</span>
                                <span v-if="debt.dueDate" :class="{'text-danger fw-bold': debt.isOverdue}">
                                    <i class="fas fa-clock me-1"></i>
                                    {{ debt.isOverdue ? 'Quá hạn ' + Math.abs(debt.daysRemaining) + ' ngày' : 'Còn ' + debt.daysRemaining + ' ngày' }}
                                </span>
                            </div>
                        </div>
                        <div class="debt-amount-box">
                            <div class="debt-remaining" :class="debt.debtType === 1 ? 'text-danger' : 'text-success'">
                                {{ formatCurrency(debt.remainingAmount) }}
                            </div>
                            <div class="debt-total">Tổng: {{ formatCurrency(debt.totalWithInterest) }}</div>
                        </div>
                    </div>

                    <!-- Progress -->
                    <div class="progress-thin">
                        <div class="progress-bar-thin" 
                             :style="{ width: debt.percentagePaid + '%', backgroundColor: debt.debtType === 1 ? '#ef4444' : '#10b981' }">
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1" style="font-size: 0.75rem; color: var(--text-muted);">
                        <span>Đã trả: {{ formatCurrency(debt.amountPaid) }}</span>
                        <span>{{ debt.percentagePaid.toFixed(0) }}%</span>
                    </div>
                </div>

                <!-- Quick Action -->
                <div class="ps-3 border-start d-none d-sm-block">
                     <button class="btn btn-light rounded-circle text-primary" @@click.stop="openPaymentModal(debt)" title="Thanh toán ngay">
                        <i class="fas fa-money-bill-wave"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile FAB -->
    <div class="fab-add d-md-none" @@click="openAddModal">
        <i class="fas fa-plus"></i>
    </div>

    <!-- MODALS -->
    
    <!-- Add/Edit Modal (Reusing structure with new classes) -->
    <div class="modal fade" id="debtModal" tabindex="-1" data-bs-backdrop="static">
         <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">{{ isEditing ? 'Cập Nhật Khoản Nợ' : 'Thêm Khoản Nợ Mới' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-4 bg-light p-1 rounded-pill">
                        <button class="btn flex-fill rounded-pill fw-bold transition-all" 
                                :class="debtForm.debtType === 1 ? 'bg-white shadow-sm text-danger' : 'text-muted'"
                                @@click="debtForm.debtType = 1">
                            Tôi đi vay
                        </button>
                        <button class="btn flex-fill rounded-pill fw-bold transition-all" 
                                :class="debtForm.debtType === 2 ? 'bg-white shadow-sm text-success' : 'text-muted'"
                                @@click="debtForm.debtType = 2">
                            Tôi cho vay
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted fw-bold">Tên khoản nợ</label>
                        <input type="text" v-model="debtForm.name" class="form-control form-control-modern" placeholder="VD: Vay tiền trọ...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted fw-bold">Người liên quan</label>
                        <input type="text" v-model="debtForm.personName" class="form-control form-control-modern" placeholder="Tên người vay/chủ nợ">
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small text-muted fw-bold">Số tiền gốc</label>
                            <input type="number" v-model.number="debtForm.initialAmount" class="form-control form-control-modern" :disabled="isEditing">
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted fw-bold">Lãi suất (%/năm)</label>
                            <input type="number" v-model.number="debtForm.interestRate" class="form-control form-control-modern">
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-6">
                            <label class="form-label small text-muted fw-bold">Ngày vay</label>
                            <input type="date" v-model="debtForm.startDate" class="form-control form-control-modern" :disabled="isEditing">
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted fw-bold">Hạn trả</label>
                            <input type="date" v-model="debtForm.dueDate" class="form-control form-control-modern">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-modern btn-modern-primary rounded-pill px-4 flex-grow-1" @@click="saveDebt">
                        {{ isEditing ? 'Lưu Thay Đổi' : 'Tạo Khoản Nợ' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Modal -->
    <div class="modal fade" id="paymentModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Thanh Toán</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="bg-primary bg-opacity-10 p-4 rounded-3 text-center mb-4">
                        <small class="text-muted d-block uppercase tracking-wide mb-1">Số tiền còn lại</small>
                        <h2 class="text-primary fw-bold mb-0">{{ formatCurrency(selectedDebt?.remainingAmount) }}</h2>
                        <div class="small text-muted mt-1">{{ selectedDebt?.name }}</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small text-muted fw-bold">Nhập số tiền trả</label>
                        <input type="number" v-model.number="paymentForm.amount" class="form-control form-control-modern fs-4 text-center fw-bold text-success">
                    </div>
                    <div class="mb-3">
                         <label class="form-label small text-muted fw-bold">Ngày trả</label>
                         <input type="date" v-model="paymentForm.date" class="form-control form-control-modern">
                    </div>
                    <div class="mb-3">
                         <label class="form-label small text-muted fw-bold">Ghi chú</label>
                         <textarea v-model="paymentForm.note" class="form-control form-control-modern" rows="2"></textarea>
                    </div>
                </div>
                 <div class="modal-footer">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success rounded-pill px-4 flex-grow-1" @@click="confirmPayment">
                         <i class="fas fa-check me-2"></i> Xác Nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Detail Modal -->
    <div class="modal fade" id="debtDetailModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
             <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h4 class="modal-title fw-bold mb-0">{{ selectedDebt?.name }}</h4>
                        <span class="badge rounded-pill mt-2" 
                              :class="selectedDebt?.status === 1 ? 'bg-primary' : (selectedDebt?.status === 3 ? 'bg-success' : 'bg-secondary')">
                              {{ selectedDebt?.statusDisplay }}
                        </span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4 mb-4">
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded-3 h-100 text-center">
                                <small class="text-muted d-block mb-1">Tổng Gốc + Lãi</small>
                                <h5 class="fw-bold text-dark mb-0">{{ formatCurrency(selectedDebt?.totalWithInterest) }}</h5>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded-3 h-100 text-center">
                                <small class="text-muted d-block mb-1">Đã Trả</small>
                                <h5 class="fw-bold text-success mb-0">{{ formatCurrency(selectedDebt?.amountPaid) }}</h5>
                            </div>
                        </div>
                        <div class="col-sm-4">
                             <div class="p-3 bg-light rounded-3 h-100 text-center border border-primary border-opacity-25">
                                <small class="text-primary d-block mb-1">Còn Lại</small>
                                <h5 class="fw-bold text-primary mb-0">{{ formatCurrency(selectedDebt?.remainingAmount) }}</h5>
                            </div>
                        </div>
                    </div>
                    
                    <h6 class="fw-bold mb-3 border-bottom pb-2">Lịch sử giao dịch</h6>
                    <div class="payment-history" style="max-height: 250px; overflow-y: auto;">
                        <div v-if="!selectedDebt?.payments || selectedDebt?.payments.length === 0" class="text-center text-muted py-4">
                            Chưa có giao dịch nào.
                        </div>
                         <div v-for="payment in selectedDebt?.payments" :key="payment.id" class="d-flex justify-content-between align-items-center p-3 mb-2 bg-light rounded-3">
                             <div>
                                 <div class="fw-bold text-dark">{{ formatCurrency(payment.amount) }}</div>
                                 <small class="text-muted">{{ formatDate(payment.paymentDate) }}</small>
                             </div>
                              <div class="text-end small text-muted">
                                  {{ payment.note || 'Thanh toán đợt' }}
                              </div>
                         </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button class="btn btn-outline-danger rounded-pill" @@click="deleteDebt(selectedDebt?.id)">
                        <i class="fas fa-trash-alt me-2"></i> Xóa
                    </button>
                    <div>
                        <button class="btn btn-light rounded-pill px-4 me-2" @@click="openEditModal">Sửa</button>
                        <button class="btn btn-primary rounded-pill px-4" @@click="openPaymentModal(selectedDebt)">Thanh Toán</button>
                    </div>
                </div>
             </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/debts.css" asp-append-version="true" />
}

@section Scripts {
    <script>window.currentUserId = '@Model.CurrentUserId';</script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="~/js/debts.js" asp-append-version="true"></script>
}
