@page
@model MoneyTrackerApp.Pages.Auth.ForgotPasswordModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<section class="auth-container">
    <div class="card">
        <h1>Quên mật khẩu</h1>
        <form id="fp-form">
            <div class="field">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@example.com" required />
            </div>
            <button type="submit" class="btn">Gửi mã đặt lại</button>
        </form>
        <div id="result" class="result" hidden></div>
    </div>
    <style>
        .auth-container{min-height:70vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#a855f7, #0ea5e9 70%);padding:32px}
        .card{width:100%;max-width:420px;background:#fff;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,.15);padding:28px}
        h1{margin:0 0 16px 0;font-size:24px}
        .field{margin-bottom:12px}
        label{display:block;font-size:13px;color:#555;margin-bottom:6px}
        input{width:100%;padding:12px;border-radius:10px;border:1px solid #e5e7eb;outline:none}
        input:focus{border-color:#a855f7;box-shadow:0 0 0 3px rgba(168,85,247,.15)}
        .btn{width:100%;padding:12px;border:none;border-radius:10px;background:#a855f7;color:#fff;font-weight:600;margin-top:8px;cursor:pointer}
        .btn:hover{background:#7e22ce}
        .result{margin-top:12px;font-size:12px;word-break:break-all}
    </style>
</section>
<script>
const form = document.getElementById('fp-form');
const result = document.getElementById('result');
form.addEventListener('submit', async (e)=>{
  e.preventDefault();
  const email = form.email.value.trim();
  const res = await fetch('/api/auth/forgot-password',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ email })
  });
  result.hidden = false;
  result.textContent = res.ok ? 'Đã gửi mã đặt lại nếu email tồn tại' : 'Gửi thất bại';
  result.style.color = res.ok ? '#16a34a' : '#dc2626';
});
</script>