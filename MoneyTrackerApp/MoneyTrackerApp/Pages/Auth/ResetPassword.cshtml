@page
@model MoneyTrackerApp.Pages.Auth.ResetPasswordModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<section class="auth-container">
    <div class="card">
        <h1>Đặt lại mật khẩu</h1>
        <form id="rp-form">
            <div class="field">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@example.com" required />
            </div>
            <div class="field">
                <label>Mã xác thực</label>
                <input type="text" name="token" placeholder="Mã nhận qua email" required />
            </div>
            <div class="field">
                <label>Mật khẩu mới</label>
                <input type="password" name="password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn">Đặt lại</button>
        </form>
        <div id="result" class="result" hidden></div>
    </div>
    <style>
        .auth-container{min-height:70vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#ef4444, #f59e0b 70%);padding:32px}
        .card{width:100%;max-width:480px;background:#fff;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,.15);padding:28px}
        h1{margin:0 0 16px 0;font-size:24px}
        .field{margin-bottom:12px}
        label{display:block;font-size:13px;color:#555;margin-bottom:6px}
        input{width:100%;padding:12px;border-radius:10px;border:1px solid #e5e7eb;outline:none}
        input:focus{border-color:#f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.15)}
        .btn{width:100%;padding:12px;border:none;border-radius:10px;background:#f59e0b;color:#fff;font-weight:600;margin-top:8px;cursor:pointer}
        .btn:hover{background:#d97706}
        .result{margin-top:12px;font-size:12px;word-break:break-all}
    </style>
</section>
<script>
const form = document.getElementById('rp-form');
const result = document.getElementById('result');
form.addEventListener('submit', async (e)=>{
  e.preventDefault();
  const email = form.email.value.trim();
  const token = form.token.value.trim();
  const newPassword = form.password.value;
  const res = await fetch('/api/auth/reset-password',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ email, token, newPassword })
  });
  result.hidden = false;
  result.textContent = res.ok ? 'Đặt lại mật khẩu thành công' : 'Đặt lại thất bại';
  result.style.color = res.ok ? '#16a34a' : '#dc2626';
});
</script>