@page
@model MoneyTrackerApp.Pages.Auth.LoginModel
@{
  Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập - MoneyTrackerApp</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #22c55e;
      --glass-bg: rgba(255, 255, 255, 0.15);
      --glass-border: rgba(255, 255, 255, 0.2);
      --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
      --text-color: #ffffff;
      --input-bg: rgba(255, 255, 255, 0.1);
      --input-border: rgba(255, 255, 255, 0.3);
      --input-focus: rgba(255, 255, 255, 0.2);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background: linear-gradient(45deg, #11998e, #38ef7d, #0f2027);
      background-size: 400% 400%;
      animation: gradientBG 15s ease infinite;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    @@keyframes gradientBG {
      0% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
      100% {
        background-position: 0% 50%;
      }
    }

    /* Decorative Blobs */
    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      z-index: 0;
      opacity: 0.6;
    }

    .blob-1 {
      top: -10%;
      left: -10%;
      width: 500px;
      height: 500px;
      background: #7F00FF;
      animation: float 8s ease-in-out infinite;
    }

    .blob-2 {
      bottom: -10%;
      right: -10%;
      width: 400px;
      height: 400px;
      background: #00C9FF;
      animation: float 10s ease-in-out infinite reverse;
    }

    .blob-3 {
      top: 20%;
      right: 20%;
      width: 300px;
      height: 300px;
      background: #92FE9D;
      animation: float 12s ease-in-out infinite 2s;
    }

    @@keyframes float {
      0% { transform: translate(0, 0); }
      50% { transform: translate(20px, 40px); }
      100% { transform: translate(0, 0); }
    }

    .login-container {
      position: relative;
      z-index: 1;
      width: 100%;
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    .glass-card {
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      border-radius: 24px;
      padding: 48px;
      width: 100%;
      max-width: 450px;
      color: var(--text-color);
      transition: transform 0.3s ease;
    }

    .glass-card:hover {
      transform: translateY(-5px);
    }

    .login-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .login-header h1 {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 8px;
      background: linear-gradient(to right, #fff, #e0e0e0);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .login-header p {
      color: rgba(255, 255, 255, 0.8);
      font-size: 15px;
      font-weight: 300;
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      color: rgba(255, 255, 255, 0.9);
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 8px;
      margin-left: 4px;
    }

    .input-wrapper {
      position: relative;
    }

    .input-wrapper i {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255, 255, 255, 0.6);
      font-size: 18px;
    }

    input {
      width: 100%;
      padding: 14px 16px 14px 48px;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: 12px;
      color: white;
      font-size: 15px;
      font-family: inherit;
      transition: all 0.3s ease;
    }

    input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    input:focus {
      outline: none;
      background: var(--input-focus);
      border-color: rgba(255, 255, 255, 0.6);
      box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
    }

    .btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      font-family: inherit;
    }

    .btn-primary {
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      color: white;
      margin-top: 10px;
      box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4);
      background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
    }

    .btn-primary:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
    }

    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      color: rgba(255, 255, 255, 0.6);
      margin: 24px 0;
      font-size: 13px;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .divider:not(:empty)::before {
      margin-right: 10px;
    }

    .divider:not(:empty)::after {
      margin-left: 10px;
    }

    .btn-google {
      background: rgba(255, 255, 255, 0.95);
      color: #333;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      transition: all 0.3s ease;
    }

    .btn-google:hover {
      background: white;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .login-footer {
      text-align: center;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .login-footer p {
      color: rgba(255, 255, 255, 0.7);
      font-size: 14px;
    }

    .login-footer a {
      color: #4ade80;
      text-decoration: none;
      font-weight: 600;
      margin-left: 4px;
      transition: color 0.3s;
    }

    .login-footer a:hover {
      color: #22c55e;
      text-decoration: underline;
    }

    /* Logo/Brand Icon */
    .brand-icon {
      width: 60px;
      height: 60px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      margin: 0 auto 16px;
      backdrop-filter: blur(10px);
    }

    /* Focus visible for accessibility */
    *:focus-visible {
      outline: 2px solid rgba(255, 255, 255, 0.5);
      outline-offset: 2px;
    }

    /* Improve button hover states */
    .btn-icon:hover {
      background: rgba(255, 255, 255, 0.3);
      transform: scale(1.05);
    }

    .btn-icon:active {
      transform: scale(0.95);
    }

    .alert {
      padding: 12px 16px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      animation: slideIn 0.3s ease;
    }

    @@keyframes slideIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .alert-danger {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    .alert-success {
      background: rgba(34, 197, 94, 0.2);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #86efac;
    }

    /* Responsive Design */
    @@media (max-width: 576px) {
      .glass-card {
        padding: 32px 24px;
        margin: 10px;
      }

      .login-header h1 {
        font-size: 24px;
      }

      .login-header p {
        font-size: 14px;
      }

      input {
        padding: 12px 16px 12px 44px;
        font-size: 14px;
      }

      .btn {
        padding: 12px;
        font-size: 15px;
      }

      .blob {
        display: none;
      }
    }

    /* Loading spinner */
    .fa-circle-notch {
      animation: spin 1s linear infinite;
    }

    @@keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Smooth transitions */
    * {
      transition: all 0.3s ease;
    }

    input, .btn {
      transition: all 0.3s ease;
    }
  </style>
  <!-- FontAwesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
  <!-- Decorative Background Elements -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <!-- Theme & Language Controls -->
  <div style="position: absolute; top: 20px; right: 20px; display: flex; gap: 10px; z-index: 10;">
    <button class="btn-icon" title="Đổi ngôn ngữ" style="background:rgba(255,255,255,0.2); border:1px solid rgba(255,255,255,0.3); color:white; cursor:pointer; width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center;" onclick="toggleLanguage()">
      <i class="fas fa-globe"></i>
    </button>
    <button class="btn-icon" title="Giao diện" style="background:rgba(255,255,255,0.2); border:1px solid rgba(255,255,255,0.3); color:white; cursor:pointer; width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center;" onclick="toggleTheme()">
      <i class="fas fa-moon"></i>
    </button>
  </div>

  <!-- Login Container -->
  <div class="login-container">
    <div class="glass-card">
      <div class="login-header">
        <a href="@Url.Content("~/")" onclick="window.location.href = '@Url.Content("~/")'; return false;" class="text-decoration-none">
          <div class="brand-icon" style="transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="fas fa-wallet" style="color: white;"></i>
          </div>
        </a>
        <h1>Chào mừng trở lại!</h1>
        <p>Đăng nhập để tiếp tục quản lý tài chính</p>
      </div>

      @{
        var error = Request.Query["error"];
      }

      @if (!string.IsNullOrEmpty(error))
      {
        <div class="alert alert-danger">
          <i class="fas fa-exclamation-circle"></i>
          @if (error == "google_failed")
          {
            <span>Đăng nhập Google thất bại. Vui lòng thử lại.</span>
          }
          else if (error == "invalid_credentials")
          {
            <span>Email hoặc mật khẩu không chính xác.</span>
          }
          else if (error == "missing_fields")
          {
            <span>Vui lòng điền đầy đủ email và mật khẩu.</span>
          }
          else
          {
            <span>Lỗi: @error @(string.IsNullOrEmpty(Request.Query["details"]) ? "" : $"({Request.Query["details"]})")</span>
          }
        </div>
      }

      <form id="login-form" method="post" onsubmit="handleLogin(event)">
        <div class="form-group">
          <label for="email">Email</label>
          <div class="input-wrapper">
            <i class="fas fa-envelope"></i>
            <input type="email" id="email" name="email" placeholder="name@example.com" required />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Mật khẩu</label>
          <div class="input-wrapper">
            <i class="fas fa-lock"></i>
            <input type="password" id="password" name="password" placeholder="••••••••" required />
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <label class="remember-me" style="display: flex; align-items: center; font-weight: 400; font-size: 14px; cursor: pointer; margin: 0;">
            <input type="checkbox" id="rememberMe" name="rememberMe" style="width: 16px; height: 16px; margin-right: 8px; accent-color: var(--primary-color);">
            Ghi nhớ đăng nhập
          </label>

        
          <a href="/Auth/ForgotPassword" style="color: rgba(255,255,255,0.8); font-size: 13px; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(255,255,255,0.8)'">
            Quên mật khẩu?
          </a>
        </div>

        <button type="submit" class="btn btn-primary" id="submit-btn">
          Đăng nhập
        </button>
      </form>

      <div class="divider">hoặc tiếp tục với</div>

      <a href="/api/auth/google/start" class="btn btn-google">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
        </svg>
        Google
      </a>

      <div class="login-footer">
        <p>Chưa có tài khoản? <a href="/Auth/Register">Đăng ký ngay</a></p>
      </div>
    </div>
  </div>

  <!-- 2FA Modal -->
  <div id="2fa-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:9999; justify-content:center; align-items:center;">
    <div class="glass-card" style="max-width:400px; padding:30px; animation: slideIn 0.3s ease;">
      <div style="text-align:center;">
        <h2 style="color:white; margin-bottom:10px;">Xác thực 2 lớp</h2>
        <p style="color:rgba(255,255,255,0.7); margin-bottom:20px;">Vui lòng nhập mã xác thực đã được gửi đến email của bạn.</p>
        
        <div id="2fa-error" class="alert alert-danger" style="display:none;"></div>

        <div class="form-group">
          <input type="text" id="2fa-code" placeholder="######" maxlength="6" style="text-align:center; letter-spacing:8px; font-size:24px; font-weight:bold; text-transform:uppercase;" />
        </div>
        
        <button onclick="verify2FA()" class="btn btn-primary" id="btn-verify-2fa">Xác nhận</button>
        <button onclick="close2FA()" class="btn" style="margin-top:10px; background:transparent; border:1px solid rgba(255,255,255,0.3); color:white;">Hủy bỏ</button>
      </div>
    </div>
  </div>

  <script>
    // Helper function to get cookie
    function getCookie(name) {
      const value = `; ${document.cookie}`;
      const parts = value.split(`; ${name}=`);
      if (parts.length === 2) return parts.pop().split(';').shift();
      return null;
    }

    // Toggle language
    function toggleLanguage() {
      const currentLang = localStorage.getItem('language') || 'vi';
      const newLang = currentLang === 'vi' ? 'en' : 'vi';
      localStorage.setItem('language', newLang);
      // In production, this would reload with new language
      alert(`Ngôn ngữ đã chuyển sang: ${newLang === 'vi' ? 'Tiếng Việt' : 'English'}`);
    }

    // Toggle theme
    function toggleTheme() {
      const currentTheme = localStorage.getItem('theme') || 'light';
      const newTheme = currentTheme === 'light' ? 'dark' : 'light';
      localStorage.setItem('theme', newTheme);
      // In production, this would apply theme
      alert(`Giao diện đã chuyển sang: ${newTheme === 'light' ? 'Sáng' : 'Tối'}`);
    }

    function redirectAfterAuth(role, onboardingCompleted) {
      const normalizedRole = (role || '').toLowerCase();
      if (normalizedRole === 'admin') {
        window.location.href = '/Admin/Dashboard';
        return;
      }

      if (onboardingCompleted === false) {
        window.location.href = '/Onboarding/Welcome';
      } else {
        window.location.href = '/home';
      }
    }

    // Check for tokens in URL (from Google callback)
    const params = new URLSearchParams(location.search);
    const accessToken = params.get('accessToken');
    const refreshToken = params.get('refreshToken');
    const roleFromUrl = params.get('role');

    if (accessToken && refreshToken) {
      localStorage.setItem('accessToken', accessToken);
      localStorage.setItem('refreshToken', refreshToken);
      if (roleFromUrl) {
        localStorage.setItem('role', roleFromUrl);
      }
      const sessionId = params.get('sessionId');
      if (sessionId) {
          sessionStorage.setItem('currentSessionId', sessionId);
      }
      
      // Show success message for Google Login
      window.onload = function() {
          showSuccess('Đăng nhập Google thành công! Đang chuyển hướng...');
          setTimeout(() => {
            redirectAfterAuth(roleFromUrl, /*onboardingCompleted*/ undefined);
          }, 1500);
      };
    }

    // Handle form submission
    async function handleLogin(e) {
      e.preventDefault();

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const submitBtn = document.getElementById('submit-btn');

      // Disable button during request
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Đang xử lý...';

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email: email,
            password: password,
            rememberMe: document.getElementById('rememberMe').checked
          })
        });

        if (!response.ok) {
          const data = await response.json().catch(() => ({}));
          showError(data.message || 'Đăng nhập thất bại');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Đăng nhập';
          return;
        }

        const data = await response.json();

        if (data.message === '2fa_required') {
           document.getElementById('2fa-modal').style.display = 'flex';
           window.pendingEmail = email; // Store for verification
           submitBtn.disabled = false;
           submitBtn.textContent = 'Đăng nhập';
           return;
        }

        // Save tokens
        localStorage.setItem('accessToken', data.accessToken);
        localStorage.setItem('refreshToken', data.refreshToken);

        localStorage.setItem('role', data.role || '');
        if (data.sessionId) sessionStorage.setItem('currentSessionId', data.sessionId);
        
        // Show success message
        showSuccess('Đăng nhập thành công! Đang chuyển hướng...');

        // Redirect based on role/onboarding status
        setTimeout(() => {
            redirectAfterAuth(data.role, data.onboardingCompleted);
        }, 1500);
      } catch (error) {
        console.error('Login error:', error);
        showError('Lỗi hệ thống. Vui lòng thử lại.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Đăng nhập';
      }
    }

    // 2FA Functions
    function close2FA() {
        document.getElementById('2fa-modal').style.display = 'none';
        document.getElementById('2fa-code').value = '';
        document.getElementById('2fa-error').style.display = 'none';
    }

    async function verify2FA() {
        const code = document.getElementById('2fa-code').value.trim();
        const btn = document.getElementById('btn-verify-2fa');
        const errorDiv = document.getElementById('2fa-error');
        
        if (!code) return;
        
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Đang kiểm tra...';
        errorDiv.style.display = 'none';

        try {
            const response = await fetch('/api/auth/verify-2fa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    email: window.pendingEmail, 
                    code: code,
                    rememberMe: document.getElementById('rememberMe').checked
                })
            });
            
            if (!response.ok) {
                const data = await response.json().catch(() => ({}));
                errorDiv.textContent = data.message || 'Mã xác thực không đúng';
                errorDiv.style.display = 'flex';
                btn.disabled = false;
                btn.textContent = 'Xác nhận';
                return;
            }

            const data = await response.json();
            localStorage.setItem('accessToken', data.accessToken);
            localStorage.setItem('refreshToken', data.refreshToken);
            localStorage.setItem('role', data.role || '');
            if (data.sessionId) sessionStorage.setItem('currentSessionId', data.sessionId);

            showSuccess('Xác thực thành công! Đang chuyển hướng...');

            setTimeout(() => {
                redirectAfterAuth(data.role, data.onboardingCompleted);
            }, 1000);
        } catch (err) {
            errorDiv.textContent = 'Lỗi kết nối';
            errorDiv.style.display = 'flex';
            btn.disabled = false;
            btn.textContent = 'Xác nhận';
        }
    }

    function showError(message) {
      const form = document.getElementById('login-form');
      const existing = document.querySelector('.alert');
      if (existing) existing.remove();

      const alert = document.createElement('div');
      alert.className = 'alert alert-danger';
      alert.innerHTML = '<i class="fas fa-exclamation-circle"></i> <span>' + message + '</span>';
      form.parentElement.insertBefore(alert, form);

      // Auto remove after 5 seconds
      setTimeout(() => {
        if (alert.parentElement) {
          alert.style.opacity = '0';
          setTimeout(() => alert.remove(), 300);
        }
      }, 5000);
    }

    function showSuccess(message) {
      const form = document.getElementById('login-form');
      const existing = document.querySelector('.alert');
      if (existing) existing.remove();

      const alert = document.createElement('div');
      alert.className = 'alert alert-success';
      alert.innerHTML = '<i class="fas fa-check-circle"></i> <span>' + message + '</span>';
      form.parentElement.insertBefore(alert, form);
    }

    // Add enter key support for 2FA
    document.addEventListener('DOMContentLoaded', function() {
      const twoFAInput = document.getElementById('2fa-code');
      if (twoFAInput) {
        twoFAInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            verify2FA();
          }
        });
      }
    });
  </script>
