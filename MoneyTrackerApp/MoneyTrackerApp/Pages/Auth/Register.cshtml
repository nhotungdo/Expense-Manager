@page
@model MoneyTrackerApp.Pages.Auth.RegisterModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<section class="auth-container">
    <div class="card">
        <h1>Đăng ký</h1>
        <form id="register-form">
            <div class="field">
                <label>Họ tên</label>
                <input type="text" name="fullName" placeholder="Nguyễn Văn A" />
            </div>
            <div class="field">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@example.com" required />
            </div>
            <div class="field">
                <label>Mật khẩu</label>
                <input type="password" name="password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn">Tạo tài khoản</button>
        </form>
        <div id="result" class="result" hidden></div>
    </div>
    <style>
        .auth-container{min-height:70vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#22c55e, #0ea5e9 70%);padding:32px}
        .card{width:100%;max-width:480px;background:#fff;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,.15);padding:28px}
        h1{margin:0 0 16px 0;font-size:24px}
        .field{margin-bottom:12px}
        label{display:block;font-size:13px;color:#555;margin-bottom:6px}
        input{width:100%;padding:12px;border-radius:10px;border:1px solid #e5e7eb;outline:none}
        input:focus{border-color:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.15)}
        .btn{width:100%;padding:12px;border:none;border-radius:10px;background:#22c55e;color:#fff;font-weight:600;margin-top:8px;cursor:pointer}
        .btn:hover{background:#16a34a}
        .result{margin-top:12px;font-size:12px;word-break:break-all}
    </style>
</section>
<script>
const form = document.getElementById('register-form');
const result = document.getElementById('result');
form.addEventListener('submit', async (e)=>{
  e.preventDefault();
  const fullName = form.fullName.value.trim();
  const email = form.email.value.trim();
  const password = form.password.value;
  const res = await fetch('/api/auth/register',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ fullName, email, password })
  });
  const data = await res.json().catch(()=>({message:'Lỗi'}));
  result.hidden = false;
  if(res.ok){
    localStorage.setItem('accessToken', data.accessToken);
    localStorage.setItem('refreshToken', data.refreshToken);
    result.textContent = 'Đăng ký thành công';
    result.style.color = '#16a34a';
  }else{
    result.textContent = data.message || 'Đăng ký thất bại';
    result.style.color = '#dc2626';
  }
});
</script>