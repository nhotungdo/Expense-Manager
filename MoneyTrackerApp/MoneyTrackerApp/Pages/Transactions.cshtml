@page "/Transactions"
@model MoneyTrackerApp.Pages.TransactionsModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Transactions";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4">Transactions</h2>
        <div class="d-flex gap-2">
            <input id="pageSearchInput" type="search" class="form-control" style="min-width:300px;"
                placeholder="Search transactions...">
            <button id="pageSearchBtn" class="btn btn-primary">Search</button>
        </div>
    </div>

    <div id="transactionsContainer">
        <div class="text-center py-5 text-muted">Loading transactions...</div>
    </div>

    <nav id="transactionsPagination" aria-label="Transactions pagination" class="mt-3"></nav>
</div>

<style>
    .transaction-item {
        border-bottom: 1px solid #e9ecef;
        padding: 12px 0;
    }

    .transaction-amount {
        font-weight: 700;
    }
</style>

@section Scripts {
    <script>
        function getQueryParam(name) {
            const params = new URLSearchParams(location.search);
            return params.get(name);
        }

        async function loadTransactions(page = 1) {
            const search = getQueryParam('search') || getQueryParam('q') || document.getElementById('pageSearchInput').value || '';
            const params = new URLSearchParams();
            if (search) params.append('searchText', search);
            params.append('pageNumber', page);
            params.append('pageSize', 50);

            const container = document.getElementById('transactionsContainer');
            container.innerHTML = '<div class="text-center py-4 text-muted">Loading transactions...</div>';

            try {
                const res = await fetch('/api/Transactions?' + params.toString());
                if (res.status === 401) { window.location.href = '/Auth/Login'; return; }
                if (!res.ok) { container.innerHTML = '<div class="text-danger p-3">Failed to load transactions.</div>'; return; }
                const data = await res.json();
                if (!data || data.length === 0) {
                    container.innerHTML = '<div class="text-center py-4 text-muted">No transactions found.</div>';
                    return;
                }

                container.innerHTML = data.map(t => `
                        <div class="transaction-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">${t.description}</div>
                                <div class="small text-muted">${new Date(t.transactionDate).toLocaleString()} • ${t.accountName} • ${t.categoryName || 'Uncategorized'}</div>
                            </div>
                            <div class="text-end">
                                <div class="transaction-amount ${t.transactionTypeDisplay === 'Income' ? 'text-success' : 'text-danger'}">${t.transactionTypeDisplay === 'Income' ? '+' : '-'} ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: t.currency }).format(t.amount)}</div>
                            </div>
                        </div>
                    `).join('');
            } catch (err) {
                console.error('Error loading transactions', err);
                container.innerHTML = '<div class="text-danger p-3">Error loading transactions.</div>';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const q = getQueryParam('search');
            if (q) document.getElementById('pageSearchInput').value = q;
            document.getElementById('pageSearchBtn').addEventListener('click', function () {
                const v = document.getElementById('pageSearchInput').value;
                const url = new URL(location.href);
                url.searchParams.set('search', v);
                location.href = url.toString();
            });

            loadTransactions();
        });
    </script>
}