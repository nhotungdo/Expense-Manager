@page "/home"
@model MoneyTrackerApp.Pages.HomeModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tổng quan";
}

@section Styles {
    <link rel="stylesheet" href="/css/home.css" />
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Tổng quan tài chính</h1>
            <p class="text-slate-500 text-sm mt-1">Chào mừng trở lại, @User.Identity?.Name!</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-50 shadow-sm transition-all" onclick="window.location.reload()">
                <i class="fas fa-sync-alt text-slate-400"></i>
                <span>Làm mới</span>
            </button>
        </div>
    </div>

    <!-- Global Search Bar -->
    <div class="relative">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden transition-all" id="searchContainer">
            <div class="flex items-center gap-3 px-4 py-3">
                <i class="fas fa-search text-slate-400"></i>
                <input 
                    type="text" 
                    id="globalSearch" 
                    placeholder="Tìm kiếm giao dịch, danh mục, tài khoản... (Ctrl+K)" 
                    class="flex-1 outline-none text-sm text-slate-700 placeholder-slate-400 bg-transparent"
                    autocomplete="off"
                />
                <div class="flex items-center gap-2">
                    <!-- Filter Buttons -->
                    <button 
                        class="search-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-slate-100 text-slate-600 hover:bg-slate-200" 
                        data-filter="all"
                        onclick="setSearchFilter('all')"
                    >
                        <i class="fas fa-globe mr-1"></i> Tất cả
                    </button>
                    <button 
                        class="search-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-500 hover:bg-slate-100" 
                        data-filter="transaction"
                        onclick="setSearchFilter('transaction')"
                    >
                        <i class="fas fa-exchange-alt mr-1"></i> Giao dịch
                    </button>
                    <button 
                        class="search-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-500 hover:bg-slate-100" 
                        data-filter="category"
                        onclick="setSearchFilter('category')"
                    >
                        <i class="fas fa-tags mr-1"></i> Danh mục
                    </button>
                    <button 
                        class="search-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-500 hover:bg-slate-100" 
                        data-filter="account"
                        onclick="setSearchFilter('account')"
                    >
                        <i class="fas fa-wallet mr-1"></i> Tài khoản
                    </button>
                    <button 
                        class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 transition-all" 
                        onclick="clearSearch()"
                        id="clearSearchBtn"
                        style="display: none;"
                    >
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            
            <!-- Search Results Dropdown -->
            <div id="searchResults" class="hidden border-t border-slate-100 max-h-96 overflow-y-auto">
                <!-- Loading State -->
                <div id="searchLoading" class="hidden p-6 text-center">
                    <i class="fas fa-circle-notch fa-spin text-2xl text-slate-400 mb-2"></i>
                    <p class="text-sm text-slate-500">Đang tìm kiếm...</p>
                </div>
                
                <!-- Empty State -->
                <div id="searchEmpty" class="hidden p-6 text-center">
                    <i class="fas fa-search text-3xl text-slate-300 mb-2"></i>
                    <p class="text-sm text-slate-500">Không tìm thấy kết quả</p>
                </div>
                
                <!-- Results Container -->
                <div id="searchResultsContent" class="p-4 space-y-4"></div>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Total Assets -->
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-wallet text-6xl text-blue-600"></i>
            </div>
            <div class="relative z-10">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600">
                        <i class="fas fa-wallet text-lg"></i>
                    </div>
                    <h3 class="text-slate-500 font-medium text-sm">Tổng tài sản</h3>
                </div>
                <div class="text-2xl font-bold text-slate-900 mt-2" id="cardTotalAssets">Đang tải...</div>
                <div class="flex items-center gap-2 mt-2 text-sm">
                    <span class="text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-lg font-medium text-xs flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> +12.5%
                    </span>
                    <span class="text-slate-400">so với tháng trước</span>
                </div>
            </div>
        </div>

        <!-- Income -->
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-arrow-down text-6xl text-emerald-600"></i>
            </div>
            <div class="relative z-10">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                        <i class="fas fa-arrow-down text-lg"></i>
                    </div>
                    <h3 class="text-slate-500 font-medium text-sm">Thu nhập tháng này</h3>
                </div>
                <div class="text-2xl font-bold text-slate-900 mt-2" id="monthlyIncome">...</div>
                <div class="flex items-center gap-2 mt-2 text-sm">
                    <span class="text-slate-400">Đã nhận</span>
                </div>
            </div>
        </div>

        <!-- Expense -->
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-arrow-up text-6xl text-rose-600"></i>
            </div>
            <div class="relative z-10">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 rounded-xl bg-rose-50 flex items-center justify-center text-rose-600">
                        <i class="fas fa-arrow-up text-lg"></i>
                    </div>
                    <h3 class="text-slate-500 font-medium text-sm">Chi tiêu tháng này</h3>
                </div>
                <div class="text-2xl font-bold text-slate-900 mt-2" id="monthlyExpense">...</div>
                <div class="flex items-center gap-2 mt-2 text-sm">
                    <span class="text-rose-600 bg-rose-50 px-2 py-0.5 rounded-lg font-medium text-xs flex items-center gap-1">
                        <i class="fas fa-exclamation-circle"></i> Cao hơn TB
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Modern AI Financial Assistant (Trading Analysis Style) -->
    <div class="mb-6">
        <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white p-6 rounded-2xl shadow-xl relative overflow-hidden border border-slate-700/50">
            <!-- Background Decoration -->
            <div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                <i class="fas fa-chart-line text-[120px] text-white"></i>
            </div>
            
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                            <i class="fas fa-brain text-xl text-white"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-lg text-white flex items-center gap-2">
                                Phân tích & Dự báo AI
                                <span class="px-2 py-0.5 rounded text-[10px] bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 uppercase tracking-wide">Beta</span>
                            </h3>
                            <p class="text-slate-400 text-sm">Phân tích hành vi tiêu dùng thời gian thực</p>
                        </div>
                    </div>
                    <div>
                        <button onclick="loadAiAnalysis()" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 transition-colors">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Spending Trend -->
                    <div class="bg-white/5 rounded-xl p-5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-colors group">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="text-slate-400 text-xs uppercase tracking-wider font-semibold">Xu hướng chi tiêu</h4>
                            <i class="fas fa-chart-bar text-indigo-400 group-hover:scale-110 transition-transform"></i>
                        </div>
                        <div class="flex items-baseline gap-2 mb-2">
                            <span class="text-2xl font-bold text-white" id="aiTrendValue">--</span>
                            <span class="text-sm font-medium" id="aiTrendBadge"></span>
                        </div>
                        <p class="text-slate-400 text-xs leading-relaxed" id="aiTrendText">Đang tải dữ liệu...</p>
                    </div>

                    <!-- Prediction -->
                    <div class="bg-white/5 rounded-xl p-5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-colors group">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="text-slate-400 text-xs uppercase tracking-wider font-semibold">Dự báo cuối tháng</h4>
                            <i class="fas fa-crystal-ball text-purple-400 group-hover:scale-110 transition-transform"></i>
                        </div>
                        <div class="mb-3">
                            <span class="text-2xl font-bold text-white" id="aiPredictionValue">--</span>
                            <span class="text-slate-400 text-xs ml-1">VND</span>
                        </div>
                        <div class="w-full bg-slate-700/50 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-gradient-to-r from-indigo-500 to-purple-500 h-full rounded-full transition-all duration-1000" style="width: 0%" id="aiPredictionBar"></div>
                        </div>
                        <div class="flex justify-between mt-2 text-[10px] text-slate-500">
                            <span>Hiện tại</span>
                            <span>Dự kiến</span>
                        </div>
                    </div>

                    <!-- Anomalies -->
                    <div class="bg-white/5 rounded-xl p-5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-colors group">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="text-slate-400 text-xs uppercase tracking-wider font-semibold">Cảnh báo & Insights</h4>
                            <i class="fas fa-bell text-rose-400 group-hover:scale-110 transition-transform"></i>
                        </div>
                        <div id="aiInsightsList" class="space-y-3 max-h-[100px] overflow-y-auto custom-scrollbar">
                            <div class="flex items-start gap-3 animate-pulse">
                                <div class="w-1.5 h-1.5 rounded-full bg-slate-600 mt-1.5"></div>
                                <div class="h-2 bg-slate-700 rounded w-3/4"></div>
                            </div>
                            <div class="flex items-start gap-3 animate-pulse">
                                <div class="w-1.5 h-1.5 rounded-full bg-slate-600 mt-1.5"></div>
                                <div class="h-2 bg-slate-700 rounded w-1/2"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>    <!-- Main Content Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Chart Section (2 cols) -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Expense Breakdown Chart -->
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Phân bổ chi tiêu</h3>
                        <p class="text-sm text-slate-500">Theo danh mục trong tháng này</p>
                    </div>
                    <select id="expenseChartPeriod" class="bg-slate-50 border-0 text-sm font-medium text-slate-600 rounded-lg py-2 pl-3 pr-8 focus:ring-2 focus:ring-blue-500 cursor-pointer">
                        <option value="month">Tháng này</option>
                        <option value="week">Tuần này</option>
                        <option value="year">Năm nay</option>
                    </select>
                </div>
                <div class="h-80 w-full relative flex items-center justify-center">
                    <canvas id="expenseChart"></canvas>
                </div>
            </div>

            <!-- Income Breakdown Chart -->
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Nguồn thu nhập</h3>
                        <p class="text-sm text-slate-500">Phân tích thu nhập theo danh mục</p>
                    </div>
                    <select id="incomeChartPeriod" class="bg-slate-50 border-0 text-sm font-medium text-slate-600 rounded-lg py-2 pl-3 pr-8 focus:ring-2 focus:ring-blue-500 cursor-pointer">
                        <option value="month">Tháng này</option>
                        <option value="week">Tuần này</option>
                        <option value="year">Năm nay</option>
                    </select>
                </div>
                <div class="h-80 w-full relative flex items-center justify-center">
                    <canvas id="incomeChart"></canvas>
                </div>
            </div>
        </div>


        <!-- Right Column (1 col) -->
        <div class="space-y-6">
            <!-- Quick Actions -->
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <h3 class="font-bold text-slate-900 mb-4">Thao tác nhanh</h3>
                <div class="grid grid-cols-2 gap-3">
                    <button onclick="openTransactionModal(1)" class="p-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 transition-colors flex flex-col items-center justify-center gap-2 group cursor-pointer border border-transparent hover:border-emerald-200">
                        <div class="w-8 h-8 rounded-full bg-emerald-100 group-hover:bg-white text-emerald-600 flex items-center justify-center transition-colors">
                            <i class="fas fa-arrow-down"></i>
                        </div>
                        <span class="text-xs font-semibold text-emerald-700">Thu nhập</span>
                    </button>
                    <button onclick="openTransactionModal(2)" class="p-3 rounded-xl bg-rose-50 hover:bg-rose-100 transition-colors flex flex-col items-center justify-center gap-2 group cursor-pointer border border-transparent hover:border-rose-200">
                        <div class="w-8 h-8 rounded-full bg-rose-100 group-hover:bg-white text-rose-600 flex items-center justify-center transition-colors">
                            <i class="fas fa-arrow-up"></i>
                        </div>
                        <span class="text-xs font-semibold text-rose-700">Chi tiêu</span>
                    </button>
                    <button onclick="openTransactionModal(3)" class="p-3 rounded-xl bg-blue-50 hover:bg-blue-100 transition-colors flex flex-col items-center justify-center gap-2 group cursor-pointer border border-transparent hover:border-blue-200">
                        <div class="w-8 h-8 rounded-full bg-blue-100 group-hover:bg-white text-blue-600 flex items-center justify-center transition-colors">
                            <i class="fas fa-exchange-alt"></i>
                        </div>
                        <span class="text-xs font-semibold text-blue-700">Chuyển tiền</span>
                    </button>
                    <button onclick="openExportModal()" class="p-3 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors flex flex-col items-center justify-center gap-2 group cursor-pointer border border-transparent hover:border-slate-200">
                        <div class="w-8 h-8 rounded-full bg-slate-100 group-hover:bg-white text-slate-600 flex items-center justify-center transition-colors">
                            <i class="fas fa-file-export"></i>
                        </div>
                        <span class="text-xs font-semibold text-slate-700">Xuất báo cáo</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm">
        <div class="p-6 border-b border-slate-100">
            <h3 class="text-lg font-bold text-slate-900">Giao dịch gần đây</h3>
        </div>
        <div class="p-0" id="transactionList">
            <div class="p-8 text-center text-slate-400">
                <i class="fas fa-circle-notch fa-spin text-2xl mb-2"></i>
                <p>Đang tải dữ liệu...</p>
            </div>
        </div>
    </div>
</div>



<!-- Modals removed - Use Global Transaction Modal -->


<!-- Export Modal -->
<div class="modal fade" id="exportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl rounded-2xl">
            <div class="modal-header border-0 pb-0 pt-6 px-6">
                <h5 class="modal-title font-bold text-xl text-slate-800">Xuất báo cáo</h5>
                <button type="button" class="btn-close opacity-50 hover:opacity-100" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-6">
                <form id="exportForm">
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Loại báo cáo</label>
                        <select id="exportReportType" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-100 focus:border-blue-400 transition-all">
                            <option value="1">Báo cáo dòng tiền</option>
                            <option value="3">Phân tích danh mục</option>
                            <option value="4">Xu hướng tháng</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Từ ngày</label>
                            <input type="date" id="exportStartDate" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-100 focus:border-blue-400 transition-all">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Đến ngày</label>
                            <input type="date" id="exportEndDate" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-100 focus:border-blue-400 transition-all">
                        </div>
                    </div>
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Định dạng</label>
                        <select id="exportFileFormat" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-100 focus:border-blue-400 transition-all">
                            <option value="1">PDF</option>
                            <option value="2">Excel (XLSX)</option>
                            <option value="3">CSV</option>
                        </select>
                    </div>
                    <button type="submit" class="w-full py-3.5 bg-slate-800 text-white rounded-xl font-bold hover:bg-slate-900 shadow-lg shadow-slate-200 transition-all transform hover:-translate-y-0.5" id="btnExport">
                        Xuất file
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js Library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- Chart Configuration -->
    <script src="/js/charts-config.js"></script>
    

    <!-- Home Page Logic with Pie Charts -->
    <script src="/js/home.js"></script>
    
    <!-- Global Search Functionality -->
    <script src="/js/search.js"></script>
    
    <script type="module">
        // AI and Export logic remain here


        document.addEventListener('DOMContentLoaded', () => {
            loadPersonalWalletData();
            loadAccounts();
            loadAiAnalysis(); // AI Analysis
            
            // Cleaned up Transaction Form listeners as they are now global
            document.getElementById('exportForm').addEventListener('submit', handleExport);
            
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            const exportStart = document.getElementById('exportStartDate');
            const exportEnd = document.getElementById('exportEndDate');
            if(exportStart) exportStart.valueAsDate = firstDay;
            if(exportEnd) exportEnd.valueAsDate = today;
        });

        window.loadAiAnalysis = async function() {
            try {
                const trendVal = document.getElementById('aiTrendValue');
                const trendText = document.getElementById('aiTrendText');
                const trendBadge = document.getElementById('aiTrendBadge');
                
                const predVal = document.getElementById('aiPredictionValue');
                const predBar = document.getElementById('aiPredictionBar');
                
                const insightsList = document.getElementById('aiInsightsList');

                // Loading State
                if(trendText) trendText.innerText = "Đang phân tích...";
                if(insightsList) insightsList.innerHTML = `<div class="flex items-center gap-2 text-sm text-slate-300"><i class="fas fa-circle-notch fa-spin text-purple-400"></i><span>Đang xử lý...</span></div>`;

                const res = await fetch('/api/Analysis?t=' + Date.now(), { credentials: 'include' });
                if(!res.ok) throw new Error("Failed to fetch analysis");
                
                const data = await res.json();
                
                // Trend
                if(trendVal) trendVal.innerText = data.trendPercentage.toFixed(1) + '%';
                if(trendBadge && trendText) {
                    if(data.trend == 'Increasing') {
                        trendBadge.innerHTML = '<i class="fas fa-arrow-up text-rose-400"></i>';
                        trendBadge.className = 'text-sm font-medium text-rose-400';
                        trendText.innerText = 'Chi tiêu tăng so với tháng trước';
                    } else if(data.trend == 'Decreasing') {
                        trendBadge.innerHTML = '<i class="fas fa-arrow-down text-emerald-400"></i>';
                        trendBadge.className = 'text-sm font-medium text-emerald-400';
                        trendText.innerText = 'Chi tiêu giảm so với tháng trước';
                    } else {
                        trendBadge.innerHTML = '<i class="fas fa-minus text-slate-400"></i>';
                        trendBadge.className = 'text-sm font-medium text-slate-400';
                        trendText.innerText = 'Chi tiêu ổn định';
                    }
                }

                // Prediction
                if(predVal) predVal.innerText = new Intl.NumberFormat('vi-VN').format(data.predictedSpendingThisMonth);
                if(predBar) {
                    let pct = 0;
                     if(data.predictedSpendingThisMonth > 0)
                        pct = (data.totalSpendingThisMonth / data.predictedSpendingThisMonth) * 100;
                    if(pct > 100) pct = 100;
                    predBar.style.width = pct + '%';
                }

                // Insights & Anomalies
                let html = '';
                if(insightsList) {
                    // Anomalies first
                    if(data.anomalies) {
                        data.anomalies.forEach(a => {
                            html += `
                            <div class="flex items-start gap-3 p-2 rounded bg-white/5 border border-white/5">
                                <div class="mt-1"><i class="fas fa-exclamation-triangle text-rose-400 text-xs"></i></div>
                                <div>
                                    <p class="text-xs text-white font-medium">${a.note || a.categoryName}</p>
                                    <p class="text-[10px] text-slate-400">${new Intl.NumberFormat('vi-VN').format(a.amount)} VND - ${new Date(a.date).toLocaleDateString('vi-VN')}</p>
                                </div>
                            </div>`;
                        });
                    }

                    // General Insights
                    if(data.insights) {
                        data.insights.forEach(i => {
                             html += `
                            <div class="flex items-start gap-3">
                                <div class="w-1.5 h-1.5 rounded-full bg-indigo-400 mt-1.5 flex-shrink-0"></div>
                                <p class="text-xs text-slate-300 leading-relaxed">${i}</p>
                            </div>`;
                        });
                    }
                    
                    if(html === '') html = '<p class="text-xs text-slate-400">Chưa có dữ liệu phân tích.</p>';
                    insightsList.innerHTML = html;
                }

            } catch(e) {
                console.error(e);
                const trendText = document.getElementById('aiTrendText');
                if(trendText) trendText.innerText = "Không thể tải dữ liệu";
            }
        };

        window.openExportModal = function() {
            const modal = new bootstrap.Modal(document.getElementById('exportModal'));
            modal.show();
        };

        // Export Logic...
        async function handleExport(e) {
            e.preventDefault();
            const btn = document.getElementById('btnExport');
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-2"></i> Đang xử lý...';

            const data = {
                reportType: parseInt(document.getElementById('exportReportType').value),
                startDate: document.getElementById('exportStartDate').value,
                endDate: document.getElementById('exportEndDate').value,
                fileFormat: parseInt(document.getElementById('exportFileFormat').value)
            };

            try {
                const response = await fetch('/api/Report/export', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                    credentials: 'include'
                });

                if (!response.ok) throw new Error('Xuất báo cáo thất bại');

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                
                const contentDisposition = response.headers.get('Content-Disposition');
                let fileName = 'report.csv';
                if (contentDisposition) {
                    const match = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (match && match[1]) fileName = match[1].replace(/['"]/g, '');
                }
                
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);

                bootstrap.Modal.getInstance(document.getElementById('exportModal')).hide();
            } catch (error) {
                console.error(error);
                alert('Không thể xuất báo cáo: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        }
        


        // --- Helper Logic (Charts, Timeline) ---
        // (Existing Chart Rendering logic kept in home.js or here?) 
        // We will assume home.js handles charts. Account loading here for export dropdowns if needed.
        
        let cachedAccounts = [];
        async function loadAccounts() {
             try {
                const res = await fetch('/api/Accounts/summaries', { credentials: 'include' });
                if (res.ok) {
                    cachedAccounts = await res.json();
                }
            } catch (err) { console.error(err); }
        }

        function formatCurrencySimple(val) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(val);
        }
    </script>
}
