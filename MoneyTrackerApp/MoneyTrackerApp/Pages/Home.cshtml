@page "/home"
@model MoneyTrackerApp.Pages.HomeModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tổng quan";
}

<div class="dashboard-container container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Tổng quan</h1>
            <p class="text-muted mb-0">Chào mừng trở lại, <span id="userName" class="fw-bold">User</span>! Đây là tổng quan tài chính của bạn.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="loadDashboardData()">
                <i class="fas fa-sync-alt"></i> Làm mới
            </button>
            <button class="btn btn-primary" onclick="openAddTransactionModal()">
                <i class="fas fa-plus"></i> Thêm giao dịch
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Balance -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-start border-4 border-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng số dư</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalBalance">Đang tải...</div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-primary text-white">
                                💰
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Income -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-start border-4 border-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Thu nhập (Tháng)
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="monthlyIncome">Đang tải...</div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-success text-white">
                                ⬇️
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Expense -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-start border-4 border-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Chi tiêu (Tháng)
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="monthlyExpense">Đang tải...</div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-danger text-white">
                                ⬆️
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Net Savings -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-start border-4 border-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Tiết kiệm ròng</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="netSavings">Đang tải...</div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-info text-white">
                                🐷
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Cash Flow Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4 h-100">
                <div
                    class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white border-bottom-0">
                    <h6 class="m-0 font-weight-bold text-primary">Tổng quan dòng tiền (7 ngày qua)</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area" style="height: 320px;">
                        <canvas id="cashFlowChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Expense Breakdown Pie Chart -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4 h-100">
                <div
                    class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white border-bottom-0">
                    <h6 class="m-0 font-weight-bold text-primary">Chi tiêu hàng đầu</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2" style="height: 250px;">
                        <canvas id="expensePieChart"></canvas>
                    </div>
                    <div class="mt-4 text-center small" id="expenseLegend">
                        <!-- Legend loaded via JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions & Budgets -->
    <div class="row g-4">
        <!-- Recent Transactions -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4 h-100">
                <div class="card-header py-3 bg-white border-bottom-0">
                    <h6 class="m-0 font-weight-bold text-primary">Giao dịch gần đây</h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" id="recentTransactionsList">
                        <div class="text-center py-5 text-muted">Đang tải giao dịch...</div>
                    </div>
                </div>
                <div class="card-footer text-center bg-white border-top-0 pb-3">
                    <a href="#" class="btn btn-sm btn-light text-primary fw-bold">Xem tất cả giao dịch</a>
                </div>
            </div>
        </div>

        <!-- Budget Alerts / Status -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4 h-100">
                <div class="card-header py-3 bg-white border-bottom-0">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng ngân sách</h6>
                </div>
                <div class="card-body">
                    <div id="budgetList">
                        <div class="text-center py-5 text-muted">Đang tải ngân sách...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Transaction Modal Placeholder -->
<div class="modal fade" id="addTransactionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm giao dịch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addTransactionForm">
                    <div class="mb-3">
                                        <label for="accountSelect" class="form-label">Tài khoản</label>
                                        <select id="accountSelect" class="form-select" required>
                                            <option value="">Đang tải tài khoản...</option>
                                        </select>
                                        <div class="invalid-feedback" id="accountError"></div>
                    </div>
                    <div class="mb-3">
                        <label for="transactionType" class="form-label">Loại</label>
                        <select id="transactionType" class="form-select">
                            <option value="2">Chi tiêu</option>
                            <option value="1">Thu nhập</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Danh mục</label>
                        <select id="parentCategorySelect" class="form-select">
                            <option value="">Đang tải danh mục...</option>
                        </select>
                        <select id="childCategorySelect" class="form-select mt-2 d-none">
                            <option value="">Chọn danh mục con...</option>
                        </select>
                        <div class="invalid-feedback" id="categoryError"></div>
                    </div>
                    <div class="mb-3">
                        <label for="amountInput" class="form-label">Số tiền</label>
                        <input id="amountInput" type="number" step="0.01" class="form-control" required />
                        <div class="invalid-feedback" id="amountError"></div>
                    </div>
                    <div class="mb-3">
                        <label for="currencyInput" class="form-label">Đơn vị tiền tệ</label>
                        <input id="currencyInput" type="text" class="form-control" value="VND" maxlength="3" required />
                        <div class="invalid-feedback" id="currencyError"></div>
                    </div>
                    <div class="mb-3">
                        <label for="dateInput" class="form-label">Ngày</label>
                        <input id="dateInput" type="date" class="form-control" required />
                        <div class="invalid-feedback" id="dateError"></div>
                    </div>
                    <div class="mb-3">
                        <label for="noteInput" class="form-label">Ghi chú</label>
                        <input id="noteInput" type="text" class="form-control" maxlength="512" />
                    </div>
                    <div class="mb-3">
                        <label for="receiptFileInput" class="form-label">Đính kèm hóa đơn (tùy chọn)</label>
                        <input id="receiptFileInput" type="file" accept="image/*" class="form-control" />
                        <img id="receiptPreview" src="#" class="img-fluid mt-2 d-none" style="max-height:200px;" />
                        <div class="d-flex align-items-center mt-2">
                            <div id="receiptScanStatus" class="small text-muted"></div>
                            <div id="receiptSpinner" class="spinner-border spinner-border-sm text-primary ms-2 d-none" role="status"><span class="visually-hidden">Đang tải...</span></div>
                        </div>
                        <input type="hidden" id="attachmentUrl" />
                        <input type="hidden" id="ocrText" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="submitAddTransaction" class="btn btn-primary">Lưu giao dịch</button>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-circle {
        height: 3rem;
        width: 3rem;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .card {
        border: none;
        border-radius: 0.75rem;
    }

    .shadow {
        box-shadow: 0 .15rem 1.75rem 0 rgba(58, 59, 69, .15) !important;
    }

    .text-gray-800 {
        color: #5a5c69 !important;
    }

    .text-gray-300 {
        color: #dddfeb !important;
    }

    .border-left-primary {
        border-left: .25rem solid #4e73df !important;
    }

    .border-left-success {
        border-left: .25rem solid #1cc88a !important;
    }

    .border-left-info {
        border-left: .25rem solid #36b9cc !important;
    }

    .border-left-warning {
        border-left: .25rem solid #f6c23e !important;
    }

    .border-left-danger {
        border-left: .25rem solid #e74a3b !important;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global Chart Instances
        let cashFlowChartInstance = null;
        let expensePieChartInstance = null;

        async function loadDashboardData() {
            try {
                const response = await fetch('/api/dashboard');
                if (!response.ok) {
                    if (response.status === 401) window.location.href = '/Auth/Login';
                    return;
                }

                const data = await response.json();
                updateSummaryCards(data);
                renderCashFlowChart(data.cashFlowChart);
                renderExpensePieChart(data.expensePieChart);
                renderRecentTransactions(data.recentTransactions);
                renderBudgetAlerts(data.budgetAlerts);

                // Set user name if available (from layout or token)
                // document.getElementById('userName').textContent = ...; 
            } catch (error) {
                console.error('Error loading dashboard:', error);
            }
        }

        function updateSummaryCards(data) {
            document.getElementById('totalBalance').textContent = formatCurrency(data.currentBalance);
            document.getElementById('monthlyIncome').textContent = formatCurrency(data.monthlyIncome);
            document.getElementById('monthlyExpense').textContent = formatCurrency(data.monthlyExpense);
            document.getElementById('netSavings').textContent = formatCurrency(data.monthlySavings);
        }

        function renderCashFlowChart(chartData) {
            const ctx = document.getElementById('cashFlowChart').getContext('2d');

            if (cashFlowChartInstance) cashFlowChartInstance.destroy();

            cashFlowChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: chartData.labels,
                    datasets: [
                        {
                            label: 'Thu nhập',
                            data: chartData.incomeData,
                            borderColor: '#1cc88a',
                            backgroundColor: 'rgba(28, 200, 138, 0.05)',
                            tension: 0.3,
                            fill: true
                        },
                        {
                            label: 'Chi tiêu',
                            data: chartData.expenseData,
                            borderColor: '#e74a3b',
                            backgroundColor: 'rgba(231, 74, 59, 0.05)',
                            tension: 0.3,
                            fill: true
                        }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        function renderExpensePieChart(chartData) {
            const ctx = document.getElementById('expensePieChart').getContext('2d');

            if (expensePieChartInstance) expensePieChartInstance.destroy();

            if (!chartData || chartData.length === 0) {
                // Handle empty data
                return;
            }

            expensePieChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: chartData.map(d => d.label),
                    datasets: [{
                        data: chartData.map(d => d.value),
                        backgroundColor: chartData.map(d => d.color || '#4e73df'),
                        hoverOffset: 4
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Custom Legend
            const legendHtml = chartData.map(d => `
                        <span class="mr-2">
                            <i class="fas fa-circle" style="color: ${d.color || '#4e73df'}"></i> ${d.label}
                        </span>
                    `).join(' ');
            document.getElementById('expenseLegend').innerHTML = legendHtml;
        }

        function renderRecentTransactions(transactions) {
            const container = document.getElementById('recentTransactionsList');
            if (!transactions || transactions.length === 0) {
                container.innerHTML = '<div class="text-center py-4 text-muted">Không có giao dịch gần đây.</div>';
                return;
            }

            container.innerHTML = transactions.map(t => `
                        <div class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-light text-primary me-3" style="width: 40px; height: 40px; font-size: 1.2rem;">
                                    ${t.categoryIcon || '📄'}
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">${t.description}</div>
                                    <div class="small text-muted">${new Date(t.date).toLocaleDateString()}</div>
                                </div>
                            </div>
                            <div class="fw-bold ${t.type === 'Income' ? 'text-success' : 'text-danger'}">
                                ${t.type === 'Income' ? '+' : '-'} ${formatCurrency(t.amount)}
                            </div>
                        </div>
                    `).join('');
        }

        function renderBudgetAlerts(alerts) {
            const container = document.getElementById('budgetList');
            if (!alerts || alerts.length === 0) {
                container.innerHTML = '<div class="text-center py-4 text-muted">Không có cảnh báo ngân sách. Bạn đang làm rất tốt!</div>';
                return;
            }

            container.innerHTML = alerts.map(a => `
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small font-weight-bold">${a.categoryName}</span>
                                <span class="small font-weight-bold ${a.percentage > 100 ? 'text-danger' : ''}">${Math.round(a.percentage)}%</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar ${a.percentage > 100 ? 'bg-danger' : (a.percentage > 80 ? 'bg-warning' : 'bg-success')}" 
                                     role="progressbar" 
                                     style="width: ${Math.min(a.percentage, 100)}%"></div>
                            </div>
                            <div class="small text-muted mt-1">${a.message}</div>
                        </div>
                    `).join('');
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        }

        function openAddTransactionModal() {
            var modalEl = document.getElementById('addTransactionModal');
            var modal = new bootstrap.Modal(modalEl);
            // Load accounts into the form each time modal opens
            loadAccountSummaries().catch(err => console.warn('Failed to load accounts', err));
            // load parent categories and reset child select
            loadParentCategories().catch(err => console.warn('Failed to load categories', err));
            const childSel = document.getElementById('childCategorySelect');
            if (childSel) { childSel.classList.add('d-none'); childSel.innerHTML = '<option value="">Chọn danh mục con...</option>'; }
            modal.show();
        }

        async function loadAccountSummaries() {
            const select = document.getElementById('accountSelect');
            if (!select) return;
            select.innerHTML = '<option value="">Đang tải tài khoản...</option>';

            try {
                const res = await fetch('/api/Accounts/summaries');
                if (!res.ok) {
                    select.innerHTML = '<option value="">Không thể tải tài khoản</option>';
                    return;
                }
                const accounts = await res.json();
                if (!accounts || accounts.length === 0) {
                    select.innerHTML = '<option value="">Không có tài khoản nào</option>';
                    return;
                }
                select.innerHTML = accounts.map(a => `<option value="${a.id}">${a.name} (${a.currency}) - ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: a.currency }).format(a.currentBalance)}</option>`).join('');
            } catch (err) {
                console.error('Error loading accounts', err);
                select.innerHTML = '<option value="">Lỗi tải tài khoản</option>';
            }
        }

        async function submitAddTransaction() {
            const accountId = parseInt(document.getElementById('accountSelect').value);
            const transactionType = parseInt(document.getElementById('transactionType').value);
            const amount = parseFloat(document.getElementById('amountInput').value);
            const currency = (document.getElementById('currencyInput').value || 'VND').toUpperCase();
            const transactionDate = document.getElementById('dateInput').value;
            const note = document.getElementById('noteInput').value || null;
            // client-side validation (inline)
            if (!validateAddTransactionForm()) return;

            const dto = {
                accountId: accountId,
                categoryId: (function () {
                    const child = document.getElementById('childCategorySelect');
                    if (child && !child.classList.contains('d-none') && child.value) return parseInt(child.value);
                    const parent = document.getElementById('parentCategorySelect');
                    return parent && parent.value ? parseInt(parent.value) : null;
                })(),
                transactionType: transactionType,
                amount: amount,
                currency: currency,
                note: note,
                transactionDate: transactionDate,
                attachmentUrl: document.getElementById('attachmentUrl')?.value || null,
                ocrText: document.getElementById('ocrText')?.value || null
            };

            try {
                const res = await fetch('/api/Transactions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });

                if (res.status === 401) {
                    window.location.href = '/Auth/Login';
                    return;
                }

                if (!res.ok) {
                    const body = await res.json().catch(() => ({}));
                    alert('Không thể tạo giao dịch: ' + (body?.message || res.statusText));
                    return;
                }

                // Success: close modal and refresh dashboard
                const modalEl = document.getElementById('addTransactionModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                await loadDashboardData();
            } catch (err) {
                console.error('Error creating transaction', err);
                alert('Lỗi tạo giao dịch');
            }
        }

        document.addEventListener('DOMContentLoaded', loadDashboardData);

        // Wire up add-transaction submit button
        document.addEventListener('DOMContentLoaded', function () {
            const submitBtn = document.getElementById('submitAddTransaction');
            if (submitBtn) submitBtn.addEventListener('click', submitAddTransaction);
        });

        // Load parent categories and wire child population
        let __allCategoriesCache = null;
        async function loadParentCategories(type = null) {
            const parent = document.getElementById('parentCategorySelect');
            const child = document.getElementById('childCategorySelect');
            if (!parent) return;
            parent.innerHTML = '<option value="">Đang tải danh mục...</option>';
            try {
                const url = '/api/Categories' + (type ? `?type=${type}` : '');
                const res = await fetch(url);
                if (!res.ok) {
                    parent.innerHTML = '<option value="">Không thể tải danh mục</option>';
                    return;
                }
                const cats = await res.json();
                __allCategoriesCache = cats || [];

                const parents = (__allCategoriesCache || []).filter(c => !c.parentCategoryId);
                if (!parents || parents.length === 0) {
                    parent.innerHTML = '<option value="">Không có danh mục</option>';
                } else {
                    parent.innerHTML = [`<option value="">(Không có danh mục)</option>`].concat(
                        parents.map(p => `<option value="${p.id}">${p.name}</option>`)
                    ).join('');
                }

                // attach change handler
                parent.removeEventListener('change', _parentChangeHandler);
                parent.addEventListener('change', _parentChangeHandler);
                // reset child
                if (child) { child.classList.add('d-none'); child.innerHTML = '<option value="">Chọn danh mục con...</option>'; }
            } catch (err) {
                console.error('Error loading parent categories', err);
                parent.innerHTML = '<option value="">Lỗi tải danh mục</option>';
            }
        }

        function _parentChangeHandler(e) {
            const parentId = e.target.value;
            if (!parentId) {
                const child = document.getElementById('childCategorySelect');
                if (child) { child.classList.add('d-none'); child.innerHTML = '<option value="">Chọn danh mục con...</option>'; }
                return;
            }
            loadChildCategories(parseInt(parentId));
        }

        async function loadChildCategories(parentId) {
            const child = document.getElementById('childCategorySelect');
            if (!child) return;
            child.innerHTML = '<option value="">Đang tải...</option>';
            try {
                let subs = [];
                if (__allCategoriesCache) {
                    subs = __allCategoriesCache.filter(c => c.parentCategoryId === parentId);
                } else {
                    // fallback call: request subcategories from API
                    const res = await fetch(`/api/Categories?parentId=${parentId}`);
                    if (res.ok) subs = await res.json();
                }

                if (!subs || subs.length === 0) {
                    child.classList.add('d-none');
                    child.innerHTML = '<option value="">Không có danh mục con</option>';
                    return;
                }

                child.classList.remove('d-none');
                child.innerHTML = [`<option value="">(Không có danh mục con)</option>`].concat(
                    subs.map(s => `<option value="${s.id}">${s.name}</option>`)
                ).join('');
            } catch (err) {
                console.error('Error loading child categories', err);
                child.classList.add('d-none');
                child.innerHTML = '<option value="">Lỗi tải danh mục con</option>';
            }
        }

        // Validation: inline bootstrap feedback
        function clearValidationStates() {
            ['accountSelect','amountInput','currencyInput','dateInput','parentCategorySelect','childCategorySelect'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.remove('is-invalid');
            });
            ['accountError','amountError','currencyError','dateError','categoryError'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.textContent = '';
            });
        }

        function validateAddTransactionForm() {
            clearValidationStates();
            let ok = true;
            const account = document.getElementById('accountSelect');
            const amountEl = document.getElementById('amountInput');
            const currencyEl = document.getElementById('currencyInput');
            const dateEl = document.getElementById('dateInput');
            const parent = document.getElementById('parentCategorySelect');
            const child = document.getElementById('childCategorySelect');

            if (!account || !account.value) {
                ok = false;
                account.classList.add('is-invalid');
                document.getElementById('accountError').textContent = 'Vui lòng chọn tài khoản.';
            }

            const amount = parseFloat(amountEl?.value || '0');
            if (!amountEl || isNaN(amount) || amount <= 0) {
                ok = false;
                amountEl.classList.add('is-invalid');
                document.getElementById('amountError').textContent = 'Nhập số tiền hợp lệ lớn hơn 0.';
            }

            const currency = (currencyEl?.value || '').trim();
            if (!currency || currency.length !== 3) {
                ok = false;
                currencyEl.classList.add('is-invalid');
                document.getElementById('currencyError').textContent = 'Mã tiền tệ phải có 3 ký tự.';
            }

            if (!dateEl || !dateEl.value) {
                ok = false;
                dateEl.classList.add('is-invalid');
                document.getElementById('dateError').textContent = 'Vui lòng chọn ngày.';
            }

            // optional: require category? skip but mark if invalid format
            // Choose category: prefer child if visible
            const chosenCat = (child && !child.classList.contains('d-none') && child.value) ? child.value : (parent && parent.value ? parent.value : '');
            if (chosenCat === '') {
                // no category selected is allowed; do not mark invalid by default
            }

            return ok;
        }

        // Receipt handling: preview, upload, OCR scan
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('receiptFileInput');
            if (fileInput) fileInput.addEventListener('change', handleReceiptFileSelect);
        });

        function showReceiptPreviewDataUrl(dataUrl) {
            const img = document.getElementById('receiptPreview');
            if (!img) return;
            img.src = dataUrl;
            img.classList.remove('d-none');
        }

        function setProcessing(isProcessing) {
            const submitBtn = document.getElementById('submitAddTransaction');
            const fileInput = document.getElementById('receiptFileInput');
            const spinner = document.getElementById('receiptSpinner');
            if (submitBtn) submitBtn.disabled = !!isProcessing;
            if (fileInput) fileInput.disabled = !!isProcessing;
            if (spinner) spinner.classList.toggle('d-none', !isProcessing);
        }

        function setReceiptStatus(text, isError = false) {
            const el = document.getElementById('receiptScanStatus');
            if (!el) return;
            el.textContent = text;
            el.classList.toggle('text-danger', isError);
        }

        function fileToDataUrl(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        async function handleReceiptFileSelect(e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            setProcessing(true);
            try {
                setReceiptStatus('Đang chuẩn bị hóa đơn...');
                const dataUrl = await fileToDataUrl(file);
                showReceiptPreviewDataUrl(dataUrl);

                // Extract base64 (strip data:*/*;base64, prefix)
                const base64 = (dataUrl + '').split(',')[1] || '';

                // 1) Call OCR process endpoint
                setReceiptStatus('Đang quét hóa đơn (OCR)...');
                const ocrRes = await fetch('/api/ocr/process', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ imageBase64: base64 })
                });
                if (!ocrRes.ok) {
                    setReceiptStatus('OCR thất bại: ' + ocrRes.statusText, true);
                } else {
                    const ocr = await ocrRes.json();
                    // Pre-fill fields if OCR extracted values
                    if (ocr) {
                        if (ocr.amount) document.getElementById('amountInput').value = ocr.amount;
                        if (ocr.date) {
                            // Convert to yyyy-MM-dd
                            const d = new Date(ocr.date);
                            if (!isNaN(d)) {
                                const yyyy = d.getFullYear();
                                const mm = String(d.getMonth() + 1).padStart(2, '0');
                                const dd = String(d.getDate()).padStart(2, '0');
                                document.getElementById('dateInput').value = `${yyyy}-${mm}-${dd}`;
                            }
                        }
                        if (ocr.merchantName) document.getElementById('noteInput').value = ocr.merchantName;
                        if (ocr.rawText) document.getElementById('ocrText').value = ocr.rawText;
                    }
                    setReceiptStatus('Quét OCR hoàn tất. Đang tải lên hóa đơn...');

                    // 2) Upload the receipt file to server so we can attach URL
                    const fd = new FormData();
                    fd.append('file', file);
                    const upRes = await fetch('/api/ocr/upload', { method: 'POST', body: fd });
                    if (!upRes.ok) {
                        setReceiptStatus('Tải lên thất bại: ' + upRes.statusText, true);
                        document.getElementById('attachmentUrl').value = '';
                    } else {
                        const up = await upRes.json();
                        const url = up?.url || up?.attachmentUrl || null;
                        document.getElementById('attachmentUrl').value = url || '';
                        setReceiptStatus(url ? 'Hóa đơn đã được tải lên' : 'Đã tải lên nhưng không có URL trả về');
                    }
                }
            } catch (err) {
                console.error('Receipt handling error', err);
                setReceiptStatus('Lỗi xử lý hóa đơn', true);
            } finally {
                setProcessing(false);
            }
        }
    </script>
}