@page "/home"
@model MoneyTrackerApp.Pages.HomeModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Bento Grid -->
<div class="bento-container">
    
    <!-- Scorecard 1: Total Balance -->
    <div class="bento-card bento-col-1">
        <div class="card-header-clean">
            <h3 class="card-title">Tổng tài sản</h3>
            <div class="icon-btn text-primary"><i class="fas fa-eye"></i></div>
        </div>
        <div class="score-value text-primary" id="cardTotalAssets">Đang tải...</div>
        <div class="score-trend text-muted">
            Tổng số dư trên tất cả các ví
        </div>
    </div>

    <!-- Scorecard 2: Income -->
    <div class="bento-card bento-col-1">
        <div class="card-header-clean">
            <h3 class="card-title">Thu nhập</h3>
            <div class="icon-btn text-success"><i class="fas fa-arrow-down"></i></div>
        </div>
        <div class="score-value text-success" id="monthlyIncome">...</div>
        <div class="score-trend trend-up">
            <i class="fas fa-chart-line"></i> Tháng này
        </div>
    </div>

    <!-- Scorecard 3: Expense -->
    <div class="bento-card bento-col-1">
        <div class="card-header-clean">
            <h3 class="card-title">Chi tiêu</h3>
            <div class="icon-btn text-danger"><i class="fas fa-arrow-up"></i></div>
        </div>
        <div class="score-value text-danger" id="monthlyExpense">...</div>
        <div class="score-trend trend-down">
            <i class="fas fa-level-down-alt"></i> Tháng này
        </div>
    </div>

    <!-- AI Insights -->
    <div class="bento-card bento-col-1" style="background: linear-gradient(135deg, #4f46e5, #818cf8); color: white;">
        <div class="card-header-clean">
            <h3 class="card-title" style="color: white;"><i class="fas fa-robot"></i> Tư vấn AI</h3>
        </div>
        <p class="mb-0" style="font-size: 0.95rem; opacity: 0.9;">
            "Dựa trên thói quen của bạn, bạn sắp vượt quá ngân sách Ăn uống. Hãy chú ý!"
        </p>
    </div>

    <!-- Cashflow Chart -->
    <div class="bento-card bento-col-2 bento-row-2">
        <div class="card-header-clean">
            <h3 class="card-title">Dòng tiền</h3>
            <select class="form-select form-select-sm w-auto border-0 bg-light">
                <option>30 ngày qua</option>
                <option>7 ngày qua</option>
            </select>
        </div>
        <div style="flex: 1; position: relative;">
            <canvas id="cashflowChart"></canvas>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="bento-card bento-col-2 bento-row-2">
        <div class="card-header-clean">
            <h3 class="card-title">Giao dịch gần đây</h3>
            <a href="/Transactions/Index" class="text-sm text-primary font-bold">Xem tất cả</a>
        </div>
        <div style="overflow-y: auto; max-height: 400px; padding-right: 5px;">
            <div id="transactionList">
                <div class="text-center text-muted py-5">Đang tải giao dịch...</div>
            </div>
        </div>
    </div>

</div>

<!-- Transaction Modal (Clean Style) -->
<div class="modal fade" id="transactionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="transactionModalTitle">Giao dịch mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="transactionForm">
                    <input type="hidden" id="transType" value="2">
                    
                    <div class="mb-4 text-center">
                        <label class="small text-muted text-uppercase fw-bold mb-2">Số tiền</label>
                        <div class="input-group justify-content-center">
                            <input type="number" class="form-control border-0 text-center fw-bold fs-1 p-0 shadow-none" 
                                   id="transAmount" placeholder="0" required min="0" style="max-width: 250px;">
                        </div>
                        <span class="text-muted small">VND</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="fw-semibold small text-muted mb-1">Ví</label>
                            <select class="form-select bg-light border-0 py-2.5 rounded-3" id="transAccount" required>
                                <option value="">Chọn ví...</option>
                            </select>
                        </div>
                    </div>

                     <div class="row g-3 mb-3">
                         <div class="col-6">
                            <label class="fw-semibold small text-muted mb-1">Ngày</label>
                            <input type="date" class="form-control bg-light border-0 py-2.5 rounded-3" id="transDate" required>
                         </div>
                         <div class="col-6">
                             <label class="fw-semibold small text-muted mb-1">Danh mục</label>
                             <select class="form-select bg-light border-0 py-2.5 rounded-3" id="transCategory">
                                <option value="">Chọn...</option>
                            </select>
                         </div>
                    </div>

                    <div class="mb-4">
                        <label class="fw-semibold small text-muted mb-1">Ghi chú</label>
                        <textarea class="form-control bg-light border-0 rounded-3" id="transNote" rows="2" 
                                  placeholder="Nội dung giao dịch..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm" id="btnSaveTrans" 
                            style="border-radius: 1rem;">
                        Lưu giao dịch
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Transfer Modal -->
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-primary">Chuyển tiền</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="transferForm">
                     <div class="mb-4 text-center">
                        <label class="small text-muted text-uppercase fw-bold mb-2">Số tiền</label>
                        <input type="number" class="form-control border-0 text-center fw-bold fs-1 p-0 shadow-none text-primary" 
                               id="transferAmount" placeholder="0" required min="0">
                        <span class="text-muted small">VND</span>
                    </div>
                    <!-- Reuse logic from existing transfer options -->
                    <!-- ... Simplified for brevity, similar to above ... -->
                     <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm" id="btnSaveTransfer" 
                            style="border-radius: 1rem;">
                        Xác nhận chuyển
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import { validateTransactionInput, buildTransactionDto, createTransaction } from '/js/transactions-utils.js';
        document.addEventListener('DOMContentLoaded', () => {
            loadPersonalWalletData();
            loadAccounts();
            
            document.getElementById('transDate').valueAsDate = new Date();
            document.getElementById('transactionForm').addEventListener('submit', saveTransaction);
        });

        // Chart Instance
        let cashflowChart = null;

        async function loadPersonalWalletData() {
            try {
                const response = await fetch('/api/dashboard', { credentials: 'include' });
                if (!response.ok) return;

                const data = await response.json();

                // 1. Asset Overview
                document.getElementById('cardTotalAssets').textContent = formatCurrencySimple(data.currentBalance);

                // 2. Scorecards
                const incomeTotal = (data.cashFlowChart?.incomeData || []).reduce((a, b) => a + b, 0);
                const expenseTotal = (data.cashFlowChart?.expenseData || []).reduce((a, b) => a + b, 0);

                document.getElementById('monthlyIncome').textContent = formatCurrencySimple(incomeTotal);
                document.getElementById('monthlyExpense').textContent = formatCurrencySimple(expenseTotal);

                // 3. Transactions
                renderTimeline(data.recentTransactions);

                // 4. Chart
                renderChart(data.cashFlowChart);

            } catch (error) {
                console.error('Error loading data:', error);
            }
        }

        function renderChart(chartData) {
            const ctx = document.getElementById('cashflowChart').getContext('2d');
            
            if (cashflowChart) {
                cashflowChart.destroy();
            }

            const labels = chartData?.labels || ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
            const incomeData = chartData?.incomeData || [0,0,0,0,0,0,0];
            const expenseData = chartData?.expenseData || [0,0,0,0,0,0,0];

            cashflowChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Thu nhập',
                            data: incomeData,
                            backgroundColor: '#10b981',
                            borderRadius: 6,
                        },
                        {
                            label: 'Chi tiêu',
                            data: expenseData,
                            backgroundColor: '#ef4444',
                            borderRadius: 6,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f3f4f6', borderDash: [5, 5] },
                            ticks: { display: false }
                        },
                        x: {
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
                    }
                }
            });
        }

        function renderTimeline(transactions) {
            const list = document.getElementById('transactionList');
            if (!transactions || transactions.length === 0) {
                list.innerHTML = '<div class="text-center text-muted py-4">Không có giao dịch gần đây.</div>';
                return;
            }

            list.innerHTML = `<table class="clean-table">
                ${transactions.map(t => {
                    const isIncome = t.transactionType === 1;
                    const isExpense = t.transactionType === 2;
                    const amountClass = isIncome ? 'amount-inc' : (isExpense ? 'amount-exp' : 'text-primary');
                    const sign = isIncome ? '+' : (isExpense ? '-' : '');
                    
                    return `
                    <tr>
                        <td style="width: 50px;">
                            <div class="cat-icon text-muted">
                                ${t.categoryIcon || '<i class="fas fa-file-invoice-dollar"></i>'}
                            </div>
                        </td>
                        <td>
                            <div class="font-bold text-main">${t.categoryName || 'Giao dịch'}</div>
                            <div class="text-xs text-muted">${t.accountName} • ${new Date(t.transactionDate).toLocaleDateString('vi-VN')}</div>
                        </td>
                        <td class="text-end">
                            <div class="${amountClass}">${sign}${formatCurrencySimple(t.amount)}</div>
                        </td>
                    </tr>
                    `;
                }).join('')}
            </table>`;
        }
        
        // --- Helper Logic ---
        
        let cachedAccounts = [];
        async function loadAccounts() {
             try {
                const res = await fetch('/api/Accounts/summaries', { credentials: 'include' });
                if (res.ok) {
                    cachedAccounts = await res.json();
                    const transSelect = document.getElementById('transAccount');
                    if(transSelect) {
                        transSelect.innerHTML = '<option value="">Chọn ví...</option>' + 
                            cachedAccounts.map(a => `<option value="${a.id}">${a.name} (${formatCurrencySimple(a.currentBalance)})</option>`).join('');
                    }
                }
            } catch (err) { console.error(err); }
        }

        function openTransactionModal(typeStr) {
            const isIncome = typeStr === 'Income';
            const modalTitle = document.getElementById('transactionModalTitle');
            const btnSave = document.getElementById('btnSaveTrans');
            const transType = document.getElementById('transType');
            
            transType.value = isIncome ? '1' : '2';
            modalTitle.textContent = isIncome ? 'Thu nhập mới' : 'Chi tiêu mới';
            btnSave.className = `btn w-100 py-3 rounded-3 fw-bold shadow-sm ${isIncome ? 'btn-success' : 'btn-danger'}`;
            
            const modal = new bootstrap.Modal(document.getElementById('transactionModal'));
            modal.show();
            
            loadCategories(isIncome ? 1 : 2);
        }
        
        async function loadCategories(type) {
             const select = document.getElementById('transCategory');
             select.innerHTML = '<option>Đang tải...</option>';
             try {
                 const res = await fetch(`/api/Categories?type=${type}`, { credentials: 'include' });
                 if(res.ok) {
                     const cats = await res.json();
                     select.innerHTML = '<option value="">Chọn...</option>' + 
                        cats.map(c => `<option value="${c.id}">${c.icon||''} ${c.name}</option>`).join('');
                 }
             } catch(e){}
        }

        async function saveTransaction(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSaveTrans');
            btn.disabled = true;
            btn.textContent = 'Đang lưu...';
            
            const raw = {
                type: parseInt(document.getElementById('transType').value),
                amount: parseFloat(document.getElementById('transAmount').value),
                accountId: document.getElementById('transAccount').value,
                categoryId: document.getElementById('transCategory').value || null,
                date: document.getElementById('transDate').value,
                note: document.getElementById('transNote').value,
                currency: 'VND'
            };

            const { valid, errors } = validateTransactionInput(raw);
            if (!valid) {
                alert('Dữ liệu không hợp lệ:\n' + errors.join('\n'));
                btn.disabled = false;
                btn.textContent = 'Lưu giao dịch';
                return;
            }

            const dto = buildTransactionDto(raw);

            try {
                const result = await createTransaction(dto);
                if(result.ok) {
                   bootstrap.Modal.getInstance(document.getElementById('transactionModal')).hide();
                   // Refresh data
                   loadPersonalWalletData();
                   loadAccounts(); // Update balances
                   btn.textContent = 'Đã lưu!';
                   setTimeout(() => btn.disabled = false, 1000);
                } else {
                    alert('Lưu giao dịch thất bại: ' + (result.error || 'Lỗi không xác định'));
                    btn.disabled = false;
                    btn.textContent = 'Lưu giao dịch';
                }
            } catch (err) {
                 console.error(err);
                 btn.disabled = false;
                 btn.textContent = 'Save Transaction';
            }
        }

        function formatCurrencySimple(val) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(val);
        }
    </script>
}
