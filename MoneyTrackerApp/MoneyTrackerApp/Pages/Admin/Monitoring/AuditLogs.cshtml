@page
@model MoneyTrackerApp.Pages.Admin.Monitoring.AuditLogsModel
@{
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nhật ký kiểm toán";
}

<div class="card-modern mb-4">
    <div class="section-title">
        <span>Bộ lọc Nhật ký</span>
    </div>
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label small text-muted text-uppercase fw-bold">Người dùng</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                <input class="form-control bg-light border-start-0 ps-0" placeholder="Email / ID..." />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted text-uppercase fw-bold">Hành động</label>
            <select class="form-select bg-light">
                <option>Tất cả hành động</option>
                <option>Refund</option>
                <option>Price Change</option>
                <option>Cancel Subscription</option>
                <option>Grant</option>
                <option>Login</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted text-uppercase fw-bold">Thời gian</label>
            <input type="date" class="form-control bg-light" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100"><i class="fas fa-filter me-2"></i> Lọc dữ liệu</button>
        </div>
    </div>
</div>

<div class="card-modern">
    <div class="section-title">
        <span>Danh sách Audit Logs</span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-file-export me-1"></i> Xuất CSV</button>
            <button class="btn btn-sm btn-light"><i class="fas fa-sync-alt"></i></button>
        </div>
    </div>

    <div class="table-responsive table-modern-wrapper">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Người dùng</th>
                    <th>Hành động</th>
                    <th>Chi tiết</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-muted font-monospace small">2025-01-02 09:20</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-light text-secondary d-flex justify-content-center align-items-center" style="width: 24px; height: 24px; font-size: 10px;">A</div>
                            <span class="fw-medium">admin@sample.com</span>
                        </div>
                    </td>
                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">Refund</span></td>
                    <td>Hoàn tiền TX-0001, thu hồi gói Pro</td>
                    <td class="font-monospace text-muted small">192.168.1.10</td>
                </tr>
                <tr>
                    <td class="text-muted font-monospace small">2025-01-02 10:05</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-light text-secondary d-flex justify-content-center align-items-center" style="width: 24px; height: 24px; font-size: 10px;">O</div>
                            <span class="fw-medium">ops@sample.com</span>
                        </div>
                    </td>
                    <td><span class="badge bg-warning-subtle text-warning border border-warning-subtle">Price Change</span></td>
                    <td>Chỉnh giá gói Business từ 499k → 449k</td>
                    <td class="font-monospace text-muted small">192.168.1.11</td>
                </tr>
                <tr>
                    <td class="text-muted font-monospace small">2025-01-02 11:00</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-light text-secondary d-flex justify-content-center align-items-center" style="width: 24px; height: 24px; font-size: 10px;">S</div>
                            <span class="fw-medium">support@sample.com</span>
                        </div>
                    </td>
                    <td><span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancel</span></td>
                    <td>Hủy gói user kol@brand.com theo yêu cầu</td>
                    <td class="font-monospace text-muted small">192.168.1.12</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
