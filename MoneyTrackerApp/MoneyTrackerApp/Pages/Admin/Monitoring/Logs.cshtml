@page
@model MoneyTrackerApp.Pages.Admin.Monitoring.LogsModel
@{
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Logs hệ thống";
}

<div class="row g-4 mb-4">
    <!-- Stats Cards -->
    <div class="col-md-4">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                     <div class="stat-label">Lỗi ứng dụng (24h)</div>
                     <div class="stat-value text-danger">5</div>
                     <div class="stat-trend text-muted"><small>Cần kiểm tra</small></div>
                </div>
                <div class="stat-icon" style="color: #ef4444; background-color: #fee2e2;"><i class="fas fa-bug"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                     <div class="stat-label">Webhook thất bại</div>
                     <div class="stat-value text-warning">2</div>
                     <div class="stat-trend text-muted"><small>Đang thử lại</small></div>
                </div>
                <div class="stat-icon" style="color: #f59e0b; background-color: #fef3c7;"><i class="fas fa-satellite-dish"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                     <div class="stat-label">Retry thành công</div>
                     <div class="stat-value text-success">98%</div>
                     <div class="stat-trend text-success"><small>Hoạt động tốt</small></div>
                </div>
                <div class="stat-icon" style="color: #10b981; background-color: #d1fae5;"><i class="fas fa-redo"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card-modern mb-4">
    <div class="section-title">
        <span>Application Logs</span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-filter me-1"></i> Bộ lọc</button>
            <button class="btn btn-sm btn-light"><i class="fas fa-sync-alt"></i></button>
        </div>
    </div>
    
    <!-- Filter Bar -->
    <div class="row g-2 mb-4">
        <div class="col-md-3">
             <select class="form-select form-select-sm bg-light border-0">
                <option>Tất cả mức độ</option>
                <option>Error</option>
                <option>Warning</option>
                <option>Info</option>
            </select>
        </div>
        <div class="col-md-4">
            <div class="search-box w-100">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Tìm kiếm log..." style="background-color: #f8fafc;">
            </div>
        </div>
        <div class="col-md-3">
            <input type="date" class="form-control form-control-sm bg-light border-0" />
        </div>
    </div>

    <div class="table-responsive table-modern-wrapper">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Cấp độ</th>
                    <th>Nguồn</th>
                    <th>Thông điệp</th>
                    <th class="text-end">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-muted font-monospace small">2025-01-02 10:05</td>
                    <td><span class="status-badge danger">Error</span></td>
                    <td class="fw-medium">CheckoutController</td>
                    <td>Timeout khi gọi Payment Gateway</td>
                    <td class="text-end"><button class="btn btn-sm btn-light border hover-shadow"><i class="fas fa-eye"></i></button></td>
                </tr>
                <tr>
                    <td class="text-muted font-monospace small">2025-01-02 10:15</td>
                    <td><span class="status-badge warning">Warn</span></td>
                    <td class="fw-medium">SubscriptionJob</td>
                    <td>Retry charge lần 2</td>
                    <td class="text-end"><button class="btn btn-sm btn-light border hover-shadow"><i class="fas fa-eye"></i></button></td>
                </tr>
                <tr>
                    <td class="text-muted font-monospace small">2025-01-02 11:20</td>
                    <td><span class="status-badge info">Info</span></td>
                    <td class="fw-medium">WebhookReceiver</td>
                    <td>Stripe event invoice.paid</td>
                    <td class="text-end"><button class="btn btn-sm btn-light border hover-shadow"><i class="fas fa-eye"></i></button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card-modern">
    <div class="section-title">
        <span>Webhook Logs</span>
        <small class="text-muted fw-normal ms-2">Các sự kiện từ cổng thanh toán</small>
    </div>
    <div class="table-responsive table-modern-wrapper">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Gateway</th>
                    <th>Event</th>
                    <th>Trạng thái</th>
                    <th>Đã thử</th>
                    <th>Cập nhật</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold"><i class="fab fa-stripe text-primary me-2"></i>Stripe</td>
                    <td class="font-monospace text-primary">invoice.payment_failed</td>
                    <td><span class="status-badge danger">Failed</span></td>
                    <td>2 lần</td>
                    <td class="text-muted small">5 phút trước</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary ms-1"><i class="fas fa-redo me-1"></i> Retry</button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">Momo</td>
                    <td class="font-monospace text-primary">payment.success</td>
                    <td><span class="status-badge success">Success</span></td>
                    <td>1 lần</td>
                    <td class="text-muted small">30 phút trước</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-light border hover-shadow"><i class="fas fa-eye"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

