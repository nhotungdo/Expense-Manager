@page
@model MoneyTrackerApp.Pages.Admin.ServicePackagesModel
@{
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý gói dịch vụ";
}

<div class="card-modern">
    <div class="section-title">
        <span>Gói dịch vụ</span>
        <button class="btn btn-primary btn-sm" onclick="openCreateModal()">
            <i class="fas fa-plus me-1"></i> Thêm gói mới
        </button>
    </div>
    
    <div class="table-responsive table-modern-wrapper">
        <table class="table-modern" id="packagesTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên gói</th>
                    <th>Giá</th>
                    <th>Thời hạn</th>
                    <th>Trạng thái</th>
                    <th>Thứ tự</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody id="packagesTableBody">
                <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                        <i class="fas fa-spinner fa-spin fa-2x mb-2"></i>
                        <p class="mb-0">Đang tải dữ liệu...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="packageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm gói dịch vụ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="packageForm">
                    <input type="hidden" id="packageId" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold">Tên gói *</label>
                            <input type="text" class="form-control bg-light" id="packageName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold">Giá (VNĐ) *</label>
                            <input type="number" class="form-control bg-light" id="packagePrice" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold">Giá gốc (VNĐ)</label>
                            <input type="number" class="form-control bg-light" id="packageOriginalPrice" />
                            <div class="form-text">Giá gạch ngang (nếu có khuyến mãi)</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold">Thời hạn (ngày) *</label>
                            <input type="number" class="form-control bg-light" id="packageDuration" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Mô tả ngắn</label>
                        <textarea class="form-control bg-light" id="packageDescription" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Tính năng *</label>
                        <textarea class="form-control bg-light font-monospace" id="packageFeatures" rows="5" required placeholder="- Tính năng 1&#10;- Tính năng 2"></textarea>
                        <small class="text-muted">Nhập mỗi tính năng trên một dòng</small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small text-muted text-uppercase fw-bold">Badge Text</label>
                            <input type="text" class="form-control bg-light" id="packageBadgeText" placeholder="VD: Bán chạy" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted text-uppercase fw-bold">Màu Badge</label>
                            <select class="form-select bg-light" id="packageBadgeColor">
                                <option value="">Không có</option>
                                <option value="popular">Popular (Vàng)</option>
                                <option value="discount">Discount (Đỏ)</option>
                                <option value="new">New (Xanh)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted text-uppercase fw-bold">Thứ tự</label>
                            <input type="number" class="form-control bg-light" id="packageDisplayOrder" value="0" />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-light rounded">
                                <input class="form-check-input ms-0 me-3 float-none" type="checkbox" id="packageIsPopular">
                                <label class="form-check-label fw-medium" for="packageIsPopular">Đánh dấu phổ biến</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch p-3 bg-light rounded">
                                <input class="form-check-input ms-0 me-3 float-none" type="checkbox" id="packageIsActive" checked>
                                <label class="form-check-label fw-medium" for="packageIsActive">Kích hoạt</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary px-4" onclick="savePackage()">
                    <i class="fas fa-save me-1"></i> Lưu lại
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-service-packages.js"></script>
    <script>
        // Override the render function in external JS to match new HTML structure
        window.addEventListener('load', function() {
            window.renderPackagesTable = function() {
                const tbody = document.getElementById('packagesTableBody');
                if (packages.length === 0) {
                     tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted">Chưa có gói dịch vụ nào.</td></tr>`;
                     return;
                }

                tbody.innerHTML = packages.map(pkg => `
                    <tr>
                        <td class="font-monospace text-muted small">#${pkg.id}</td>
                        <td>
                            <div class="fw-bold text-dark">${pkg.name}</div>
                            ${pkg.badgeText ? `<span class="badge bg-warning text-dark border-0 small mt-1">${pkg.badgeText}</span>` : ''}
                        </td>
                        <td>
                            <div class="fw-bold text-success">${formatCurrency(pkg.price)} ₫</div>
                            ${pkg.originalPrice ? `<div class="text-decoration-line-through text-muted small">${formatCurrency(pkg.originalPrice)} ₫</div>` : ''}
                        </td>
                        <td class="text-muted small">${pkg.durationDays >= 365 ? Math.floor(pkg.durationDays / 365) + ' năm' : pkg.durationDays + ' ngày'}</td>
                        <td>
                            <span class="status-badge ${pkg.isActive ? 'success' : 'danger'}">
                                ${pkg.isActive ? 'Active' : 'Inactive'}
                            </span>
                            ${pkg.isPopular ? '<span class="status-badge warning ms-1"><i class="fas fa-star"></i> Popular</span>' : ''}
                        </td>
                        <td class="text-muted text-center">${pkg.displayOrder}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-light border hover-shadow" onclick="editPackage(${pkg.id})">
                                <i class="fas fa-edit text-secondary"></i>
                            </button>
                            <button class="btn btn-sm btn-light border hover-shadow ms-1" onclick="deletePackage(${pkg.id})">
                                <i class="fas fa-trash text-danger"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            };
            
            // Re-render because loadPackages might have finished before we overrode the function
            if(packages && packages.length > 0) renderPackagesTable();
        });
    </script>
}
