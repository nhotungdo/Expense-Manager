@page
@model MoneyTrackerApp.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "System Settings";
    Layout = "_AdminLayout";
}

<div class="row g-4 justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="admin-card">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">General Configuration</h5>
                <p class="text-secondary small mb-0">Monitor and update system parameters</p>
            </div>
            
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <!-- Maintenance Mode -->
                    <div class="list-group-item p-4 border-0 border-bottom">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="fw-bold mb-1">Maintenance Mode</h6>
                                <p class="text-secondary small mb-0">Disable access for standard users during updates.</p>
                            </div>
                            <form method="post" asp-page-handler="MaintenanceMode">
                                <div class="form-check form-switch">
                                    @{
                                        var maintMode = Model.Settings.FirstOrDefault(s => s.Key == "MaintenanceMode");
                                        var isMaint = maintMode?.Value == "true" && maintMode?.IsActive == true;
                                    }
                                    <input class="form-check-input" type="checkbox" role="switch" name="enabled" value="true" 
                                           onchange="this.form.submit()" @(isMaint ? "checked" : "")>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Other Settings List -->
                    @foreach (var setting in Model.Settings.Where(s => s.Key != "MaintenanceMode"))
                    {
                        <div class="list-group-item p-4 border-0 border-bottom">
                            <form method="post" asp-page-handler="Update" asp-route-key="@setting.Key">
                                <div class="row align-items-center">
                                    <div class="col-md-4">
                                        <h6 class="fw-bold mb-1">@setting.Key</h6>
                                        <p class="text-secondary small mb-0">@setting.Description</p>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="text" class="form-control" name="UpdateSetting.Value" value="@setting.Value">
                                        <input type="hidden" name="UpdateSetting.IsActive" value="true" />
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <button class="btn btn-sm btn-outline-primary">Save</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }

                    @if (!Model.Settings.Any())
                    {
                        <div class="p-5 text-center text-secondary">
                            <i class="fas fa-cogs fa-3x mb-3 text-light"></i>
                            <p>No settings found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Info Panel -->
    <div class="col-12 col-lg-4">
        <div class="admin-card bg-primary text-white mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">System Info</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2 opacity-75">Version: <span class="fw-bold">v2.4.0</span></li>
                    <li class="mb-2 opacity-75">Environment: <span class="fw-bold">Production</span></li>
                    <li class="opacity-75">Server Time: <span class="fw-bold">@DateTime.UtcNow.ToString("HH:mm") UTC</span></li>
                </ul>
            </div>
        </div>
    </div>
</div>
