@page
@model MoneyTrackerApp.Pages.Admin.Notifications.EmailSenderModel
@{
    ViewData["Title"] = "Gửi thông báo Email";
    Layout = "_AdminLayout";
}

<div class="row g-4">
    <!-- Email Composition Form -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="card-title mb-0 fw-bold"><i class="fas fa-edit me-2 text-primary"></i>Soạn Email</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @Model.StatusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="Input.To" class="form-label fw-medium">Người nhận (Email)</label>
                        <input asp-for="Input.To" class="form-control" placeholder="example1@gmail.com" />
                        <div class="form-text">Phân cách nhiều email bằng dấu phẩy.</div>
                        <span asp-validation-for="Input.To" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Subject" class="form-label fw-medium">Tiêu đề</label>
                        <input asp-for="Input.Subject" class="form-control" placeholder="Nhập tiêu đề email..." />
                        <span asp-validation-for="Input.Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Body" class="form-label fw-medium">Nội dung</label>
                        <textarea asp-for="Input.Body" class="form-control" rows="8" placeholder="Nhập nội dung email..."></textarea>
                        <span asp-validation-for="Input.Body" class="text-danger small"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Attachments" class="form-label fw-medium">Đính kèm</label>
                            <input asp-for="Input.Attachments" class="form-control" type="file" multiple />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ScheduleTime" class="form-label fw-medium">Lên lịch (Tùy chọn)</label>
                            <input asp-for="Input.ScheduleTime" class="form-control" type="datetime-local" />
                            <div class="form-text">Để trống nếu muốn gửi ngay.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="reset" class="btn btn-light"><i class="fas fa-undo me-2"></i>Làm mới</button>
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-paper-plane me-2"></i>Gửi Email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- History Logs -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold"><i class="fas fa-history me-2 text-primary"></i>Lịch sử gửi</h5>
                <a href="javascript:void(0)" onclick="window.location.reload()" class="btn btn-sm btn-icon btn-light" title="Làm mới"><i class="fas fa-sync-alt"></i></a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light sticky-top">
                            <tr>
                                <th class="ps-3">Người nhận</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-3">Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.EmailLogs.Any())
                            {
                                foreach (var log in Model.EmailLogs)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-medium text-truncate" style="max-width: 150px;" title="@log.RecipientEmail">@log.RecipientEmail</div>
                                            <div class="small text-muted text-truncate" style="max-width: 150px;" title="@log.Subject">@log.Subject</div>
                                        </td>
                                        <td>
                                            @if (log.Status == "Sent")
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill">Đã gửi</span>
                                            }
                                            else if (log.Status == "Pending")
                                            {
                                                <span class="badge bg-warning-subtle text-warning rounded-pill">Đang xử lý</span>
                                            }
                                            else if (log.Status == "Scheduled")
                                            {
                                                <span class="badge bg-info-subtle text-info rounded-pill">Đã lên lịch</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill">Thất bại</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3 small text-muted">
                                            @log.CreatedAt?.ToString("dd/MM HH:mm")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                        Chưa có lịch sử gửi email nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
