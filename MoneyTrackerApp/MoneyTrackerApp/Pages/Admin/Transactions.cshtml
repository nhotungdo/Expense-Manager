@page
@model MoneyTrackerApp.Pages.Admin.TransactionsModel
@{
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sổ giao dịch";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                     <div class="stat-label">Doanh thu (MRR)</div>
                     <div class="stat-value">--</div>
                     <div class="stat-trend text-muted"><small>Ước tính</small></div>
                </div>
                <div class="stat-icon bg-light text-success"><i class="fas fa-money-bill-wave"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
         <div class="card-modern">
            <div class="stat-card">
                <div>
                     <div class="stat-label">Thanh toán (24h)</div>
                     <div class="stat-value">--</div>
                     <div class="stat-trend text-success"><small><i class="fas fa-arrow-up"></i> Tăng nhẹ</small></div>
                </div>
                <div class="stat-icon bg-light text-primary"><i class="fas fa-check-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
         <div class="card-modern">
            <div class="stat-card">
                <div>
                     <div class="stat-label">Hoàn tiền</div>
                     <div class="stat-value">--</div>
                     <div class="stat-trend text-muted"><small>Chưa có dữ liệu</small></div>
                </div>
                <div class="stat-icon bg-light text-warning"><i class="fas fa-undo"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
         <div class="card-modern">
            <div class="stat-card">
                <div>
                     <div class="stat-label">Cổng thanh toán</div>
                     <div class="stat-value" style="font-size: 1.2rem;">Stripe / Paypal</div>
                     <div class="stat-trend text-success"><small>Hoạt động tốt</small></div>
                </div>
                <div class="stat-icon bg-light text-info"><i class="fas fa-plug"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card-modern mb-4">
    <div class="section-title">Bộ lọc & Công cụ</div>
    <div class="row g-3 align-items-end">
        <div class="col-lg-3">
            <label class="form-label small text-muted text-uppercase fw-bold">Từ ngày</label>
            <input type="date" class="form-control">
        </div>
        <div class="col-lg-3">
            <label class="form-label small text-muted text-uppercase fw-bold">Đến ngày</label>
            <input type="date" class="form-control">
        </div>
        <div class="col-lg-2">
            <label class="form-label small text-muted text-uppercase fw-bold">Trạng thái</label>
            <select class="form-select">
                <option>Tất cả</option>
                <option>Thành công</option>
                <option>Thất bại</option>
                <option>Hoàn tiền</option>
            </select>
        </div>
        <div class="col-lg-2">
            <label class="form-label small text-muted text-uppercase fw-bold">Cổng</label>
            <select class="form-select">
                <option>Tất cả</option>
                <option>Stripe</option>
                <option>Paypal</option>
            </select>
        </div>
        <div class="col-lg-2">
            <button class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> Áp dụng</button>
        </div>
    </div>
</div>

<div class="card-modern">
    <div class="section-title">
        <span>Danh sách giao dịch</span>
        <div class="d-flex gap-2">
             <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-download me-1"></i> Xuất CSV</button>
             <button class="btn btn-sm btn-light"><i class="fas fa-sync-alt"></i></button>
        </div>
    </div>
    
    <div class="table-responsive table-modern-wrapper">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Mã GD</th>
                    <th>Khách hàng</th>
                    <th>Gói dịch vụ</th>
                    <th>Cổng</th>
                    <th>Số tiền</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="font-monospace text-muted">TX-2025-001</td>
                    <td class="fw-medium">minh.nguyen@example.com</td>
                    <td><span class="badge bg-light text-dark border">Pro Monthly</span></td>
                    <td><i class="fab fa-stripe text-primary fa-lg"></i></td>
                    <td class="fw-bold">299,000₫</td>
                    <td class="text-muted small">01/01/2025 10:30</td>
                    <td><span class="status-badge success">Thành công</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-light border"><i class="fas fa-ellipsis-h"></i></button>
                    </td>
                </tr>
                 <tr>
                    <td class="font-monospace text-muted">TX-2025-002</td>
                    <td class="fw-medium">sarah.lee@demo.com</td>
                    <td><span class="badge bg-light text-dark border">Pro Yearly</span></td>
                    <td><i class="fab fa-paypal text-primary fa-lg"></i></td>
                    <td class="fw-bold">2,990,000₫</td>
                    <td class="text-muted small">01/01/2025 14:15</td>
                    <td><span class="status-badge danger">Thất bại</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-light border"><i class="fas fa-ellipsis-h"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>





