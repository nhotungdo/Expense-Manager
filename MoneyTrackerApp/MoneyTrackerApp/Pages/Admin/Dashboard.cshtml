@page
@model MoneyTrackerApp.Pages.Admin.DashboardModel
@{
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tổng quan hệ thống";
}

<!-- Stats Row -->
<div class="row g-4 mb-4">
    <!-- Total Users -->
    <div class="col-md-6 col-lg-3">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Người dùng</div>
                    <div class="stat-value">@Model.DashboardData.TotalUsers.ToString("N0")</div>
                    <div class="stat-trend text-success">
                        <i class="fas fa-arrow-up"></i>
                        <span>+@Model.DashboardData.NewUsersToday hôm nay</span>
                    </div>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- AUM -->
    <div class="col-md-6 col-lg-3">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Tổng tài sản (AUM)</div>
                    <div class="stat-value">@Model.DashboardData.SystemAum.ToString("N0")</div>
                    <div class="stat-trend text-muted">
                        <small>Toàn hệ thống</small>
                    </div>
                </div>
                <div class="stat-icon" style="color: #10b981; background-color: #d1fae5;">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Traffic -->
    <div class="col-md-6 col-lg-3">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Lưu lượng hôm nay</div>
                    <div class="stat-value">@Model.DashboardData.TodayTransactionsCount.ToString("N0")</div>
                    <div class="stat-trend text-warning">
                        <small>Yêu cầu xử lý</small>
                    </div>
                </div>
                <div class="stat-icon" style="color: #f59e0b; background-color: #fef3c7;">
                    <i class="fas fa-exchange-alt"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- System Health -->
    <div class="col-md-6 col-lg-3">
        <div class="card-modern">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Sức khỏe hệ thống</div>
                    <div class="stat-value">@Model.DashboardData.SystemHealthWarnings</div>
                    <div class="stat-trend @(Model.DashboardData.SystemHealthWarnings > 0 ? "text-danger" : "text-muted")">
                        @if(Model.DashboardData.SystemHealthWarnings > 0)
                        {
                            <i class="fas fa-exclamation-triangle"></i> <span>Có cảnh báo</span>
                        }
                        else
                        {
                            <i class="fas fa-check-circle text-success"></i> <span class="text-success">Hoạt động tốt</span>
                        }
                    </div>
                </div>
                <div class="stat-icon" style="color: #ef4444; background-color: #fee2e2;">
                    <i class="fas fa-heartbeat"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Row -->
<div class="row g-4 mb-4">
    <!-- Chart Section -->
    <div class="col-lg-8">
        <div class="card-modern">
            <div class="section-title">
                <span>Lưu lượng truy cập</span>
                <select class="form-select form-select-sm w-auto" style="border-radius: 6px;">
                    <option>7 ngày qua</option>
                    <option>Tháng này</option>
                </select>
            </div>
            <div id="trafficChart" class="chart-container"></div>
        </div>
    </div>

    <!-- Server Status -->
    <div class="col-lg-4">
        <div class="card-modern">
            <div class="section-title">
                <span>Trạng thái dịch vụ</span>
                <button class="btn btn-sm btn-light rounded-circle"><i class="fas fa-sync-alt"></i></button>
            </div>
            
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between align-items-center pb-2 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded bg-light text-secondary"><i class="fas fa-database"></i></div>
                        <span class="fw-medium">Database Engine</span>
                    </div>
                    <span class="status-badge success"><i class="fas fa-check"></i> Online</span>
                </div>
                
                <div class="d-flex justify-content-between align-items-center pb-2 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded bg-light text-secondary"><i class="fas fa-envelope"></i></div>
                        <span class="fw-medium">Email Service</span>
                    </div>
                    <span class="status-badge warning"><i class="fas fa-clock"></i> Waiting</span>
                </div>

                <div class="d-flex justify-content-between align-items-center pb-2 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded bg-light text-secondary"><i class="fas fa-university"></i></div>
                        <span class="fw-medium">Banking API</span>
                    </div>
                    <span class="status-badge danger"><i class="fas fa-times"></i> Error</span>
                </div>

                <div class="d-flex justify-content-between align-items-center pb-2 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded bg-light text-secondary"><i class="fas fa-memory"></i></div>
                        <span class="fw-medium">Redis Cache</span>
                    </div>
                    <span class="status-badge success"><i class="fas fa-check"></i> Online</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Logs -->
<div class="row">
    <div class="col-12">
        <div class="card-modern">
            <div class="section-title">
                <span>Nhật ký bảo mật gần đây</span>
                <a href="/Admin/Monitoring/AuditLogs" class="text-primary text-decoration-none small fw-bold">Xem tất cả <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
            
            <div class="table-modern-wrapper">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Người dùng</th>
                            <th>Hành động</th>
                            <th>IP Address</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                         @if (Model.DashboardData.RecentAuditLogs != null && Model.DashboardData.RecentAuditLogs.Any())
                        {
                            foreach (var log in Model.DashboardData.RecentAuditLogs.Take(5))
                            {
                                <tr>
                                    <td class="text-muted">@log.Time.ToString("dd/MM HH:mm")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-light text-secondary d-flex justify-content-center align-items-center" style="width: 24px; height: 24px; font-size: 10px;">
                                                @log.UserEmail?.Substring(0,1).ToUpper()
                                            </div>
                                            <span class="fw-medium">@log.UserEmail</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-normal">@log.Action</span>
                                    </td>
                                    <td class="font-monospace text-muted small">@log.IpAddress</td>
                                    <td><span class="status-badge success">Success</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                             <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                                    Không có dữ liệu nhật ký mới
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var trafficLabels = [];
        var trafficData = [];
        
        @if(Model.DashboardData.TransactionVolumeChart != null)
        {
            foreach(var item in Model.DashboardData.TransactionVolumeChart)
            {
                @:trafficLabels.push("@item.Day");
                @:trafficData.push(@item.Count);
            }
        }
        
        if (trafficLabels.length === 0) {
            trafficLabels = ["08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00"];
            trafficData = [30, 40, 35, 50, 49, 60, 70];
        }

        var options = {
            series: [{
                name: 'Requests',
                data: trafficData
            }],
            chart: {
                height: 320,
                type: 'area',
                toolbar: { show: false },
                fontFamily: 'Plus Jakarta Sans, sans-serif'
            },
            dataLabels: { enabled: false },
            stroke: {
                curve: 'smooth',
                width: 2
            },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.05,
                    stops: [0, 90, 100]
                }
            },
            xaxis: {
                categories: trafficLabels,
                axisBorder: { show: false },
                axisTicks: { show: false }
            },
            yaxis: {
                show: true,
                tickAmount: 5
            },
            grid: {
                borderColor: '#f1f5f9',
                strokeDashArray: 4,
            },
            theme: {
                monochrome: {
                    enabled: true,
                    color: '#4f46e5',
                    shadeTo: 'light',
                    shadeIntensity: 0.65
                }
            }
        };

        var chart = new ApexCharts(document.querySelector("#trafficChart"), options);
        chart.render();
    </script>
}
