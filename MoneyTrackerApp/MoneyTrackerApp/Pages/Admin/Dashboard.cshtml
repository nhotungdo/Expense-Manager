@page
@model MoneyTrackerApp.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "_AdminLayout";
    var data = Model.Data;
}

<div class="row g-4 mb-4">
    <!-- Welcome Section -->
    <div class="col-12 col-xl-8">
        <div class="admin-card bg-gradient-brand text-white border-0 shadow-lg h-100">
            <div class="card-body p-4 p-md-5 d-flex align-items-center justify-content-between position-relative overflow-hidden">
                <div class="position-relative z-1">
                    <h2 class="fw-bold mb-2">Xin chào, Admin! 👋</h2>
                    <p class="mb-4 opacity-75 fs-5">Hệ thống đang hoạt động ổn định. Chúc bạn một ngày làm việc hiệu quả!</p>
                    <div class="d-flex gap-3">
                        <button class="btn btn-light text-primary fw-bold px-4" onclick="document.getElementById('quickActions').scrollIntoView({behavior: 'smooth'})">
                            <i class="fas fa-bolt me-2"></i>Thao tác nhanh
                        </button>
                        <a href="/Admin/Monitoring/Logs" class="btn btn-outline-light px-4">
                            <i class="fas fa-terminal me-2"></i>Xem Logs
                        </a>
                    </div>
                </div>
                <!-- Abstract Decoration -->
                <div class="position-absolute end-0 bottom-0 opacity-25 me-n5 mb-n5 d-none d-md-block" style="transform: rotate(-15deg);">
                    <i class="fas fa-chart-pie" style="font-size: 15rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Card (New Feature) -->
    <div class="col-12 col-xl-4">
        <div class="admin-card h-100" id="quickActions">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">Thao tác nhanh</h5>
            </div>
            <div class="card-body pt-0">
                <div class="row g-2">
                    <div class="col-6">
                        <a href="/Admin/Users" class="btn btn-light w-100 h-100 p-3 text-start border hover-shadow transition-all">
                            <div class="text-primary mb-2"><i class="fas fa-user-plus fa-2x"></i></div>
                            <div class="fw-bold text-dark">Quản lý User</div>
                        </a>
                    </div>
                    <div class="col-6">
                         <a href="/Admin/ServicePackages" class="btn btn-light w-100 h-100 p-3 text-start border hover-shadow transition-all">
                            <div class="text-warning mb-2"><i class="fas fa-box-open fa-2x"></i></div>
                            <div class="fw-bold text-dark">Gói dịch vụ</div>
                        </a>
                    </div>
                    <div class="col-6">
                         <a href="/Admin/Settings" class="btn btn-light w-100 h-100 p-3 text-start border hover-shadow transition-all">
                            <div class="text-info mb-2"><i class="fas fa-cogs fa-2x"></i></div>
                            <div class="fw-bold text-dark">Cấu hình</div>
                        </a>
                    </div>
                     <div class="col-6">
                         <a href="/Admin/Transactions?Filter.StartDate=@DateTime.Now.ToString("yyyy-MM-dd")" class="btn btn-light w-100 h-100 p-3 text-start border hover-shadow transition-all">
                            <div class="text-success mb-2"><i class="fas fa-search-dollar fa-2x"></i></div>
                            <div class="fw-bold text-dark">Soát giao dịch</div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-5">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="admin-card h-100 hover-translate-y transition-all">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-secondary fw-medium mb-1">Tổng người dùng</p>
                        <h3 class="fw-bold mb-0">@data.TotalUsers.ToString("N0")</h3>
                    </div>
                    <div class="icon-box bg-soft-primary text-primary rounded-circle">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 text-sm">
                    <span class="badge bg-soft-success text-success rounded-pill">
                        <i class="fas fa-arrow-up me-1"></i>@data.NewUsersLast7Days
                    </span>
                    <span class="text-secondary">trong 7 ngày qua</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-md-6 col-lg-3">
        <div class="admin-card h-100 hover-translate-y transition-all">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-secondary fw-medium mb-1">Đang hoạt động</p>
                        <h3 class="fw-bold mb-0">@data.ActiveUsers.ToString("N0")</h3>
                    </div>
                    <div class="icon-box bg-soft-success text-success rounded-circle">
                        <i class="fas fa-user-check"></i>
                    </div>
                </div>
                <div class="progress h-1 my-2 bg-light">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @(data.TotalUsers > 0 ? (data.ActiveUsers * 100 / data.TotalUsers) : 0)%"></div>
                </div>
                <div class="text-secondary text-sm">
                    @(data.TotalUsers > 0 ? (data.ActiveUsers * 100 / data.TotalUsers) : 0)% tỷ lệ tương tác
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="admin-card h-100 hover-translate-y transition-all">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-secondary fw-medium mb-1">Tổng tài sản (AUM)</p>
                        <h3 class="fw-bold mb-0">@data.TotalBalance.ToString("N0") ₫</h3>
                    </div>
                    <div class="icon-box bg-soft-warning text-warning rounded-circle">
                        <i class="fas fa-coins"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 text-sm">
                    <span class="text-secondary">Toàn hệ thống</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="admin-card h-100 hover-translate-y transition-all">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-secondary fw-medium mb-1">Giao dịch hôm nay</p>
                        <h3 class="fw-bold mb-0">@data.TransactionsToday.ToString("N0")</h3>
                    </div>
                    <div class="icon-box bg-soft-info text-info rounded-circle">
                        <i class="fas fa-receipt"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 text-sm">
                    <span class="text-secondary">Cập nhật thời gian thực</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Charts Section -->
    <div class="col-12 col-xl-8">
        <div class="admin-card h-100">
            <div class="card-header border-bottom-0 bg-transparent py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Biểu đồ giao dịch</h5>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        7 ngày qua
                    </button>
                    <ul class="dropdown-menu shadow-sm border-0">
                        <li><a class="dropdown-item" href="#">7 ngày qua</a></li>
                        <li><a class="dropdown-item" href="#">30 ngày qua</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <div id="volumeChart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>

    <!-- System Metrics -->
    <div class="col-12 col-xl-4">
        <div class="admin-card h-100">
            <div class="card-header border-bottom-0 bg-transparent py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Trạng thái hệ thống</h5>
                <span class="badge bg-soft-success text-success">Ổn định</span>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var metric in data.SystemMetrics)
                    {
                        <div class="list-group-item px-4 py-3 border-0">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-medium">@metric.Name</span>
                                <span class="badge bg-soft-@metric.Tone text-@metric.Tone">@metric.Status</span>
                            </div>
                            <p class="text-secondary text-sm mb-0">@metric.Detail</p>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer bg-white border-0 text-center pb-4">
                 <button class="btn btn-light btn-sm w-100 text-secondary">Kiểm tra lại</button>
            </div>
        </div>
    </div>
</div>

<!-- Recent Logs Table -->
<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="admin-card">
            <div class="card-header border-bottom-0 bg-transparent py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Nhật ký Audit gần đây</h5>
                <a href="/Admin/Monitoring/AuditLogs" class="btn btn-sm btn-light">Xem toàn bộ</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Người dùng</th>
                            <th>Hành động</th>
                            <th>IP Address</th>
                            <th>Thời gian</th>
                            <th class="text-end pe-4">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in data.RecentAuditLogs)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-sm bg-light rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold">
                                            @log.UserEmail.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-medium">@log.UserEmail</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@log.Action</td>
                                <td class="font-monospace text-secondary">@log.IpAddress</td>
                                <td>@log.Time.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <span class="badge bg-soft-secondary text-secondary">Đã ghi nhận</span>
                                </td>
                            </tr>
                        }
                        @if (!data.RecentAuditLogs.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">Chưa có nhật ký nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var volumeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.TransactionVolumeChart));
            
            var options = {
                series: [{
                    name: 'Giao dịch',
                    data: volumeData.map(function(item) { return item.Count; })
                }],
                chart: {
                    type: 'area',
                    height: 350,
                    toolbar: { show: false },
                    fontFamily: 'Plus Jakarta Sans, sans-serif'
                },
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 2 },
                xaxis: {
                    categories: volumeData.map(function(item) { return item.Day; }),
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: { show: false },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.7,
                        opacityTo: 0.2,
                        stops: [0, 90, 100]
                    }
                },
                theme: {
                    mode: 'light', 
                    palette: 'palette1'
                },
                colors: ['#4F46E5'],
                grid: {
                    borderColor: '#f1f1f1',
                    strokeDashArray: 4,
                }
            };
            
            var chart = new ApexCharts(document.querySelector("#volumeChart"), options);
            chart.render();
        });
    </script>
}
