@page
@model MoneyTrackerApp.Pages.Admin.MasterData.Categories.IndexModel
@{
    ViewData["Title"] = "Master Categories";
    Layout = "_AdminLayout";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="fw-bold mb-0">System Categories</h2>
        <p class="text-secondary text-sm">Manage default categories for all users</p>
    </div>
    <div class="col-md-6 text-md-end">
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="fas fa-plus me-2"></i>Add Category
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Income Categories -->
    <div class="col-12 col-md-6">
        <div class="admin-card h-100">
             <div class="card-header bg-white border-0 py-3">
                 <span class="badge bg-soft-success text-success mb-2">Income</span>
                <h5 class="fw-bold mb-0">Income Categories</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var cat in Model.Categories.Where(c => c.Type == 1))
                    {
                        <div class="list-group-item px-4 py-3 border-0 border-bottom d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box-sm rounded-circle" style="background-color: @cat.Color; color: white; width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                                    <span>@cat.Icon</span>
                                </div>
                                <div>
                                    <div class="fw-bold">@cat.Name</div>
                                    <div class="text-secondary text-xs">@cat.Description</div>
                                </div>
                            </div>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@cat.Id" onsubmit="return confirm('Delete this category?');">
                                <button class="btn btn-sm btn-light text-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    }
                     @if (!Model.Categories.Any(c => c.Type == 1))
                    {
                        <div class="p-4 text-center text-secondary">No default income categories.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Expense Categories -->
    <div class="col-12 col-md-6">
        <div class="admin-card h-100">
             <div class="card-header bg-white border-0 py-3">
                 <span class="badge bg-soft-danger text-danger mb-2">Expense</span>
                <h5 class="fw-bold mb-0">Expense Categories</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                     @foreach (var cat in Model.Categories.Where(c => c.Type == 2))
                    {
                        <div class="list-group-item px-4 py-3 border-0 border-bottom d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box-sm rounded-circle" style="background-color: @cat.Color; color: white; width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                                    <span>@cat.Icon</span>
                                </div>
                                <div>
                                    <div class="fw-bold">@cat.Name</div>
                                    <div class="text-secondary text-xs">@cat.Description</div>
                                </div>
                            </div>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@cat.Id" onsubmit="return confirm('Delete this category?');">
                                <button class="btn btn-sm btn-light text-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    }
                    @if (!Model.Categories.Any(c => c.Type == 2))
                    {
                        <div class="p-4 text-center text-secondary">No default expense categories.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add System Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input asp-for="CreateCategory.Name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select asp-for="CreateCategory.Type" class="form-select">
                            <option value="1">Income</option>
                            <option value="2">Expense</option>
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                         <div class="col-6">
                            <label class="form-label">Icon (Emoji)</label>
                            <input asp-for="CreateCategory.Icon" class="form-control" placeholder="e.g. 🍔">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Color (Hex)</label>
                            <input asp-for="CreateCategory.Color" type="color" class="form-control form-control-color w-100">
                        </div>
                    </div>
                     <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input asp-for="CreateCategory.Description" class="form-control">
                    </div>
                    
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary ms-2">Add Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
