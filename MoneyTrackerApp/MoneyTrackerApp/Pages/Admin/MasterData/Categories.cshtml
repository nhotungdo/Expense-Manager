@page
@model MoneyTrackerApp.Pages.Admin.MasterData.CategoriesModel
@{
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Danh mục";
    ViewData["HideFooter"] = true;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card-modern">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex gap-3">
                    <button class="btn btn-link text-decoration-none fw-bold border-bottom border-2 border-primary text-primary p-0 pb-1" onclick="filterType(null, this)">
                        Tất cả
                    </button>
                    <button class="btn btn-link text-decoration-none fw-medium text-muted border-bottom border-2 border-transparent p-0 pb-1" onclick="filterType(1, this)">
                        Thu nhập
                    </button>
                    <button class="btn btn-link text-decoration-none fw-medium text-muted border-bottom border-2 border-transparent p-0 pb-1" onclick="filterType(2, this)">
                        Chi tiêu
                    </button>
                </div>
                <button class="btn btn-primary btn-sm" onclick="showAddModal()">
                    <i class="fas fa-plus me-1"></i> Thêm danh mục
                </button>
            </div>

            <!-- Loading State -->
            <div id="loadingState" class="text-center py-5">
                <i class="fas fa-spinner fa-spin fa-2x text-primary mb-3"></i>
                <p class="text-muted">Đang tải danh mục...</p>
            </div>

            <!-- Categories Grid -->
            <div id="categoryList" class="row g-4">
                <!-- Content injected by JS -->
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg rounded-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="categoryForm">
                    <input type="hidden" id="catId" />
                    
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Loại giao dịch *</label>
                        <div class="d-flex gap-3">
                            <label class="flex-fill cursor-pointer p-3 border rounded d-flex align-items-center gap-2 hover-shadow transition-all">
                                <input type="radio" class="form-check-input" name="catType" value="1" onchange="loadParents(1)" required>
                                <span class="fw-bold text-success">Thu nhập</span>
                            </label>
                            <label class="flex-fill cursor-pointer p-3 border rounded d-flex align-items-center gap-2 hover-shadow transition-all">
                                <input type="radio" class="form-check-input" name="catType" value="2" onchange="loadParents(2)" checked>
                                <span class="fw-bold text-danger">Chi tiêu</span>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Tên danh mục *</label>
                        <input type="text" id="catName" class="form-control bg-light" required placeholder="Ví dụ: Ăn uống, Lương..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Biểu tượng & Màu sắc</label>
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1">
                                <select id="catIcon" class="form-select bg-light" style="font-size: 1.2rem;">
                                    <optgroup label="Chi tiêu">
                                        <option value="🏠">🏠 Nhà ở</option>
                                        <option value="🍕">🍕 Ăn uống</option>
                                        <option value="🚗">🚗 Di chuyển</option>
                                        <option value="🛍️">🛍️ Mua sắm</option>
                                        <option value="🎬">🎬 Giải trí</option>
                                        <option value="🏥">🏥 Y tế</option>
                                        <option value="🎓">🎓 Giáo dục</option>
                                    </optgroup>
                                    <optgroup label="Thu nhập">
                                        <option value="💰">💰 Lương</option>
                                        <option value="💼">💼 Thưởng</option>
                                        <option value="📈">📈 Đầu tư</option>
                                        <option value="🎁">🎁 Quà tặng</option>
                                    </optgroup>
                                </select>
                            </div>
                            <input type="color" id="catColor" class="form-control form-control-color" value="#4f46e5" title="Chọn màu">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Danh mục cha</label>
                        <select id="catParent" class="form-select bg-light">
                            <option value="">-- Không có --</option>
                        </select>
                        <div class="form-text">Chọn nếu đây là danh mục con.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Mô tả</label>
                        <textarea id="catDesc" class="form-control bg-light" rows="2" placeholder="Ghi chú thêm..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary px-4" onclick="submitForm()">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let allCategories = [];
    let currentFilterType = null;
    let isEditMode = false;
    let modalInstance = null;

    document.addEventListener('DOMContentLoaded', () => {
        modalInstance = new bootstrap.Modal(document.getElementById('categoryModal'));
        loadCategories();
    });

    async function loadCategories() {
        try {
            const token = getCookie('AccessToken');
            const res = await fetch('/api/Categories', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const data = await res.json();
            
            allCategories = data;
            document.getElementById('loadingState').style.display = 'none';
            renderCategories();
            loadParents(2);
        } catch (e) {
            console.error(e);
            document.getElementById('loadingState').innerHTML = `<p class="text-danger">Lỗi tải dữ liệu</p>`;
        }
    }

    function renderCategories() {
        let filtered = allCategories.filter(c => c.isActive !== false);
        if (currentFilterType) {
            filtered = filtered.filter(c => c.type === currentFilterType);
        }

        const parents = filtered.filter(c => !c.parentCategoryId);
        const children = filtered.filter(c => c.parentCategoryId);

        const container = document.getElementById('categoryList');
        
        if (parents.length === 0) {
            container.innerHTML = `
                <div class="col-12 text-center py-5">
                    <div class="text-muted mb-2 display-4">📂</div>
                    <h5 class="text-muted">Chưa có danh mục nào</h5>
                    <button class="btn btn-outline-primary mt-3" onclick="showAddModal()">Tạo mới ngay</button>
                </div>
            `;
            return;
        }

        container.innerHTML = parents.map(p => {
            const myChildren = children.filter(c => c.parentCategoryId === p.id);
            const isIncome = p.type === 1;
            const cardBorderColor = p.color || (isIncome ? '#10b981' : '#ef4444');
            
            return `
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow transition-all" style="border-left: 4px solid ${cardBorderColor} !important;">
                    <div class="card-body">
                         <div class="d-flex justify-content-between align-items-start mb-3">
                             <div class="d-flex align-items-center gap-3">
                                <div class="rounded p-2 d-flex align-items-center justify-content-center" style="background-color: ${cardBorderColor}20; width: 48px; height: 48px; font-size: 1.5rem;">
                                    ${p.icon || '📁'}
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">${escapeHtml(p.name)}</h6>
                                    <small class="text-muted">${p.transactionCount} giao dịch</small>
                                </div>
                             </div>
                             
                             <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                    ${!p.isDefault ? `
                                        <li><button class="dropdown-item" onclick="editCategory(${p.id})"><i class="fas fa-edit me-2 text-primary"></i> Sửa</button></li>
                                        ${p.transactionCount === 0 && myChildren.length === 0 ? 
                                            `<li><button class="dropdown-item text-danger" onclick="deleteCategory(${p.id})"><i class="fas fa-trash me-2"></i> Xóa</button></li>` 
                                            : ''}
                                    ` : '<li><span class="dropdown-item text-muted small">Mặc định</span></li>'}
                                </ul>
                             </div>
                         </div>

                        ${myChildren.length > 0 ? `
                            <div class="pt-3 border-top mt-2">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Danh mục con</small>
                                <div class="mt-2 d-flex flex-column gap-2">
                                    ${myChildren.map(child => `
                                        <div class="d-flex align-items-center justify-content-between bg-light rounded p-2 px-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <span>${child.icon}</span>
                                                <span class="small fw-medium">${escapeHtml(child.name)}</span>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-link p-0 text-secondary" style="font-size: 0.8rem;" onclick="editCategory(${child.id})"><i class="fas fa-pen"></i></button>
                                                ${!child.isDefault && child.transactionCount === 0 ? 
                                                    `<button class="btn btn-link p-0 text-danger" style="font-size: 0.8rem;" onclick="deleteCategory(${child.id})"><i class="fas fa-times"></i></button>`
                                                    : ''}
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}
                    </div>
                </div>
            </div>
            `;
        }).join('');
    }

    function filterType(type, btn) {
        currentFilterType = type;
        
        // Reset styles
        const container = btn.parentElement;
        const buttons = container.querySelectorAll('button');
        buttons.forEach(b => {
            b.className = 'btn btn-link text-decoration-none fw-medium text-muted border-bottom border-2 border-transparent p-0 pb-1';
        });
        
        btn.className = 'btn btn-link text-decoration-none fw-bold border-bottom border-2 border-primary text-primary p-0 pb-1';
        renderCategories();
    }

    function showAddModal() {
        isEditMode = false;
        document.getElementById('modalTitle').innerText = "Thêm danh mục mới";
        document.getElementById('categoryForm').reset();
        document.getElementById('catId').value = "";
        
        document.querySelector('input[name="catType"][value="2"]').checked = true;
        loadParents(2);
        
        modalInstance.show();
    }

    function editCategory(id) {
        const cat = allCategories.find(c => c.id === id);
        if(!cat) return;

        isEditMode = true;
        document.getElementById('modalTitle').innerText = "Sửa danh mục";
        document.getElementById('catId').value = cat.id;
        document.getElementById('catName').value = cat.name;
        document.getElementById('catDesc').value = cat.description || '';
        document.getElementById('catColor').value = cat.color || '#4f46e5';
        
        // Handle custom icon
        const iconSelect = document.getElementById('catIcon');
        let optionExists = false;
        for(let i=0; i<iconSelect.options.length; i++) {
            if(iconSelect.options[i].value == cat.icon) optionExists = true;
        }
        if(!optionExists && cat.icon) {
             const opt = document.createElement('option');
             opt.value = cat.icon;
             opt.text = cat.icon;
             iconSelect.add(opt);
        }
        document.getElementById('catIcon').value = cat.icon;

        const radios = document.getElementsByName('catType');
        radios.forEach(r => {
             r.checked = parseInt(r.value) === cat.type;
        });
        
        loadParents(cat.type, cat.parentCategoryId, cat.id);
        
        modalInstance.show();
    }

    function loadParents(type, selectedId = null, excludeId = null) {
        const parentSelect = document.getElementById('catParent');
        parentSelect.innerHTML = '<option value="">-- Không có --</option>';
        
        const potentialParents = allCategories.filter(c => 
            c.type == type && 
            !c.parentCategoryId && 
            c.id !== excludeId
        );

        potentialParents.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.text = `${p.icon} ${p.name}`;
            if(selectedId && p.id == selectedId) opt.selected = true;
            parentSelect.appendChild(opt);
        });
    }

    function submitForm() {
        document.getElementById('categoryForm').dispatchEvent(new Event('submit'));
    }

    document.getElementById('categoryForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const token = getCookie('AccessToken');
        
        const data = {
            name: document.getElementById('catName').value,
            description: document.getElementById('catDesc').value,
            icon: document.getElementById('catIcon').value,
            color: document.getElementById('catColor').value,
            type: parseInt(document.querySelector('input[name="catType"]:checked').value),
            parentCategoryId: document.getElementById('catParent').value ? parseInt(document.getElementById('catParent').value) : null
        };

        try {
            let res;
            if(isEditMode) {
                const id = document.getElementById('catId').value;
                data.id = parseInt(id);
                res = await fetch(`/api/Categories/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(data)
                });
            } else {
                res = await fetch('/api/Categories', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(data)
                });
            }

            if(res.ok) {
                modalInstance.hide();
                loadCategories();
            } else {
                const err = await res.json();
                alert(err.message || 'Có lỗi xảy ra');
            }
        } catch(ex) {
            console.error(ex);
            alert("Lỗi kết nối");
        }
    });

    async function deleteCategory(id) {
        if(!confirm("Bạn có chắc chắn muốn xóa danh mục này?")) return;
        const token = getCookie('AccessToken');
        try {
            const res = await fetch(`/api/Categories/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
            if(res.ok) loadCategories();
            else alert('Không thể xóa');
        } catch(ex) { alert("Lỗi hệ thống"); }
    }

    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    }

    function escapeHtml(text) {
        if(!text) return '';
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, function(m) { return map[m]; });
    }
</script>
}
