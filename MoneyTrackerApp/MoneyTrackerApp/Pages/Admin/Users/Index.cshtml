@page
@model MoneyTrackerApp.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="admin-card">
            <div class="card-header bg-white border-0 py-3">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="fw-bold mb-0">Users Directory</h5>
                        <p class="text-secondary small mb-0">Manage system users and access</p>
                    </div>
                </div>
            </div>
            
            <div class="card-body border-top bg-light p-3">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-secondary"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" name="Filter.SearchTerm" placeholder="Search by name, email..." value="@Model.Filter.SearchTerm">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="Filter.IsActive">
                            <option value="">All Status</option>
                            <option value="true" selected="@(Model.Filter.IsActive == true)">Active</option>
                            <option value="false" selected="@(Model.Filter.IsActive == false)">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-dark w-100">Filter</button>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Login</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-sm bg-soft-primary text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                            @user.Email.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-medium text-dark">@user.FullName</div>
                                            <div class="text-secondary small">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @foreach(var role in user.Roles)
                                    {
                                        <span class="badge bg-soft-info text-info rounded-pill">@role</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-soft-danger text-danger rounded-pill">Locked</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="badge bg-soft-success text-success rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-soft-secondary text-secondary rounded-pill">Inactive</span>
                                    }
                                </td>
                                <td class="text-secondary small">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-secondary small">
                                    @(user.LastLogin.HasValue ? user.LastLogin.Value.ToString("dd MMM HH:mm") : "Never")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light rounded-circle icon-btn" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
                                            <li><h6 class="dropdown-header">Actions</h6></li>
                                            @if (user.IsLocked)
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="Unlock" asp-route-id="@user.Id">
                                                        <button class="dropdown-item text-success"><i class="fas fa-unlock me-2"></i>Unlock User</button>
                                                    </form>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="Lock" asp-route-id="@user.Id">
                                                        <button class="dropdown-item text-warning"><i class="fas fa-lock me-2"></i>Lock Account</button>
                                                    </form>
                                                </li>
                                            }
                                            <li>
                                                <form method="post" asp-page-handler="ResetPassword" asp-route-id="@user.Id">
                                                    <button class="dropdown-item"><i class="fas fa-key me-2"></i>Reset Password</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="card-footer bg-white border-top py-3">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.Filter.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link border-0" href="?Filter.PageNumber=@(Model.Filter.PageNumber - 1)">Previous</a>
                        </li>
                        <li class="page-item active">
                            <a class="page-link border-0 rounded-circle mx-1" href="#">@Model.Filter.PageNumber</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link border-0" href="?Filter.PageNumber=@(Model.Filter.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="toast show align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Message"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
