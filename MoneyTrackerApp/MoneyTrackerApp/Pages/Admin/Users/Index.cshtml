@page
@model MoneyTrackerApp.Pages.Admin.Users.IndexModel
@{
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý người dùng";
}

<h2>Quản lý người dùng</h2>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm theo tên, email, số điện thoại...">
            </div>
            <div class="col-md-3">
                <select id="statusFilter" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true">Hoạt động</option>
                    <option value="false">Không hoạt động</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" onclick="loadUsers()">Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tham gia</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    <!-- Loaded via JS -->
                </tbody>
            </table>
        </div>
        <nav>
            <ul class="pagination justify-content-center" id="pagination">
                <!-- Pagination -->
            </ul>
        </nav>
    </div>
</div>

<!-- User Details Modal -->
<div class="modal fade" id="userDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="userDetailsContent">
                <!-- Details loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;

        async function loadUsers(page = 1) {
            currentPage = page;
            const search = document.getElementById('searchInput').value;
            const status = document.getElementById('statusFilter').value;
            
            let url = `/api/admin/users?pageNumber=${page}&pageSize=10`;
            if (search) url += `&searchTerm=${encodeURIComponent(search)}`;
            if (status) url += `&isActive=${status}`;

            try {
                const response = await fetch(url);
                const users = await response.json();
                renderTable(users);
            } catch (error) {
                console.error('Error loading users:', error);
            }
        }

        function renderTable(users) {
            const tbody = document.getElementById('userTableBody');
            tbody.innerHTML = users.map(u => `
                <tr>
                    <td>${u.id}</td>
                    <td>
                        <div class="fw-bold">${u.fullName}</div>
                        <div class="small text-muted">${u.email}</div>
                    </td>
                    <td><span class="badge bg-info text-dark">${u.roles.join(', ')}</span></td>
                    <td>
                        ${u.isActive 
                            ? '<span class="badge bg-success">Hoạt động</span>' 
                            : '<span class="badge bg-danger">Không hoạt động</span>'}
                        ${u.isLocked ? '<span class="badge bg-warning text-dark">Bị khóa</span>' : ''}
                    </td>
                    <td>${new Date(u.createdAt).toLocaleDateString('vi-VN')}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="viewUser(${u.id})">Xem</button>
                        ${u.isLocked 
                            ? `<button class="btn btn-sm btn-success" onclick="unlockUser(${u.id})">Mở khóa</button>`
                            : `<button class="btn btn-sm btn-warning" onclick="lockUser(${u.id})">Khóa</button>`}
                    </td>
                </tr>
            `).join('');
        }

        async function viewUser(id) {
            try {
                const response = await fetch(`/api/admin/users/${id}`);
                const user = await response.json();
                
                const content = `
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Thông tin cơ bản</h6>
                            <p><strong>Tên:</strong> ${user.fullName}</p>
                            <p><strong>Email:</strong> ${user.email}</p>
                            <p><strong>Số điện thoại:</strong> ${user.phoneNumber || 'N/A'}</p>
                            <p><strong>Vai trò:</strong> ${user.roles.join(', ')}</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Trạng thái tài khoản</h6>
                            <p><strong>Trạng thái:</strong> ${user.isActive ? 'Hoạt động' : 'Không hoạt động'}</p>
                            <p><strong>Đăng nhập lần cuối:</strong> ${user.lastLogin ? new Date(user.lastLogin).toLocaleString('vi-VN') : 'Chưa bao giờ'}</p>
                            <p><strong>Bị khóa:</strong> ${user.isLocked ? `Đến ${new Date(user.lockoutEnd).toLocaleString('vi-VN')}` : 'Không'}</p>
                        </div>
                    </div>
                    <hr>
                    <h6>Hành động</h6>
                    <div class="d-flex gap-2">
                        <button class="btn btn-warning" onclick="resetPassword(${user.id})">Đặt lại mật khẩu</button>
                        <button class="btn btn-info" onclick="promoteUser(${user.id})">Đổi vai trò</button>
                    </div>
                `;
                
                document.getElementById('userDetailsContent').innerHTML = content;
                new bootstrap.Modal(document.getElementById('userDetailsModal')).show();
            } catch (error) {
                alert('Lỗi tải chi tiết người dùng');
            }
        }

        async function lockUser(id) {
            if (!confirm('Bạn có chắc chắn muốn khóa người dùng này trong 24 giờ không?')) return;
            await fetch(`/api/admin/users/${id}/lock`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ durationMinutes: 1440 })
            });
            loadUsers(currentPage);
        }

        async function unlockUser(id) {
            if (!confirm('Mở khóa người dùng này?')) return;
            await fetch(`/api/admin/users/${id}/unlock`, { method: 'POST' });
            loadUsers(currentPage);
        }
        
        async function resetPassword(id) {
            if (!confirm('Gửi email đặt lại mật khẩu cho người dùng này?')) return;
            await fetch(`/api/admin/users/${id}/reset-password`, { method: 'POST' });
            alert('Email đặt lại mật khẩu đã được thêm vào hàng đợi.');
        }

        document.addEventListener('DOMContentLoaded', () => loadUsers());
    </script>
}
