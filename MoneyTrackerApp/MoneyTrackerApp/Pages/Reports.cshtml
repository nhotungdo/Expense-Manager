        color: #333;
        margin-bottom: 4px;
    }

    .category-count {
        font-size: 12px;
        color: #666;
    }

    .category-amount {
        text-align: right;
    }

    .category-value {
        font-size: 18px;
        font-weight: 600;
        color: #333;
    }

    .category-percentage {
        font-size: 12px;
        color: #666;
    }

    .ai-section {
        padding: 20px 0;
    }

    .ai-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .ai-header h3 {
        font-size: 20px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ai-suggestions {
        display: grid;
        gap: 15px;
    }

    .ai-suggestion-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .ai-suggestion-type {
        font-size: 12px;
        opacity: 0.9;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .ai-suggestion-text {
