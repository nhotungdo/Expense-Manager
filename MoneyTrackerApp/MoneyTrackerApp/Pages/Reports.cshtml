@page
@model MoneyTrackerApp.Pages.ReportsModel
@{
    ViewData["Title"] = "Analytics Dashboard";
}
@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/reports.css" />
}

<div class="reports-container">
    <!-- Header -->
    <div class="report-header animate-fade-in">
        <div class="report-title">
            <h1><i class="fas fa-chart-line" style="color: var(--primary-color);"></i> Tổng quan Tài chính</h1>
            <p class="text-sm text-gray-500">Phân tích chi tiết dòng tiền của bạn</p>
        </div>
        <div class="report-actions">
            <div class="filter-group">
                <button class="filter-btn active" data-period="month">Tháng này</button>
                <button class="filter-btn" data-period="quarter">Quý</button>
                <button class="filter-btn" data-period="year">Năm</button>
            </div>
            <button class="glass-panel" style="padding: 0.5rem 1rem; border-radius: 0.75rem; color: var(--primary-color); font-weight: 600;" onclick="ReportsApp.showExportModal()">
                <i class="fas fa-download"></i> <span class="hidden sm:inline">Xuất báo cáo</span>
            </button>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid animate-fade-in delay-1">
        <div class="glass-panel stat-card">
            <i class="fas fa-wallet stat-icon"></i>
            <div class="stat-label">Số dư</div>
            <div class="stat-value" id="statBalance">...</div>
            <div class="text-xs text-green-500 font-medium flex items-center gap-1">
                <i class="fas fa-arrow-up"></i> Tăng trưởng ổn định
            </div>
        </div>
        <div class="glass-panel stat-card">
            <i class="fas fa-arrow-down stat-icon" style="color: var(--danger-color);"></i>
            <div class="stat-label">Chi tiêu</div>
            <div class="stat-value" id="statExpense" style="color: var(--danger-color);">...</div>
            <div class="text-xs text-gray-500" id="expenseTrend">So với tháng trước</div>
        </div>
        <div class="glass-panel stat-card">
            <i class="fas fa-arrow-up stat-icon" style="color: var(--success-color);"></i>
            <div class="stat-label">Thu nhập</div>
            <div class="stat-value" id="statIncome" style="color: var(--success-color);">...</div>
            <div class="text-xs text-gray-500" id="incomeTrend">So với tháng trước</div>
        </div>
        <div class="glass-panel stat-card ai-insight-box">
            <div class="flex justify-between items-start">
                <div class="stat-label" style="color: rgba(255,255,255,0.8);">AI Insight</div>
                <span class="ai-badge">BETA</span>
            </div>
            <div class="mt-3 text-sm font-medium" id="aiInsightText">
                Đang phân tích dữ liệu của bạn...
            </div>
        </div>
    </div>

    <!-- Main Charts Area -->
    <div class="charts-grid animate-fade-in delay-2">
        <!-- Trend Line Chart -->
        <div class="glass-panel chart-col-8">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-gray-800">Xu hướng Dòng tiền</h3>
                <div class="text-sm text-gray-500" id="trendPeriodLabel">30 ngày qua</div>
            </div>
            <div style="height: 300px; width: 100%;">
                <canvas id="trendLineChart"></canvas>
            </div>
        </div>

        <!-- Expense Structure Pie -->
        <div class="glass-panel chart-col-4">
            <h3 class="font-bold text-gray-800 mb-4">Cơ cấu Chi tiêu</h3>
            <div style="height: 200px; position: relative;">
                <canvas id="expensePieChart"></canvas>
                <div id="centerExpenseTotal" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold; font-size: 1.2rem; color: var(--text-primary);">...</div>
            </div>
            <div class="mt-4 custom-scrollbar" style="max-height: 150px; overflow-y: auto;">
                <ul id="expenseLegend" class="space-y-2">
                    <!-- Populated by JS -->
                </ul>
            </div>
        </div>
    </div>

    <!-- Detailed Analysis -->
    <div class="charts-grid animate-fade-in delay-3">
        <!-- Top Spending Categories -->
        <div class="glass-panel chart-col-6" style="grid-column: span 12; @* lg:span-6 *@"> 
             <!-- Corrected simple grid for now -->
            <h3 class="font-bold text-gray-800 mb-4">Top Danh mục Tiêu dùng</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-xs text-gray-500 border-b border-gray-100">
                            <th class="py-2">Danh mục</th>
                            <th class="py-2 text-right">Số tiền</th>
                            <th class="py-2 text-right">Tỷ lệ</th>
                            <th class="py-2 text-right">Giao dịch</th>
                        </tr>
                    </thead>
                    <tbody id="topCategoriesTable">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Export Modal (Reused but styled) -->
<div id="exportModal" class="fixed inset-0 z-50 hidden" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center;">
    <div class="glass-panel" style="background: white; width: 100%; max-width: 500px; padding: 2rem;">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-bold">Xuất Báo cáo</h3>
            <button onclick="ReportsApp.closeExportModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
        </div>
        <form id="exportForm" onsubmit="event.preventDefault(); ReportsApp.submitExport();">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Loại báo cáo</label>
                    <select id="exportReportType" class="w-full p-2 border rounded-lg bg-gray-50">
                        <option value="1">Chi tiết Giao dịch</option>
                        <option value="2">Báo cáo Dòng tiền</option>
                        <option value="3">Danh mục</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Từ ngày</label>
                        <input type="date" id="exportStartDate" class="w-full p-2 border rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Đến ngày</label>
                        <input type="date" id="exportEndDate" class="w-full p-2 border rounded-lg">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Định dạng</label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="exportFormat" value="2" checked>
                            <i class="fas fa-file-excel text-green-600"></i> Excel
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="exportFormat" value="1">
                            <i class="fas fa-file-pdf text-red-500"></i> PDF
                        </label>
                    </div>
                </div>
            </div>
            <div class="mt-8 flex justify-end gap-3">
                <button type="button" onclick="ReportsApp.closeExportModal()" class="px-4 py-2 rounded-lg border hover:bg-gray-50">Hủy</button>
                <button type="submit" class="px-4 py-2 rounded-lg bg-indigo-600 text-white font-bold hover:bg-indigo-700 shadow-lg">Xuất ngay</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
