@page
@model MoneyTrackerApp.Pages.ReportsModel
@{
    ViewData["Title"] = "Báo cáo & Phân tích";
}

<!-- External Libraries -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

<div class="reports-container">
    <div class="page-header">
        <h1>
            <i class="fas fa-chart-line"></i>
            Báo cáo & Phân tích
        </h1>
        <button class="btn btn-primary" onclick="showExportModal()">
            <i class="fas fa-download"></i> Xuất báo cáo
        </button>
    </div>

    <!-- Dashboard Overview -->
    <div class="dashboard-section">
        <h2>Tổng quan</h2>
        <div class="stats-grid">
            <div class="stat-card" data-aos="zoom-in" data-aos-delay="0">
                <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Số dư hiện tại</div>
                    <div class="stat-value" id="currentBalance">Đang tải...</div>
                </div>
            </div>

            <div class="stat-card" data-aos="zoom-in" data-aos-delay="100">
                <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <i class="fas fa-arrow-up"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Thu nhập tháng</div>
                    <div class="stat-value" id="monthlyIncome">Đang tải...</div>
                </div>
            </div>

            <div class="stat-card" data-aos="zoom-in" data-aos-delay="200">
                <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-arrow-down"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chi tiêu tháng</div>
                    <div class="stat-value" id="monthlyExpense">Đang tải...</div>
                </div>
            </div>

            <div class="stat-card" data-aos="zoom-in" data-aos-delay="300">
                <div class="stat-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                    <i class="fas fa-piggy-bank"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Tiết kiệm tháng</div>
                    <div class="stat-value" id="monthlySavings">Đang tải...</div>
                    <div class="stat-subtitle" id="savingsRate"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-section">
        <div class="chart-container" data-aos="fade-up" data-aos-delay="100">
            <div class="chart-header">
                <h3>Phân tích thu chi</h3>
            </div>
            <div id="cashFlowChart"></div>
        </div>

        <div class="chart-container budget-card" data-aos="fade-up" data-aos-delay="200">
            <div class="chart-header">
                <h3>Ngân sách</h3>
            </div>
            <div class="chart-wrapper">
                <div id="budgetChart"></div>
            </div>
            <div class="budget-summary" id="budgetSummary">
                <div class="budget-item">
                    <span class="label">Đã chi</span>
                    <span class="value" id="totalSpent">0</span>
                </div>
                <div class="budget-item">
                    <span class="label">Giới hạn</span>
                    <span class="value" id="totalLimit">0</span>
                </div>
            </div>
        </div>
    </div>

    <div class="reports-section">
        <div class="chart-container transactions-card" data-aos="fade-left" data-aos-delay="300">
            <div class="card-header">
                <h3>Giao dịch gần đây</h3>
                <a href="/Transactions" class="view-all">Xem tất cả</a>
            </div>
            <div class="transaction-list" id="recentTransactions"></div>
        </div>
    </div>

    <!-- Reports Section -->
    <div class="reports-section">
        <div class="tabs">
            <button class="tab active" onclick="switchReportTab('cashflow')">Dòng tiền</button>
            <button class="tab" onclick="switchReportTab('trends')">Xu hướng tháng</button>
            <button class="tab" onclick="switchReportTab('categories')">Phân tích danh mục</button>
            <button class="tab" onclick="switchReportTab('ai')">Thông tin chi tiết AI</button>
        </div>

        <!-- Cash Flow Report -->
        <div id="cashflowTab" class="tab-content active">
            <div class="report-filters">
                <div class="filter-group">
                    <label>Ngày bắt đầu:</label>
                    <input type="date" id="cashflowStartDate" class="form-control" />
                </div>
                <div class="filter-group">
                    <label>Ngày kết thúc:</label>
                    <input type="date" id="cashflowEndDate" class="form-control" />
                </div>
                <button class="btn btn-primary" onclick="loadCashFlowReport()">
                    <i class="fas fa-search"></i> Tạo báo cáo
                </button>
            </div>
            <div id="cashflowReport" class="report-content">
                <p class="info-message">Chọn khoảng thời gian và nhấp Tạo báo cáo để xem báo cáo dòng tiền</p>
            </div>
        </div>

        <!-- Monthly Trends Report -->
        <div id="trendsTab" class="tab-content">
            <div class="report-filters">
                <div class="filter-group">
                    <label>Năm:</label>
                    <select id="trendsYear" class="form-control">
                        <option value="2024">2024</option>
                        <option value="2023">2023</option>
                        <option value="2022">2022</option>
                    </select>
                </div>
                <button class="btn btn-primary" onclick="loadMonthlyTrends()">
                    <i class="fas fa-search"></i> Tạo báo cáo
                </button>
            </div>
            <div id="trendsReport" class="report-content">
                <p class="info-message">Chọn năm và nhấp Tạo báo cáo để xem xu hướng tháng</p>
            </div>
        </div>

        <!-- Category Breakdown Report -->
        <div id="categoriesTab" class="tab-content">
            <div class="report-filters">
                <div class="filter-group">
                    <label>Ngày bắt đầu:</label>
                    <input type="date" id="categoryStartDate" class="form-control" />
                </div>
                <div class="filter-group">
                    <label>Ngày kết thúc:</label>
                    <input type="date" id="categoryEndDate" class="form-control" />
                </div>
                <button class="btn btn-primary" onclick="loadCategoryBreakdown()">
                    <i class="fas fa-search"></i> Tạo báo cáo
                </button>
            </div>
            <div id="categoriesReport" class="report-content">
                <p class="info-message">Chọn khoảng thời gian và nhấp Tạo báo cáo để xem phân tích danh mục</p>
            </div>
        </div>

        <!-- AI Insights Tab -->
        <div id="aiTab" class="tab-content">
            <div class="ai-section">
                <div class="ai-header">
                    <h3><i class="fas fa-robot"></i> Cố vấn tài chính AI</h3>
                    <button class="btn btn-primary" onclick="generateAiSuggestions()">
                        <i class="fas fa-sync"></i> Tạo thông tin chi tiết mới
                    </button>
                </div>
                <div id="aiSuggestions" class="ai-suggestions">
                    <p class="info-message">Đang tải thông tin chi tiết AI...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Modal -->
    <div id="exportModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeExportModal()">&times;</span>
            <h2>Xuất báo cáo</h2>
            <form id="exportForm">
                <div class="form-group">
                    <label>Loại báo cáo *</label>
                    <select id="exportReportType" class="form-control" required>
                        <option value="1">Báo cáo dòng tiền</option>
                        <option value="3">Phân tích danh mục</option>
                        <option value="4">Xu hướng tháng</option>
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Ngày bắt đầu *</label>
                        <input type="date" id="exportStartDate" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Ngày kết thúc *</label>
                        <input type="date" id="exportEndDate" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Định dạng tệp *</label>
                    <select id="exportFileFormat" class="form-control" required>
                        <option value="1">PDF</option>
                        <option value="2">Excel (XLSX)</option>
                        <option value="3">CSV</option>
                        <option value="4">JSON</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeExportModal()">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-download"></i> Xuất
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
    .reports-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-header h1 {
        font-size: 28px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dashboard-section {
        margin-bottom: 40px;
    }

    .dashboard-section h2 {
        font-size: 22px;
        color: #333;
        margin-bottom: 20px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
    }

    .stat-content {
        flex: 1;
    }

    .stat-label {
        font-size: 13px;
        color: #666;
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 700;
        color: #333;
    }

    .stat-subtitle {
        font-size: 12px;
        color: #4CAF50;
        margin-top: 4px;
    }

    .charts-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .chart-container {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .chart-header {
        margin-bottom: 20px;
    }

    .chart-header h3 {
        font-size: 18px;
        color: #333;
        margin: 0;
    }

    .reports-section {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        border-bottom: 2px solid #f0f0f0;
    }

    .tab {
        padding: 12px 24px;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        color: #666;
        transition: all 0.2s;
    }

    .tab.active {
        color: #4CAF50;
        border-bottom-color: #4CAF50;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    .report-filters {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        align-items: flex-end;
    }

    .filter-group {
        flex: 1;
    }

    .filter-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        color: #333;
        font-size: 14px;
    }

    .report-content {
        padding: 20px 0;
    }

    .info-message {
        text-align: center;
        color: #666;
        padding: 40px;
        font-size: 14px;
    }

    .report-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 30px;
    }

    .summary-card {
        background: #f8f9fa;
        padding: 16px;
        border-radius: 8px;
        text-align: center;
    }

    .summary-label {
        font-size: 13px;
        color: #666;
        margin-bottom: 8px;
    }

    .summary-value {
        font-size: 20px;
        font-weight: 600;
        color: #333;
    }

    .category-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .category-item {
        display: flex;
        align-items: center;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 10px;
    }

    .category-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 20px;
    }

    .category-info {
        flex: 1;
