@page
@model MoneyTrackerApp.Pages.ReportsModel
@{
    ViewData["Title"] = "Báo cáo & Phân tích";
}

<div class="bento-grid">
    <!-- Header -->
    <div class="bento-col-span-12 flex justify-between items-center mb-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                <i class="fas fa-chart-line text-indigo-600 dark:text-indigo-400"></i>
                Báo cáo & Phân tích
            </h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">Theo dõi dòng tiền và chi tiêu của bạn.</p>
        </div>
        <button class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/30 transition-all flex items-center gap-2" onclick="showExportModal()">
            <i class="fas fa-download"></i> <span class="hidden sm:inline">Xuất báo cáo</span>
        </button>
    </div>

    <!-- Stats Grid -->
    <div class="bento-col-span-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Balance -->
        <div class="bento-card p-5 relative overflow-hidden group">
            <div class="relative z-10">
                <p class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Số dư hiện tại</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-1" id="currentBalance">...</h3>
                <div class="w-12 h-1 bg-indigo-500 rounded-full mt-3"></div>
            </div>
            <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-wallet text-6xl text-indigo-600"></i>
            </div>
        </div>

        <!-- Income -->
        <div class="bento-card p-5 relative overflow-hidden group">
            <div class="relative z-10">
                <p class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Thu nhập tháng</p>
                <h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mb-1" id="monthlyIncome">...</h3>
                <div class="w-12 h-1 bg-emerald-500 rounded-full mt-3"></div>
            </div>
             <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-arrow-up text-6xl text-emerald-600"></i>
            </div>
        </div>

        <!-- Expense -->
        <div class="bento-card p-5 relative overflow-hidden group">
            <div class="relative z-10">
                <p class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Chi tiêu tháng</p>
                <h3 class="text-2xl font-bold text-rose-600 dark:text-rose-400 mb-1" id="monthlyExpense">...</h3>
                <div class="w-12 h-1 bg-rose-500 rounded-full mt-3"></div>
            </div>
             <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-arrow-down text-6xl text-rose-600"></i>
            </div>
        </div>

        <!-- Savings -->
        <div class="bento-card p-5 relative overflow-hidden group">
            <div class="relative z-10">
                <p class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Tiết kiệm tháng</p>
                <h3 class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-1" id="monthlySavings">...</h3>
                <p class="text-xs text-blue-500 font-medium mt-3" id="savingsRate"></p>
            </div>
             <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-piggy-bank text-6xl text-blue-600"></i>
            </div>
        </div>
    </div>

    <!-- Main Charts -->
    <div class="bento-col-span-12 lg:bento-col-span-8">
        <div class="bento-card h-full min-h-[400px]">
            <div class="flex justify-between items-center mb-6">
                <h3 class="font-bold text-gray-900 dark:text-white">Phân tích thu chi</h3>
                 <div class="flex gap-2">
                     <span class="flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Thu nhập</span>
                     <span class="flex items-center gap-1 text-xs font-medium text-rose-600 dark:text-rose-400"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Chi tiêu</span>
                 </div>
            </div>
            <div class="relative h-80 w-full">
                <canvas id="cashFlowChartCanvas"></canvas>
            </div>
        </div>
    </div>

    <div class="bento-col-span-12 lg:bento-col-span-4">
        <div class="bento-card h-full min-h-[400px]">
             <h3 class="font-bold text-gray-900 dark:text-white mb-6">Ngân sách</h3>
             <div class="relative h-64 w-full flex items-center justify-center">
                 <canvas id="budgetChartCanvas"></canvas>
             </div>
             <div class="mt-6 space-y-4" id="budgetSummary">
                  <div class="flex justify-between items-center p-3 bg-gray-50 dark:bg-gray-800 rounded-xl">
                      <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Đã chi</span>
                      <span class="font-bold text-rose-600 dark:text-rose-400" id="totalSpent">0</span>
                  </div>
                  <div class="flex justify-between items-center p-3 bg-gray-50 dark:bg-gray-800 rounded-xl">
                      <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Giới hạn</span>
                      <span class="font-bold text-gray-900 dark:text-white" id="totalLimit">0</span>
                  </div>
             </div>
        </div>
    </div>
    
    <!-- Report Tabs & Detail Section -->
    <div class="bento-col-span-12">
        <div class="bento-card p-0 overflow-hidden">
             <!-- Tabs -->
            <div class="flex border-b border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50 overflow-x-auto">
                <button class="px-6 py-4 font-bold text-sm text-indigo-600 border-b-2 border-indigo-600 bg-white dark:bg-gray-800 transition-colors whitespace-nowrap" onclick="switchReportTab(this, 'cashflow')">Dòng tiền</button>
                <button class="px-6 py-4 font-medium text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 border-b-2 border-transparent hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap" onclick="switchReportTab(this, 'trends')">Xu hướng tháng</button>
                <button class="px-6 py-4 font-medium text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 border-b-2 border-transparent hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap" onclick="switchReportTab(this, 'categories')">Phân tích danh mục</button>
                <button class="px-6 py-4 font-medium text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 border-b-2 border-transparent hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap" onclick="switchReportTab(this, 'ai')">AI Insights</button>
            </div>
            
            <div class="p-6">
                 <!-- Cashflow Tab -->
                <div id="cashflowTab" class="tab-content block">
                    <div class="flex flex-wrap items-end gap-4 mb-6">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ngày bắt đầu</label>
                            <input type="date" id="cashflowStartDate" class="form-input rounded-xl border-gray-200 dark:border-gray-700 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ngày kết thúc</label>
                            <input type="date" id="cashflowEndDate" class="form-input rounded-xl border-gray-200 dark:border-gray-700 text-sm" />
                        </div>
                        <button class="px-4 py-2 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-md hover:bg-indigo-700" onclick="loadCashFlowReport()">
                            <i class="fas fa-search"></i> Xem
                        </button>
                    </div>
                    <div id="cashflowReport" class="min-h-[200px] flex items-center justify-center text-gray-500 border-2 border-dashed border-gray-100 rounded-xl">
                        Chọn khoảng thời gian để xem báo cáo
                    </div>
                </div>

                <!-- Trends Tab -->
                <div id="trendsTab" class="tab-content hidden">
                    <div class="flex items-end gap-4 mb-6">
                        <div>
                             <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Năm</label>
                             <select id="trendsYear" class="form-select rounded-xl border-gray-200 dark:border-gray-700 text-sm min-w-[100px]">
                                <option value="2026">2026</option>
                                <option value="2025">2025</option>
                                <option value="2024">2024</option>
                                <option value="2023">2023</option>
                                <option value="2022">2022</option>
                            </select>
                        </div>
                        <button class="px-4 py-2 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-md hover:bg-indigo-700" onclick="loadMonthlyTrends()">
                            <i class="fas fa-search"></i> Xem
                        </button>
                    </div>
                    <div id="trendsReport"></div>
                </div>

                <!-- Categories Tab -->
                <div id="categoriesTab" class="tab-content hidden">
                     <div class="flex flex-wrap items-end gap-4 mb-6">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ngày bắt đầu</label>
                            <input type="date" id="categoryStartDate" class="form-input rounded-xl border-gray-200 dark:border-gray-700 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ngày kết thúc</label>
                            <input type="date" id="categoryEndDate" class="form-input rounded-xl border-gray-200 dark:border-gray-700 text-sm" />
                        </div>
                        <button class="px-4 py-2 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-md hover:bg-indigo-700" onclick="loadCategoryBreakdown()">
                            <i class="fas fa-search"></i> Xem
                        </button>
                    </div>
                    <div id="categoriesReport"></div>
                </div>
                
                <!-- AI Tab -->
                <div id="aiTab" class="tab-content hidden">
                     <div class="flex justify-between items-center mb-6">
                        <h3 class="font-bold text-gray-900 dark:text-white flex items-center gap-2"><i class="fas fa-robot text-indigo-500"></i> AI Financial Advisor</h3>
                        <button class="px-4 py-2 bg-purple-600 text-white text-sm font-bold rounded-xl shadow-md hover:bg-purple-700" onclick="generateAiSuggestions()">
                            <i class="fas fa-sync-alt"></i> Phân tích mới
                        </button>
                    </div>
                    <div id="aiSuggestions" class="space-y-4">
                        <div class="animate-pulse flex space-x-4">
                            <div class="flex-1 space-y-4 py-1">
                                <div class="h-4 bg-gray-200 rounded w-3/4"></div>
                                <div class="space-y-2">
                                    <div class="h-4 bg-gray-200 rounded"></div>
                                    <div class="h-4 bg-gray-200 rounded w-5/6"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Export Modal -->
<div id="exportModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeExportModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="px-6 py-6 border-b border-gray-100 dark:border-gray-700 flex justify-between items-center">
                 <h3 class="text-lg font-bold text-gray-900 dark:text-white">Xuất báo cáo</h3>
                 <button type="button" class="text-gray-400 hover:text-gray-500" onclick="closeExportModal()">
                     <i class="fas fa-times text-xl"></i>
                 </button>
            </div>
            <div class="px-6 py-6">
                 <form id="exportForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Loại báo cáo</label>
                        <select id="exportReportType" class="form-select w-full rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700 p-2.5">
                            <option value="1">Báo cáo dòng tiền</option>
                            <option value="3">Phân tích danh mục</option>
                            

                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                         <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ngày bắt đầu</label>
                            <input type="date" id="exportStartDate" class="form-input w-full rounded-xl border-gray-200 dark:border-gray-700 p-2.5" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ngày kết thúc</label>
                            <input type="date" id="exportEndDate" class="form-input w-full rounded-xl border-gray-200 dark:border-gray-700 p-2.5" />
                        </div>
                    </div>
                     <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Định dạng</label>
                        <select id="exportFileFormat" class="form-select w-full rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700 p-2.5">
                            <option value="1">PDF</option>
                            <option value="2">Excel (XLSX)</option>
                            <option value="3">CSV</option>
                        </select>
                    </div>
                 </form>
            </div>
            <div class="px-6 py-4 bg-gray-50 dark:bg-gray-700/50 flex justify-end gap-3">
                 <button type="button" class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" onclick="closeExportModal()">Hủy</button>
                 <button type="submit" form="exportForm" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-colors">
                     <i class="fas fa-download mr-1"></i> Xuất
                 </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Init Global Charts
        let cashFlowChartInstance = null;
        let budgetChartInstance = null;
        
        document.addEventListener('DOMContentLoaded', function() {
            // Set default dates
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            
            // Helper to set date input value
            const setDate = (id, date) => {
                try {
                    document.getElementById(id).value = date.toISOString().split('T')[0];
                } catch(e) {}
            };

            setDate('cashflowStartDate', firstDay);
            setDate('cashflowEndDate', today);
            setDate('categoryStartDate', firstDay);
            setDate('categoryEndDate', today);
            setDate('exportStartDate', firstDay);
            setDate('exportEndDate', today);
            
            const trendYear = document.getElementById('trendsYear');
            if(trendYear) trendYear.value = today.getFullYear().toString();

            loadDashboard();
            loadAiSuggestions();
        });

        async function loadDashboard() {
            try {
                const response = await fetch('/api/Report/dashboard'); 
                // Assumes Authorization is handled by cookie/browser automatically or need header injection if using JWT
                if (!response.ok) throw new Error('Failed to load dashboard');
                const data = await response.json();
                displayDashboard(data);
            } catch (error) {
                console.error('Error loading dashboard:', error);
            }
        }

        function displayDashboard(data) {
             document.getElementById('currentBalance').textContent = formatCurrency(data.currentBalance);
             document.getElementById('monthlyIncome').textContent = formatCurrency(data.monthlyIncome);
             document.getElementById('monthlyExpense').textContent = formatCurrency(data.monthlyExpense);
             document.getElementById('monthlySavings').textContent = formatCurrency(data.monthlySavings);
             document.getElementById('savingsRate').textContent = `${data.savingsRate.toFixed(1)}% tỷ lệ tiết kiệm`;
             document.getElementById('totalSpent').textContent = formatCurrency(data.monthlyExpense); // Assuming budget matches expense for now
             // Note: data.budgetAlerts usually contains budget info

             renderMainChart(data.cashFlowChart);
             // renderBudgetChart(data.budgetAlerts); // Depending on API structure
        }

        function renderMainChart(chartData) {
            const ctx = document.getElementById('cashFlowChartCanvas').getContext('2d');
            
            if (cashFlowChartInstance) cashFlowChartInstance.destroy();

            // Create gradients
            const gradientIncome = ctx.createLinearGradient(0, 0, 0, 400);
            gradientIncome.addColorStop(0, 'rgba(16, 185, 129, 0.4)'); // Emerald
            gradientIncome.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

            const gradientExpense = ctx.createLinearGradient(0, 0, 0, 400);
            gradientExpense.addColorStop(0, 'rgba(244, 63, 94, 0.4)'); // Rose
            gradientExpense.addColorStop(1, 'rgba(244, 63, 94, 0.0)');

            cashFlowChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'], // Placeholder, should come from API if available
                    datasets: [
                        {
                            label: 'Thu nhập',
                            data: chartData.incomeData, // Assuming API returns array matches default labels
                            borderColor: '#10b981',
                            backgroundColor: gradientIncome,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 0
                        },
                        {
                            label: 'Chi tiêu',
                            data: chartData.expenseData,
                            borderColor: '#f43f5e',
                            backgroundColor: gradientExpense,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    scales: {
                        y: { display: false, beginAtZero: true },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
        
        // Mock Budget Chart if data structure not fully known
        // You mentioned data.budgetAlerts previously
        function renderBudgetChart(budgetData) {
             const ctx = document.getElementById('budgetChartCanvas').getContext('2d');
             if (budgetChartInstance) budgetChartInstance.destroy();
             
             budgetChartInstance = new Chart(ctx, {
                 type: 'doughnut',
                 data: {
                     labels: ['Đã chi', 'Còn lại'],
                     datasets: [{
                         data: [65, 35], // Mock
                         backgroundColor: ['#f43f5e', '#e5e7eb'],
                         borderWidth: 0,
                         hoverOffset: 4
                     }]
                 },
                 options: {
                     cutout: '80%',
                     plugins: { legend: { display: false } }
                 }
             });
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        }
        
        function switchReportTab(btn, tabId) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('block'));
            
            // Show selected
            document.getElementById(tabId + 'Tab').classList.remove('hidden');
            document.getElementById(tabId + 'Tab').classList.add('block');
            
            // Update buttons
            const btns = btn.parentElement.children;
            for(let b of btns) {
                b.classList.remove('border-indigo-600', 'text-indigo-600', 'bg-white', 'dark:bg-gray-800', 'font-bold');
                b.classList.add('border-transparent', 'text-gray-500', 'font-medium');
            }
            btn.classList.remove('border-transparent', 'text-gray-500', 'font-medium');
            btn.classList.add('border-indigo-600', 'text-indigo-600', 'bg-white', 'dark:bg-gray-800', 'font-bold');
        }

        function showExportModal() {
            document.getElementById('exportModal').classList.remove('hidden');
        }
        function closeExportModal() {
            document.getElementById('exportModal').classList.add('hidden');
        }
        
        // Placeholder functions for other buttons
        function loadCashFlowReport() {  }
        function loadMonthlyTrends() { }
        function loadCategoryBreakdown() { }
        function generateAiSuggestions() { }
        function loadAiSuggestions() { }

    </script>
}
