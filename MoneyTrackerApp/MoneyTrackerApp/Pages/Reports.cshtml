    }

    .btn-primary {
        background: #4CAF50;
        color: white;
    }

    .btn-primary:hover {
        background: #45a049;
    }

    .btn-secondary {
        background: #f1f1f1;
        color: #333;
    }

    .btn-secondary:hover {
        background: #e0e0e0;
    }

    .monthly-trend-chart {
        margin-top: 20px;
    }

    .trend-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .trend-increasing {
        background: #d4edda;
        color: #155724;
    }

    .trend-decreasing {
        background: #f8d7da;
        color: #721c24;
    }

    .trend-stable {
        background: #d1ecf1;
        color: #0c5460;
    }

    /* Transactions List */
    .transactions-card .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .view-all { font-size: 13px; color: #00D9F5; text-decoration: none; font-weight: 600; }
    .transaction-list { display: flex; flex-direction: column; gap: 12px; }
    .transaction-item { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border: 1px solid #eee; border-radius: 12px; background: #fff; }
    .t-icon { width: 36px; height: 36px; border-radius: 10px; background: #f8f9fa; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .t-info { flex: 1; margin-left: 12px; }
    .t-desc { font-size: 14px; font-weight: 600; color: #1A1A1A; margin-bottom: 2px; }
    .t-date { font-size: 11px; color: #8E8E93; }
    .t-amount { font-weight: 700; font-size: 14px; }
    .text-success { color: #00E396 !important; }
    .text-danger { color: #FF4560 !important; }

    /* Budget over-limit flash */
    .flash-warning { animation: flash 1s infinite; }
    @@keyframes flash { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }

    /* Tooltip subtle zoom */
    .apexcharts-tooltip { transition: transform 0.2s ease, opacity 0.2s ease; }
    .apexcharts-tooltip.active { transform: scale(1.05); }
</style>

<script>
    AOS.init({
        duration: 800,
        easing: 'ease-out-cubic',
        once: true
    });

    // Load dashboard on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadDashboard();
        loadAiSuggestions();

        // Set default dates
        const today = new Date();
        const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

        document.getElementById('cashflowStartDate').valueAsDate = firstDay;
        document.getElementById('cashflowEndDate').valueAsDate = today;
        document.getElementById('categoryStartDate').valueAsDate = firstDay;
        document.getElementById('categoryEndDate').valueAsDate = today;
        document.getElementById('exportStartDate').valueAsDate = firstDay;
        document.getElementById('exportEndDate').valueAsDate = today;
        document.getElementById('trendsYear').value = today.getFullYear().toString();
    });

    async function loadDashboard() {
        try {
            const response = await fetch('/api/Report/dashboard', {
                headers: {
                    'Authorization': 'Bearer ' + getCookie('AccessToken')
                }
            });

            if (!response.ok) throw new Error('Failed to load dashboard');

            const data = await response.json();
            displayDashboard(data);
        } catch (error) {
            console.error('Error loading dashboard:', error);
        }
    }

    function displayDashboard(data) {
        animateValue('currentBalance', 0, data.currentBalance, 1500);
        animateValue('monthlyIncome', 0, data.monthlyIncome, 1200);
        animateValue('monthlyExpense', 0, data.monthlyExpense, 1200);
        animateValue('monthlySavings', 0, data.monthlySavings, 1200);
        document.getElementById('savingsRate').textContent = `${data.savingsRate.toFixed(1)}% tỷ lệ tiết kiệm`;

        renderMainChart(data.cashFlowChart);
        renderBudgetChart(data.budgetAlerts);
        renderTransactions(data.recentTransactions);
    }

    function animateValue(id, start, end, duration) {
        const el = document.getElementById(id);
        let startTs = null;
        const step = (ts) => {
            if (!startTs) startTs = ts;
            const progress = Math.min((ts - startTs) / duration, 1);
            const value = Math.floor(progress * (end - start) + start);
            el.innerHTML = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
            if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
    }

    function renderMainChart(chartData) {
        const options = {
            series: [
                { name: 'Thu nhập', data: chartData.incomeData },
                { name: 'Chi tiêu', data: chartData.expenseData }
            ],
            chart: {
                type: 'area',
                height: 300,
                toolbar: { show: false },
                animations: {
                    enabled: true,
                    easing: 'easeinout',
                    speed: 800,
                    animateGradually: { enabled: true, delay: 150 },
                    dynamicAnimation: { enabled: true, speed: 350 }
                }
            },
            colors: ['#00D9F5', '#FF60A8'],
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 3 },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.7,
                    opacityTo: 0.2,
                    stops: [0, 90, 100],
                    gradientToColors: ['#007CF0', '#8A2BE2']
                }
            },
            xaxis: { categories: chartData.labels, axisBorder: { show: false }, axisTicks: { show: false } },
            yaxis: { show: false },
            tooltip: {
                theme: 'light',
                y: {
                    formatter: function (val) {
                        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(val);
                    }
                }
            }
        };
        const chart = new ApexCharts(document.querySelector('#cashFlowChart'), options);
        chart.render();
    }

    function renderBudgetChart(alerts) {
        let totalSpent = 0;
        let totalLimit = 0;
        if (alerts && alerts.length > 0) {
            alerts.forEach(a => { totalSpent += a.spent; totalLimit += a.amount; });
        }
        let percentage = totalLimit > 0 ? (totalSpent / totalLimit) * 100 : 0;
        const over = percentage >= 100;
        if (percentage > 100) percentage = 100;
        document.getElementById('totalSpent').textContent = formatShortCurrency(totalSpent);
        document.getElementById('totalLimit').textContent = formatShortCurrency(totalLimit);

        const options = {
            series: [Math.round(percentage)],
            chart: {
                height: 280,
                type: 'radialBar',
                animations: { enabled: true, easing: 'easeinout', speed: 800, animateGradually: { enabled: true, delay: 150 }, dynamicAnimation: { enabled: true, speed: 350 } }
            },
            plotOptions: {
                radialBar: {
                    hollow: { size: '65%', background: 'transparent' },
                    track: { background: '#f2f2f2' },
                    dataLabels: {
                        name: { show: true, label: 'Đã dùng', color: '#888', fontSize: '14px' },
                        value: { fontSize: '32px', fontWeight: 700, color: over ? '#FF4560' : '#1A1A1A', formatter: function (val) { return val + '%'; } }
                    }
                }
            },
            fill: {
                type: 'gradient',
                gradient: { shade: 'dark', type: 'horizontal', gradientToColors: [over ? '#FF0000' : '#007CF0'], stops: [0, 100] }
            },
            stroke: { lineCap: 'round' },
            colors: [over ? '#FF4560' : '#00D9F5']
        };
        const chart = new ApexCharts(document.querySelector('#budgetChart'), options);
        chart.render();
        const wrapper = document.querySelector('.budget-card .chart-wrapper');
        if (over && wrapper) wrapper.classList.add('flash-warning');
    }

    function renderTransactions(transactions) {
        const container = document.getElementById('recentTransactions');
        if (!container) return;
        if (!transactions || transactions.length === 0) {
            container.innerHTML = '<div class="text-center py-4 text-muted">Không có giao dịch gần đây.</div>';
            return;
        }
        container.innerHTML = transactions.map((t, index) => `
            <div class="transaction-item" data-aos="fade-up" data-aos-delay="${index * 100}">
                <div class="t-icon">${t.categoryIcon || '📄'}</div>
                <div class="t-info">
                    <div class="t-desc">${t.description}</div>
                    <div class="t-date">${new Date(t.date).toLocaleDateString('vi-VN')}</div>
                </div>
                <div class="t-amount ${t.type === 'Income' ? 'text-success' : 'text-danger'}">${t.type === 'Income' ? '+' : '-'} ${formatCurrency(t.amount)}</div>
            </div>
        `).join('');
        setTimeout(() => AOS.refresh(), 500);
    }

    function formatCurrency(amount) { return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount); }
    function formatShortCurrency(amount) {
        if (amount >= 1000000000) return (amount / 1000000000).toFixed(1) + ' tỷ';
        if (amount >= 1000000) return (amount / 1000000).toFixed(1) + ' tr';
        if (amount >= 1000) return (amount / 1000).toFixed(0) + ' k';
        return amount.toString();
    }

