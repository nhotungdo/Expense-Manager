@page
@model MoneyTrackerApp.Pages.Subscription.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán VNPay";
    Layout = "_Layout";
}

<section class="container mt-4">
    <div class="row">
        <div class="col-lg-6 mb-3">
            <h2>Thông tin gói</h2>
            <div class="card">
                <div class="card-body">
                    <p class="text-muted mb-1" id="packageName">Đang tải...</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span id="packageDescription" class="text-secondary">Vui lòng đợi</span>
                        <strong id="packagePrice">0 ₫</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-3">
            <h2>Thanh toán VNPay QR</h2>
            <form id="checkoutForm" class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Email nhận hóa đơn</label>
                        <input type="email" class="form-control" id="billingEmail" placeholder="you@example.com" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" value="" id="agreeTerms" required />
                        <label class="form-check-label" for="agreeTerms">
                            Tôi đồng ý với điều khoản & chính sách
                        </label>
                    </div>
                    <button type="submit" class="btn btn-success w-100" id="payButton">
                        <span>Thanh toán bằng VNPay QR</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    window.checkoutContext = {
        packageId: @Model.PackageId,
        userId: @Model.UserId
    };
</script>
<script src="~/js/vnpay-checkout.js"></script>



