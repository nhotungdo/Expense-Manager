@page
@model MoneyTrackerApp.Pages.Subscription.SuccessModel
@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="result-container">
    <div class="result-card success">
        <div class="result-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1>Thanh toán thành công!</h1>
        <p class="result-message">
            Cảm ơn bạn đã đăng ký gói dịch vụ. Tài khoản của bạn đã được nâng cấp thành công.
        </p>
        
        <div class="result-details">
            <div class="detail-item">
                <i class="fas fa-envelope"></i>
                <span>Email xác nhận đã được gửi đến hộp thư của bạn</span>
            </div>
            <div class="detail-item">
                <i class="fas fa-file-invoice"></i>
                <span>Hóa đơn điện tử có thể tải xuống trong phần lịch sử thanh toán</span>
            </div>
        </div>

        <div class="result-actions">
            <a href="/Dashboard" class="btn btn-primary">
                <i class="fas fa-home"></i>
                Về trang chủ
            </a>
            <a href="/Subscription/Manage" class="btn btn-outline">
                <i class="fas fa-cog"></i>
                Quản lý gói dịch vụ
            </a>
        </div>
    </div>
</div>

<style>
.result-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.result-card {
    background: white;
    border-radius: 24px;
    padding: 48px;
    max-width: 600px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.result-icon {
    width: 100px;
    height: 100px;
    margin: 0 auto 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
}

.result-card.success .result-icon {
    background: #d1fae5;
    color: #059669;
}

.result-card h1 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-primary);
}

.result-message {
    font-size: 18px;
    color: var(--text-secondary);
    margin-bottom: 32px;
    line-height: 1.6;
}

.result-details {
    background: var(--background);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 32px;
    text-align: left;
}

.detail-item {
    display: flex;
    align-items: start;
    gap: 12px;
    margin-bottom: 16px;
}

.detail-item:last-child {
    margin-bottom: 0;
}

.detail-item i {
    color: var(--primary);
    font-size: 20px;
    margin-top: 2px;
}

.result-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.btn {
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
}

.btn-outline {
    background: transparent;
    color: var(--text-primary);
    border: 2px solid var(--border-color);
}

.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
}

@@media (max-width: 768px) {
    .result-card {
        padding: 32px 24px;
    }

    .result-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }
}
</style>
