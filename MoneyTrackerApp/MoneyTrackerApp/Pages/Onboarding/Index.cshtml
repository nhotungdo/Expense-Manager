@page
@model MoneyTrackerApp.Pages.Onboarding.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thiết lập ban đầu - MoneyTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/onboarding.css" />
</head>
<body class="onboarding-page">
    <div class="onboarding-container" id="onboardingApp">
        <!-- Progress Bar (Hidden on Welcome/Complete) -->
        <div class="progress-bar-container hidden" id="progressBarContainer">
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill" style="width: 0%;"></div>
            </div>
        </div>

        <!-- VIEW: WELCOME -->
        <div id="view-welcome" class="view-section active">
            <div class="slider-container">
                <div class="slides-wrapper" id="slidesWrapper">
                    <div class="slide active">
                        <div class="slide-illustration"><div class="illustration-icon">📊</div></div>
                        <h2 class="slide-title">Theo dõi chi tiêu</h2>
                        <p class="slide-description">Ghi chép và phân loại thu chi dễ dàng.</p>
                    </div>
                    <div class="slide">
                        <div class="slide-illustration"><div class="illustration-icon">💰</div></div>
                        <h2 class="slide-title">Quản lý ví</h2>
                        <p class="slide-description">Theo dõi số dư nhiều tài khoản cùng lúc.</p>
                    </div>
                    <div class="slide">
                        <div class="slide-illustration"><div class="illustration-icon">🎯</div></div>
                        <h2 class="slide-title">Mục tiêu tài chính</h2>
                        <p class="slide-description">Đặt mục tiêu và theo dõi tiến độ tiết kiệm.</p>
                    </div>
                </div>
                
                <div class="slide-indicators">
                    <span class="indicator active" data-slide="0"></span>
                    <span class="indicator" data-slide="1"></span>
                    <span class="indicator" data-slide="2"></span>
                </div>

                <div class="slide-navigation">
                    <button type="button" class="btn-skip" id="btnSkipWelcome">Bỏ qua</button>
                    <button type="button" class="btn-next" id="btnNextSlide">Tiếp theo</button>
                    <button type="button" class="btn-start hidden" id="btnStartOnboarding">Bắt đầu ngay</button>
                </div>
            </div>
        </div>

        <!-- VIEW: BASIC SETTINGS (Step 1) -->
        <div id="view-step1" class="view-section hidden">
            <div class="onboarding-content">
                <div class="step-header">
                    <span class="step-number">Bước 1 / 4</span>
                    <h2 class="step-title">Cài đặt cơ bản</h2>
                    <p class="step-description">Cá nhân hóa trải nghiệm của bạn</p>
                </div>
                <form id="formStep1">
                    <div class="form-group">
                        <label class="form-label">Tiền tệ chính</label>
                        <select id="currency" class="form-select" required>
                            <option value="VND" selected>Việt Nam Đồng (₫)</option>
                            <option value="USD">Đô la Mỹ ($)</option>
                            <option value="EUR">Euro (€)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ngôn ngữ</label>
                        <select id="language" class="form-select" required>
                            <option value="vi" selected>Tiếng Việt</option>
                            <option value="en">Tiếng Anh</option>
                        </select>
                    </div>
                     <div class="form-group">
                        <label class="form-label">Giao diện</label>
                        <div class="theme-selector">
                            <div class="theme-option active" data-theme="light">
                                <span class="theme-name">☀️ Sáng</span>
                            </div>
                            <div class="theme-option" data-theme="dark">
                                <span class="theme-name">🌙 Tối</span>
                            </div>
                        </div>
                        <input type="hidden" id="theme" value="light">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="app.showView('welcome')">Quay lại</button>
                        <button type="submit" class="btn-primary">Tiếp theo</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- VIEW: CREATE WALLET (Step 2) -->
        <div id="view-step2" class="view-section hidden">
            <div class="onboarding-content">
                <div class="step-header">
                    <span class="step-number">Bước 2 / 4</span>
                    <h2 class="step-title">Tạo ví đầu tiên</h2>
                    <p class="step-description">Nơi khởi đầu hành trình tài chính</p>
                </div>
                <form id="formStep2">
                    <div class="form-group">
                        <label class="form-label">Tên ví</label>
                        <input type="text" id="walletName" class="form-input" value="Ví tiền mặt" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Loại ví</label>
                        <div class="wallet-type-grid">
                            <div class="wallet-type-card active" data-type="0"><div class="type-icon">💵</div><span>Tiền mặt</span></div>
                            <div class="wallet-type-card" data-type="1"><div class="type-icon">🏦</div><span>Ngân hàng</span></div>
                            <div class="wallet-type-card" data-type="2"><div class="type-icon">💳</div><span>Thẻ tín dụng</span></div>
                        </div>
                        <input type="hidden" id="walletType" value="0">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số dư ban đầu</label>
                        <input type="number" id="initialBalance" class="form-input" value="0" min="0" required>
                    </div>
                     <div class="form-group">
                        <label class="form-label">Màu sắc</label>
                        <div class="color-picker">
                            <!-- Colors generated by JS or static -->
                            <div class="color-option selected" data-color="#4CAF50" style="background:#4CAF50"></div>
                            <div class="color-option" data-color="#2196F3" style="background:#2196F3"></div>
                            <div class="color-option" data-color="#FF9800" style="background:#FF9800"></div>
                            <div class="color-option" data-color="#F44336" style="background:#F44336"></div>
                        </div>
                        <input type="hidden" id="walletColor" value="#4CAF50">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="app.showView('step1')">Quay lại</button>
                        <button type="submit" class="btn-primary">Tiếp theo</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- VIEW: CATEGORIES (Step 3) -->
        <div id="view-step3" class="view-section hidden">
            <div class="onboarding-content">
                <div class="step-header">
                    <span class="step-number">Bước 3 / 4</span>
                    <h2 class="step-title">Thiết lập danh mục</h2>
                    <p class="step-description">Chọn mẫu danh mục phù hợp với bạn</p>
                </div>
                <form id="formStep3">
                    <div class="template-grid">
                        <div class="template-card active" data-template="Student">
                            <div class="template-icon">🎓</div>
                            <div class="template-name">Sinh viên</div>
                        </div>
                        <div class="template-card" data-template="Family">
                            <div class="template-icon">🏠</div>
                            <div class="template-name">Gia đình</div>
                        </div>
                         <div class="template-card" data-template="Business">
                            <div class="template-icon">💼</div>
                            <div class="template-name">Kinh doanh</div>
                        </div>
                        <div class="template-card" data-template="Freelancer">
                            <div class="template-icon">💻</div>
                            <div class="template-name">Freelancer</div>
                        </div>
                    </div>
                    <input type="hidden" id="categoryTemplate" value="Student">
                    
                    <div class="category-preview-container" id="categoryPreview">
                        <!-- Loaded via JS -->
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="app.showView('step2')">Quay lại</button>
                        <button type="submit" class="btn-primary">Tiếp theo</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- VIEW: SAVINGS GOAL (Step 4) -->
        <div id="view-step4" class="view-section hidden">
             <div class="onboarding-content">
                <div class="step-header">
                    <span class="step-number">Bước 4 / 4</span>
                    <h2 class="step-title">Mục tiêu tiết kiệm</h2>
                    <p class="step-description">Bạn có muốn đặt mục tiêu tiết kiệm không?</p>
                </div>
                <form id="formStep4">
                    <div class="form-group">
                        <label class="form-label">Tên mục tiêu</label>
                        <input type="text" id="goalName" class="form-input" placeholder="Mua xe, Du lịch...">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số tiền mục tiêu</label>
                        <input type="number" id="targetAmount" class="form-input" placeholder="0">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ngày hoàn thành</label>
                        <input type="date" id="targetDate" class="form-input">
                    </div>
                    
                    <div class="calculation-card hidden" id="goalCalcCard">
                        <div class="calc-label">Cần tiết kiệm mỗi tháng</div>
                        <div class="calc-amount" id="monthlySavings">0 ₫</div>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="app.showView('step3')">Quay lại</button>
                         <button type="button" class="btn-text" id="skipGoal">Bỏ qua bước này</button>
                        <button type="submit" class="btn-primary">Hoàn tất</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- VIEW: COMPLETE -->
        <div id="view-complete" class="view-section hidden">
            <div class="onboarding-content centered">
                <div class="success-animation">
                    <div class="checkmark-circle">
                         <div class="checkmark"></div>
                    </div>
                </div>
                <h2 class="completion-title">Tuyệt vời!</h2>
                <p class="completion-text">Tài khoản của bạn đã được thiết lập thành công. Hãy bắt đầu quản lý tài chính ngay hôm nay.</p>
                
                <div class="setup-summary">
                    <div class="summary-card">
                        <div class="summary-icon">💼</div>
                        <div class="summary-label">Ví chính</div>
                        <div class="summary-value" id="summaryWallet">--</div>
                    </div>
                    <div class="summary-card">
                         <div class="summary-icon">📋</div>
                        <div class="summary-label">Danh mục</div>
                        <div class="summary-value" id="summaryCategories">--</div>
                    </div>
                </div>

                <button class="btn-primary btn-large" onclick="window.location.href='/Home'">
                    Đến Bảng điều khiển
                </button>
            </div>
        </div>
        
         <!-- Error Message Toast -->
        <div id="toast" class="toast-message hidden"></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- We will implement logic in onboarding.js to handle this SPA -->
    <script src="~/js/onboarding.js"></script>
</body>
</html>
