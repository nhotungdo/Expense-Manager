@page
@model MoneyTrackerApp.Pages.Onboarding.CompleteModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thiết lập hoàn tất - Money Tracker</title>
    <link rel="stylesheet" href="~/css/onboarding.css" />
</head>
<body class="onboarding-page completion-page">
    <div class="onboarding-container">
        <!-- Progress indicator -->
        <div class="progress-bar">
            <div class="progress-fill" style="width: 100%"></div>
        </div>

        <div class="onboarding-content centered">
            <!-- Success Animation -->
            <div class="success-animation">
                <div class="checkmark-circle">
                    <div class="checkmark"></div>
                </div>
            </div>

            <!-- Congratulations Message -->
            <div class="completion-message">
                <h1 class="completion-title">🎉 Chúc mừng!</h1>
                <p class="completion-text">
                    Tài khoản Money Tracker của bạn đã được thiết lập và sẵn sàng.
                    Bắt đầu quản lý tài chính như một chuyên gia!
                </p>
            </div>

            <!-- Quick Stats -->
            <div class="setup-summary">
                <div class="summary-card">
                    <div class="summary-icon">💰</div>
                    <div class="summary-label">Ví đã tạo</div>
                    <div class="summary-value" id="walletName">-</div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon">📋</div>
                    <div class="summary-label">Danh mục</div>
                    <div class="summary-value" id="categoryCount">-</div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon">🎯</div>
                    <div class="summary-label">Mục tiêu</div>
                    <div class="summary-value" id="goalCount">-</div>
                </div>
            </div>

            <!-- Action Button -->
            <div class="completion-actions">
                <button type="button" class="btn-primary btn-large" id="btnGoToDashboard">
                    Đi đến Bảng điều khiển →
                </button>
            </div>

            <!-- Tips -->
            <div class="quick-tips">
                <h3 class="tips-title">💡 Mẹo nhanh để bắt đầu</h3>
                <ul class="tips-list">
                    <li>Ghi lại giao dịch đầu tiên để thấy số dư cập nhật</li>
                    <li>Thiết lập ngân sách để kiểm soát chi tiêu</li>
                    <li>Kiểm tra trang Báo cáo để xem thông tin chi tiết</li>
                    <li>Bật thông báo để luôn theo dõi sát sao</li>
                </ul>
            </div>
        </div>
    </div>

    <script src="~/js/onboarding-complete.js"></script>
</body>
</html>
