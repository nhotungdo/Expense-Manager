@page
@model MoneyTrackerApp.Pages.Onboarding.WelcomeModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chào mừng đến với Money Tracker</title>
    <link rel="stylesheet" href="~/css/onboarding.css" />
</head>
<body class="onboarding-page">
    <div class="onboarding-container">
        <!-- Progress indicator -->
        <div class="progress-bar">
            <div class="progress-fill" style="width: 16.67%"></div>
        </div>

        <!-- Slider container -->
        <div class="slider-container">
            <div class="slides-wrapper" id="slidesWrapper">
                <!-- Slide 1 -->
                <div class="slide active">
                    <div class="slide-illustration">
                        <div class="illustration-icon">📊</div>
                    </div>
                    <h2 class="slide-title">Theo dõi chi tiêu của bạn</h2>
                    <p class="slide-description">
                        Dễ dàng ghi chép và phân loại tất cả thu nhập và chi tiêu tại một nơi. 
                        Có cái nhìn rõ ràng về dòng tiền của bạn.
                    </p>
                </div>

                <!-- Slide 2 -->
                <div class="slide">
                    <div class="slide-illustration">
                        <div class="illustration-icon">💰</div>
                    </div>
                    <h2 class="slide-title">Quản lý nhiều ví</h2>
                    <p class="slide-description">
                        Tạo và quản lý nhiều ví tiền mặt, tài khoản ngân hàng, thẻ tín dụng 
                        và hơn thế nữa. Theo dõi số dư trên tất cả các tài khoản.
                    </p>
                </div>

                <!-- Slide 3 -->
                <div class="slide">
                    <div class="slide-illustration">
                        <div class="illustration-icon">📈</div>
                    </div>
                    <h2 class="slide-title">Báo cáo & Phân tích trực quan</h2>
                    <p class="slide-description">
                        Nhận thông tin chi tiết với các biểu đồ và báo cáo đẹp mắt. 
                        Hiểu rõ thói quen chi tiêu và đưa ra quyết định tài chính tốt hơn.
                    </p>
                </div>

                <!-- Slide 4 -->
                <div class="slide">
                    <div class="slide-illustration">
                        <div class="illustration-icon">🎯</div>
                    </div>
                    <h2 class="slide-title">Đặt mục tiêu tiết kiệm</h2>
                    <p class="slide-description">
                        Xác định mục tiêu tài chính và theo dõi tiến độ. 
                        Giữ động lực với các chỉ số tiến độ trực quan.
                    </p>
                </div>

                <!-- Slide 5 -->
                <div class="slide">
                    <div class="slide-illustration">
                        <div class="illustration-icon">🤖</div>
                    </div>
                    <h2 class="slide-title">Thông tin chi tiết từ AI</h2>
                    <p class="slide-description">
                        Nhận lời khuyên tài chính cá nhân hóa và các gợi ý thông minh 
                        được hỗ trợ bởi trí tuệ nhân tạo.
                    </p>
                </div>
            </div>

            <!-- Slide indicators -->
            <div class="slide-indicators">
                <span class="indicator active" data-slide="0"></span>
                <span class="indicator" data-slide="1"></span>
                <span class="indicator" data-slide="2"></span>
                <span class="indicator" data-slide="3"></span>
                <span class="indicator" data-slide="4"></span>
            </div>

            <!-- Navigation buttons -->
            <div class="slide-navigation">
                <button type="button" class="btn-skip" id="btnSkip">Bỏ qua</button>
                <button type="button" class="btn-next" id="btnNext">Tiếp theo</button>
                <button type="button" class="btn-start hidden" id="btnStart">Bắt đầu ngay</button>
            </div>
        </div>
    </div>

    <script src="~/js/onboarding-welcome.js"></script>
</body>
</html>
