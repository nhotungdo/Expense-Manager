@page
@model MoneyTrackerApp.Pages.Onboarding.SplashModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Money Tracker - Loading</title>
    <link rel="stylesheet" href="~/css/onboarding.css" />
</head>
<body class="splash-screen">
    <div class="splash-container">
        <div class="logo-container">
            <div class="logo-icon">💰</div>
            <h1 class="app-name">Money Tracker</h1>
            <p class="app-tagline">Your Personal Finance Manager</p>
        </div>
        
        <div class="loading-animation">
            <div class="spinner"></div>
            <p class="loading-text">Loading...</p>
        </div>
    </div>

    <script>
        // Simulate loading and check onboarding status
        window.addEventListener('DOMContentLoaded', async () => {
            try {
                // Wait minimum 2 seconds for splash effect
                await new Promise(resolve => setTimeout(resolve, 2000));

                // Check if user is authenticated
                const accessToken = getCookie('AccessToken');
                
                if (!accessToken) {
                    // Not authenticated, go to login
                    window.location.href = '/Auth/Login';
                    return;
                }

                // Check onboarding status
                const response = await fetch('/api/onboarding/status', {
                    headers: {
                        'Authorization': `Bearer ${accessToken}`
                    }
                });

                if (response.ok) {
                    const status = await response.json();
                    
                    if (status.isCompleted) {
                        // Onboarding completed, go to home
                        window.location.href = '/Home';
                    } else {
                        // Continue onboarding
                        redirectToOnboardingStep(status.currentStep);
                    }
                } else {
                    // Initialize onboarding
                    const initResponse = await fetch('/api/onboarding/initialize', {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${accessToken}`
                        }
                    });

                    if (initResponse.ok) {
                        window.location.href = '/Onboarding/Welcome';
                    } else {
                        window.location.href = '/Auth/Login';
                    }
                }
            } catch (error) {
                console.error('Error checking onboarding status:', error);
                // Default to login on error
                window.location.href = '/Auth/Login';
            }
        });

        function redirectToOnboardingStep(step) {
            const stepRoutes = {
                0: '/Onboarding/Welcome',
                1: '/Onboarding/Welcome',
                2: '/Onboarding/BasicSettings',
                3: '/Onboarding/CreateWallet',
                4: '/Onboarding/SetupCategories',
                5: '/Onboarding/SavingsGoal',
                6: '/Home'
            };

            window.location.href = stepRoutes[step] || '/Onboarding/Welcome';
        }

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }
    </script>
</body>
</html>
