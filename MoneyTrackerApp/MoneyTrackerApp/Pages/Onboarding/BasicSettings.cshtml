@page
@model MoneyTrackerApp.Pages.Onboarding.BasicSettingsModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cài đặt cơ bản - Money Tracker</title>
    <link rel="stylesheet" href="~/css/onboarding.css" />
</head>
<body class="onboarding-page">
    <div class="onboarding-container">
        <!-- Progress indicator -->
        <div class="progress-bar">
            <div class="progress-fill" style="width: 33.33%"></div>
        </div>

        <div class="onboarding-content">
            <div class="step-header">
                <span class="step-number">Bước 1 / 4</span>
                <h1 class="step-title">Cài đặt cơ bản</h1>
                <p class="step-description">Hãy cá nhân hóa trải nghiệm của bạn</p>
            </div>

            <form id="basicSettingsForm" class="onboarding-form">
                <!-- Currency Selection -->
                <div class="form-group">
                    <label for="currency" class="form-label">
                        <span class="label-icon">💱</span>
                        Tiền tệ chính
                    </label>
                    <select id="currency" name="currency" class="form-select" required>
                        <option value="VND" selected>Việt Nam Đồng (₫)</option>
                        <option value="USD">Đô la Mỹ ($)</option>
                        <option value="EUR">Euro (€)</option>
                        <option value="GBP">Bảng Anh (£)</option>
                        <option value="JPY">Yên Nhật (¥)</option>
                    </select>
                    <small class="form-hint">Đây sẽ là đơn vị tiền tệ mặc định cho tất cả các giao dịch</small>
                </div>

                <!-- Language Selection -->
                <div class="form-group">
                    <label for="language" class="form-label">
                        <span class="label-icon">🌐</span>
                        Ngôn ngữ
                    </label>
                    <select id="language" name="language" class="form-select" required>
                        <option value="vi" selected>Tiếng Việt</option>
                        <option value="en">Tiếng Anh</option>
                    </select>
                    <small class="form-hint">Chọn ngôn ngữ ưa thích của bạn</small>
                </div>

                <!-- Theme Selection -->
                <div class="form-group">
                    <label class="form-label">
                        <span class="label-icon">🎨</span>
                        Giao diện
                    </label>
                    <div class="theme-selector">
                        <div class="theme-option" data-theme="light">
                            <div class="theme-preview light">
                                <div class="preview-bar"></div>
                                <div class="preview-content"></div>
                            </div>
                            <span class="theme-name">Sáng</span>
                            <input type="radio" name="theme" value="light" checked>
                        </div>
                        <div class="theme-option" data-theme="dark">
                            <div class="theme-preview dark">
                                <div class="preview-bar"></div>
                                <div class="preview-content"></div>
                            </div>
                            <span class="theme-name">Tối</span>
                            <input type="radio" name="theme" value="dark">
                        </div>
                    </div>
                </div>

                <!-- Error message -->
                <div id="errorMessage" class="error-message hidden"></div>

                <!-- Navigation buttons -->
                <div class="form-actions">
                    <button type="button" class="btn-secondary" onclick="window.location.href='/Onboarding/Welcome'">
                        ← Quay lại
                    </button>
                    <button type="submit" class="btn-primary">
                        Tiếp theo →
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/onboarding-basic-settings.js"></script>
</body>
</html>
