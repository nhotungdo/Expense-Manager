@using MoneyTrackerApp.Services
@using MoneyTrackerApp.DTOs
@using System.Security.Claims
@using System.Linq
@inject IAccountService AccountService

@{
    decimal totalBalance = 0;
    string currency = "VND";
    
    // Get current user ID
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier);
    if (userIdClaim != null && long.TryParse(userIdClaim.Value, out var userId))
    {
        try {
            // Fetch account summaries
            var accounts = await AccountService.GetAccountSummariesAsync(userId);
            
            totalBalance = accounts.Where(a => a.IncludeInTotal).Sum(a => a.CurrentBalance);
            
            if (accounts.Any()) currency = accounts.First().Currency;
        } catch { } 
    }
}

<div class="wallet-context-switcher d-flex align-items-center me-3 border-end pe-3">
    <!-- Wallet Dropdown -->
    <div class="dropdown me-3">
        <button class="btn btn-light dropdown-toggle d-flex align-items-center border-0 bg-transparent" type="button" id="walletDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="wallet-icon-container bg-primary-subtle rounded-circle p-1 me-2 text-primary">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="d-flex flex-column align-items-start lh-sm">
                <span class="small text-muted fw-bold text-uppercase">Ví</span>
                <span class="fw-bold text-dark" id="selectedWalletName">Tất cả tài khoản</span>
            </div>
        </button>
        <ul class="dropdown-menu shadow border-0" aria-labelledby="walletDropdown">
            <li><a class="dropdown-item active" href="#" data-wallet-id="all"><i class="fas fa-layer-group me-2"></i>Tất cả tài khoản</a></li>
            <li><hr class="dropdown-divider"></li>
            <!-- Dynamic part would go here -->
            <li><a class="dropdown-item text-muted disabled" href="#">(Tính năng sắp ra mắt)</a></li>
        </ul>
    </div>

    <!-- Balance Glance -->
    <div class="balance-glance position-relative">
        <div class="small text-muted text-uppercase fw-bold">Tổng số dư</div>
        <div class="d-flex align-items-center">
            <span class="fs-5 fw-bolder text-dark me-2 money-amount" data-value="@totalBalance">@totalBalance.ToString("N0") @currency</span>
            <button class="btn btn-sm btn-link text-muted p-0 border-0" id="toggleBalanceBtn" onclick="toggleBalance()">
                <i class="fas fa-eye"></i>
            </button>
        </div>
    </div>
</div>

<script>
    function toggleBalance() {
        const amountElements = document.querySelectorAll('.money-amount');
        const btn = document.getElementById('toggleBalanceBtn');
        const icon = btn.querySelector('i');
        
        amountElements.forEach(el => {
            if (el.classList.contains('hidden-balance')) {
                // Restore original value
                el.textContent = el.dataset.originalValue;
                el.classList.remove('hidden-balance');
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                // Hide value
                el.dataset.originalValue = el.textContent;
                el.textContent = '******';
                el.classList.add('hidden-balance');
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        });
    }
</script>
