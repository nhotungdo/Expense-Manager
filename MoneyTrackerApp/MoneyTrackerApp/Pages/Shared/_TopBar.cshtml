@using Microsoft.AspNetCore.Identity

<!-- Modern Top Navigation Bar -->
<header class="fixed top-0 left-64 right-0 h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 z-30">
    <!-- Search Bar -->
    <div class="flex-1 max-w-xl">
       
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
        <!-- Quick Add Button -->
        <div class="relative quick-add-dropdown">
            <button 
                type="button" 
                onclick="toggleQuickAdd()"
                class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-full font-semibold text-sm hover:shadow-lg hover:scale-105 transition-all duration-200">
                <i class="fas fa-plus"></i>
                <span>Thêm nhanh</span>
            </button>
            
            <!-- Dropdown Menu -->
            <div id="quickAddMenu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-slate-200 py-2 z-50">
                <a href="javascript:void(0)" onclick="openTransactionModal(1)" class="flex items-center gap-3 px-4 py-3 hover:bg-emerald-50 transition-colors">
                    <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-arrow-down text-emerald-600"></i>
                    </div>
                    <span class="font-medium text-slate-700">Thêm thu nhập</span>
                </a>
                <a href="javascript:void(0)" onclick="openTransactionModal(2)" class="flex items-center gap-3 px-4 py-3 hover:bg-red-50 transition-colors">
                    <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-arrow-up text-red-600"></i>
                    </div>
                    <span class="font-medium text-slate-700">Thêm chi tiêu</span>
                </a>
                <div class="border-t border-slate-200 my-2"></div>
                <a href="/Trading/Index" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 transition-colors">
                    <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-chart-pie text-slate-600"></i>
                    </div>
                    <span class="font-medium text-slate-700">Xem phân tích</span>
                </a>
            </div>
        </div>

        <!-- Currency Selector -->
        <div class="relative currency-selector me-2">
            <button 
                type="button" 
                onclick="toggleCurrencyMenu()"
                class="flex items-center gap-2 px-3 py-2 bg-slate-50 hover:bg-slate-100 rounded-xl transition-all border border-slate-100">
                <span id="currentCurrencyFlag" class="text-lg">🇻🇳</span>
                <span id="currentCurrencyCode" class="font-bold text-slate-700 text-sm">VND</span>
                <i class="fas fa-chevron-down text-slate-400 text-[10px]"></i>
            </button>
            <div id="currencyMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-2xl shadow-xl border border-slate-200 py-2 z-50">
                <a href="javascript:void(0)" onclick="setGlobalCurrency('VND', '🇻🇳')" class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 transition-colors">
                    <span class="text-lg">🇻🇳</span>
                    <span class="font-medium text-slate-700">VNĐ (Việt Nam)</span>
                </a>
                <a href="javascript:void(0)" onclick="setGlobalCurrency('USD', '🇺🇸')" class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 transition-colors">
                    <span class="text-lg">🇺🇸</span>
                    <span class="font-medium text-slate-700">USD (Mỹ)</span>
                </a>
                <a href="javascript:void(0)" onclick="setGlobalCurrency('EUR', '🇪🇺')" class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 transition-colors">
                    <span class="text-lg">🇪🇺</span>
                    <span class="font-medium text-slate-700">EUR (Châu Âu)</span>
                </a>
                <a href="javascript:void(0)" onclick="setGlobalCurrency('JPY', '🇯🇵')" class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 transition-colors">
                    <span class="text-lg">🇯🇵</span>
                    <span class="font-medium text-slate-700">JPY (Nhật Bản)</span>
                </a>
                <div class="border-t border-slate-100 my-1"></div>
                <a href="/Settings/Currencies" class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 transition-colors text-blue-600">
                    <i class="fas fa-cog text-xs"></i>
                    <span class="font-medium text-sm">Thêm tiền tệ...</span>
                </a>
            </div>
        </div>

        <!-- Notifications -->
        <a href="/Notifications" class="relative w-10 h-10 bg-slate-50 hover:bg-slate-100 rounded-xl flex items-center justify-center transition-colors">
            <i class="far fa-bell text-slate-600 text-lg"></i>
            <span id="userNotificationBadge" class="hidden absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-semibold">0</span>
        </a>

        <!-- User Profile Dropdown -->
        <div class="relative user-dropdown">
            <button 
                type="button"
                onclick="toggleUserMenu()"
                class="flex items-center gap-3 pl-3 pr-4 py-2 bg-slate-50 hover:bg-slate-100 rounded-xl transition-colors">
                <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-lg flex items-center justify-center">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-white font-bold text-sm">@User.Identity.Name?.Substring(0, 1).ToUpper()</span>
                    }
                    else
                    {
                        <i class="fas fa-user text-white text-sm"></i>
                    }
                </div>
                <span class="font-semibold text-slate-700 text-sm">@User.Identity?.Name</span>
                <i class="fas fa-chevron-down text-slate-400 text-xs"></i>
            </button>
            
            <!-- User Dropdown Menu -->
            <div id="userMenu" class="hidden absolute right-0 mt-2 w-72 bg-white rounded-2xl shadow-xl border border-slate-200 py-2 z-50">
                <!-- User Profile Header -->
                <div class="px-4 py-3 border-b border-slate-100">
                     <p class="font-bold text-slate-800 break-words">@User.Identity?.Name</p>
                     <p class="text-xs text-slate-500">Đang hoạt động</p>
                </div>

                <a href="/Profile" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 transition-colors">
                    <i class="fas fa-user-circle text-slate-600 w-5"></i>
                    <span class="font-medium text-slate-700">Xem hồ sơ</span>
                </a>
                <a href="/Settings" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 transition-colors">
                    <i class="fas fa-cog text-slate-600 w-5"></i>
                    <span class="font-medium text-slate-700">Cài đặt</span>
                </a>
                
                <!-- Account Switcher Section -->
                <div class="border-t border-slate-200 my-2"></div>
                <div class="px-4 py-2 flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Chuyển đổi tài khoản</span>
                </div>
                
                <div id="accountSwitcherLoading" class="hidden px-4 py-2 text-center text-slate-500 text-sm">
                    <i class="fas fa-spinner fa-spin mr-2"></i>Đang tải...
                </div>
                
                <div id="accountSwitcherList" class="max-h-48 overflow-y-auto custom-scrollbar">
                    <!-- Accounts injected by JS -->
                </div>
                
                <a href="/Auth/Login?action=add_account&returnUrl=@(Context.Request.Path + Context.Request.QueryString)" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 transition-colors text-blue-600">
                    <i class="fas fa-plus-circle w-5"></i>
                    <span class="font-medium">Thêm tài khoản khác</span>
                </a>

                <div class="border-t border-slate-200 my-2"></div>
                
                <form asp-page="/Auth/Logout" method="post">
                    <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 hover:bg-red-50 transition-colors text-left">
                        <i class="fas fa-sign-out-alt text-red-600 w-5"></i>
                        <span class="font-medium text-red-600">Đăng xuất</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>

<script>
    function toggleQuickAdd() {
        const menu = document.getElementById('quickAddMenu');
        menu.classList.toggle('hidden');
    }
    
    function toggleUserMenu() {
        const menu = document.getElementById('userMenu');
        const isClosed = menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        
        if (isClosed) {
            loadAccounts();
        }
    }
    
    async function loadAccounts() {
        const listEl = document.getElementById('accountSwitcherList');
        const loadingEl = document.getElementById('accountSwitcherLoading');
        
        if (!listEl) return;
        
        loadingEl.classList.remove('hidden');
        listEl.innerHTML = '';
        
        try {
            const response = await fetch('/api/auth/accounts');
            if (response.ok) {
                const accounts = await response.json();
                renderAccounts(accounts, listEl);
            }
        } catch (error) {
            console.error('Failed to load accounts', error);
        } finally {
            loadingEl.classList.add('hidden');
        }
    }
    
    function renderAccounts(accounts, container) {
        if (!accounts || accounts.length === 0) {
            container.innerHTML = '<div class="px-4 py-2 text-sm text-slate-400 italic">Không có tài khoản khác</div>';
            return;
        }
        
        // Filter out current account if desired, or show it as active
        // Let's show all, marking active
        const html = accounts.map(acc => {
            const activeClass = acc.isActive ? 'bg-blue-50 border-l-4 border-blue-500' : 'hover:bg-slate-50';
            const icon = acc.isActive ? '<i class="fas fa-check-circle text-blue-500"></i>' : '';
            const statusText = acc.isActive ? '<span class="text-xs text-blue-600 font-medium">Hiện tại</span>' : '';
            
            return `
                <div onclick="switchAccount('${acc.sessionId}', ${acc.isActive})" 
                     class="cursor-pointer px-4 py-3 flex items-center justify-between transition-colors ${activeClass}">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-xs shrink-0">
                            ${acc.email.charAt(0).toUpperCase()}
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-slate-800 truncate">${acc.fullName || acc.email}</p>
                            <p class="text-xs text-slate-500 truncate">${acc.email}</p>
                        </div>
                    </div>
                    <div class="shrink-0 ml-2">
                        ${icon}
                    </div>
                </div>
            `;
        }).join('');
        
        container.innerHTML = html;
    }
    
    async function switchAccount(sessionId, isActive) {
        if (isActive) return; // Already here
        
        try {
            const overlay = document.createElement('div');
            overlay.className = 'fixed inset-0 bg-white/50 backdrop-blur-sm z-[100] flex items-center justify-center';
            overlay.innerHTML = '<div class="bg-white p-4 rounded-xl shadow-lg flex items-center gap-3"><i class="fas fa-spinner fa-spin text-blue-600"></i><span class="font-medium">Đang chuyển tài khoản...</span></div>';
            document.body.appendChild(overlay);
            
            const res = await fetch(`/api/auth/switch-account/${sessionId}`, { method: 'POST' });
            if (res.ok) {
                sessionStorage.setItem('currentSessionId', sessionId);
                window.location.reload();
            } else {
                alert('Không thể chuyển tài khoản. Vui lòng đăng nhập lại.');
                document.body.removeChild(overlay);
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối.');
            if (document.body.lastChild.className?.includes('fixed')) document.body.removeChild(document.body.lastChild);
        }
    }
    
    function toggleCurrencyMenu() {
        const menu = document.getElementById('currencyMenu');
        menu.classList.toggle('hidden');
    }

    function setGlobalCurrency(code, flag) {
        localStorage.setItem('globalCurrency', code);
        localStorage.setItem('globalCurrencyFlag', flag);
        
        document.getElementById('currentCurrencyCode').innerText = code;
        document.getElementById('currentCurrencyFlag').innerText = flag;
        document.getElementById('currencyMenu').classList.add('hidden');
        
        // Trigger global event for components to refresh
        window.dispatchEvent(new CustomEvent('currency:changed', { detail: { code, flag } }));
        
        // If on home or report page, reload data might be needed
        // For simplicity, we can reload or just let components handle it
        if (typeof window.loadPersonalWalletData === 'function') {
            window.loadPersonalWalletData();
        }
        if (typeof window.loadRecentTransactions === 'function') {
            window.loadRecentTransactions();
        }
    }

    // Initialize currency selector from localStorage
    document.addEventListener('DOMContentLoaded', () => {
        const code = localStorage.getItem('globalCurrency') || 'VND';
        const flag = localStorage.getItem('globalCurrencyFlag') || '🇻🇳';
        
        const codeEl = document.getElementById('currentCurrencyCode');
        const flagEl = document.getElementById('currentCurrencyFlag');
        
        if (codeEl) codeEl.innerText = code;
        if (flagEl) flagEl.innerText = flag;
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
        if (!event.target.closest('.quick-add-dropdown')) {
            document.getElementById('quickAddMenu')?.classList.add('hidden');
        }
        if (!event.target.closest('.user-dropdown')) {
            document.getElementById('userMenu')?.classList.add('hidden');
        }
        if (!event.target.closest('.currency-selector')) {
            document.getElementById('currencyMenu')?.classList.add('hidden');
        }
    });
</script>
