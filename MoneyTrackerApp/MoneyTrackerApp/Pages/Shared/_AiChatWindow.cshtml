@* AI Chat Floating Window *@
<div class="ai-chat-container" id="aiChatContainer">
    <!-- Floating Action Button -->
    <button class="ai-chat-fab" id="aiChatFab" onclick="toggleAiChat()">
        <i class="fas fa-robot"></i>
        <span class="ai-chat-badge" id="aiChatBadge" style="display: none;">1</span>
    </button>

    <!-- Chat Window -->
    <div class="ai-chat-window" id="aiChatWindow" style="display: none;">
        <!-- Chat Header -->
        <div class="ai-chat-header">
            <div class="ai-chat-header-left">
                <div class="ai-avatar">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="ai-chat-title">
                    <h4>Financial Copilot</h4>
                    <span class="ai-status">Trực tuyến</span>
                </div>
            </div>
            <div class="ai-chat-header-right">
                <button class="ai-chat-btn" onclick="clearAiChat()" title="Xóa lịch sử">
                    <i class="fas fa-trash-alt"></i>
                </button>
                <button class="ai-chat-btn" onclick="toggleAiChat()" title="Đóng">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Chat Messages -->
        <div class="ai-chat-messages" id="aiChatMessages">
            <div class="ai-message ai-message-bot">
                <div class="ai-message-avatar">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="ai-message-content">
                    <div class="ai-message-bubble">
                        <p>Xin chào! 👋 Tôi là trợ lý tài chính AI của bạn. Tôi có thể giúp bạn:</p>
                        <ul>
                            <li>Phân tích chi tiêu và xu hướng</li>
                            <li>Dự báo dòng tiền</li>
                            <li>Đưa ra lời khuyên tiết kiệm</li>
                            <li>Trả lời câu hỏi về tài chính</li>
                        </ul>
                        <p>Hãy hỏi tôi bất cứ điều gì! 💡</p>
                    </div>
                    <span class="ai-message-time">Bây giờ</span>
                </div>
            </div>
        </div>

        <!-- Suggested Prompts -->
        <div class="ai-chat-suggestions" id="aiChatSuggestions">
            <button class="ai-suggestion-chip" onclick="sendSuggestedPrompt('Tình hình tài chính hôm nay?')">
                <i class="fas fa-chart-line"></i> Tình hình tài chính hôm nay?
            </button>
            <button class="ai-suggestion-chip" onclick="sendSuggestedPrompt('Tôi có chi tiêu quá đà không?')">
                <i class="fas fa-exclamation-triangle"></i> Tôi có chi tiêu quá đà không?
            </button>
            <button class="ai-suggestion-chip" onclick="sendSuggestedPrompt('Dự báo cuối tháng')">
                <i class="fas fa-crystal-ball"></i> Dự báo cuối tháng
            </button>
            <button class="ai-suggestion-chip" onclick="sendSuggestedPrompt('Làm sao để tiết kiệm hơn?')">
                <i class="fas fa-piggy-bank"></i> Làm sao để tiết kiệm hơn?
            </button>
        </div>

        <!-- Chat Input -->
        <div class="ai-chat-input-container">
            <div class="ai-chat-input-wrapper">
                <input 
                    type="text" 
                    class="ai-chat-input" 
                    id="aiChatInput" 
                    placeholder="Hỏi bất cứ điều gì về tài chính của bạn..."
                    onkeypress="handleAiChatKeyPress(event)"
                />
                <button class="ai-chat-send" id="aiChatSend" onclick="sendAiMessage()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>
