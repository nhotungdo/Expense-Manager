@using System.Security.Claims
@{
    var email = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name ?? "Admin";
}

<nav class="admin-header">
    <button class="btn btn-link link-dark border-0 p-0" id="menu-toggle">
        <i class="fas fa-bars fa-lg"></i>
    </button>

    <div class="ms-auto d-flex align-items-center gap-3">
        <div class="text-end d-none d-sm-block">
            <div class="fw-semibold">@email</div>
            <div class="text-muted small">Admin</div>
        </div>
        <div class="dropdown">
            <div class="admin-profile dropdown-toggle" id="adminDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="admin-avatar">AD</div>
            </div>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow" aria-labelledby="adminDropdown">
                <li>
                    <form class="form-inline" asp-area="" asp-page="/Auth/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item text-danger">Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    if (!document.getElementById('menu-toggle').hasAttribute('data-initialized')) {
        document.getElementById('menu-toggle').addEventListener('click', function (e) {
            e.preventDefault();
            $("#sidebar-wrapper").toggleClass("toggled");
        });
        document.getElementById('menu-toggle').setAttribute('data-initialized', 'true');
    }
</script>
