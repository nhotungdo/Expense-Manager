<!-- Modern Add Transaction Modal -->
<div id="transactionModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
        <!-- Modal Header with Tabs -->
        <div class="sticky top-0 bg-white border-b border-slate-200 rounded-t-3xl z-10">
            <div class="flex items-center justify-between p-6 pb-0">
                <h2 class="text-2xl font-bold text-slate-900">Thêm giao dịch</h2>
                <button onclick="closeTransactionModal()" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 rounded-xl flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-slate-600"></i>
                </button>
            </div>

            <!-- Transaction Type Tabs -->
            <div class="flex gap-2 p-6 pt-4">
                <button 
                    type="button" 
                    onclick="setTransactionType('Expense')" 
                    class="flex-1 py-3 px-4 rounded-xl font-semibold text-sm transition-all tab-expense active"
                    data-type="Expense">
                    <i class="fas fa-arrow-up mr-2"></i>Chi tiêu
                </button>
                <button 
                    type="button" 
                    onclick="setTransactionType('Income')" 
                    class="flex-1 py-3 px-4 rounded-xl font-semibold text-sm transition-all tab-income"
                    data-type="Income">
                    <i class="fas fa-arrow-down mr-2"></i>Thu nhập
                </button>
                <button 
                    type="button" 
                    onclick="setTransactionType('Transfer')" 
                    class="flex-1 py-3 px-4 rounded-xl font-semibold text-sm transition-all tab-transfer"
                    data-type="Transfer">
                    <i class="fas fa-exchange-alt mr-2"></i>Chuyển khoản
                </button>
            </div>
        </div>

        <!-- Modal Body -->
        <form id="transactionForm" class="p-6 space-y-6">
            <input type="hidden" id="transactionType" value="Expense">

            <!-- Amount Input (Large, Centered) -->
            <div class="text-center py-6">
                <label class="block text-sm font-semibold text-slate-500 mb-3">Số tiền</label>
                <div class="relative inline-block">
                    <span class="absolute left-0 top-1/2 -translate-y-1/2 text-4xl font-bold text-slate-400">₫</span>
                    <input 
                        type="number" 
                        id="amount" 
                        step="0.01"
                        placeholder="0"
                        class="text-5xl font-bold text-center border-none outline-none w-full pl-12 text-slate-900 bg-transparent"
                        required
                        autofocus
                    />
                </div>
            </div>

            <!-- Category Selection (Icon Grid) -->
            <div id="categorySection">
                <label class="block text-sm font-semibold text-slate-700 mb-3">Danh mục</label>
                <div class="grid grid-cols-4 gap-3">
                    <!-- Category Icons -->
                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-red-50 hover:border-red-500 border-2 border-transparent rounded-xl transition-all" data-category="Food">
                        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-utensils text-red-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Ăn uống</span>
                    </button>

                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-blue-50 hover:border-blue-500 border-2 border-transparent rounded-xl transition-all" data-category="Transport">
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-car text-blue-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Di chuyển</span>
                    </button>

                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-purple-50 hover:border-purple-500 border-2 border-transparent rounded-xl transition-all" data-category="Shopping">
                        <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-shopping-bag text-purple-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Mua sắm</span>
                    </button>

                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-emerald-50 hover:border-emerald-500 border-2 border-transparent rounded-xl transition-all" data-category="Entertainment">
                        <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-film text-emerald-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Giải trí</span>
                    </button>

                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-yellow-50 hover:border-yellow-500 border-2 border-transparent rounded-xl transition-all" data-category="Bills">
                        <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-file-invoice text-yellow-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Hóa đơn</span>
                    </button>

                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-pink-50 hover:border-pink-500 border-2 border-transparent rounded-xl transition-all" data-category="Health">
                        <div class="w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-heartbeat text-pink-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Sức khỏe</span>
                    </button>

                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-indigo-50 hover:border-indigo-500 border-2 border-transparent rounded-xl transition-all" data-category="Education">
                        <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-graduation-cap text-indigo-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Giáo dục</span>
                    </button>

                    <button type="button" class="category-btn flex flex-col items-center gap-2 p-4 bg-slate-50 hover:bg-slate-200 hover:border-slate-500 border-2 border-transparent rounded-xl transition-all" data-category="Other">
                        <div class="w-12 h-12 bg-slate-200 rounded-full flex items-center justify-center">
                            <i class="fas fa-ellipsis-h text-slate-600"></i>
                        </div>
                        <span class="text-xs font-medium text-slate-700">Khác</span>
                    </button>
                </div>
                <input type="hidden" id="categoryId" required>
            </div>

            <!-- Date Picker -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Ngày</label>
                <input 
                    type="date" 
                    id="transactionDate" 
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>

            <!-- Wallet Selection -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Ví</label>
                <select 
                    id="walletId" 
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    required>
                    <option value="">Chọn ví</option>
                    <option value="1">Ví chính</option>
                    <option value="2">Tài khoản tiết kiệm</option>
                    <option value="3">Ví tiền mặt</option>
                </select>
            </div>

            <!-- Note (Textarea) -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Ghi chú (Tùy chọn)</label>
                <textarea 
                    id="note" 
                    rows="3"
                    placeholder="Thêm ghi chú về giao dịch này..."
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                ></textarea>
            </div>

            <!-- Receipt Upload (Dashed Box) -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Hóa đơn (Tùy chọn)</label>
                <div class="border-2 border-dashed border-slate-300 rounded-xl p-8 text-center hover:border-blue-500 hover:bg-blue-50 transition-all cursor-pointer" onclick="document.getElementById('receiptFile').click()">
                    <input type="file" id="receiptFile" accept="image/*" class="hidden">
                    <i class="fas fa-cloud-upload-alt text-4xl text-slate-400 mb-3"></i>
                    <p class="text-sm font-medium text-slate-600">Kéo hóa đơn vào đây hoặc nhấp để tải lên</p>
                    <p class="text-xs text-slate-400 mt-1">PNG, JPG tối đa 10MB</p>
                </div>
            </div>
        </form>

        <!-- Modal Footer -->
        <div class="sticky bottom-0 bg-white border-t border-slate-200 p-6 rounded-b-3xl flex gap-3">
            <button 
                type="button" 
                onclick="closeTransactionModal()" 
                class="flex-1 py-3 px-6 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition-colors">
                Hủy
            </button>
            <button 
                type="submit" 
                onclick="saveTransaction()" 
                class="flex-1 py-3 px-6 bg-gradient-to-r from-blue-500 to-indigo-600 hover:shadow-lg text-white font-semibold rounded-xl transition-all">
                Lưu giao dịch
            </button>
        </div>
    </div>
</div>

<style>
    /* Tab Styles */
    .tab-expense {
        background: #fee2e2;
        color: #991b1b;
    }
    .tab-expense.active {
        background: #ef4444;
        color: white;
    }

    .tab-income {
        background: #d1fae5;
        color: #065f46;
    }
    .tab-income.active {
        background: #10b981;
        color: white;
    }

    .tab-transfer {
        background: #dbeafe;
        color: #1e40af;
    }
    .tab-transfer.active {
        background: #3b82f6;
        color: white;
    }

    /* Category Button Active State */
    .category-btn.active {
        border-color: currentColor !important;
        background: currentColor !important;
    }
</style>

<script>
    function openTransactionModal(type = 'Expense') {
        document.getElementById('transactionModal').classList.remove('hidden');
        setTransactionType(type);
        // Set today's date
        document.getElementById('transactionDate').valueAsDate = new Date();
    }

    function closeTransactionModal() {
        document.getElementById('transactionModal').classList.add('hidden');
        document.getElementById('transactionForm').reset();
    }

    function setTransactionType(type) {
        document.getElementById('transactionType').value = type;
        
        // Update tab styles
        document.querySelectorAll('[data-type]').forEach(btn => {
            btn.classList.remove('active');
        });
        document.querySelector(`[data-type="${type}"]`).classList.add('active');

        // Show/hide category section for transfers
        const categorySection = document.getElementById('categorySection');
        if (type === 'Transfer') {
            categorySection.style.display = 'none';
        } else {
            categorySection.style.display = 'block';
        }
    }

    // Category selection
    document.querySelectorAll('.category-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            document.getElementById('categoryId').value = this.dataset.category;
        });
    });

    function saveTransaction() {
        const form = document.getElementById('transactionForm');
        if (form.checkValidity()) {
            // Add your save logic here
            console.log('Saving transaction...');
            closeTransactionModal();
        } else {
            form.reportValidity();
        }
    }

    // Close modal on backdrop click
    document.getElementById('transactionModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeTransactionModal();
        }
    });
</script>
