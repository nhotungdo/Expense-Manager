@using System.Security.Claims

<!-- Modern Sidebar with Clean Fintech Design -->
<aside class="fixed left-0 top-0 h-screen w-64 bg-white border-r border-slate-200 flex flex-col z-50 transition-transform duration-300 ease-in-out font-sans shadow-sm" id="sidebar">
    <!-- 1. Brand / Logo -->
    <div class="h-20 flex items-center px-6 border-b border-slate-100">
        <a href="/home" class="flex items-center gap-3 group">
            <div class="w-9 h-9 bg-gradient-to-br from-slate-900 to-slate-700 rounded-xl flex items-center justify-center text-white shadow-md group-hover:scale-110 transition-transform duration-200">
                <i class="fas fa-wallet text-sm"></i>
            </div>
            <div class="flex flex-col">
                <span class="font-bold text-lg text-slate-800 tracking-tight leading-none">MoneyTracker</span>
                <span class="text-[10px] text-slate-500 font-medium tracking-wide">EXPENSE MANAGER</span>
            </div>
        </a>
    </div>

 

    <!-- 3. Navigation -->
    <nav class="flex-1 px-3 space-y-0.5 overflow-y-auto custom-scrollbar">
        <!-- Dashboard -->
        <a href="/home" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower() == "/home" ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-grid-2 w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower() == "/home" ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Tổng quan</span>
        </a>

        <!-- Transactions (Active if path contains /Transactions) -->
        <!-- Trading (Replaces Transactions) -->
        <a href="/Trading/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/trading") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-chart-pie w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/trading") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Giao dịch</span>
        </a>

        <!-- Wallets -->
        <a href="/Wallets/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/wallets") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-wallet w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/wallets") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Ví của tôi</span>
        </a>

        <!-- Shared Wallets -->
        <a href="/Wallets/Shared/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/wallets/shared") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-share-alt w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/wallets/shared") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Ví chia sẻ</span>
        </a>

        <!-- Bank Sync -->
        <a href="/Wallets/BankSync" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/wallets/banksync") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-university w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/wallets/banksync") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Liên kết ngân hàng</span>
        </a>

        <!-- Budgets -->
        <a href="/Budgets/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/budgets") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-chart-pie w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/budgets") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Ngân sách</span>
        </a>

        <!-- Savings -->
        <a href="/Savings/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/savings") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-piggy-bank w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/savings") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Sổ tiết kiệm</span>
        </a>

        <div class="my-4 px-3">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Mở rộng</span>
        </div>

        <!-- Reports -->
        <a href="/Reports" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/reports") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-chart-line w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/reports") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Báo cáo</span>
        </a>

        <!-- Currencies -->
        <a href="/Settings/Currencies" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/settings/currencies") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-globe w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/settings/currencies") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Tỷ giá & Tiền tệ</span>
        </a>

        <!-- Debts -->
        <a href="/Debts/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/debts") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-hand-holding-usd w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/debts") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Sổ nợ</span>
        </a>

        <!-- Groups -->
        <a href="/Groups/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/groups") == true ? "bg-slate-50 text-slate-900" : "text-slate-500 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fas fa-users w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/groups") == true ? "text-slate-900" : "text-slate-400 group-hover:text-slate-900") transition-colors"></i>
            <span class="text-sm font-medium">Chi tiêu nhóm</span>
        </a>
        
        <!-- Service Packages (Premium) -->
        <a href="/ServicePackages" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/servicepackages") == true ? "bg-gradient-to-r from-amber-50 to-orange-50 text-amber-700" : "text-slate-500 hover:bg-amber-50 hover:text-amber-700")">
            <i class="fas fa-crown w-5 text-center @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/servicepackages") == true ? "text-amber-600" : "text-amber-500") transition-colors"></i>
            <span class="text-sm font-medium">Gói Premium</span>
            @if(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("/servicepackages") != true) {
                <span class="ml-auto w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            }
        </a>
    </nav>

    <!-- 4. User Profile & Settings -->
    <div class="border-t border-slate-100 p-3 bg-slate-50/50">
        <a href="/Settings/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group hover:bg-white hover:shadow-sm">
            <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 group-hover:bg-slate-900 group-hover:text-white transition-colors">
                <i class="fas fa-cog text-xs"></i>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-slate-700 truncate">Cài đặt</p>
            </div>
        </a>
        
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group hover:bg-white hover:shadow-sm mt-1">
                <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                     <i class="fas fa-shield-alt text-xs"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-slate-700 truncate">Admin</p>
                </div>
            </a>
        }

        <form asp-page="/Auth/Logout" method="post" class="mt-1">
            <button type="submit" class="flex items-center gap-3 w-full px-3 py-2.5 rounded-xl transition-all duration-200 group hover:bg-red-50 hover:text-red-600">
                <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 group-hover:bg-red-100 group-hover:text-red-600 transition-colors">
                    <i class="fas fa-sign-out-alt text-xs"></i>
                </div>
                <span class="text-sm font-medium text-slate-500 group-hover:text-red-600">Đăng xuất</span>
            </button>
        </form>
    </div>
</aside>
