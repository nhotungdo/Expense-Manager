<!-- Modern Sidebar with Tailwind CSS -->
<aside class="fixed left-0 top-0 h-screen w-64 bg-white border-r border-slate-200 flex flex-col z-40 sidebar-modern">
    <!-- Logo Area -->
    <div class="px-6 py-6 border-b border-slate-200">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-wallet text-white text-lg"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold text-slate-900">Money Tracker</h1>
                <p class="text-xs text-slate-500">Quản lý tài chính</p>
            </div>
        </div>
    </div>
    
    <!-- Navigation Menu -->
    <nav class="flex-1 px-3 py-4 overflow-y-auto">
        <div class="space-y-1">
            <a href="/home" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower() == "/home" ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-th-large w-5 text-base"></i>
                <span>Tổng quan</span>
            </a>
            <a href="/Transactions/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("transactions") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-exchange-alt w-5 text-base"></i>
                <span>Giao dịch</span>
            </a>
            <a href="/Wallets/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("wallets") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-wallet w-5 text-base"></i>
                <span>Ví của tôi</span>
            </a>
            <a href="/Budgets/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("budgets") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-chart-pie w-5 text-base"></i>
                <span>Ngân sách</span>
            </a>
            <a href="/Reports" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("reports") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-chart-line w-5 text-base"></i>
                <span>Báo cáo</span>
            </a>
            
            <!-- Divider -->
            <div class="my-3 border-t border-slate-200"></div>
            
            <a href="/ServicePackages" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("servicepackages") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-crown w-5 text-base"></i>
                <span>Gói dịch vụ</span>
                <span class="ml-auto px-2 py-0.5 bg-gradient-to-r from-yellow-400 to-orange-500 text-white text-xs font-bold rounded-full">NEW</span>
            </a>
            <a href="/Debts/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("debts") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-hand-holding-usd w-5 text-base"></i>
                <span>Sổ nợ</span>
            </a>
            <a href="/Groups/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("groups") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-users w-5 text-base"></i>
                <span>Nhóm</span>
            </a>
            <a href="/Investments/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm @(ViewContext.RouteData.Values["page"]?.ToString().ToLower().Contains("investments") == true ? "bg-blue-50 text-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <i class="fas fa-chart-bar w-5 text-base"></i>
                <span>Đầu tư</span>
            </a>
        </div>
    </nav>
    
    <!-- Footer Actions -->
    <div class="px-3 py-4 border-t border-slate-200 space-y-1">
        <a href="/Settings/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900">
            <i class="fas fa-cog w-5 text-base"></i>
            <span>Cài đặt</span>
        </a>
        <!-- Chuyển đến dashboard admin chỉ có email của admin mới hiển thị-->
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900">
                <i class="fas fa-chart-line w-5 text-base"></i>
                <span>Dashboard Admin</span>
            </a>
        }
        
        <form asp-page="/Auth/Logout" method="post" class="w-full">
            <button type="submit" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 font-medium text-sm text-slate-600 w-full text-left hover:bg-red-50 hover:text-red-600">
                <i class="fas fa-sign-out-alt w-5 text-base"></i>
                <span>Đăng xuất</span>
            </button>
        </form>
    </div>
</aside>
