<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MoneyTracker Admin</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Frameworks -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Core Admin CSS -->
    <link rel="stylesheet" href="~/css/admin-ultra-modern.css" asp-append-version="true" />
    
    <!-- Charts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <meta name="current-session-id" content="@User.FindFirst("sid")?.Value" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="/Admin/Dashboard" class="brand-logo text-decoration-none">
                    <div class="brand-icon">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <span>MoneyTracker</span>
                </a>
            </div>
            
            <nav class="sidebar-nav custom-scrollbar">
                <div class="nav-label">Tổng quan</div>
                <a href="/Admin/Dashboard" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Dashboard") == true ? "active" : "")">
                    <i class="fas fa-layer-group"></i> <span>Dashboard</span>
                </a>
                
                <div class="nav-label">Quản lý</div>
                <a href="/Admin/Users" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Users") == true ? "active" : "")">
                    <i class="fas fa-users-cog"></i> <span>Người dùng</span>
                </a>
                <a href="/Admin/ServicePackages" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("ServicePackages") == true ? "active" : "")">
                    <i class="fas fa-box-open"></i> <span>Gói dịch vụ</span>
                </a>
                <a href="/Admin/Transactions" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Transactions") == true ? "active" : "")">
                    <i class="fas fa-receipt"></i> <span>Giao dịch</span>
                </a>
                <a href="/Admin/Notifications/EmailSender" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("EmailSender") == true ? "active" : "")">
                    <i class="fas fa-paper-plane"></i> <span>Gửi thông báo</span>
                </a>
                
                <div class="nav-label">Hệ thống & Dữ liệu</div>
                <a href="/Admin/MasterData/Categories" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("MasterData/Categories") == true ? "active" : "")">
                    <i class="fas fa-tags"></i> <span>Danh mục</span>
                </a>
                <a href="/Admin/Settings" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Settings") == true ? "active" : "")">
                    <i class="fas fa-cogs"></i> <span>Cấu hình</span>
                </a>
                
                <div class="nav-label">Giám sát</div>
                <a href="/Admin/Monitoring/Logs" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Monitoring/Logs") == true ? "active" : "")">
                    <i class="fas fa-terminal"></i> <span>System Logs</span>
                </a>
                <a href="/Admin/Monitoring/AuditLogs" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Monitoring/AuditLogs") == true ? "active" : "")">
                    <i class="fas fa-shield-alt"></i> <span>Audit Logs</span>
                </a>
            </nav>
            
            <div class="sidebar-footer">
                <a href="/" class="nav-link justify-content-center text-secondary hover-white">
                    <i class="fas fa-arrow-left"></i> <span>Về trang chủ</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <header class="admin-topbar">
                <div class="topbar-left d-flex align-items-center gap-3">
                    <button class="icon-btn d-lg-none" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="h5 mb-0 fw-bold header-title">@ViewData["Title"]</h1>
                </div>
                
                <div class="topbar-right">
                    <div class="search-box d-none d-md-block">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Tìm kiếm (Ctrl + K)...">
                    </div>
                    
                    <a href="/Notifications" class="icon-btn position-relative text-decoration-none text-dark d-flex align-items-center justify-content-center">
                        <i class="far fa-bell"></i>
                        <span class="badge-dot d-none" id="notificationBadge"></span>
                    </a>
                    
                    <div class="dropdown">
                        <div class="user-mini-profile pointer cursor-pointer" data-bs-toggle="dropdown">
                            <div class="user-avatar">
                                <i class="fas fa-user-shield"></i>
                            </div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-3" style="min-width: 280px;">
                            <li>
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-primary-subtle text-primary rounded-circle p-2 me-2">
                                        <i class="fas fa-user-shield"></i>
                                    </div>
                                    <div>
                                        <h6 class="dropdown-header p-0 mb-0 text-dark">@User.Identity?.Name</h6>
                                        <small class="text-muted">Administrator</small>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            
                            <li><h6 class="dropdown-header text-uppercase x-small text-muted">Chuyển tài khoản</h6></li>
                            <div id="adminAccountSwitcher">
                                <li class="text-center text-muted small py-2"><i class="fas fa-spinner fa-spin me-1"></i> Loading...</li>
                            </div>
                            
                            <li><a class="dropdown-item text-primary fw-medium" href="/Auth/Login?action=add_account&returnUrl=/Admin/Dashboard"><i class="fas fa-plus-circle me-2"></i>Thêm tài khoản</a></li>
                            
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Profile"><i class="fas fa-user me-2"></i>Hồ sơ</a></li>
                            <li><a class="dropdown-item" href="/Settings"><i class="fas fa-cog me-2"></i>Cài đặt</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-page="/Auth/Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <div class="admin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    
    <script>
        // Toggle Sidebar
        document.getElementById('sidebarToggle')?.addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('show');
        });
        
        // Close sidebar on mobile click outside
        document.addEventListener('click', function(event) {
            var sidebar = document.getElementById('sidebar');
            var toggle = document.getElementById('sidebarToggle');
            if (window.innerWidth <= 1024 && sidebar && toggle) {
                 if (!sidebar.contains(event.target) && !toggle.contains(event.target) && sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                }
            }
        });

        // Admin Account Switcher Logic
        const adminSwitcherContainer = document.getElementById('adminAccountSwitcher');
        if (adminSwitcherContainer) {
            // Use Bootstrap events if possible, or lazy load
            const dropdown = adminSwitcherContainer.closest('.dropdown');
            if (dropdown) {
                dropdown.addEventListener('show.bs.dropdown', function () {
                    loadAdminAccounts();
                });
            }
        }

        async function loadAdminAccounts() {
            const container = document.getElementById('adminAccountSwitcher');
            if (!container) return;
            
            try {
                const response = await fetch('/api/auth/accounts');
                if (response.ok) {
                    const accounts = await response.json();
                    if (accounts.length === 0) {
                        container.innerHTML = '<li class="dropdown-item-text text-muted small italic">Không có tài khoản khác</li>';
                        return;
                    }
                    
                    container.innerHTML = accounts.map(acc => {
                         const activeClass = acc.isActive ? 'bg-light border-start border-3 border-primary' : '';
                         const check = acc.isActive ? '<i class="fas fa-check text-primary ms-auto"></i>' : '';
                         
                         return `
                            <li>
                                <a href="javascript:void(0)" onclick="switchAdminAccount('${acc.sessionId}', ${acc.isActive})" 
                                   class="dropdown-item d-flex align-items-center gap-2 py-2 ${activeClass}">
                                    <div class="rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 10px;">
                                        ${acc.email.charAt(0).toUpperCase()}
                                    </div>
                                    <div class="ms-1" style="line-height: 1.2;">
                                        <div class="fw-medium small text-truncate" style="max-width: 150px;">${acc.fullName || acc.email}</div>
                                        <div class="text-muted x-small text-truncate" style="max-width: 150px;">${acc.email}</div>
                                    </div>
                                    ${check}
                                </a>
                            </li>
                         `;
                    }).join('');
                }
            } catch (e) {
                container.innerHTML = '<li class="dropdown-item-text text-danger small">Lỗi tải dữ liệu</li>';
            }
        }

        async function switchAdminAccount(sessionId, isActive) {
            if (isActive) return;
            try {
                const res = await fetch(`/api/auth/switch-account/${sessionId}`, { method: 'POST' });
                if (res.ok) {
                    sessionStorage.setItem('currentSessionId', sessionId);
                    window.location.reload();
                }
                else alert('Chuyển tài khoản thất bại');
            } catch (e) {
                alert('Lỗi kết nối');
            }
        }

        // Auto Restore Session Script
        (function() {
            const metaSid = document.querySelector('meta[name="current-session-id"]')?.content;
            if (metaSid) {
                const storedSid = sessionStorage.getItem('currentSessionId');
                if (storedSid && storedSid !== metaSid) {
                     const restoreAttempts = parseInt(sessionStorage.getItem('restore_attempts') || '0');
                     if (restoreAttempts < 3) {
                         sessionStorage.setItem('restore_attempts', restoreAttempts + 1);
                         // Overlay
                         const overlay = document.createElement('div');
                         overlay.className = 'position-fixed top-0 start-0 w-100 h-100 bg-white d-flex align-items-center justify-content-center';
                         overlay.style.zIndex = '9999';
                         overlay.style.opacity = '0.8';
                         overlay.innerHTML = '<div class="text-center"><div class="spinner-border text-primary mb-2"></div><div>Đang khôi phục phiên làm việc...</div></div>';
                         document.body.appendChild(overlay);

                         fetch('/api/auth/switch-account/' + storedSid, { method: 'POST' })
                             .then(res => {
                                 if (res.ok) {
                                     sessionStorage.removeItem('restore_attempts');
                                     window.location.reload();
                                 } else {
                                     sessionStorage.setItem('currentSessionId', metaSid);
                                     sessionStorage.removeItem('restore_attempts');
                                     if(document.body.contains(overlay)) document.body.removeChild(overlay);
                                 }
                             }).catch(() => {
                                 if(document.body.contains(overlay)) document.body.removeChild(overlay);
                             });
                     } else {
                         sessionStorage.setItem('currentSessionId', metaSid);
                         sessionStorage.removeItem('restore_attempts');
                     }
                } else if (!storedSid) {
                    sessionStorage.setItem('currentSessionId', metaSid);
                } else {
                    sessionStorage.removeItem('restore_attempts');
                }
            }
        })();

        // Notification Badge Logic
        document.addEventListener('DOMContentLoaded', function() {
            updateNotificationBadge();
            // Poll every 60 seconds
            setInterval(updateNotificationBadge, 60000);
        });

        async function updateNotificationBadge() {
            try {
                const response = await fetch('/api/notification/unread-count');
                if (response.ok) {
                    const data = await response.json();
                    const badge = document.getElementById('notificationBadge');
                    if (badge) {
                        if (data.count > 0) {
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }
                }
            } catch (error) {
                console.error('Error fetching notifications:', error);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
