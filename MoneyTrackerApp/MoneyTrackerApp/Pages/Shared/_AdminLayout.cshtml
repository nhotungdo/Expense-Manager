<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .admin-sidebar {
            min-height: 100vh;
            background-color: #343a40;
            color: white;
        }
        .admin-sidebar a {
            color: rgba(255,255,255,.8);
            padding: 10px 20px;
            display: block;
            text-decoration: none;
        }
        .admin-sidebar a:hover, .admin-sidebar a.active {
            color: white;
            background-color: rgba(255,255,255,.1);
        }
        .admin-content {
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="admin-sidebar col-md-2 d-none d-md-block">
            <div class="p-3">
                <h4>Admin Panel</h4>
            </div>
            <nav>
                <a href="/Admin/Dashboard" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Dashboard") == true ? "active" : "")">
                    <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                </a>
                <a href="/Admin/Users" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Users") == true ? "active" : "")">
                    <i class="fas fa-users me-2"></i> User Management
                </a>
                <a href="/Admin/Settings" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Settings") == true ? "active" : "")">
                    <i class="fas fa-cogs me-2"></i> System Settings
                </a>
                <a href="/Admin/MasterData/Categories" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("MasterData") == true ? "active" : "")">
                    <i class="fas fa-database me-2"></i> Master Data
                </a>
                <a href="/Admin/Monitoring/AuditLogs" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Monitoring") == true ? "active" : "")">
                    <i class="fas fa-history me-2"></i> Audit Logs
                </a>
                <hr />
                <a href="/Home">
                    <i class="fas fa-arrow-left me-2"></i> Back to App
                </a>
            </nav>
        </div>
        <div class="col-md-10 col-12">
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <span class="nav-link">Admin User</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <div class="admin-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
