<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Money Tracker</title>
    
    <!-- Preconnect to external resources for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    
    <!-- Fonts - Plus Jakarta Sans for modern fintech look -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS v3.4 -->
    <script src="https://cdn.tailwindcss.com?v=3.4"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Inter', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        primary: '#3b82f6',
                        income: '#10b981',
                        expense: '#ef4444',
                    }
                }
            }
        }
    </script>
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- Custom Styles -->
    <!-- Design System -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/micro-interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/christmas.css" asp-append-version="true" />
</head>

@using Microsoft.AspNetCore.Identity

<body class="bg-slate-50 font-sans antialiased">
    <div id="snow-container"></div>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <!-- Authenticated Layout -->
        <div class="min-h-screen">
            <!-- Sidebar -->
            <partial name="_Sidebar" />

            <!-- Top Navigation -->
            <partial name="_TopBar" />

            <!-- Main Content Area -->
            <main class="ml-64 mt-16 min-h-screen bg-slate-50">
                <div class="p-6">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <!-- Public Layout (Landing Page, Auth, etc.) -->
        <div class="min-h-screen">
             @RenderBody()
        </div>
    }

    <!-- Quick Add Modal -->
    <partial name="_QuickAddModal" />

    <!-- Core Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    
    <!-- Bootstrap 5.3 JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Application Scripts -->
    <script src="~/js/micro-interactions.js" asp-append-version="true"></script>
    <script src="~/js/performance.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/quick-add.js" asp-append-version="true"></script>
    <script src="~/js/christmas.js" asp-append-version="true"></script>
   
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
