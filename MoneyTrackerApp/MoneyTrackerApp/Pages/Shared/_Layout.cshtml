<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Money Tracker</title>
    
    <!-- Preconnect to external resources for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    
    <!-- Fonts - Be Vietnam Pro & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS v3.4 -->
    <script src="https://cdn.tailwindcss.com?v=3.4"></script>
    <script>
        tailwind.config = {
            darkMode: ['class', '[data-theme="dark"]'],
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Be Vietnam Pro', 'Inter', 'system-ui', 'sans-serif'],
                        mono: ['ui-monospace', 'SFMono-Regular', 'monospace'],
                    },
                    colors: {
                        primary: {
                            DEFAULT: '#2563EB',
                            50: '#EFF6FF',
                            100: '#DBEAFE',
                            200: '#BFDBFE',
                            300: '#93C5FD',
                            400: '#60A5FA',
                            500: '#3B82F6',
                            600: '#2563EB',
                            700: '#1D4ED8',
                            800: '#1E40AF',
                            900: '#1E3A8A',
                        },
                        secondary: '#7C3AED',
                        success: '#10B981',
                        danger: '#F43F5E',
                        warning: '#F59E0B',
                        info: '#3B82F6',
                        dark: '#111827',
                        light: '#F3F4F6'
                    },
                    borderRadius: {
                        'xl': '1rem',
                        '2xl': '1.25rem',
                        '3xl': '1.5rem',
                    },
                    boxShadow: {
                        'soft': '0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)',
                        'glow': '0 0 15px rgba(37, 99, 235, 0.5)',
                    }
                }
            }
        }
    </script>
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- Custom Styles -->
    <!-- Theme System (must load first) -->
    <link rel="stylesheet" href="~/css/theme-variables.css" asp-append-version="true" />
    <!-- Bento Grid System & Utilities -->
    <link rel="stylesheet" href="~/css/bento-grid.css" asp-append-version="true" />
    
    <!-- Design System -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/micro-interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/css/christmas.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>

@using Microsoft.AspNetCore.Identity

<body class="font-sans antialiased" style="background-color: var(--bg-secondary); color: var(--text-primary); transition: background-color 0.3s;">
    <div id="snow-container"></div>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <!-- Authenticated Layout -->
        <div class="min-h-screen">
            <!-- Sidebar -->
            <partial name="_Sidebar" />

            <!-- Top Navigation -->
            <partial name="_TopBar" />

            <!-- Main Content Area -->
            <main class="ml-64 mt-16 min-h-screen bg-slate-50">
                <div class="p-6">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <!-- Public Layout (Landing Page, Auth, etc.) -->
        <div class="min-h-screen">
             @RenderBody()
        </div>
    }

    <!-- Quick Add Modal -->
    <partial name="_QuickAddModal" />

    <!-- Core Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    
    <!-- Bootstrap 5.3 JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Application Scripts -->
    <script src="~/js/theme-manager.js" asp-append-version="true"></script>
    <script src="~/js/micro-interactions.js" asp-append-version="true"></script>
    <script src="~/js/performance.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/quick-add.js" asp-append-version="true"></script>
    <script src="~/js/christmas.js" asp-append-version="true"></script>
   
    <!-- AI Chat Widget -->
    <partial name="_AiChatWidget" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
