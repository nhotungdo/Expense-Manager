@page
@{
    ViewData["Title"] = "Tỷ giá & Tiền tệ";
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Main Settings Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-4 border-0">
                    <h5 class="fw-bold mb-0"><i class="fas fa-globe-asia me-2 text-primary"></i>Cài đặt Tiền tệ chính</h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <label class="form-label text-muted">Đơn vị tiền tệ mặc định</label>
                            <select class="form-select form-select-lg fw-bold">
                                <option value="VND" selected>🇻🇳 VND - Vietnamese Dong</option>
                                <option value="USD">🇺🇸 USD - US Dollar</option>
                                <option value="EUR">🇪🇺 EUR - Euro</option>
                                <option value="JPY">🇯🇵 JPY - Japanese Yen</option>
                                <option value="KRW">🇰🇷 KRW - South Korean Won</option>
                            </select>
                            <div class="form-text mt-2">Đơn vị này sẽ được sử dụng cho tất cả các báo cáo và tổng hợp.</div>
                        </div>
                        <div class="col-md-4 text-center mt-3 mt-md-0">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1">Tỷ giá hiện tại (tham khảo)</small>
                                <h3 class="fw-bold text-primary mb-0">1 USD ≈ 25,450 VND</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Converter Tool -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-4 border-0">
                    <h5 class="fw-bold mb-0"><i class="fas fa-calculator me-2 text-success"></i>Công cụ chuyển đổi</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Số tiền</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="amountFrom" value="100">
                                <select class="form-select" id="currencyFrom" style="max-width: 100px;">
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                    <option value="VND">VND</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-center justify-content-center">
                            <button class="btn btn-outline-secondary rounded-circle mt-4" onclick="swapCurrencies()">
                                <i class="fas fa-exchange-alt"></i>
                            </button>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Thành tiền (Dự kiến)</label>
                            <div class="input-group">
                                <input type="text" class="form-control bg-light" id="amountTo" readonly value="2,545,000">
                                <select class="form-select" id="currencyTo" style="max-width: 100px;">
                                    <option value="VND" selected>VND</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 text-end">
                        <small class="text-muted">Cập nhật lần cuối: Hôm nay, 10:30 AM</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Exchange Rates Sidebar -->
        <div class="col-lg-4">
             <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Tỷ giá thị trường</h5>
                    
                    <div class="exchange-rate-list">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-white-10">
                            <div class="d-flex align-items-center">
                                <img src="https://flagcdn.com/w40/us.png" class="rounded-circle me-3" width="30">
                                <div>
                                    <div class="fw-bold">USD/VND</div>
                                    <small class="text-white-50">US Dollar</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold">25,450</div>
                                <small class="text-success"><i class="fas fa-arrow-up"></i> +0.15%</small>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-white-10">
                            <div class="d-flex align-items-center">
                                <img src="https://flagcdn.com/w40/eu.png" class="rounded-circle me-3" width="30">
                                <div>
                                    <div class="fw-bold">EUR/VND</div>
                                    <small class="text-white-50">Euro</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold">27,120</div>
                                <small class="text-danger"><i class="fas fa-arrow-down"></i> -0.05%</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-white-10">
                            <div class="d-flex align-items-center">
                                <img src="https://flagcdn.com/w40/jp.png" class="rounded-circle me-3" width="30">
                                <div>
                                    <div class="fw-bold">JPY/VND</div>
                                    <small class="text-white-50">Japanese Yen</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold">165.4</div>
                                <small class="text-success"><i class="fas fa-arrow-up"></i> +0.2%</small>
                            </div>
                        </div>
                         
                        <div class="d-flex justify-content-between align-items-center mb-3 border-white-10">
                            <div class="d-flex align-items-center">
                                <img src="https://flagcdn.com/w40/gb.png" class="rounded-circle me-3" width="30">
                                <div>
                                    <div class="fw-bold">GBP/VND</div>
                                    <small class="text-white-50">British Pound</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold">31,850</div>
                                <small class="text-success"><i class="fas fa-arrow-up"></i> +0.1%</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-white-10 { border-color: rgba(255, 255, 255, 0.1) !important; }
</style>

<script>
    function swapCurrencies() {
        var from = document.getElementById('currencyFrom');
        var to = document.getElementById('currencyTo');
        var temp = from.value;
        from.value = to.value;
        to.value = temp;
        // Logic to swap amount would go here
    }
</script>
