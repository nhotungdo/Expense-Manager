@page
@model MoneyTrackerApp.Pages.Settings.CurrenciesModel
@{
    ViewData["Title"] = "Exchange Rates";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/currencies-modern.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
}

<div class="currency-page-wrapper">
    <div class="container-fluid px-4 py-4">
        <!-- Header Section -->
        <div class="glass-header mb-5">
            <div class="glass-header-content d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="display-6 fw-bold mb-2">Tỷ giá & Tiền tệ</h2>
                    <p class="mb-0 opacity-75">Quản lý tiền tệ và theo dõi tỷ giá hối đoái toàn cầu theo thời gian thực.</p>
                </div>
                <div class="d-none d-md-block">
                    <div class="p-3 bg-white bg-opacity-20 rounded-4 backdrop-blur">
                        <small class="d-block text-white-50 mb-1">Cập nhật lúc</small>
                        <div class="fw-bold fs-5" id="lastUpdated">@DateTime.Now.ToString("HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Converter & Settings -->
            <div class="col-lg-8">
                <!-- Currency Converter -->
                <div class="glass-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0 text-dark">
                            <i class="fas fa-coins me-2 text-primary"></i>Chuyển đổi nhanh
                        </h4>
                        <span class="badge bg-light text-primary rounded-pill px-3 py-2">Real-time</span>
                    </div>

                    <div class="row align-items-center g-3">
                        <!-- From Currency -->
                        <div class="col-md-5">
                            <div class="p-3 bg-white rounded-4 border">
                                <label class="small text-muted mb-2 fw-semibold">Số tiền & Nguồn</label>
                                <div class="d-flex align-items-center">
                                    <input type="number" id="amountInput" class="amount-input" value="1" min="0">
                                </div>
                                <div class="d-flex align-items-center mt-2">
                                    <img id="fromFlag" src="" class="flag-icon me-2" alt="flag">
                                    <select id="fromCurrency" class="form-select border-0 bg-transparent fw-bold text-dark ps-0 shadow-none cursor-pointer"></select>
                                </div>
                            </div>
                        </div>

                        <!-- Swap Button -->
                        <div class="col-md-2 text-center">
                            <button id="swapBtn" class="swap-btn mx-auto" aria-label="Swap currencies">
                                <i class="fas fa-exchange-alt"></i>
                            </button>
                        </div>

                        <!-- To Currency -->
                        <div class="col-md-5">
                            <div class="p-3 bg-success bg-opacity-10 rounded-4 border border-success border-opacity-25">
                                <label class="small text-success mb-2 fw-semibold">Kết quả quy đổi</label>
                                <div class="d-flex align-items-center">
                                    <span id="resultAmount" class="amount-input text-success">--</span>
                                </div>
                                <div class="d-flex align-items-center mt-2">
                                    <img id="toFlag" src="" class="flag-icon me-2" alt="flag">
                                    <select id="toCurrency" class="form-select border-0 bg-transparent fw-bold text-success ps-0 shadow-none cursor-pointer"></select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top text-center">
                        <small class="text-muted d-block mb-1">Tỷ giá chuyển đổi hiện tại</small>
                        <p class="mb-0 fw-bold fs-5 text-dark" id="exchangeRateDisplay">
                            <!-- Rate display via JS -->
                        </p>
                    </div>
                </div>

                <!-- Historical Chart -->
                <div class="glass-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                         <h4 class="fw-bold mb-0 text-dark">
                            <i class="fas fa-chart-line me-2 text-secondary"></i>Lịch sử biến động
                        </h4>
                        <select class="form-select form-select-sm w-auto rounded-pill border-0 bg-light">
                            <option>7 ngày qua</option>
                            <option>1 tháng</option>
                            <option>1 năm</option>
                        </select>
                    </div>
                    <div class="chart-container">
                        <div id="currencyChart"></div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Live Rates & Settings -->
            <div class="col-lg-4">
                <!-- Main Currency Settings -->
                <div class="glass-card mb-4 bg-white">
                    <h5 class="fw-bold mb-3">Đơn vị tiền tệ chính</h5>
                    <p class="text-muted small mb-3">Đơn vị này được dùng để tổng hợp tất cả tài sản của bạn.</p>
                    
                    <div class="p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center">
                            <img src="https://flagcdn.com/w40/vn.png" class="flag-icon me-3">
                            <div>
                                <div class="fw-bold">Vietnamese Dong</div>
                                <small class="text-muted">VND</small>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Mặc định</span>
                    </div>
                    <button class="btn btn-outline-primary w-100 rounded-pill fw-semibold">Thay đổi đơn vị chính</button>
                </div>

                <!-- Market Rates -->
                <div class="glass-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Thị trường</h5>
                        <small class="text-primary cursor-pointer hover-underline">Xem thêm</small>
                    </div>
                    
                    <div id="liveRatesList" class="live-rates-container">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/currencies-modern.js"></script>
}
