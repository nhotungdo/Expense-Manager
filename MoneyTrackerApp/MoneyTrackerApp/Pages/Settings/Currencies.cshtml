@page
@model MoneyTrackerApp.Pages.Settings.CurrenciesModel
@{
    ViewData["Title"] = "Fintech Exchange Rates 2026";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/currencies-modern.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
}

<div class="currency-page-wrapper">
    <div class="container-fluid px-4 py-4">
        <!-- Header Section -->
        <div class="glass-header mb-5">
            <div class="glass-header-content d-flex justify-content-between align-items-center">
                <div>
                    <div class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-2 mb-3 backdrop-blur">
                        <i class="fas fa-bolt me-2"></i> Live Market Data 2026
                    </div>
                    <h2 class="display-5 fw-bold mb-2">Quản lý Tiền tệ</h2>
                    <p class="mb-0 opacity-75 fs-5">Hệ thống tỷ giá thời gian thực chuẩn quốc tế.</p>
                </div>
                <div class="d-none d-md-block text-end">
                    <button class="btn btn-white bg-white text-primary rounded-pill px-4 py-2 fw-bold mb-2" onclick="syncRates()">
                        <i class="fas fa-sync-alt me-2" id="syncIcon"></i>Cập nhật ngay
                    </button>
                    <div class="p-3 bg-white bg-opacity-20 rounded-4 backdrop-blur mt-2">
                        <small class="d-block text-white-50 mb-1">Cập nhật lúc</small>
                        <div class="fw-bold fs-5" id="lastUpdated">--:--</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Converter & Charts -->
            <div class="col-lg-7">
                <!-- Currency Converter Widget -->
                <div class="glass-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0 text-dark">
                            <i class="fas fa-exchange-alt me-2 text-primary"></i>Quy đổi nhanh
                        </h4>
                    </div>

                    <div class="row align-items-center g-3">
                        <div class="col-md-5">
                            <div class="p-4 bg-white rounded-4 border">
                                <label class="small text-muted mb-2 fw-semibold">Gửi đi</label>
                                <input type="number" id="amountInput" class="amount-input" value="1000000" min="0">
                                <div class="d-flex align-items-center mt-3">
                                    <img id="fromFlag" src="" class="flag-icon me-2">
                                    <select id="fromCurrency" class="form-select border-0 bg-transparent fw-bold text-dark ps-0 shadow-none cursor-pointer"></select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-2 text-center">
                            <button id="swapBtn" class="swap-btn mx-auto">
                                <i class="fas fa-arrows-alt-h"></i>
                            </button>
                        </div>

                        <div class="col-md-5">
                            <div class="p-4 bg-primary bg-opacity-10 rounded-4 border border-primary border-opacity-25">
                                <label class="small text-primary mb-2 fw-semibold">Nhận được (Ước tính)</label>
                                <div id="resultAmount" class="amount-input text-primary">--</div>
                                <div class="d-flex align-items-center mt-3">
                                    <img id="toFlag" src="" class="flag-icon me-2">
                                    <select id="toCurrency" class="form-select border-0 bg-transparent fw-bold text-primary ps-0 shadow-none cursor-pointer"></select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top text-center">
                        <p class="mb-0 text-muted" id="exchangeRateDisplay">
                            <!-- Rate display via JS -->
                        </p>
                    </div>
                </div>

                <!-- Currency List Table -->
                <div class="glass-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0">Danh sách tiền tệ</h4>
                        <button class="btn btn-primary rounded-pill px-4" onclick="showAddModal()">
                            <i class="fas fa-plus me-2"></i>Thêm mới
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="currency-table">
                            <thead>
                                <tr>
                                    <th>Tiền tệ</th>
                                    <th>Mã</th>
                                    <th>Tỷ giá (USD)</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="currencyTableBody">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Markets & Settings -->
            <div class="col-lg-5">
                <!-- Market Overview -->
                <div class="glass-card mb-4">
                    <h4 class="fw-bold mb-4">Thị trường 2026</h4>
                    <div id="marketRatesList">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Currency Settings -->
                <div class="glass-card">
                    <h4 class="fw-bold mb-4">Cấu hình hệ thống</h4>
                    <div class="mb-4 p-3 bg-light rounded-4">
                        <label class="small text-muted mb-2 d-block">Tiền tệ mặc định</label>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <img src="https://flagcdn.com/w40/vn.png" class="flag-icon me-2">
                                <span class="fw-bold">VNĐ - Vietnamese Dong</span>
                            </div>
                            <span class="badge bg-success rounded-pill">Đang dùng</span>
                        </div>
                    </div>
                    <div class="alert alert-info rounded-4 border-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Hệ thống sử dụng tỷ giá thực tế từ các nguồn uy tín. Bạn có thể ghi đè tỷ giá thủ công nếu cần.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="currencyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm tiền tệ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="currencyForm">
                    <input type="hidden" id="currencyId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Tên tiền tệ</label>
                            <input type="text" id="name" class="form-control rounded-3" required placeholder="Ví dụ: US Dollar">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Mã (ISO)</label>
                            <input type="text" id="code" class="form-control rounded-3" required placeholder="USD">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ký hiệu</label>
                            <input type="text" id="symbol" class="form-control rounded-3" required placeholder="$">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Tỷ giá (vs USD)</label>
                            <input type="number" id="rate" class="form-control rounded-3" step="0.000000001" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Mã quốc gia (Flag)</label>
                            <input type="text" id="flag" class="form-control rounded-3" placeholder="us, vn, eu...">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="saveCurrency()">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/currencies-modern.js"></script>
}
