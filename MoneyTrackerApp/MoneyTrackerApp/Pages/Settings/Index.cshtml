@page
@model MoneyTrackerApp.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Cài đặt";
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="list-group shadow-sm sticky-top" style="top: 80px;">
                <a href="#localization" class="list-group-item list-group-item-action active" data-bs-toggle="list">
                    <i class="bi bi-globe me-2">🌍</i> Bản địa hóa
                </a>
                <a href="#appearance" class="list-group-item list-group-item-action" data-bs-toggle="list">
                    <i class="bi bi-palette me-2">🎨</i> Giao diện
                </a>
                <a href="#formatting" class="list-group-item list-group-item-action" data-bs-toggle="list">
                    <i class="bi bi-calendar3 me-2">📅</i> Định dạng
                </a>
                <a href="#notifications" class="list-group-item list-group-item-action" data-bs-toggle="list">
                    <i class="bi bi-bell me-2">🔔</i> Thông báo
                </a>
                <a href="#danger" class="list-group-item list-group-item-action text-danger" data-bs-toggle="list">
                    <i class="bi bi-exclamation-triangle me-2">⚠️</i> Vùng nguy hiểm
                </a>
            </div>
        </div>

        <div class="col-md-9">
            <div class="tab-content">
                <!-- Localization -->
                <div class="tab-pane fade show active" id="localization">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Bản địa hóa</h5>
                        </div>
                        <div class="card-body">
                            <form id="localizationForm">
                                <div class="mb-3">
                                    <label class="form-label">Ngôn ngữ</label>
                                    <select class="form-select" id="language" onchange="updateSetting('language', this.value)">
                                        <!-- Options loaded via JS -->
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Tiền tệ mặc định</label>
                                    <select class="form-select" id="currency" onchange="updateSetting('currency', this.value)">
                                        <!-- Options loaded via JS -->
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Múi giờ</label>
                                    <select class="form-select" id="timezone" onchange="updateSetting('timezone', this.value)">
                                        <!-- Options loaded via JS -->
                                    </select>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Appearance -->
                <div class="tab-pane fade" id="appearance">
                    <!-- Theme Mode -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">🌓 Chế độ hiển thị</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center g-3">
                                <div class="col-md-4">
                                    <div class="theme-option p-4 border rounded-3 cursor-pointer position-relative" 
                                         onclick="changeTheme('light')" 
                                         id="theme-light"
                                         data-theme="light">
                                        <div class="theme-preview mb-3">
                                            <div class="preview-window bg-light border rounded p-2">
                                                <div class="d-flex gap-1 mb-2">
                                                    <div class="preview-dot bg-danger rounded-circle" style="width: 6px; height: 6px;"></div>
                                                    <div class="preview-dot bg-warning rounded-circle" style="width: 6px; height: 6px;"></div>
                                                    <div class="preview-dot bg-success rounded-circle" style="width: 6px; height: 6px;"></div>
                                                </div>
                                                <div class="bg-white rounded p-2 mb-1" style="height: 30px;"></div>
                                                <div class="bg-white rounded p-2" style="height: 40px;"></div>
                                            </div>
                                        </div>
                                        <div class="fs-1 mb-2">☀️</div>
                                        <div class="fw-semibold">Chế độ sáng</div>
                                        <small class="text-muted">Giao diện sáng, dễ nhìn ban ngày</small>
                                        <div class="theme-check position-absolute top-0 end-0 m-2 d-none">
                                            <i class="bi bi-check-circle-fill text-primary fs-4"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="theme-option p-4 border rounded-3 cursor-pointer position-relative" 
                                         onclick="changeTheme('dark')" 
                                         id="theme-dark"
                                         data-theme="dark">
                                        <div class="theme-preview mb-3">
                                            <div class="preview-window bg-dark border rounded p-2">
                                                <div class="d-flex gap-1 mb-2">
                                                    <div class="preview-dot bg-danger rounded-circle" style="width: 6px; height: 6px;"></div>
                                                    <div class="preview-dot bg-warning rounded-circle" style="width: 6px; height: 6px;"></div>
                                                    <div class="preview-dot bg-success rounded-circle" style="width: 6px; height: 6px;"></div>
                                                </div>
                                                <div class="bg-secondary rounded p-2 mb-1" style="height: 30px;"></div>
                                                <div class="bg-secondary rounded p-2" style="height: 40px;"></div>
                                            </div>
                                        </div>
                                        <div class="fs-1 mb-2">🌙</div>
                                        <div class="fw-semibold">Chế độ tối</div>
                                        <small class="text-muted">Giảm mỏi mắt ban đêm</small>
                                        <div class="theme-check position-absolute top-0 end-0 m-2 d-none">
                                            <i class="bi bi-check-circle-fill text-primary fs-4"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="theme-option p-4 border rounded-3 cursor-pointer position-relative" 
                                         onclick="changeTheme('auto')" 
                                         id="theme-auto"
                                         data-theme="auto">
                                        <div class="theme-preview mb-3">
                                            <div class="preview-window border rounded p-2" style="background: linear-gradient(to right, #f8f9fa 50%, #212529 50%);">
                                                <div class="d-flex gap-1 mb-2">
                                                    <div class="preview-dot bg-danger rounded-circle" style="width: 6px; height: 6px;"></div>
                                                    <div class="preview-dot bg-warning rounded-circle" style="width: 6px; height: 6px;"></div>
                                                    <div class="preview-dot bg-success rounded-circle" style="width: 6px; height: 6px;"></div>
                                                </div>
                                                <div class="rounded p-2 mb-1" style="height: 30px; background: rgba(255,255,255,0.5);"></div>
                                                <div class="rounded p-2" style="height: 40px; background: rgba(255,255,255,0.5);"></div>
                                            </div>
                                        </div>
                                        <div class="fs-1 mb-2">🖥️</div>
                                        <div class="fw-semibold">Tự động</div>
                                        <small class="text-muted">Theo cài đặt hệ thống</small>
                                        <div class="theme-check position-absolute top-0 end-0 m-2 d-none">
                                            <i class="bi bi-check-circle-fill text-primary fs-4"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Primary Color -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">🎨 Màu chủ đạo</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">Chọn màu chủ đạo cho giao diện của bạn</p>
                            
                            <!-- Preset Colors -->
                            <div class="row g-3 mb-4" id="presetColors">
                                <!-- Loaded via JS -->
                            </div>

                            <!-- Custom Color Picker -->
                            <div class="border-top pt-4">
                                <label class="form-label fw-semibold">Hoặc chọn màu tùy chỉnh</label>
                                <div class="d-flex gap-3 align-items-center">
                                    <input type="color" 
                                           class="form-control form-control-color" 
                                           id="customColorPicker" 
                                           value="#10b981"
                                           title="Chọn màu"
                                           style="width: 80px; height: 50px;">
                                    <div class="flex-grow-1">
                                        <input type="text" 
                                               class="form-control" 
                                               id="customColorInput" 
                                               placeholder="#10b981"
                                               pattern="^#[0-9A-Fa-f]{6}$">
                                        <small class="text-muted">Nhập mã màu hex (ví dụ: #10b981)</small>
                                    </div>
                                    <button class="btn btn-primary" onclick="applyCustomColor()">
                                        <i class="bi bi-check-lg"></i> Áp dụng
                                    </button>
                                </div>
                            </div>

                            <!-- Color Preview -->
                            <div class="border-top pt-4 mt-4">
                                <label class="form-label fw-semibold mb-3">Xem trước</label>
                                <div class="color-preview-demo">
                                    <button class="btn btn-primary me-2 mb-2">Button Primary</button>
                                    <button class="btn btn-outline-primary me-2 mb-2">Button Outline</button>
                                    <div class="badge badge-primary me-2 mb-2">Badge</div>
                                    <div class="progress mt-2" style="height: 8px;">
                                        <div class="progress-bar" role="progressbar" style="width: 65%; background: var(--primary);"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Options -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">⚙️ Tùy chọn khác</h5>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="reducedMotion" onchange="toggleReducedMotion()">
                                <label class="form-check-label" for="reducedMotion">
                                    <strong>Giảm hiệu ứng chuyển động</strong>
                                    <br><small class="text-muted">Tắt animations để cải thiện hiệu suất</small>
                                </label>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="compactMode" onchange="toggleCompactMode()">
                                <label class="form-check-label" for="compactMode">
                                    <strong>Chế độ thu gọn</strong>
                                    <br><small class="text-muted">Giảm khoảng cách giữa các phần tử</small>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Formatting -->
                <div class="tab-pane fade" id="formatting">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Định dạng</h5>
                        </div>
                        <div class="card-body">
                            <form id="formattingForm">
                                <div class="mb-3">
                                    <label class="form-label">Định dạng ngày</label>
                                    <select class="form-select" id="dateFormat" onchange="updateSetting('dateFormat', this.value)">
                                        <!-- Options loaded via JS -->
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Định dạng giờ</label>
                                    <select class="form-select" id="timeFormat" onchange="updateSetting('timeFormat', this.value)">
                                        <!-- Options loaded via JS -->
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Ngày đầu tuần</label>
                                    <select class="form-select" id="firstDayOfWeek" onchange="updateSetting('firstDayOfWeek', this.value)">
                                        <option value="0">Chủ nhật</option>
                                        <option value="1">Thứ hai</option>
                                        <option value="6">Thứ bảy</option>
                                    </select>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Notifications -->
                <div class="tab-pane fade" id="notifications">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">Thông báo</h5>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="notificationsEnabled" onchange="updateNotifications()">
                                <label class="form-check-label fw-bold" for="notificationsEnabled">Bật thông báo</label>
                            </div>
                            <div class="ms-4">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="emailNotifications" onchange="updateNotifications()">
                                    <label class="form-check-label" for="emailNotifications">Thông báo qua Email</label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="pushNotifications" onchange="updateNotifications()">
                                    <label class="form-check-label" for="pushNotifications">Thông báo đẩy</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="tab-pane fade" id="danger">
                    <div class="card shadow-sm border-danger mb-4">
                        <div class="card-header bg-danger text-white py-3">
                            <h5 class="mb-0">Vùng nguy hiểm</h5>
                        </div>
                        <div class="card-body">
                            <p>Đặt lại tất cả cài đặt về mặc định. Hành động này không thể hoàn tác.</p>
                            <button class="btn btn-outline-danger" onclick="resetSettings()">Đặt lại về mặc định</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="settingsToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Cài đặt</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/theme-manager.js"></script>
    <script>
        let currentSettings = {};

        // Theme Functions
        function changeTheme(theme) {
            window.themeManager.saveTheme(theme);
            updateThemeUI(theme);
            updateSetting('theme', theme);
        }

        function updateThemeUI(theme) {
            // Remove all active states
            document.querySelectorAll('.theme-option').forEach(el => {
                el.classList.remove('border-primary', 'border-3', 'shadow-sm');
                el.querySelector('.theme-check').classList.add('d-none');
            });
            
            // Add active state to selected
            const selected = document.getElementById(`theme-${theme}`);
            if (selected) {
                selected.classList.add('border-primary', 'border-3', 'shadow-sm');
                selected.querySelector('.theme-check').classList.remove('d-none');
            }
        }

        function loadPresetColors() {
            const colors = window.themeManager.getPresetColors();
            const container = document.getElementById('presetColors');
            
            colors.forEach(color => {
                const col = document.createElement('div');
                col.className = 'col-6 col-md-3';
                col.innerHTML = `
                    <div class="color-preset-option p-3 border rounded-3 cursor-pointer text-center position-relative"
                         onclick="applyPresetColor('${color.value}')"
                         data-color="${color.value}">
                        <div class="color-circle mx-auto mb-2 rounded-circle border border-2" 
                             style="width: 50px; height: 50px; background: ${color.value};"></div>
                        <div class="fw-semibold small">${color.name}</div>
                        <small class="text-muted">${color.description}</small>
                        <div class="color-preset-check position-absolute top-0 end-0 m-2 d-none">
                            <i class="bi bi-check-circle-fill text-white fs-5" style="filter: drop-shadow(0 0 2px rgba(0,0,0,0.5));"></i>
                        </div>
                    </div>
                `;
                container.appendChild(col);
            });
            
            // Highlight current color
            updateColorUI(window.themeManager.getPrimaryColor());
        }

        function applyPresetColor(color) {
            window.themeManager.savePrimaryColor(color);
            updateColorUI(color);
            document.getElementById('customColorPicker').value = color;
            document.getElementById('customColorInput').value = color;
        }

        function applyCustomColor() {
            const colorInput = document.getElementById('customColorInput');
            const colorPicker = document.getElementById('customColorPicker');
            
            let color = colorInput.value.trim();
            
            // Validate hex color
            if (!/^#[0-9A-Fa-f]{6}$/.test(color)) {
                color = colorPicker.value;
            }
            
            window.themeManager.savePrimaryColor(color);
            updateColorUI(color);
            
            showToast('Màu chủ đạo đã được cập nhật!', 'success');
        }

        function updateColorUI(color) {
            // Remove all active states
            document.querySelectorAll('.color-preset-option').forEach(el => {
                el.classList.remove('border-primary', 'border-3', 'shadow-sm');
                el.querySelector('.color-preset-check').classList.add('d-none');
            });
            
            // Add active state to selected
            const selected = document.querySelector(`[data-color="${color}"]`);
            if (selected) {
                selected.classList.add('border-primary', 'border-3', 'shadow-sm');
                selected.querySelector('.color-preset-check').classList.remove('d-none');
            }
        }

        function toggleReducedMotion() {
            const enabled = document.getElementById('reducedMotion').checked;
            if (enabled) {
                document.documentElement.style.setProperty('--transition-fast', '0ms');
                document.documentElement.style.setProperty('--transition-base', '0ms');
                document.documentElement.style.setProperty('--transition-slow', '0ms');
            } else {
                document.documentElement.style.setProperty('--transition-fast', '150ms cubic-bezier(0.4, 0, 0.2, 1)');
                document.documentElement.style.setProperty('--transition-base', '300ms cubic-bezier(0.4, 0, 0.2, 1)');
                document.documentElement.style.setProperty('--transition-slow', '500ms cubic-bezier(0.4, 0, 0.2, 1)');
            }
            localStorage.setItem('reducedMotion', enabled);
            showToast(enabled ? 'Đã tắt hiệu ứng chuyển động' : 'Đã bật hiệu ứng chuyển động', 'success');
        }

        function toggleCompactMode() {
            const enabled = document.getElementById('compactMode').checked;
            document.documentElement.classList.toggle('compact-mode', enabled);
            localStorage.setItem('compactMode', enabled);
            showToast(enabled ? 'Đã bật chế độ thu gọn' : 'Đã tắt chế độ thu gọn', 'success');
        }

        // Sync color picker and input
        document.addEventListener('DOMContentLoaded', () => {
            const colorPicker = document.getElementById('customColorPicker');
            const colorInput = document.getElementById('customColorInput');
            
            if (colorPicker && colorInput) {
                colorPicker.addEventListener('input', (e) => {
                    colorInput.value = e.target.value;
                });
                
                colorInput.addEventListener('input', (e) => {
                    const value = e.target.value;
                    if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
                        colorPicker.value = value;
                    }
                });
            }
        });

        async function loadOptions() {
            try {
                const response = await fetch('/api/settings/options');
                const data = await response.json();

                // Populate Languages
                const langSelect = document.getElementById('language');
                data.languages.forEach(l => {
                    const opt = document.createElement('option');
                    opt.value = l.code;
                    opt.textContent = l.name;
                    langSelect.appendChild(opt);
                });

                // Populate Currencies
                const currSelect = document.getElementById('currency');
                data.currencies.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.code;
                    opt.textContent = `${c.code} - ${c.name} (${c.symbol})`;
                    currSelect.appendChild(opt);
                });

                // Populate Timezones
                const tzSelect = document.getElementById('timezone');
                data.timezones.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = t.displayName;
                    tzSelect.appendChild(opt);
                });

                // Populate Date Formats
                const dfSelect = document.getElementById('dateFormat');
                data.dateFormats.forEach(f => {
                    const opt = document.createElement('option');
                    opt.value = f;
                    opt.textContent = f;
                    dfSelect.appendChild(opt);
                });

                // Populate Time Formats
                const tfSelect = document.getElementById('timeFormat');
                data.timeFormats.forEach(f => {
                    const opt = document.createElement('option');
                    opt.value = f;
                    opt.textContent = f;
                    tfSelect.appendChild(opt);
                });

            } catch (error) {
                console.error('Error loading options:', error);
            }
        }

        async function loadSettings() {
            try {
                const response = await fetch('/api/settings');
                if (response.ok) {
                    currentSettings = await response.json();
                    
                    // Set values
                    document.getElementById('language').value = currentSettings.language;
                    document.getElementById('currency').value = currentSettings.defaultCurrency;
                    document.getElementById('timezone').value = currentSettings.timezone;
                    document.getElementById('dateFormat').value = currentSettings.dateFormat;
                    document.getElementById('timeFormat').value = currentSettings.timeFormat;
                    document.getElementById('firstDayOfWeek').value = currentSettings.firstDayOfWeek;
                    
                    document.getElementById('notificationsEnabled').checked = currentSettings.notificationsEnabled;
                    document.getElementById('emailNotifications').checked = currentSettings.emailNotifications;
                    document.getElementById('pushNotifications').checked = currentSettings.pushNotifications;

                    // Update theme UI
                    updateThemeUI(currentSettings.theme || 'light');
                    
                    // Update primary color if different from current
                    if (currentSettings.primaryColor && currentSettings.primaryColor !== window.themeManager.getPrimaryColor()) {
                        window.themeManager.applyPrimaryColor(currentSettings.primaryColor);
                        localStorage.setItem('primaryColor', currentSettings.primaryColor);
                    }
                    
                    // Load saved preferences
                    const reducedMotion = localStorage.getItem('reducedMotion') === 'true';
                    const compactMode = localStorage.getItem('compactMode') === 'true';
                    
                    document.getElementById('reducedMotion').checked = reducedMotion;
                    document.getElementById('compactMode').checked = compactMode;
                    
                    if (reducedMotion) toggleReducedMotion();
                    if (compactMode) toggleCompactMode();
                }
            } catch (error) {
                console.error('Error loading settings:', error);
            }
        }

        async function updateSetting(key, value) {
            // Optimistic update
            currentSettings[key] = value;
            
            // Prepare DTO
            const dto = { ...currentSettings };
            // Ensure firstDayOfWeek is int
            dto.firstDayOfWeek = parseInt(dto.firstDayOfWeek);

            try {
                let endpoint = '/api/settings';
                let body = dto;

                // Use specific endpoints for some settings if preferred, but general update is easier
                if (key === 'language') endpoint = '/api/settings/language';
                if (key === 'currency') endpoint = '/api/settings/currency';
                if (key === 'theme') endpoint = '/api/settings/theme';
                if (key === 'timezone') endpoint = '/api/settings/timezone';

                if (endpoint !== '/api/settings') {
                    body = { [key]: value };
                }

                const response = await fetch(endpoint, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });

                if (response.ok) {
                    showToast(`${key} cập nhật thành công!`, 'success');
                } else {
                    showToast(`Không thể cập nhật ${key}.`, 'danger');
                    loadSettings(); // Revert
                }
            } catch (error) {
                showToast(`Lỗi cập nhật ${key}.`, 'danger');
                loadSettings(); // Revert
            }
        }

        async function updateNotifications() {
            const dto = {
                notificationsEnabled: document.getElementById('notificationsEnabled').checked,
                emailNotifications: document.getElementById('emailNotifications').checked,
                pushNotifications: document.getElementById('pushNotifications').checked
            };

            try {
                const response = await fetch('/api/settings/notifications', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });

                if (response.ok) {
                    showToast('Tùy chọn thông báo đã được cập nhật!', 'success');
                    currentSettings.notificationsEnabled = dto.notificationsEnabled;
                    currentSettings.emailNotifications = dto.emailNotifications;
                    currentSettings.pushNotifications = dto.pushNotifications;
                } else {
                    showToast('Không thể cập nhật thông báo.', 'danger');
                }
            } catch (error) {
                showToast('Lỗi cập nhật thông báo.', 'danger');
            }
        }

        async function resetSettings() {
            if (!confirm('Bạn có chắc chắn muốn đặt lại tất cả cài đặt về mặc định không?')) return;

            try {
                const response = await fetch('/api/settings/reset', { method: 'POST' });
                if (response.ok) {
                    showToast('Cài đặt đã được đặt lại về mặc định.', 'success');
                    loadSettings();
                } else {
                    showToast('Không thể đặt lại cài đặt.', 'danger');
                }
            } catch (error) {
                showToast('Lỗi đặt lại cài đặt.', 'danger');
            }
        }

        function showToast(message, type = 'info') {
            const toastEl = document.getElementById('settingsToast');
            const toastBody = document.getElementById('toastMessage');
            toastBody.textContent = message;
            toastEl.className = `toast align-items-center text-white bg-${type} border-0`;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        document.addEventListener('DOMContentLoaded', async () => {
            await loadOptions();
            await loadSettings();
            loadPresetColors();
            
            // Set initial color picker values
            const currentColor = window.themeManager.getPrimaryColor();
            document.getElementById('customColorPicker').value = currentColor;
            document.getElementById('customColorInput').value = currentColor;
        });
    </script>
    
