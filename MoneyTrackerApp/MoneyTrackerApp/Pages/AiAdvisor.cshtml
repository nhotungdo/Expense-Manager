@page
@model MoneyTrackerApp.Pages.AiAdvisorModel
@{
    ViewData["Title"] = "Cố vấn tài chính AI";
}

<div class="ai-advisor-page modern-page">
    <!-- Page Header -->
    <div class="page-header-modern">
        <div class="header-content">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-brain"></i>
                    Cố vấn tài chính AI
                </h1>
                <p class="page-subtitle">Nhận gợi ý và phân tích thông minh về tài chính của bạn</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline" onclick="refreshInsights()">
                    <i class="fas fa-sync-alt"></i>
                    Làm mới
                </button>
                <button class="btn btn-primary" onclick="generateNewInsights()">
                    <i class="fas fa-magic"></i>
                    Tạo gợi ý mới
                </button>
            </div>
        </div>
    </div>

    <!-- AI Overview Cards -->
    <div class="ai-overview-grid">
        <div class="ai-stat-card">
            <div class="stat-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Gợi ý tích cực</p>
                <h3 class="stat-value" id="positiveCount">0</h3>
            </div>
        </div>
        
        <div class="ai-stat-card">
            <div class="stat-icon warning">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Cảnh báo</p>
                <h3 class="stat-value" id="warningCount">0</h3>
            </div>
        </div>
        
        <div class="ai-stat-card">
            <div class="stat-icon info">
                <i class="fas fa-lightbulb"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Mẹo hữu ích</p>
                <h3 class="stat-value" id="tipsCount">0</h3>
            </div>
        </div>
        
        <div class="ai-stat-card">
            <div class="stat-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Cập nhật lần cuối</p>
                <h3 class="stat-value" id="lastUpdate">--</h3>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        <button class="tab-btn active" data-filter="all" onclick="filterSuggestions('all')">
            <i class="fas fa-th"></i>
            Tất cả
        </button>
        <button class="tab-btn" data-filter="success" onclick="filterSuggestions('success')">
            <i class="fas fa-check-circle"></i>
            Tích cực
        </button>
        <button class="tab-btn" data-filter="warning" onclick="filterSuggestions('warning')">
            <i class="fas fa-exclamation-triangle"></i>
            Cảnh báo
        </button>
        <button class="tab-btn" data-filter="info" onclick="filterSuggestions('info')">
            <i class="fas fa-lightbulb"></i>
            Thông tin
        </button>
    </div>

    <!-- Suggestions List -->
    <div class="suggestions-container" id="suggestionsContainer">
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Đang tải gợi ý...</p>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/ai-advisor.css">
    <script src="~/js/ai-advisor.js"></script>
}
