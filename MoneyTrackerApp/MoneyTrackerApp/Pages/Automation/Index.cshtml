@page
@model MoneyTrackerApp.Pages.Automation.IndexModel
@{
    ViewData["Title"] = "Tự động hóa";
    var activeRules = Model.Rules.Count(r => r.IsActive);
    var totalRules = Model.Rules.Count;
}

<div class="min-h-screen bg-slate-50/50 pb-12">
    <!-- Top Configuration Bar -->
    <div class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-4">
                    <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-200">
                        <i class="fas fa-magic text-sm"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-900 tracking-tight">Tự động hóa</h1>
                        <p class="text-xs text-slate-500">Quản lý quy tắc thông minh</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <a asp-page="Create" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 rounded-xl hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all shadow-lg shadow-indigo-200 hover:-translate-y-0.5">
                        <i class="fas fa-plus mr-2"></i>
                        Thêm quy tắc
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Stats Overview -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Total Count Card -->
            <div class="relative overflow-hidden bg-white rounded-2xl p-6 border border-slate-100 shadow-sm group hover:shadow-md transition-all">
                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i class="fas fa-layer-group text-6xl text-indigo-600"></i>
                </div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl">
                        <i class="fas fa-list-ul text-xl"></i>
                    </div>
                    <h3 class="font-semibold text-slate-600">Tổng quy tắc</h3>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-bold text-slate-900">@totalRules</span>
                    <span class="text-sm text-slate-500">đã thiết lập</span>
                </div>
            </div>

            <!-- Active Count Card -->
            <div class="relative overflow-hidden bg-white rounded-2xl p-6 border border-slate-100 shadow-sm group hover:shadow-md transition-all">
                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i class="fas fa-bolt text-6xl text-emerald-600"></i>
                </div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
                        <i class="fas fa-power-off text-xl"></i>
                    </div>
                    <h3 class="font-semibold text-slate-600">Đang chạy</h3>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-bold text-slate-900">@activeRules</span>
                    <span class="text-sm text-slate-500">đang kích hoạt</span>
                </div>
            </div>

            <!-- Last Run Card -->
            <div class="relative overflow-hidden bg-white rounded-2xl p-6 border border-slate-100 shadow-sm group hover:shadow-md transition-all">
                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i class="fas fa-history text-6xl text-amber-500"></i>
                </div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="p-3 bg-amber-50 text-amber-600 rounded-xl">
                        <i class="fas fa-clock text-xl"></i>
                    </div>
                    <h3 class="font-semibold text-slate-600">Hoạt động gần nhất</h3>
                </div>
                @if(Model.Rules.Any(r => r.LastExecutedAt.HasValue))
                {
                    var lastRun = Model.Rules.Where(r => r.LastExecutedAt.HasValue).OrderByDescending(r => r.LastExecutedAt).First();
                    <div>
                         <p class="text-lg font-bold text-slate-900 line-clamp-1 mb-1" title="@lastRun.Name">@lastRun.Name</p>
                         <p class="text-sm text-slate-500">@lastRun.LastExecutedAt?.ToString("HH:mm dd/MM/yyyy")</p>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2 text-slate-400">
                        <span>Chưa có hoạt động</span>
                    </div>
                }
            </div>
        </div>

        @if (!Model.Rules.Any())
        {
            <!-- Modern Empty State -->
            <div class="text-center py-20 bg-white rounded-3xl border border-dashed border-slate-200">
                 <div class="w-24 h-24 bg-indigo-50 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-magic text-4xl text-indigo-500"></i>
                 </div>
                <h2 class="text-2xl font-bold text-slate-900 mb-3">Tự động hóa tài chính của bạn</h2>
                <p class="text-slate-500 max-w-lg mx-auto mb-8 leading-relaxed">
                    Thiết lập các quy tắc thông minh để tự động phân loại giao dịch, <br>gửi thông báo chi tiêu và giúp bạn tiết kiệm thời gian.
                </p>
                 <a asp-page="Create" class="inline-flex items-center px-8 py-4 text-base font-semibold text-white bg-indigo-600 rounded-xl hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all hover:-translate-y-1">
                    <i class="fas fa-plus mr-2"></i>
                    Bắt đầu ngay
                </a>
            </div>
        }
        else
        {
            <!-- Modern Grid Layout -->
             <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                @foreach (var rule in Model.Rules)
                {
                   <!-- Rule Card -->
                    <div class="group relative bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-xl hover:border-indigo-100 transition-all duration-300 flex flex-col">
                        
                        <!-- Card Header -->
                        <div class="flex items-start justify-between mb-6">
                             <div class="flex items-center gap-4">
                                 <div class="w-12 h-12 rounded-2xl bg-gradient-to-br @(rule.IsActive ? "from-indigo-500 to-indigo-600 shadow-indigo-200" : "from-slate-100 to-slate-200 text-slate-400") shadow-lg flex items-center justify-center text-white shrink-0">
                                     @if(rule.TriggerType == "TransactionCreated") { <i class="fas fa-receipt text-lg"></i> }
                                     else { <i class="fas fa-clock text-lg"></i> }
                                 </div>
                                 <div class="min-w-0">
                                     <h3 class="font-bold text-slate-900 line-clamp-1 text-lg mb-0.5" title="@rule.Name">@rule.Name</h3>
                                     <span class="text-xs font-medium px-2 py-0.5 rounded-full @(rule.IsActive ? "bg-green-50 text-green-700" : "bg-slate-100 text-slate-600")">
                                         @(rule.IsActive ? "Đang chạy" : "Tạm dừng")
                                     </span>
                                 </div>
                             </div>
                             
                             <!-- Toggle Switch -->
                             <form method="post" asp-page-handler="Toggle" asp-route-id="@rule.Id">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer" onchange="this.form.submit()" @(rule.IsActive ? "checked" : "")>
                                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                                </label>
                             </form>
                        </div>

                        <!-- Rule Flow Visual -->
                         <div class="bg-slate-50 rounded-xl p-4 mb-6 space-y-3 flex-grow border border-slate-100/50">
                             <!-- If -->
                             <div class="flex items-center gap-3">
                                 <span class="text-xs font-bold text-slate-400 uppercase tracking-wider w-8">Nếu</span>
                                 <div class="flex items-center gap-2 min-w-0">
                                     <i class="fas fa-bolt text-amber-500 text-xs"></i>
                                     <span class="text-sm font-medium text-slate-700 truncate">
                                          @if(rule.TriggerType == "TransactionCreated") { <span>Có giao dịch mới</span> }
                                          else { <span>@rule.TriggerType</span> }
                                     </span>
                                 </div>
                             </div>
                             
                             <!-- Then -->
                             <div class="flex items-center gap-3">
                                 <span class="text-xs font-bold text-slate-400 uppercase tracking-wider w-8">Thì</span>
                                  <div class="flex items-center gap-2 min-w-0">
                                      <i class="fas fa-arrow-right text-indigo-500 text-xs"></i>
                                      <span class="text-sm font-semibold text-indigo-700 truncate">
                                          @if(rule.ActionType == "Transfer") { <span>Chuyển tiền</span> }
                                          else if(rule.ActionType == "Notify") { <span>Gửi thông báo</span> }
                                          else { <span>@rule.ActionType</span> }
                                     </span>
                                 </div>
                             </div>
                         </div>

                         <!-- Card Footer -->
                         <div class="flex items-center justify-between pt-4 border-t border-slate-50 mt-auto">
                             <div class="flex items-center gap-1.5 text-xs text-slate-400">
                                 <i class="fas fa-history"></i>
                                 @if(rule.LastExecutedAt.HasValue) 
                                 { 
                                     <span title="@rule.LastExecutedAt">@rule.LastExecutedAt.Value.ToString("dd/MM HH:mm")</span> 
                                 }
                                 else 
                                 { 
                                     <span>Chưa hoạt động</span> 
                                 }
                             </div>
                             
                             <div class="flex items-center gap-2">
                                 <!-- Edit Button (Placeholder link) -->
                                 @* <a href="#" class="w-8 h-8 flex items-center justify-center rounded-full text-slate-400 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
                                     <i class="fas fa-pen"></i>
                                 </a> *@
                                 
                                 <form method="post" asp-page-handler="Delete" asp-route-id="@rule.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xóa quy tắc này?');">
                                     <button class="w-8 h-8 flex items-center justify-center rounded-full text-slate-400 hover:bg-red-50 hover:text-red-500 transition-colors" title="Xóa quy tắc">
                                         <i class="fas fa-trash-alt"></i>
                                     </button>
                                 </form>
                             </div>
                         </div>
                    </div>
                }
             </div>
        }
    </div>
</div>

