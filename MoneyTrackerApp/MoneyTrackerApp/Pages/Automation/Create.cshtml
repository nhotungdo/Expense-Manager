@page
@model MoneyTrackerApp.Pages.Automation.CreateModel
@{
    ViewData["Title"] = "Tạo Quy tắc Mới";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
            <a asp-page="./Index" class="p-2 rounded-full hover:bg-slate-100 transition-colors text-slate-500">
                <i class="fas fa-arrow-left text-lg"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Tạo Quy tắc Mới</h1>
                <p class="text-slate-500 text-sm">Thiết lập tự động hóa cho tài chính của bạn</p>
            </div>
        </div>
    </div>

    <form method="post" class="space-y-6">
        <!-- Rule Name -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
            <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-2">Tên quy tắc</label>
            <input asp-for="Name" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500 transition-colors" placeholder="Ví dụ: Tự động tiết kiệm khi nhận lương" required />
            <span asp-validation-for="Name" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Condition Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="bg-blue-50/50 p-4 border-b border-slate-100 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-sm">1</div>
                <h2 class="font-semibold text-slate-800">KHI (Điều kiện)</h2>
            </div>
            
            <div class="p-6 space-y-6">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">Sự kiện kích hoạt</label>
                    <select asp-for="TriggerType" asp-items="Model.TriggerTypes" class="w-full px-4 py-3 rounded-xl border-slate-200 bg-slate-50 text-slate-500 pointer-events-none"></select>
                    <p class="text-xs text-slate-400 mt-2">Hiện tại chỉ hỗ trợ kích hoạt khi có giao dịch mới được tạo.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-50">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2">Loại giao dịch</label>
                        <select asp-for="ConditionTransactionType" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500">
                            <option value="">Tất cả loại giao dịch</option>
                            <option value="1">Thu nhập (Income)</option>
                            <option value="2">Chi tiêu (Expense)</option>
                            <option value="3">Chuyển tiền (Transfer)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2">Danh mục cụ thể</label>
                        <select asp-for="ConditionCategoryId" asp-items="Model.Categories" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500">
                            <option value="">Tất cả danh mục</option>
                        </select>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-50">
                    <label class="block text-sm font-medium text-slate-700 mb-2">Số tiền giao dịch</label>
                    <div class="flex gap-3">
                        <select asp-for="ConditionOperator" class="w-24 px-3 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500 bg-slate-50">
                            <option value=">">Lớn hơn</option>
                            <option value=">=">Lớn hơn hoặc bằng</option>
                            <option value="<">Nhỏ hơn</option>
                            <option value="<=">Nhỏ hơn hoặc bằng</option>
                            <option value="==">Bằng</option>
                        </select>
                        <div class="relative flex-1">
                            <input asp-for="ConditionAmount" type="number" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500 pl-12" placeholder="0" />
                            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium">VND</div>
                        </div>
                    </div>
                    <p class="text-xs text-slate-400 mt-2">Để trống nếu không muốn áp dụng điều kiện số tiền.</p>
                </div>
            </div>
        </div>

        <!-- Action Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="bg-green-50/50 p-4 border-b border-slate-100 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold text-sm">2</div>
                <h2 class="font-semibold text-slate-800">THÌ (Hành động)</h2>
            </div>
            
            <div class="p-6 space-y-6">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">Hành động thực hiện</label>
                    <select asp-for="ActionType" asp-items="Model.ActionTypes" id="actionTypeSelect" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500"></select>
                </div>

                <!-- Notify Actions -->
                <div id="notifyFields" class="hidden">
                    <label class="block text-sm font-medium text-slate-700 mb-2">Nội dung thông báo</label>
                    <input asp-for="NoteMessage" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500" placeholder="Nhập nội dung thông báo tùy chỉnh..." />
                    <p class="text-xs text-slate-400 mt-2">Nếu để trống, hệ thống sẽ sử dụng tên quy tắc làm nội dung.</p>
                </div>

                <!-- Transfer Actions -->
                <div id="transferFields" class="hidden space-y-6">
                    <div class="p-4 bg-yellow-50 rounded-xl border border-yellow-100 flex items-start gap-3">
                        <i class="fas fa-info-circle text-yellow-600 mt-1"></i>
                        <p class="text-sm text-yellow-700">Hệ thống sẽ tự động tạo một giao dịch chuyển tiền từ tài khoản nguồn sang tài khoản đích khi điều kiện được thỏa mãn.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-2">Đến tài khoản</label>
                            <select asp-for="ActionDestinationAccountId" asp-items="Model.Accounts" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500"></select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-2">Số tiền chuyển</label>
                            <div class="flex gap-3">
                                <input asp-for="ActionAmount" type="number" step="0.01" class="w-full px-4 py-3 rounded-xl border-slate-200 focus:border-blue-500 focus:ring-blue-500" required />
                                <div class="flex items-center gap-2 px-3 bg-slate-50 rounded-xl border border-slate-200">
                                    <input asp-for="ActionIsPercentage" type="checkbox" id="isPercentage" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" />
                                    <label for="isPercentage" class="text-sm text-slate-600 whitespace-nowrap">%</label>
                                </div>
                            </div>
                            <p class="text-xs text-slate-400 mt-2">Nếu chọn %, số tiền sẽ được tính dựa trên số tiền của giao dịch gốc.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit -->
        <div class="flex items-center justify-end gap-4 pt-4">
            <a asp-page="./Index" class="px-6 py-3 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors font-medium">Hủy bỏ</a>
            <button type="submit" class="px-8 py-3 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700 shadow-lg shadow-blue-200 transition-all transform hover:-translate-y-0.5">
                <i class="fas fa-save me-2"></i>Tạo Quy tắc
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const actionTypeSelect = document.getElementById('actionTypeSelect');
            const transferFields = document.getElementById('transferFields');
            const notifyFields = document.getElementById('notifyFields');

            function updateFields() {
                const value = actionTypeSelect.value;
                if (value === 'Transfer') {
                    transferFields.classList.remove('hidden');
                    notifyFields.classList.add('hidden');
                } else if (value === 'Notify') {
                    transferFields.classList.add('hidden');
                    notifyFields.classList.remove('hidden');
                } else {
                    transferFields.classList.add('hidden');
                    notifyFields.classList.add('hidden');
                }
            }

            actionTypeSelect.addEventListener('change', updateFields);
            updateFields(); // Run on load
        });
    </script>
}
