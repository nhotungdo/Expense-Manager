@page
@model MoneyTrackerApp.Pages.Savings.IndexModel
@using MoneyTrackerApp.Models
@{
    ViewData["Title"] = "Sổ Tiết kiệm";
}

<!-- Savings Page - Bento Grid Redesign -->
<div class="savings-page">
    <div class="bento-grid">
        <!-- Header Section -->
        <div class="page-header bento-col-span-12">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-piggy-bank"></i> Sổ Tiết kiệm
                </h1>
                <p class="page-subtitle">Quản lý các mục tiêu tài chính và hiện thực hóa ước mơ của bạn</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-primary btn-lg shadow-sm" data-bs-toggle="modal" data-bs-target="#createGoalModal">
                    <i class="fas fa-plus me-2"></i> Mục tiêu mới
                </button>
            </div>
        </div>

        <!-- Summary Statistics -->
        <div class="bento-col-span-12 grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Total Saved -->
            <div class="savings-stats-card highlight">
                <div class="stat-icon-wrapper">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Tổng tích lũy</p>
                    <h3 class="stat-value">@Model.TotalSaved.ToString("N0") <span class="text-sm opacity-70 font-normal">VND</span></h3>
                    <div class="mt-2 text-sm opacity-80">
                        <i class="fas fa-chart-line me-1"></i> Đang thực hiện @Model.TotalGoalsCount mục tiêu
                    </div>
                </div>
                <!-- Decorative BG icon -->
                <div class="absolute -right-4 -bottom-4 opacity-10 text-9xl transform rotate-12">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>

            <!-- Completion Rate -->
            <div class="savings-stats-card">
                <div class="stat-icon-wrapper text-emerald-600 bg-emerald-50">
                    <i class="fas fa-chart-pie"></i>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Tiến độ tổng thể</p>
                    <div class="flex items-baseline gap-2">
                        <h3 class="stat-value text-emerald-600">
                             @(Model.TotalTarget > 0 ? (Model.TotalSaved / Model.TotalTarget * 100).ToString("F1") : "0")%
                        </h3>
                    </div>
                   <div class="w-full bg-slate-100 rounded-full h-2 mt-3 overflow-hidden">
                        <div class="bg-emerald-500 h-full rounded-full transition-all duration-1000" 
                             style="width: @(Model.TotalTarget > 0 ? (Model.TotalSaved / Model.TotalTarget * 100) : 0)%"></div>
                   </div>
                </div>
            </div>

            <!-- Goals Status -->
            <div class="savings-stats-card">
                 <div class="stat-icon-wrapper text-violet-600 bg-violet-50">
                    <i class="fas fa-flag-checkered"></i>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Mục tiêu đạt được</p>
                    <h3 class="stat-value text-violet-600">@Model.CompletedGoalsCount <span class="text-lg text-slate-400 font-normal">/ @Model.TotalGoalsCount</span></h3>
                    <p class="text-sm text-slate-500 mt-1">
                        Hãy tiếp tục cố gắng!
                    </p>
                </div>
            </div>
        </div>

        <!-- Goals Grid -->
        <div class="bento-col-span-12">
            <h3 class="text-xl font-bold text-slate-800 mb-4 px-1">Danh sách mục tiêu</h3>
            
            @if (Model.SavingsGoals.Count > 0)
            {
                <div class="goals-grid">
                    <!-- Create New Card (Inline) -->
                    <div class="create-goal-card rounded-2xl p-6 flex flex-col items-center justify-center text-center" 
                         data-bs-toggle="modal" data-bs-target="#createGoalModal">
                        <div class="create-icon-circle">
                            <i class="fas fa-plus"></i>
                        </div>
                        <h4 class="font-bold text-slate-700">Tạo mục tiêu mới</h4>
                        <p class="text-sm text-slate-500 mt-1">Đặt tên, số tiền và thời hạn</p>
                    </div>

                    @foreach (var goal in Model.SavingsGoals)
                    {
                        var percent = goal.TargetAmount > 0 ? (goal.CurrentAmount / goal.TargetAmount * 100) : 100;
                        var isCompleted = percent >= 100;
                        var daysLeft = goal.TargetDate.HasValue ? (goal.TargetDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).Days : -1;

                        <div class="goal-card group">
                            <div class="goal-header">
                                <div class="goal-icon" style="background-color: @(goal.Color + "15"); color: @goal.Color;">
                                    <i class="@(goal.Icon ?? "fas fa-piggy-bank")"></i>
                                </div>
                                <div class="goal-info">
                                    <div class="flex justify-between items-start">
                                        <h4 class="goal-title">@goal.Name</h4>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v text-slate-400"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="openEditModal(@goal.Id, '@goal.Name', @goal.TargetAmount, @goal.CurrentAmount, '@(goal.TargetDate?.ToString("yyyy-MM-dd") ?? "")', '@goal.Icon', '@goal.Color')"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="openDeleteModal(@goal.Id)"><i class="fas fa-trash me-2"></i>Xóa</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="mt-1">
                                        @if(isCompleted) {
                                            <span class="goal-status bg-emerald-100 text-emerald-700"><i class="fas fa-check me-1"></i> Hoàn thành</span>
                                        } else if(daysLeft >= 0) {
                                            <span class="goal-status bg-orange-100 text-orange-700"><i class="far fa-clock me-1"></i> Còn @daysLeft ngày</span>
                                        } else {
                                            <span class="goal-status bg-slate-100 text-slate-600">Đang thực hiện</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="goal-progress-section">
                                <div class="progress-header">
                                    <span>Tiến độ</span>
                                    <span class="font-bold">@percent.ToString("F0")%</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @Math.Min(percent, 100)%; background-color: @goal.Color;"></div>
                                </div>
                                <div class="flex justify-between mt-2 text-sm">
                                    <span class="font-bold text-slate-700">@goal.CurrentAmount.ToString("N0")</span>
                                    <span class="text-slate-400">/ @goal.TargetAmount.ToString("N0")</span>
                                </div>
                            </div>

                            <div class="goal-footer">
                                @if(!isCompleted) {
                                    <a asp-page="/Transactions/Create" asp-route-goalId="@goal.Id" class="btn btn-light w-full fw-semibold text-primary hover:bg-primary-50">
                                        <i class="fas fa-plus-circle me-2"></i> Nạp tiền
                                    </a>
                                } else {
                                     <button onclick="triggerConfetti()" class="btn btn-emerald-soft w-full fw-semibold text-emerald-600">
                                        <i class="fas fa-medal me-2"></i> Chúc mừng!
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                 <div class="empty-state-savings">
                    <div class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300 text-4xl">
                        <i class="fas fa-seedling"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800 mb-2">Chưa có mục tiêu nào</h3>
                    <p class="text-slate-500 mb-6">Hãy đặt mục tiêu đầu tiên để bắt đầu hành trình tiết kiệm của bạn.</p>
                    <button class="btn btn-primary btn-lg rounded-pill px-5" data-bs-toggle="modal" data-bs-target="#createGoalModal">
                        <i class="fas fa-plus me-2"></i> Tạo mục tiêu ngay
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modals -->
<partial name="_SavingsModals" model="Model" />

@section Styles {
    <link rel="stylesheet" href="~/css/savings.css" asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="~/js/savings.js" asp-append-version="true"></script>
}
