@page
@model MoneyTrackerApp.Pages.Savings.IndexModel
@using MoneyTrackerApp.Models
@{
    ViewData["Title"] = "Sổ Tiết kiệm";
}

<div class="savings-container">
    <!-- Header Area -->
    <div class="savings-header">
        <div class="header-title-group">
            <h1>Sổ Tiết Kiệm</h1>
            <p>Quản lý tài chính, hiện thực hóa ước mơ</p>
        </div>
        <button class="btn-new-goal" data-bs-toggle="modal" data-bs-target="#createGoalModal">
            <i class="fas fa-plus-circle"></i> Mục tiêu mới
        </button>
    </div>

    <!-- Stats Dashboard -->
    <div class="stats-dashboard">
        <!-- Main Total Card -->
        <div class="stat-card main-total">
            <span class="stat-label">Tổng tích lũy hiện tại</span>
            <h2 class="stat-value">@Model.TotalSaved.ToString("N0") <small style="font-size: 1.5rem; opacity: 0.7;">VND</small></h2>
            
            <div class="stat-meta">
                <span>
                    <i class="fas fa-bullseye me-2"></i> @Model.TotalGoalsCount Mục tiêu
                </span>
                <span>
                    <i class="fas fa-check-circle me-2"></i> @Model.CompletedGoalsCount Hoàn thành
                </span>
            </div>
            
            <i class="fas fa-wallet main-total-bg-icon"></i>
        </div>

        <!-- Progress Card -->
        <div class="stat-card progress-card">
            <div class="icon-box">
                <i class="fas fa-chart-pie"></i>
            </div>
            <h3 class="stat-value-secondary">
                @(Model.TotalTarget > 0 ? (Model.TotalSaved / Model.TotalTarget * 100).ToString("F1") : "0")%
            </h3>
            <p class="stat-desc">Tiến độ tổng thể trên toàn bộ các mục tiêu đặt ra.</p>
        </div>

        <!-- Goals Status Card -->
        <div class="stat-card goals-card">
            <div class="icon-box">
                <i class="fas fa-flag-checkered"></i>
            </div>
            <h3 class="stat-value-secondary">
                @((Model.TotalTarget - Model.TotalSaved).ToString("N0")) <small class="text-xs text-muted">VND</small>
            </h3>
            <p class="stat-desc">Số tiền còn lại cần tiết kiệm để đạt tất cả mục tiêu.</p>
        </div>
    </div>

    <!-- Goals Grid -->
    <div class="goals-section">
        <h3 class="goals-section-title">
            <i class="fas fa-layer-group text-primary"></i> Danh sách mục tiêu
        </h3>

        <div class="goals-grid">
            <!-- Create New Card (First Item) -->
            <div class="goal-item create-card-modern" data-bs-toggle="modal" data-bs-target="#createGoalModal">
                <i class="fas fa-plus create-plus-icon"></i>
                <h4 style="color: var(--savings-text-sub); font-weight: 600;">Thêm mục tiêu mới</h4>
            </div>

            @foreach (var goal in Model.SavingsGoals)
            {
                var percent = goal.TargetAmount > 0 ? (goal.CurrentAmount / goal.TargetAmount * 100) : 100;
                var isCompleted = percent >= 100;
                var daysLeft = goal.TargetDate.HasValue ? (goal.TargetDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).Days : -1;
                
                <div class="goal-item" style="--goal-color: @goal.Color">
                    <div class="goal-header-bg" style="background-color: @goal.Color;"></div>
                    
                    <div class="goal-content">
                        <div class="goal-icon-float" style="color: @goal.Color">
                            <i class="@(goal.Icon ?? "fas fa-piggy-bank")"></i>
                        </div>
                        
                        <div class="goal-title-row">
                            <h3>@goal.Name</h3>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-edit-ghost" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
                                    <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="openEditModal(@goal.Id, '@goal.Name', @goal.TargetAmount, @goal.CurrentAmount, '@(goal.TargetDate?.ToString("yyyy-MM-dd") ?? "")', '@goal.Icon', '@goal.Color')"><i class="fas fa-edit me-2 text-primary"></i>Chỉnh sửa</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="javascript:void(0)" onclick="openDeleteModal(@goal.Id)"><i class="fas fa-trash-alt me-2"></i>Xóa mục tiêu</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="goal-dates">
                            @if(isCompleted) {
                                <span class="text-success"><i class="fas fa-check-circle me-1"></i> Đã hoàn thành</span>
                            } else if (daysLeft >= 0) {
                                <span class="@(daysLeft < 7 ? "text-danger" : "")"><i class="far fa-clock me-1"></i> Còn @daysLeft ngày</span>
                            } else {
                                <span><i class="fas fa-infinity me-1"></i> Đang thực hiện</span>
                            }
                        </div>

                        <div class="progress-area">
                            <div class="progress-info">
                                <span style="color: @goal.Color">@percent.ToString("F0")%</span>
                                <span class="text-muted">@goal.CurrentAmount.ToString("N0") / @goal.TargetAmount.ToString("N0")</span>
                            </div>
                            <div class="custom-progress-bar">
                                <div class="progress-fill" style="width: @Math.Min(percent, 100)%; color: @goal.Color"></div>
                            </div>
                        </div>

                        <div class="goal-actions">
                            @if(!isCompleted) {
                                <a asp-page="/Transactions/Create" asp-route-goalId="@goal.Id" class="btn-action btn-deposit">
                                    <i class="fas fa-plus"></i> Nạp tiền
                                </a>
                            } else {
                                <button onclick="triggerConfetti()" class="btn-action" style="background: #dcfce7; color: #16a34a;">
                                    <i class="fas fa-medal"></i> Tuyệt vời!
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modals -->
<partial name="_SavingsModals" model="Model" />

@section Styles {
    <link rel="stylesheet" href="~/css/savings.css" asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="~/js/savings.js" asp-append-version="true"></script>
}
