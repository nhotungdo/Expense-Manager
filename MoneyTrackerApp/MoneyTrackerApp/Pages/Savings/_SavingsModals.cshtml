@model MoneyTrackerApp.Pages.Savings.IndexModel

@{
    var icons = new[] { "fas fa-piggy-bank", "fas fa-car", "fas fa-home", "fas fa-plane", "fas fa-laptop", "fas fa-mobile-alt", "fas fa-graduation-cap", "fas fa-ring", "fas fa-baby", "fas fa-heart", "fas fa-star", "fas fa-gamepad", "fas fa-camera", "fas fa-bicycle", "fas fa-gift", "fas fa-tshirt", "fas fa-coffee", "fas fa-book", "fas fa-music" };
    var colors = new[] { "#6366f1", "#ef4444", "#f59e0b", "#10b981", "#3b82f6", "#ec4899", "#8b5cf6", "#14b8a6", "#f97316" };
}

<!-- Create Goal Modal -->
<div class="modal fade modal-modern" id="createGoalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    Tạo Mục Tiêu Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createGoalForm" method="post" asp-page-handler="Create">
                    <!-- Name -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Tên mục tiêu</label>
                        <input type="text" class="form-control" asp-for="NewGoal.Name" placeholder="Ví dụ: Mua iPhone 16..." required>
                    </div>

                    <!-- Amounts -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Số tiền cần (VND)</label>
                            <input type="number" class="form-control" asp-for="NewGoal.TargetAmount" placeholder="0" required min="0">
                        </div>
                         <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Khởi đầu (VND)</label>
                            <input type="number" class="form-control" asp-for="NewGoal.InitialAmount" placeholder="0" min="0">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Hạn chót (Tùy chọn)</label>
                        <input type="date" class="form-control" asp-for="NewGoal.TargetDate">
                    </div>

                    <!-- Appearance -->
                    <div class="mb-4">
                         <label class="form-label fw-bold text-secondary text-uppercase small ls-1 mb-3">Chọn biểu tượng</label>
                         <input type="hidden" id="selectedIcon" asp-for="NewGoal.Icon">
                         <div class="icon-grid">
                             @{
                                 foreach(var icon in icons)
                                 {
                                     <div class="icon-choice @(Model.NewGoal.Icon == icon ? "active" : "")" onclick="selectIcon('@icon', this)">
                                         <i class="@icon"></i>
                                     </div>
                                 }
                             }
                         </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary text-uppercase small ls-1 mb-3">Chọn màu sắc</label>
                        <input type="hidden" id="selectedColor" asp-for="NewGoal.Color">
                        <div class="color-grid">
                            @{
                                foreach(var color in colors)
                                {
                                     <div class="color-choice @(Model.NewGoal.Color == color ? "active" : "")" 
                                          style="background-color: @color;" 
                                          onclick="selectColor('@color', this)"></div>
                                }
                            }
                        </div>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-primary py-3 rounded-pill fw-bold shadow-sm">
                            <i class="fas fa-plus me-2"></i> Hoàn tất tạo mới
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Goal Modal -->
<div class="modal fade modal-modern" id="editGoalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    Chỉnh sửa Mục Tiêu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editGoalForm" method="post" asp-page-handler="Edit">
                    <input type="hidden" id="editGoalId" name="EditId" />
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Tên mục tiêu</label>
                        <input type="text" class="form-control" id="editGoalName" name="NewGoal.Name" required>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Mục tiêu (VND)</label>
                            <input type="number" class="form-control" id="editTargetAmount" name="NewGoal.TargetAmount" required min="0">
                        </div>
                         <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Đã có (VND)</label>
                            <input type="number" class="form-control" id="editCurrentAmount" name="NewGoal.InitialAmount" min="0">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary text-uppercase small ls-1">Hạn chót</label>
                        <input type="date" class="form-control" id="editTargetDate" name="NewGoal.TargetDate">
                    </div>

                    <div class="mb-4">
                         <label class="form-label fw-bold text-secondary text-uppercase small ls-1 mb-3">Biểu tượng</label>
                         <input type="hidden" id="editSelectedIcon" name="NewGoal.Icon">
                         <div class="icon-grid" id="editIconContainer">
                             @{
                                 foreach(var icon in icons)
                                 {
                                     <div class="icon-choice" onclick="selectEditIcon('@icon', this)" data-icon="@icon">
                                         <i class="@icon"></i>
                                     </div>
                                 }
                             }
                         </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary text-uppercase small ls-1 mb-3">Màu sắc</label>
                        <input type="hidden" id="editSelectedColor" name="NewGoal.Color">
                        <div class="color-grid" id="editColorContainer">
                            @{
                                foreach(var color in colors)
                                {
                                     <div class="color-choice" 
                                          style="background-color: @color;" 
                                          onclick="selectEditColor('@color', this)" 
                                          data-color="@color"></div>
                                }
                            }
                        </div>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-primary py-3 rounded-pill fw-bold shadow-sm">
                            <i class="fas fa-save me-2"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade modal-modern" id="deleteGoalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-5 text-center">
                <div class="mb-4 text-warning" style="font-size: 4rem;">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
                <h3 class="fw-bold mb-3">Xóa mục tiêu này?</h3>
                <p class="text-secondary mb-5">
                    Bạn có chắc chắn muốn xóa mục tiêu này không? Hành động này sẽ xóa toàn bộ lịch sử giao dịch liên quan và không thể hoàn tác.
                </p>
                
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" id="deleteGoalId" name="id" />
                    <div class="d-flex gap-3 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-5 fw-bold" data-bs-dismiss="modal">Không</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold">Xóa ngay</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
