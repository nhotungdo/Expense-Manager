@page
@model MoneyTrackerApp.Pages.NotificationsModel
@{
    ViewData["Title"] = "Thông báo";
}

<div class="notifications-container">
    <div class="page-header">
        <h1>
            <i class="fas fa-bell"></i>
            Thông báo
            <span id="unreadBadge" class="badge">0</span>
        </h1>
        <button class="btn btn-secondary" onclick="markAllAsRead()">
            <i class="fas fa-check-double"></i> Đánh dấu tất cả là đã đọc
        </button>
    </div>

    <div class="notifications-filter">
        <button class="filter-btn active" onclick="filterNotifications('all')">
            Tất cả thông báo
        </button>
        <button class="filter-btn" onclick="filterNotifications('unread')">
            Chỉ chưa đọc
        </button>
    </div>

    <div id="notificationsList" class="notifications-list">
        <div class="loading-spinner">
            <i class="fas fa-spinner fa-spin"></i> Đang tải thông báo...
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    .notifications-container {
        padding: 20px;
        max-width: 900px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-header h1 {
        font-size: 28px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .badge {
        background: #f44336;
        color: white;
        font-size: 14px;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 600;
    }

    .notifications-filter {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .filter-btn {
        padding: 10px 20px;
        border: 2px solid #e0e0e0;
        background: white;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        color: #666;
        cursor: pointer;
        transition: all 0.2s;
    }

    .filter-btn.active {
        border-color: #4CAF50;
        background: #4CAF50;
        color: white;
    }

    .filter-btn:hover:not(.active) {
        border-color: #4CAF50;
        color: #4CAF50;
    }

    .notifications-list {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .notification-item {
        padding: 20px;
        border-bottom: 1px solid #f0f0f0;
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .notification-item:last-child {
        border-bottom: none;
    }

    .notification-item:hover {
        background: #f8f9fa;
    }

    .notification-item.unread {
        background: #e8f5e9;
    }

    .notification-item.unread:hover {
        background: #c8e6c9;
    }

    .notification-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .notification-icon.budget {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .notification-icon.debt {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .notification-icon.transaction {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

    .notification-icon.default {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
    }

    .notification-content {
        flex: 1;
    }

    .notification-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .notification-title {
        font-size: 16px;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .notification-time {
        font-size: 12px;
        color: #999;
        white-space: nowrap;
    }

    .notification-message {
        font-size: 14px;
        color: #666;
        line-height: 1.5;
        margin: 0;
    }

    .notification-type-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 500;
        margin-top: 8px;
        text-transform: uppercase;
    }

    .type-budget {
        background: #e3f2fd;
        color: #1976d2;
    }

    .type-debt {
        background: #fce4ec;
        color: #c2185b;
    }

    .type-transaction {
        background: #e0f2f1;
        color: #00796b;
    }

    .type-default {
        background: #f3e5f5;
        color: #7b1fa2;
    }

    .loading-spinner {
        text-align: center;
        padding: 40px;
        color: #666;
        font-size: 18px;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

    .empty-state i {
        font-size: 64px;
        margin-bottom: 20px;
        opacity: 0.3;
    }

    .empty-state p {
        font-size: 16px;
        margin: 0;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary {
        background: #f1f1f1;
        color: #333;
    }

    .btn-secondary:hover {
        background: #e0e0e0;
    }
</style>

<script>
    let currentFilter = 'all';

    // Load notifications on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadNotifications();
        loadUnreadCount();
        
        // Refresh notifications every 30 seconds
        setInterval(loadUnreadCount, 30000);
    });

    async function loadNotifications(unreadOnly = false) {
        try {
            const url = `/api/Notification${unreadOnly ? '?unreadOnly=true' : ''}`;
            const response = await fetch(url, {
                headers: {
                    'Authorization': 'Bearer ' + getCookie('AccessToken')
                }
            });

            if (!response.ok) throw new Error('Failed to load notifications');

            const notifications = await response.json();
            displayNotifications(notifications);
        } catch (error) {
            console.error('Error loading notifications:', error);
            document.getElementById('notificationsList').innerHTML = '<p class="error-message">Không thể tải thông báo</p>';
        }
    }

    async function loadUnreadCount() {
        try {
            const response = await fetch('/api/Notification/unread-count', {
                headers: {
                    'Authorization': 'Bearer ' + getCookie('AccessToken')
                }
            });

            if (!response.ok) throw new Error('Failed to load unread count');

            const data = await response.json();
            document.getElementById('unreadBadge').textContent = data.count;
            
            if (data.count === 0) {
                document.getElementById('unreadBadge').style.display = 'none';
            } else {
                document.getElementById('unreadBadge').style.display = 'inline-block';
            }
        } catch (error) {
            console.error('Error loading unread count:', error);
        }
    }

    function displayNotifications(notifications) {
        const container = document.getElementById('notificationsList');
        
        if (notifications.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-bell-slash"></i>
                    <p>Chưa có thông báo nào</p>
                </div>
            `;
            return;
        }

        container.innerHTML = notifications.map(notification => {
            const iconClass = getNotificationIconClass(notification.type);
            const typeClass = getNotificationTypeClass(notification.type);
            const timeAgo = getTimeAgo(new Date(notification.createdAt));
            
            return `
                <div class="notification-item ${notification.isRead ? '' : 'unread'}" onclick="markAsRead(${notification.id})">
                    <div class="notification-icon ${iconClass}">
                        ${getNotificationIcon(notification.type)}
                    </div>
                    <div class="notification-content">
                        <div class="notification-header">
                            <h3 class="notification-title">${escapeHtml(notification.title)}</h3>
                            <span class="notification-time">${timeAgo}</span>
                        </div>
                        <p class="notification-message">${escapeHtml(notification.message)}</p>
                        <span class="notification-type-badge ${typeClass}">${notification.type}</span>
                    </div>
                </div>
            `;
        }).join('');
    }

    function getNotificationIconClass(type) {
        const typeMap = {
            'BudgetAlert': 'budget',
            'DebtReminder': 'debt',
            'ScheduledTransaction': 'transaction',
            'Transaction': 'transaction'
        };
        return typeMap[type] || 'default';
    }

    function getNotificationTypeClass(type) {
        const typeMap = {
            'BudgetAlert': 'type-budget',
            'DebtReminder': 'type-debt',
            'ScheduledTransaction': 'type-transaction',
            'Transaction': 'type-transaction'
        };
        return typeMap[type] || 'type-default';
    }

    function getNotificationIcon(type) {
        const iconMap = {
            'BudgetAlert': '<i class="fas fa-exclamation-triangle"></i>',
            'DebtReminder': '<i class="fas fa-hand-holding-usd"></i>',
            'ScheduledTransaction': '<i class="fas fa-clock"></i>',
            'Transaction': '<i class="fas fa-money-bill-wave"></i>'
        };
        return iconMap[type] || '<i class="fas fa-info-circle"></i>';
    }

    async function markAsRead(notificationId) {
        try {
            const response = await fetch(`/api/Notification/${notificationId}/read`, {
                method: 'PUT',
                headers: {
                    'Authorization': 'Bearer ' + getCookie('AccessToken')
                }
            });

            if (!response.ok) throw new Error('Failed to mark notification as read');

            // Reload notifications
            loadNotifications(currentFilter === 'unread');
            loadUnreadCount();
        } catch (error) {
            console.error('Error marking notification as read:', error);
        }
    }

    async function markAllAsRead() {
        try {
            const response = await fetch('/api/Notification/read-all', {
                method: 'PUT',
                headers: {
                    'Authorization': 'Bearer ' + getCookie('AccessToken')
                }
            });

            if (!response.ok) throw new Error('Failed to mark all notifications as read');

            // Reload notifications
            loadNotifications(currentFilter === 'unread');
            loadUnreadCount();
            alert('Đã đánh dấu tất cả thông báo là đã đọc');
        } catch (error) {
            console.error('Error marking all notifications as read:', error);
            alert('Không thể đánh dấu tất cả thông báo là đã đọc');
        }
    }

    function filterNotifications(filter) {
        currentFilter = filter;
        
        // Update filter buttons
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');
        
        // Load notifications based on filter
        loadNotifications(filter === 'unread');
    }

    function getTimeAgo(date) {
        const seconds = Math.floor((new Date() - date) / 1000);
        
        const intervals = {
            year: 31536000,
            month: 2592000,
            week: 604800,
            day: 86400,
            hour: 3600,
            minute: 60
        };
        
        for (const [unit, secondsInUnit] of Object.entries(intervals)) {
            const interval = Math.floor(seconds / secondsInUnit);
            if (interval >= 1) {
                // Vietnamese translation for time units
                const unitVi = {
                    year: 'năm',
                    month: 'tháng',
                    week: 'tuần',
                    day: 'ngày',
                    hour: 'giờ',
                    minute: 'phút'
                }[unit];
                return `${interval} ${unitVi} trước`;
            }
        }
        
        return 'Vừa xong';
    }

    // Utility functions
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return '';
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
