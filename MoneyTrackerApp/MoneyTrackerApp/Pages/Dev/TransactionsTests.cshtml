@page
@{
    Layout = "/Pages/Shared/_Layout.cshtml";

    ViewData["Title"] = "Transaction Utils Tests";
}

<div class="container mt-4">
    <h3>Transaction Utilities - Unit Tests</h3>
    <div id="testResults" class="mt-3"></div>
</div>

@section Scripts {
    <script type="module">
        import { validateTransactionInput, buildTransactionDto } from '/js/transactions-utils.js';

        function assert(condition, message) {
            if (!condition) throw new Error(message);
        }

        function writeResult(name, ok, error) {
            const el = document.getElementById('testResults');
            const item = document.createElement('div');
            item.className = `p-2 mb-2 ${ok ? 'bg-success-subtle' : 'bg-danger-subtle'}`;
            item.textContent = ok ? `✔ ${name}` : `✖ ${name}: ${error}`;
            el.appendChild(item);
        }

        async function apiGet(path) {
            const res = await fetch(path, { credentials: 'include' });
            if (!res.ok) {
                if (res.status === 401 || res.status === 403) throw new Error('AUTH_REQUIRED');
                throw new Error(`GET ${path} failed`);
            }
            return res.json();
        }

        async function apiPost(path, body) {
            const res = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body) });
            if (!res.ok) {
                if (res.status === 401 || res.status === 403) throw new Error('AUTH_REQUIRED');
                throw new Error(`POST ${path} failed`);
            }
            return res.json();
        }

        async function apiDelete(path) {
            const res = await fetch(path, { method: 'DELETE', credentials: 'include' });
            if (!res.ok && res.status !== 204) {
                if (res.status === 401 || res.status === 403) throw new Error('AUTH_REQUIRED');
                throw new Error(`DELETE ${path} failed`);
            }
        }

        function isAuthenticatedUI() {
            return !!document.querySelector('.app-wrapper');
        }

        const tests = [
            {
                name: 'Validation rejects non-positive amount',
                run: () => {
                    const { valid, errors } = validateTransactionInput({ type: 2, amount: 0, accountId: 1, date: '2025-01-01' });
                    assert(!valid, 'should be invalid');
                    assert(errors.some(e => e.includes('Số tiền')), 'missing amount error');
                }
            },
            {
                name: 'Validation rejects overlong note',
                run: () => {
                    const longNote = 'x'.repeat(513);
                    const { valid, errors } = validateTransactionInput({ type: 1, amount: 10, accountId: 1, date: '2025-01-01', note: longNote });
                    assert(!valid, 'should be invalid');
                    assert(errors.some(e => e.includes('512')), 'missing note length error');
                }
            },
            {
                name: 'Validation rejects transfer to same account',
                run: () => {
                    const { valid, errors } = validateTransactionInput({ type: 3, amount: 10, accountId: 1, pairedAccountId: 1, date: '2025-01-01' });
                    assert(!valid, 'should be invalid');
                    assert(errors.some(e => e.includes('cùng một ví')), 'missing same account error');
                }
            },
            {
                name: 'DTO builds correctly',
                run: () => {
                    const dto = buildTransactionDto({ type: 2, amount: 123.45, accountId: '7', categoryId: '9', date: '2025-01-01', note: 'Lunch', currency: 'VND' });
                    assert(dto.AccountId === 7, 'account id');
                    assert(dto.CategoryId === 9, 'category id');
                    assert(dto.TransactionType === 2, 'type');
                    assert(dto.Amount === 123.45, 'amount');
                    assert(dto.Note === 'Lunch', 'note');
                    assert(dto.Currency === 'VND', 'currency');
                }
            },
            {
                name: 'Income increases total assets exactly once',
                run: async () => {
                    if (!isAuthenticatedUI()) {
                        writeResult('Income increases total assets exactly once (bỏ qua: chưa đăng nhập)', true);
                        return;
                    }
                    const dashboardBefore = await apiGet('/api/Report/dashboard');
                    const accounts = await apiGet('/api/Accounts/summaries');
                    if (!accounts || accounts.length === 0) throw new Error('No accounts available');
                    const acc = accounts.find(a => a.includeInTotal) || accounts[0];
                    const amount = 12345;
                    const note = `TEST_INCOME_DOUBLE_CHECK_${Date.now()}`;
                    const dto = { TransactionType: 1, Amount: amount, AccountId: acc.id, CategoryId: null, TransactionDate: new Date().toISOString().substring(0, 10), Note: note, Currency: 'VND' };
                    const created = await apiPost('/api/Transactions', dto);
                    const dashboardAfter = await apiGet('/api/Report/dashboard');
                    const delta = Math.round((dashboardAfter.currentBalance - dashboardBefore.currentBalance) * 100) / 100;
                    assert(delta === amount, `Expected delta ${amount}, got ${delta}`);
                    // cleanup
                    await apiDelete(`/api/Transactions/${created.id}`);
                }
            }
        ];

        (async function run() {
            for (const t of tests) {
                try {
                    const result = t.run();
                    if (result && typeof result.then === 'function') await result;
                    writeResult(t.name, true);
                } catch (e) { writeResult(t.name, false, e.message); }
            }
        })();
    </script>
}
