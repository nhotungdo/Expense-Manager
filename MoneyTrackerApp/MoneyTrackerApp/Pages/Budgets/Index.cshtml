@page
@model MoneyTrackerApp.Pages.Budgets.IndexModel
@{
    ViewData["Title"] = "Quản lý Ngân sách";
    var culture = new System.Globalization.CultureInfo("vi-VN");
    var jsonSerializerOptions = new System.Text.Json.JsonSerializerOptions 
    { 
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
    var categoryDataJson = System.Text.Json.JsonSerializer.Serialize(Model.CategorySpendings, jsonSerializerOptions);
    var dailyDataJson = System.Text.Json.JsonSerializer.Serialize(Model.DailySpendings, jsonSerializerOptions);
}

@Html.AntiForgeryToken()

<div class="container mx-auto px-4 py-8 space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                <i class="fas fa-wallet text-indigo-600 dark:text-indigo-400"></i>
                Quản lý Ngân sách
            </h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1">Kiểm soát chi tiêu và theo dõi giới hạn tài chính của bạn</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-sm text-gray-500 dark:text-gray-400">Tháng này:</span>
            <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full text-sm font-semibold">
                @DateTime.Now.ToString("MM/yyyy")
            </span>
        </div>
    </div>

    <!-- Top Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Budget Health Card -->
        <div class="card-modern md:col-span-1 p-6 relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="fas fa-chart-pie text-9xl text-indigo-500"></i>
            </div>
            
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-6 relative z-10">Sức khỏe Ngân sách</h3>
            
            <div class="flex flex-col items-center justify-center relative z-10">
                <div class="relative w-40 h-40 flex items-center justify-center">
                    <svg class="transform -rotate-90 w-full h-full">
                        <circle cx="80" cy="80" r="70" stroke="currentColor" stroke-width="12" fill="transparent"
                                class="text-gray-200 dark:text-gray-700" />
                        <circle cx="80" cy="80" r="70" stroke="currentColor" stroke-width="12" fill="transparent"
                                stroke-dasharray="440" 
                                style="stroke-dashoffset: calc(440 - (440 * @Math.Min(Model.Percentage, 100) / 100)); transition: stroke-dashoffset 1s ease-in-out;"
                                class="@(Model.Percentage > 100 ? "text-rose-500" : (Model.Percentage > 80 ? "text-amber-500" : "text-emerald-500"))" />
                    </svg>
                    <div class="absolute flex flex-col items-center">
                        <span class="text-3xl font-bold text-gray-900 dark:text-white">@Model.Percentage.ToString("0")%</span>
                        <span class="text-xs text-gray-500 dark:text-gray-400">Đã dùng</span>
                    </div>
                </div>

                <div class="mt-6 w-full space-y-3">
                    <div class="flex justify-between items-end border-b border-gray-100 dark:border-gray-700 pb-2">
                        <span class="text-sm text-gray-500 dark:text-gray-400">Đã chi</span>
                        <span class="text-xl font-bold text-gray-900 dark:text-white">@Model.TotalSpent.ToString("C0", culture)</span>
                    </div>
                     <div class="flex justify-between items-end border-b border-gray-100 dark:border-gray-700 pb-2">
                        <span class="text-sm text-gray-500 dark:text-gray-400">Ngân sách</span>
                        <span class="text-xl font-bold text-indigo-600 dark:text-indigo-400">@((Model.TotalBudget > 0 ? Model.TotalBudget : 0).ToString("C0", culture))</span>
                    </div>
                    <div class="flex justify-between items-end">
                        <span class="text-sm text-gray-500 dark:text-gray-400">Còn lại</span>
                        <span class="text-lg font-bold @(Model.TotalBudget - Model.TotalSpent < 0 ? "text-rose-500" : "text-emerald-500")">
                            @((Model.TotalBudget - Model.TotalSpent).ToString("C0", culture))
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Spending Trend Chart -->
        <div class="card-modern md:col-span-2 p-6 flex flex-col">
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-4 flex justify-between items-center">
                <span>Xu hướng Chi tiêu</span>
                <span class="text-xs font-normal px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded-md text-gray-500">Tích lũy theo ngày</span>
            </h3>
            <div class="flex-grow w-full h-full min-h-[300px] relative">
                <canvas id="trendChart"></canvas>
            </div>
            <div class="mt-4 flex gap-4 text-xs text-gray-500 dark:text-gray-400 justify-center">
                <div class="flex items-center gap-1">
                    <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
                    <span>Thực tế</span>
                </div>
                <div class="flex items-center gap-1">
                    <span class="w-3 h-3 rounded-full bg-rose-400 border border-dashed border-white"></span>
                    <span>Ngân sách TB ngày</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Category Breakdown -->
        <div class="card-modern col-span-1 lg:col-span-2 p-0 overflow-hidden flex flex-col">
            <div class="p-6 border-b border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50 flex justify-between items-center">
                 <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Phân bổ Danh mục</h3>
            </div>
            <div class="p-6 flex flex-col md:flex-row gap-8 items-center h-full">
                <div class="w-full md:w-1/2 flex justify-center">
                    <div class="w-64 h-64 relative">
                        <canvas id="categoryChart"></canvas>
                         <div class="absolute inset-0 flex items-center justify-center flex-col pointer-events-none">
                            <span class="text-sm text-gray-400">Tổng chi</span>
                            <span class="text-xl font-bold text-gray-800 dark:text-white">@Model.TotalSpent.ToString("#,##0")</span>
                        </div>
                    </div>
                </div>
                <div class="w-full md:w-1/2 max-h-80 overflow-y-auto pr-2 custom-scrollbar">
                    <ul class="space-y-3">
                        @foreach(var item in Model.CategorySpendings)
                        {
                            <li class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-white shadow-sm" style="background-color: @item.Color">
                                        <i class="@item.Icon text-sm"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-800 dark:text-gray-200">@item.Name</p>
                                        <div class="w-24 h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full mt-1 overflow-hidden">
                                            <div class="h-full rounded-full" style="width: @((Model.TotalSpent > 0 ? (item.Amount/Model.TotalSpent)*100 : 0).ToString("0"))%; background-color: @item.Color"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-gray-800 dark:text-gray-200">@item.Amount.ToString("C0", culture)</p>
                                    <p class="text-xs text-gray-500">@((Model.TotalSpent > 0 ? (item.Amount/Model.TotalSpent)*100 : 0).ToString("0.0"))%</p>
                                </div>
                            </li>
                        }
                        @if(!Model.CategorySpendings.Any())
                        {
                            <li class="text-center text-gray-500 py-4">Chưa có dữ liệu chi tiêu tháng này</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Settings & AI -->
        <div class="col-span-1 flex flex-col gap-6">
            
            <!-- Settings Card -->
            <div class="card-modern p-6">
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-4 flex items-center gap-2">
                    <i class="fas fa-sliders-h text-indigo-500"></i> Cài đặt Hạn mức
                </h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Ngân sách tháng</label>
                        <div class="relative">
                            <input type="number" id="budgetInput" value="@Model.TotalBudget.ToString("0")" 
                                   class="w-full pl-4 pr-12 py-3 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-lg font-bold text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 transition-all shadow-inner" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 font-bold">VND</span>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <button onclick="setQuickBudget(5000000)" class="flex-1 py-2 text-xs font-bold text-indigo-600 bg-indigo-50 dark:bg-indigo-900/20 dark:text-indigo-300 rounded-lg hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition-colors">5 Tr</button>
                        <button onclick="setQuickBudget(10000000)" class="flex-1 py-2 text-xs font-bold text-indigo-600 bg-indigo-50 dark:bg-indigo-900/20 dark:text-indigo-300 rounded-lg hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition-colors">10 Tr</button>
                        <button onclick="setQuickBudget(20000000)" class="flex-1 py-2 text-xs font-bold text-indigo-600 bg-indigo-50 dark:bg-indigo-900/20 dark:text-indigo-300 rounded-lg hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition-colors">20 Tr</button>
                    </div>

                    <button id="btnUpdateBudget" onclick="updateBudget()"
                            class="w-full py-3 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:scale-[1.02] active:scale-95 transition-all">
                        Lưu Cấu hình
                    </button>
                </div>
            </div>

            <!-- AI Insight Card -->
            <div class="card-modern p-6 bg-gradient-to-br from-indigo-900 to-purple-900 text-white relative overflow-hidden border-none">
                <div class="absolute top-0 right-0 p-4 opacity-20">
                    <i class="fas fa-robot text-6xl"></i>
                </div>
                
                <h3 class="text-sm font-bold text-indigo-200 uppercase tracking-wider mb-2 flex items-center gap-2">
                    <i class="fas fa-magic"></i> AI Advisor
                </h3>
                
                <div class="relative z-10">
                    @if (Model.Percentage > 90)
                    {
                         <p class="text-base font-medium leading-relaxed mb-3">
                            Bạn đã tiêu gần hết ngân sách! Hãy cân nhắc cắt giảm các khoản chi không thiết yếu như 
                            <span class="font-bold text-amber-300 border-b border-amber-300/50">Ăn uống</span> hoặc 
                            <span class="font-bold text-amber-300 border-b border-amber-300/50">Giải trí</span>.
                        </p>
                    }
                    else if (Model.ProjectedSpent > Model.TotalBudget)
                    {
                        <p class="text-base font-medium leading-relaxed mb-3">
                            Xu hướng hiện tại cho thấy bạn sẽ vượt ngân sách khoảng 
                            <span class="font-bold text-rose-300">@((Model.ProjectedSpent - Model.TotalBudget).ToString("C0", culture))</span>.
                            Hãy chậm lại nhé!
                        </p>
                    }
                    else
                    {
                        <p class="text-base font-medium leading-relaxed mb-3">
                            Chi tiêu của bạn đang trong tầm kiểm soát. Bạn đang tiết kiệm được khoảng
                            <span class="font-bold text-emerald-300">@((Model.TotalBudget - Model.ProjectedSpent).ToString("C0", culture))</span>
                            vào cuối tháng này.
                        </p>
                    }
                    <button class="text-xs font-bold bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg transition-colors border border-white/20">
                        Xem chi tiết phân tích
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Hidden Data for JS -->
<div id="budgetData" style="display:none;"
     data-total-budget="@Model.TotalBudget"
     data-category-json='@Html.Raw(categoryDataJson)'
     data-daily-json='@Html.Raw(dailyDataJson)'>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.min.js"></script> 
    <script src="~/js/budgets.js" asp-append-version="true"></script>
}
