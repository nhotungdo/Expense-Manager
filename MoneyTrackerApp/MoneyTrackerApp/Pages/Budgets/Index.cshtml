@page
@model MoneyTrackerApp.Pages.Budgets.IndexModel
@{
    ViewData["Title"] = "Quản lý Ngân sách";
    var culture = new System.Globalization.CultureInfo("vi-VN");
}

@Html.AntiForgeryToken()

<div class="bento-grid" id="budgetData" 
     data-spent="@Model.TotalSpent" 
     data-limit="@Model.TotalBudget" 
     data-api="@Model.ApiSpent"
     data-pro="@Model.ProSpent"
     data-storage="@Model.StorageSpent"
     data-other="@Model.OtherSpent">
    
    <!-- Page Header -->
    <div class="bento-col-span-12 mb-2">
         <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <i class="fas fa-wallet text-indigo-600 dark:text-indigo-400"></i> Quản lý & Kiểm soát Ngân sách
        </h1>
        <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">Kiểm soát chi tiêu chi tiết và cấu hình giới hạn để tránh vượt ngân sách.</p>
    </div>

    <!-- 1. Health Monitor Section -->
    <div class="bento-col-span-12">
        <div class="bento-card p-6">
            <h5 class="text-gray-500 dark:text-gray-400 font-bold text-xs uppercase tracking-wider mb-4">Sức khỏe Ngân sách</h5>
            
            <div class="flex justify-between items-baseline mb-3">
                <div class="flex items-baseline gap-2">
                    <span class="text-4xl font-bold text-gray-900 dark:text-white font-mono tracking-tight" id="txtSpentAmount">@Model.TotalSpent.ToString("C0", culture)</span>
                    <span class="text-gray-400 font-medium">/ <span id="txtLimitAmount">@((Model.TotalBudget > 0 ? Model.TotalBudget : 0).ToString("C0", culture))</span></span>
                </div>
                <div class="font-bold text-lg" id="lblPercentageStatus">
                    <!-- Populated by JS -->
                </div>
            </div>

            <div class="relative w-full h-8 bg-gray-100 dark:bg-gray-800 rounded-xl overflow-hidden mt-2">
                <!-- Main Usage Bar -->
                <div class="h-full bg-amber-500 rounded-xl transition-all duration-1000 ease-out flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-amber-500/30" 
                     role="progressbar" 
                     style="width: 0%;" 
                     id="mainProgressBar">
                </div>
                <!-- Forecast Marker (Ghost bar) -->
                <div class="absolute top-0 bottom-0 border-r-2 border-rose-500 border-dashed z-10 opacity-70" 
                     style="left: @((Model.TotalBudget > 0 ? Math.Min((Model.ProjectedSpent/Model.TotalBudget)*100, 100) : 0).ToString("0"))%; pointer-events: none;"
                     title="Dự báo cuối tháng">
                     <span class="absolute -top-1 left-full ml-1 px-2 py-0.5 bg-rose-500 text-white text-[10px] font-bold rounded-md whitespace-nowrap shadow-sm transform -translate-y-1/2">
                         Dự báo
                     </span>
                </div>
            </div>
            
            <div class="mt-3 text-sm text-gray-500 dark:text-gray-400 flex items-center gap-1.5 bg-gray-50 dark:bg-gray-800/50 w-fit px-3 py-1.5 rounded-lg border border-gray-100 dark:border-gray-700">
                <i class="fas fa-info-circle"></i>
                <span>Dự kiến cuối tháng sẽ dùng hết <strong class="text-gray-900 dark:text-white">@Model.ProjectedSpent.ToString("C0", culture)</strong></span>
            </div>
        </div>
    </div>

    <!-- LEFT COLUMN: Configuration -->
    <div class="bento-col-span-12 lg:bento-col-span-5 flex flex-col gap-6">
        
        <!-- 2. Budget Configuration -->
        <div class="bento-card p-0 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
                <h6 class="font-bold text-indigo-600 dark:text-indigo-400 flex items-center gap-2">
                    <i class="fas fa-sliders-h"></i> Cài đặt Hạn mức
                </h6>
            </div>
            <div class="p-6">
                <div class="mb-5">
                    <label for="budgetInput" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Ngân sách hàng tháng</label>
                    <div class="flex relative rounded-xl shadow-sm">
                        <span class="inline-flex items-center px-4 rounded-l-xl border border-r-0 border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-500 dark:text-gray-400 text-lg font-bold">₫</span>
                        <input type="number" class="flex-1 min-w-0 block w-full px-4 py-3 rounded-none rounded-r-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white font-bold text-lg focus:ring-indigo-500 focus:border-indigo-500" id="budgetInput" value="@Model.TotalBudget.ToString("0")">
                    </div>
                    <div class="mt-3 flex gap-2 flex-wrap">
                        <button class="px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" onclick="setQuickBudget(1000000)">1 Triệu</button>
                        <button class="px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" onclick="setQuickBudget(2000000)">2 Triệu</button>
                        <button class="px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" onclick="setQuickBudget(5000000)">5 Triệu</button>
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Loại giới hạn</label>
                    <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4 bg-white dark:bg-gray-800">
                        <div class="flex items-start gap-3 mb-4">
                            <input class="mt-1 w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 bg-gray-100 dark:bg-gray-700 dark:border-gray-600" type="radio" name="thresholdAction" id="softCap" checked>
                            <label class="block" for="softCap">
                                <span class="block font-bold text-gray-900 dark:text-white text-sm">Giới hạn Mềm (Soft Cap)</span>
                                <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">Chỉ gửi cảnh báo, dịch vụ vẫn hoạt động bình thường.</span>
                            </label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input class="mt-1 w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 bg-gray-100 dark:bg-gray-700 dark:border-gray-600" type="radio" name="thresholdAction" id="hardCap">
                            <label class="block" for="hardCap">
                                <span class="block font-bold text-gray-900 dark:text-white text-sm">Giới hạn Cứng (Hard Cap)</span>
                                <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">Tự động ngắt dịch vụ/API khi chạm ngưỡng.</span>
                            </label>
                        </div>
                    </div>
                </div>

                <button class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/20 transition-all active:scale-95 flex items-center justify-center gap-2" id="btnUpdateBudget" onclick="updateBudget()">
                    <i class="fas fa-save"></i> Cập nhật Ngân sách
                </button>
            </div>
        </div>

        <!-- 3. Alert Rules -->
        <div class="bento-card p-0 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 bg-amber-50/50 dark:bg-amber-900/10">
                <h6 class="font-bold text-amber-600 dark:text-amber-500 flex items-center gap-2">
                    <i class="fas fa-bell"></i> Cấu hình Cảnh báo
                </h6>
            </div>
            <div class="p-6">
                <div class="mb-5">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Mốc kích hoạt</label>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3">
                            <input class="w-5 h-5 text-amber-500 rounded border-gray-300 focus:ring-amber-500 bg-gray-100 dark:bg-gray-700 dark:border-gray-600" type="checkbox" id="alert50" checked>
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="alert50">Gửi cảnh báo khi đạt <strong>50%</strong></label>
                        </div>
                        <div class="flex items-center gap-3">
                            <input class="w-5 h-5 text-amber-500 rounded border-gray-300 focus:ring-amber-500 bg-gray-100 dark:bg-gray-700 dark:border-gray-600" type="checkbox" id="alert80" checked>
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="alert80">Gửi cảnh báo khi đạt <strong>80%</strong></label>
                        </div>
                        <div class="flex items-center gap-3">
                            <input class="w-5 h-5 text-amber-500 rounded border-gray-300 focus:ring-amber-500 bg-gray-100 dark:bg-gray-700 dark:border-gray-600" type="checkbox" id="alert100" checked>
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="alert100">Gửi cảnh báo khi đạt <strong>100%</strong></label>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Kênh thông báo</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="flex items-center gap-2 p-3 border border-gray-200 dark:border-gray-700 rounded-xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                            <input class="radio text-amber-500 focus:ring-amber-500" type="checkbox" id="channelEmail" checked>
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Email</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 border border-gray-200 dark:border-gray-700 rounded-xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                            <input class="radio text-amber-500 focus:ring-amber-500" type="checkbox" id="channelApp" checked>
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">In-App</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-100 dark:bg-gray-800 opacity-70 cursor-not-allowed">
                            <input class="radio text-amber-500 focus:ring-amber-500" type="checkbox" id="channelSMS" disabled>
                            <span class="text-sm font-medium text-gray-500">SMS (Pro)</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 border border-gray-200 dark:border-gray-700 rounded-xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                            <input class="radio text-amber-500 focus:ring-amber-500" type="checkbox" id="channelWebhook">
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Webhook</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: Analytics -->
    <div class="bento-col-span-12 lg:bento-col-span-7 flex flex-col gap-6">
        
        <!-- 4. Cost Breakdown -->
        <div class="bento-card p-0 overflow-hidden h-full">
            <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 bg-white dark:bg-gray-800 flex justify-between items-center">
                <h6 class="font-bold text-sky-600 dark:text-sky-400 flex items-center gap-2">
                    <i class="fas fa-chart-pie"></i> Phân bổ chi tiêu
                </h6>
                <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs rounded-lg border border-gray-200 dark:border-gray-600">Tháng này</span>
            </div>
            <div class="p-6">
                <div class="flex flex-col md:flex-row items-center gap-8">
                    <div class="relative w-full md:w-1/2 h-64">
                         <canvas id="costBreakdownChart"></canvas>
                    </div>
                    <div class="w-full md:w-1/2 md:border-l border-gray-100 dark:border-gray-700 md:pl-8">
                        <h6 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Top tiêu hao</h6>
                        <ul class="space-y-3">
                            <li class="flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="w-3 h-3 rounded-full bg-blue-500"></span>
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">OpenAI API</span>
                                </div>
                                <span class="font-bold text-gray-900 dark:text-white font-mono">1.200.000đ</span>
                            </li>
                            <li class="flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Hosting Gói Pro</span>
                                </div>
                                <span class="font-bold text-gray-900 dark:text-white font-mono">300.000đ</span>
                            </li>
                            <li class="flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">AWS Storage</span>
                                </div>
                                <span class="font-bold text-gray-900 dark:text-white font-mono">50.000đ</span>
                            </li>
                             <li class="flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="w-3 h-3 rounded-full bg-slate-500"></span>
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">GitHub Copilot</span>
                                </div>
                                <span class="font-bold text-gray-900 dark:text-white font-mono">230.000đ</span>
                            </li>
                             <li class="flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="w-3 h-3 rounded-full bg-violet-500"></span>
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Vercel Team</span>
                                </div>
                                <span class="font-bold text-gray-900 dark:text-white font-mono">460.000đ</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. AI Advisor -->
        <div class="bento-card p-6 bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 border border-indigo-100 dark:border-indigo-800">
            <div class="flex items-start gap-4">
               <div class="shrink-0">
                   <div class="w-12 h-12 bg-white dark:bg-white/10 rounded-full flex items-center justify-center shadow-sm">
                       <i class="fas fa-lightbulb text-amber-400 text-xl"></i>
                   </div>
               </div>
               <div class="flex-grow">
                   <h6 class="font-bold text-indigo-900 dark:text-indigo-100 mb-1">Phát hiện chi tiêu bất thường</h6>
                   <p class="text-sm text-indigo-700 dark:text-indigo-300 mb-3 leading-relaxed">
                       Hệ thống phát hiện chi phí <strong>OpenAI API</strong> tăng 20% so với trung bình tháng trước, chủ yếu vào các ngày thứ Ba.
                   </p>
                   <div class="bg-indigo-100/50 dark:bg-indigo-900/30 rounded-xl p-3 flex items-start gap-3">
                       <i class="fas fa-magic text-indigo-500 mt-0.5"></i>
                       <small class="font-semibold text-indigo-700 dark:text-indigo-300">Gợi ý: Nâng cấp lên gói Annual Plan có thể tiết kiệm 15% chi phí.</small>
                   </div>
               </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.min.js"></script> 
    <!-- Ensure ChartJS is loaded -->
    <!-- Removed budgets.css link as we use Tailwind now -->
    
    <!-- We must ensure specific JS for budget/alerts works. -->
    <!-- Assuming budgets.js handles logic based on IDs -->
    <script src="~/js/budgets.js" asp-append-version="true"></script>
}
