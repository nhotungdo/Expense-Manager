@page
@model MoneyTrackerApp.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Transactions";
}

<!-- Modern Transactions Page -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">Transactions</h1>
            <p class="text-slate-500 mt-1">Track and manage all your financial activities</p>
        </div>
        <button onclick="openAddTransaction()" class="flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-xl font-semibold hover:shadow-lg hover:scale-105 transition-all">
            <i class="fas fa-plus"></i>
            <span>New Transaction</span>
        </button>
    </div>

    <!-- Filter Bar (White Card) -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Date Range -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Date Range</label>
                <select class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option>Last 7 Days</option>
                    <option selected>Last 30 Days</option>
                    <option>This Month</option>
                    <option>Last Month</option>
                    <option>Custom Range</option>
                </select>
            </div>

            <!-- Wallet Filter -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Wallet</label>
                <select class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option>All Wallets</option>
                    <option>Main Wallet</option>
                    <option>Savings</option>
                </select>
            </div>

            <!-- Category Filter -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Category</label>
                <select class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option>All Categories</option>
                    <option>Food & Dining</option>
                    <option>Transportation</option>
                    <option>Shopping</option>
                </select>
            </div>

            <!-- Type Filter -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Type</label>
                <select class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option>All Types</option>
                    <option>Income</option>
                    <option>Expense</option>
                    <option>Transfer</option>
                </select>
            </div>
        </div>

        <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-200">
            <button class="text-sm text-slate-600 hover:text-slate-900 font-medium">
                <i class="fas fa-redo mr-2"></i>Reset Filters
            </button>
            <button class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700">
                <i class="fas fa-check mr-2"></i>Apply Filter
            </button>
        </div>
    </div>

    <!-- Transaction Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 font-medium">Total Income</p>
                    <h3 class="text-2xl font-bold text-emerald-600 mt-1" id="totalIncome">$0.00</h3>
                    <p class="text-xs text-slate-400 mt-1">12 transactions</p>
                </div>
                <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center">
                    <i class="fas fa-arrow-down text-emerald-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 font-medium">Total Expense</p>
                    <h3 class="text-2xl font-bold text-red-600 mt-1" id="totalExpense">$0.00</h3>
                    <p class="text-xs text-slate-400 mt-1">28 transactions</p>
                </div>
                <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center">
                    <i class="fas fa-arrow-up text-red-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 font-medium">Net Balance</p>
                    <h3 class="text-2xl font-bold text-slate-900 mt-1" id="netBalance">$0.00</h3>
                    <p class="text-xs text-emerald-600 mt-1">
                        <i class="fas fa-arrow-up"></i> +15.2% vs last period
                    </p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                    <i class="fas fa-equals text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction List (Grouped by Date) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-200">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-slate-900">Transaction History</h3>
                <button class="text-sm text-blue-600 hover:text-blue-700 font-semibold">
                    <i class="fas fa-download mr-2"></i>Export
                </button>
            </div>
        </div>

        <div id="transactionsList" class="divide-y divide-slate-200">
            <!-- Group: Today -->
            <div class="p-6">
                <h4 class="text-sm font-bold text-slate-900 mb-4">Today, Dec 09</h4>
                <div class="space-y-3">
                    <!-- Transaction Item -->
                    <div class="flex items-center justify-between p-4 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer group">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-utensils text-red-600"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-slate-900">Lunch at Restaurant</p>
                                <p class="text-sm text-slate-500">Food & Dining • Main Wallet</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-red-600">-$45.00</p>
                            <p class="text-xs text-slate-400">2:30 PM</p>
                        </div>
                    </div>

                    <div class="flex items-center justify-between p-4 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer group">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-briefcase text-emerald-600"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-slate-900">Freelance Project Payment</p>
                                <p class="text-sm text-slate-500">Income • Main Wallet</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-emerald-600">+$500.00</p>
                            <p class="text-xs text-slate-400">10:15 AM</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Group: Yesterday -->
            <div class="p-6">
                <h4 class="text-sm font-bold text-slate-900 mb-4">Yesterday, Dec 08</h4>
                <div class="space-y-3">
                    <div class="flex items-center justify-between p-4 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer group">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-shopping-bag text-blue-600"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-slate-900">Online Shopping</p>
                                <p class="text-sm text-slate-500">Shopping • Credit Card</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-red-600">-$120.50</p>
                            <p class="text-xs text-slate-400">6:45 PM</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="p-6 border-t border-slate-200 flex items-center justify-between">
            <button class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 disabled:opacity-50">
                <i class="fas fa-chevron-left mr-2"></i>Previous
            </button>
            <span class="text-sm text-slate-600">Page 1 of 5</span>
            <button class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900">
                Next<i class="fas fa-chevron-right ml-2"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/transactions.js"></script>
}
