@page
@model MoneyTrackerApp.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Giao dịch";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold"><i class="fas fa-list-ul me-2 text-primary"></i>Lịch sử Giao dịch</h1>
            <p class="text-muted small mb-0">Xem và quản lý tất cả các hoạt động tài chính của bạn</p>
        </div>
        <div>
            <a href="/Transactions/Create" class="btn btn-primary rounded-pill shadow-sm">
                <i class="fas fa-plus me-1"></i> Thêm mới
            </a>
        </div>
    </div>

    <!-- Balance Summary Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-circle bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="fas fa-wallet fa-2x"></i>
                        </div>
                        <div>
                            <span class="text-uppercase text-xs fw-bold text-muted spacing-1">Tổng Số Dư Hiện Tại</span>
                            <h2 class="mb-0 fw-bold text-dark display-6">
                                @CurrencyHelper.FormatCurrency(Model.TotalBalance) <small class="fs-6 text-muted">@Model.Currency</small>
                            </h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions List -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
             <h5 class="mb-0 fw-bold">Danh sách gần đây</h5>
             <!-- Could add filters here later -->
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase text-xs fw-bold text-muted border-0 rounded-start">Ngày</th>
                            <th class="py-3 text-uppercase text-xs fw-bold text-muted border-0">Danh mục</th>
                            <th class="py-3 text-uppercase text-xs fw-bold text-muted border-0">Ghi chú</th>
                            <th class="py-3 text-uppercase text-xs fw-bold text-muted border-0">Ví</th>
                            <th class="pe-4 py-3 text-end text-uppercase text-xs fw-bold text-muted border-0 rounded-end">Số tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions != null && Model.Transactions.Any())
                        {
                            @foreach (var t in Model.Transactions)
                            {
                                var isExpense = t.TransactionType == 2;
                                var colorClass = isExpense ? "text-danger" : (t.TransactionType == 1 ? "text-success" : "text-primary");
                                var sign = isExpense ? "-" : (t.TransactionType == 1 ? "+" : "");
                                
                                <tr onclick="window.location.href='/Transactions/Create?id=@t.Id'" style="cursor: pointer;">
                                    <td class="ps-4 border-bottom-0">
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark">@t.TransactionDate.ToString("dd/MM/yyyy")</span>
                                            <small class="text-muted">@t.TransactionDate.ToString("HH:mm")</small>
                                        </div>
                                    </td>
                                    <td class="border-bottom-0">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-circle p-2" style="background-color: @(t.CategoryColor ?? "#e0e7ff"); color: @(t.CategoryColor ?? "#4338ca")">
                                                <i class="@(t.CategoryIcon ?? "fas fa-receipt")"></i>
                                            </span>
                                            <span class="fw-medium">@(t.CategoryName ?? "Không có")</span>
                                        </div>
                                    </td>
                                    <td class="border-bottom-0">
                                        <div class="text-truncate" style="max-width: 250px;" title="@t.Note">
                                            @(string.IsNullOrEmpty(t.Note) ? "-" : t.Note)
                                        </div>
                                    </td>
                                    <td class="border-bottom-0">
                                        <span class="badge bg-light text-dark fw-normal border">
                                            <i class="fas fa-wallet me-1 text-muted"></i> @(t.AccountName ?? "Ví")
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end border-bottom-0">
                                        <span class="fw-bold @colorClass fs-6">
                                            @sign@CurrencyHelper.FormatCurrency(t.Amount)
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <div class="d-flex flex-column align-items-center">
                                        <i class="fas fa-inbox fa-3x mb-3 opacity-25"></i>
                                        <p>Chưa có giao dịch nào.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-center">
             <!-- Pagination can go here -->
        </div>
    </div>
</div>
