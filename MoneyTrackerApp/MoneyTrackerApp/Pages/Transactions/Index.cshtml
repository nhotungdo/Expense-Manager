@page
@model MoneyTrackerApp.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Giao dịch";
}

<!-- Transactions Page - Redesigned -->
<div class="transactions-page">
    <div class="bento-grid">
        <!-- Header Section -->
        <div class="page-header bento-col-span-12">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-receipt"></i> Giao dịch
                </h1>
                <p class="page-subtitle">Theo dõi và quản lý tất cả các giao dịch tài chính của bạn</p>
            </div>
            <div class="header-actions">
                <button class="btn-export" id="exportBtn">
                    <i class="fas fa-download"></i> Xuất báo cáo
                </button>
                <a href="/Transactions/Create" class="btn-primary">
                    <i class="fas fa-plus"></i> Giao dịch mới
                </a>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="summary-card income bento-col-span-4">
            <div class="card-icon">
                <i class="fas fa-arrow-down"></i>
            </div>
            <div class="card-content">
                <span class="card-label">Tổng thu nhập</span>
                <h3 class="card-value" id="totalIncome">
                    +@Model.ViewModel.TotalIncome.ToString("N0") <span class="currency">VND</span>
                </h3>
                <span class="card-change positive">
                    <i class="fas fa-arrow-up"></i> 8.2% so với kỳ trước
                </span>
            </div>
        </div>

        <div class="summary-card expense bento-col-span-4">
            <div class="card-icon">
                <i class="fas fa-arrow-up"></i>
            </div>
            <div class="card-content">
                <span class="card-label">Tổng chi tiêu</span>
                <h3 class="card-value" id="totalExpense">
                    -@Model.ViewModel.TotalExpense.ToString("N0") <span class="currency">VND</span>
                </h3>
                <span class="card-change negative">
                    <i class="fas fa-arrow-down"></i> 3.5% so với kỳ trước
                </span>
            </div>
        </div>

        <div class="summary-card balance bento-col-span-4">
            <div class="card-icon">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="card-content">
                <span class="card-label">Số dư ròng</span>
                <h3 class="card-value @(Model.ViewModel.NetIncome >= 0 ? "positive" : "negative")" id="netBalance">
                    @Model.ViewModel.NetIncome.ToString("N0") <span class="currency">VND</span>
                </h3>
                <span class="card-change">
                    Tỷ lệ tiết kiệm: <strong id="savingsRate">0%</strong>
                </span>
            </div>
        </div>

        <!-- Analysis Section & Filters -->
        <!-- Transaction Type Distribution -->
        <div class="analysis-card bento-col-span-4">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-chart-pie"></i> Phân bổ giao dịch
                </h5>
                <div class="card-actions">
                    <select class="period-select" id="distributionPeriod">
                        <option value="month">Tháng này</option>
                        <option value="week">Tuần này</option>
                        <option value="year">Năm nay</option>
                    </select>
                </div>
            </div>
            <div class="chart-wrapper">
                <canvas id="transactionDistributionChart"></canvas>
            </div>
            <div class="chart-stats">
                <div class="stat-item">
                    <span class="stat-dot income"></span>
                    <span class="stat-label">Thu nhập</span>
                    <span class="stat-value" id="incomePercentage">0%</span>
                </div>
                <div class="stat-item">
                    <span class="stat-dot expense"></span>
                    <span class="stat-label">Chi tiêu</span>
                    <span class="stat-value" id="expensePercentage">0%</span>
                </div>
                <div class="stat-item">
                    <span class="stat-dot investment"></span>
                    <span class="stat-label">Đầu tư</span>
                    <span class="stat-value" id="investmentPercentage">0%</span>
                </div>
            </div>
        </div>

        <!-- Expense by Category -->
        <div class="analysis-card bento-col-span-4">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="fas fa-layer-group"></i> Chi tiêu theo danh mục
                </h5>
                <div class="card-actions">
                    <select class="period-select" id="categoryPeriod">
                        <option value="month">Tháng này</option>
                        <option value="week">Tuần này</option>
                        <option value="year">Năm nay</option>
                    </select>
                </div>
            </div>
            <div class="chart-wrapper">
                <canvas id="categoryExpenseChart"></canvas>
            </div>
            <div class="category-breakdown" id="categoryBreakdown">
                <!-- Dynamic category items -->
            </div>
        </div>

        <!-- Filters Section -->
        <div class="filters-section bento-col-span-4">
            <div class="filters-header">
                <h5 class="filters-title">
                    <i class="fas fa-filter"></i> Lọc giao dịch
                </h5>
                <button class="btn-reset" id="resetFilters">
                    <i class="fas fa-redo"></i> Đặt lại
                </button>
            </div>

            <form method="get" class="filters-form" id="filtersForm">
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="far fa-calendar"></i> Khoảng thời gian
                    </label>
                    <div class="date-range-inputs">
                        <input type="date" asp-for="Filter.StartDate" class="filter-input" id="startDate" />
                        <span class="date-separator">đến</span>
                        <input type="date" asp-for="Filter.EndDate" class="filter-input" id="endDate" />
                    </div>
                </div>

                <div class="filter-group">
                    <label class="filter-label">
                        <i class="fas fa-tag"></i> Loại giao dịch
                    </label>
                    <select asp-for="Filter.TransactionType" class="filter-select" id="transactionType">
                        <option value="">Tất cả loại</option>
                        <option value="1">Thu nhập</option>
                        <option value="2">Chi tiêu</option>
                        <option value="3">Chuyển khoản</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">
                        <i class="fas fa-wallet"></i> Tài khoản
                    </label>
                    <select asp-for="Filter.AccountId" asp-items="Model.AccountList" class="filter-select" id="accountFilter">
                        <option value="">Tất cả tài khoản</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">
                        <i class="fas fa-folder"></i> Danh mục
                    </label>
                    <select asp-for="Filter.CategoryId" asp-items="Model.CategoryList" class="filter-select" id="categoryFilter">
                        <option value="">Tất cả danh mục</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">
                        <i class="fas fa-dollar-sign"></i> Khoảng số tiền
                    </label>
                    <div class="amount-range-inputs">
                        <input type="number" class="filter-input" placeholder="Tối thiểu" id="minAmount" />
                        <span class="amount-separator">-</span>
                        <input type="number" class="filter-input" placeholder="Tối đa" id="maxAmount" />
                    </div>
                </div>

                <div class="filter-group">
                    <label class="filter-label">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </label>
                    <input asp-for="Filter.SearchText" type="text" class="filter-input" placeholder="Tìm theo ghi chú..." id="searchText" />
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-apply-filter">
                        <i class="fas fa-check"></i> Áp dụng bộ lọc
                    </button>
                </div>
            </form>
        </div>

        <!-- Transactions List -->
        <div class="transactions-list-section bento-col-span-12">
            <div class="list-header">
                <h5 class="list-title">Lịch sử giao dịch</h5>
                <div class="list-controls">
                    <div class="view-toggle">
                        <button class="toggle-btn active" data-view="list">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="toggle-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                    <select class="sort-select" id="sortBy">
                        <option value="date-desc">Mới nhất</option>
                        <option value="date-asc">Cũ nhất</option>
                        <option value="amount-desc">Số tiền cao nhất</option>
                        <option value="amount-asc">Số tiền thấp nhất</option>
                    </select>
                </div>
            </div>

            @if (!Model.ViewModel.Transactions.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-receipt"></i>
                    </div>
                    <h3 class="empty-title">Không tìm thấy giao dịch</h3>
                    <p class="empty-description">Không có giao dịch nào phù hợp với bộ lọc hiện tại. Hãy thử điều chỉnh tiêu chí tìm kiếm.</p>
                    <a href="/Transactions/Create" class="btn-primary">
                        <i class="fas fa-plus"></i> Tạo giao dịch đầu tiên
                    </a>
                </div>
            }
            else
            {
                <div class="transactions-container" id="transactionsContainer">
                    @foreach (var dateGroup in Model.ViewModel.Transactions.GroupBy(t => t.TransactionDate.Date).OrderByDescending(g => g.Key))
                    {
                        <div class="transaction-date-group">
                            <div class="date-header">
                                <span class="date-label">
                                    @dateGroup.Key.ToString("dddd, MMMM dd, yyyy")
                                    @if (dateGroup.Key == DateTime.Today)
                                    {
                                        <span class="today-badge">Hôm nay</span>
                                    }
                                </span>
                                <span class="date-total">
                                    @dateGroup.Sum(t => t.TransactionType == 1 ? t.Amount : (t.TransactionType == 2 ? -t.Amount : 0)).ToString("+#,##0;-#,##0;0") VND
                                </span>
                            </div>

                            <div class="transactions-list">
                                @foreach (var transaction in dateGroup)
                                {
                                    <div class="transaction-item @(transaction.TransactionType == 1 ? "income" : transaction.TransactionType == 2 ? "expense" : "transfer")" 
                                         data-transaction-id="@transaction.Id">
                                        <div class="transaction-icon" style="background-color: @(transaction.CategoryColor ?? "#6366f1")20;">
                                            <i class="@(transaction.CategoryIcon ?? "fas fa-wallet")" style="color: @(transaction.CategoryColor ?? "#6366f1");"></i>
                                        </div>
                                        <div class="transaction-details">
                                            <h6 class="transaction-title">@(transaction.CategoryName ?? "Chưa phân loại")</h6>
                                            <p class="transaction-note">@(transaction.Note ?? transaction.Description)</p>
                                            <div class="transaction-meta">
                                                <span class="meta-item">
                                                    <i class="far fa-clock"></i> @transaction.TransactionDate.ToString("HH:mm")
                                                </span>
                                                <span class="meta-item">
                                                    <i class="fas fa-wallet"></i> @transaction.AccountName
                                                </span>
                                            </div>
                                        </div>
                                        <div class="transaction-amount @(transaction.TransactionType == 1 ? "positive" : transaction.TransactionType == 2 ? "negative" : "neutral")">
                                            <span class="amount-value">
                                                @(transaction.TransactionType == 1 ? "+" : transaction.TransactionType == 2 ? "-" : "")@transaction.Amount.ToString("N0")
                                            </span>
                                            <span class="amount-currency">VND</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <div class="pagination-section">
                    <div class="pagination-info">
                        Hiển thị <strong>@Model.ViewModel.Transactions.Count</strong> giao dịch
                    </div>
                    <div class="pagination-controls">
                        <button class="page-btn" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button class="page-btn active">1</button>
                        <button class="page-btn">2</button>
                        <button class="page-btn">3</button>
                        <button class="page-btn">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Export Modal -->
<div class="modal fade" id="exportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xuất báo cáo giao dịch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="export-options">
                    <div class="option-group">
                        <label class="option-label">Kỳ báo cáo</label>
                        <select class="form-select" id="exportPeriod">
                            <option value="current">Bộ lọc hiện tại</option>
                            <option value="month">Tháng này</option>
                            <option value="quarter">Quý này</option>
                            <option value="year">Năm nay</option>
                            <option value="custom">Tùy chỉnh</option>
                        </select>
                    </div>
                    <div class="option-group">
                        <label class="option-label">Định dạng file</label>
                        <div class="format-buttons">
                            <button class="format-btn active" data-format="pdf">
                                <i class="far fa-file-pdf"></i> PDF
                            </button>
                            <button class="format-btn" data-format="excel">
                                <i class="far fa-file-excel"></i> Excel
                            </button>
                            <button class="format-btn" data-format="csv">
                                <i class="fas fa-file-csv"></i> CSV
                            </button>
                        </div>
                    </div>
                    <div class="option-group">
                        <label class="checkbox-label">
                            <input type="checkbox" checked> Bao gồm biểu đồ và phân tích
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" checked> Bao gồm phân tích danh mục
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-primary" id="confirmExport">
                    <i class="fas fa-download"></i> Xuất báo cáo
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/transactions-page.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/transactions.js" asp-append-version="true"></script>
}
