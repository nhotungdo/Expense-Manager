@page
@model MoneyTrackerApp.Pages.Transactions.CreateModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Sửa giao dịch" : "Thêm giao dịch";
}

<div class="max-w-2xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-6">
        <a asp-page="/Transactions/Index" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-gray-500 dark:text-gray-400 shadow-sm">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@(Model.IsEditMode ? "Sửa giao dịch" : "Giao dịch mới")</h1>
    </div>

    <!-- Main Card -->
    <div class="bento-card relative">
        <form method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-xl text-sm border border-red-100 dark:border-red-900/50"></div>
            <input type="hidden" asp-for="Id" />
            
            <!-- Hidden Type (Default to Expense) -->
            <input type="hidden" asp-for="Transaction.TransactionType" value="2" />

            <!-- 2. Amount Input -->
            <div class="py-12 text-center">
                <label class="block text-sm font-semibold text-gray-500 uppercase tracking-widest mb-4">Số tiền @(Model.Transaction.Currency ?? "VND")</label>
                <div class="relative inline-block w-full max-w-lg group">
                    <input asp-for="Transaction.Amount" type="number" step="0.01" class="block w-full text-center text-6xl font-black text-gray-900 dark:text-white border-0 focus:ring-0 p-0 placeholder-gray-200 dark:placeholder-gray-700 bg-transparent tracking-tight transition-transform group-hover:scale-105" placeholder="0" />
                    <div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                </div>
                <input type="hidden" asp-for="Transaction.Currency" value="VND" />
                <span asp-validation-for="Transaction.Amount" class="text-sm text-rose-500 block mt-3 font-medium"></span>
            </div>

            <!-- Hidden Category -->
            <input type="hidden" asp-for="Transaction.CategoryId" value="" />

            <!-- 4. Details Section -->
            <div class="space-y-4 pt-4">
                <!-- Date -->
                <div>
                     <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Thời gian</label>
                     <input asp-for="Transaction.TransactionDate" type="date" class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary text-sm transition-all" />
                </div>

                <!-- Wallet (Source) -->
                <div>
                     <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" id="accountLabel">Ví nguồn</label>
                     <select asp-for="Transaction.AccountId" asp-items="Model.AccountList" class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary text-sm transition-all">
                     </select>
                     <span asp-validation-for="Transaction.AccountId" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                 <!-- Wallet (Destination) for Transfer -->
                <div id="pairedAccountGroup" class="hidden">
                     <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Đến ví</label>
                     <select asp-for="Transaction.PairedAccountId" asp-items="Model.AccountList" class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary text-sm transition-all">
                         <option value="">-- Chọn ví đích --</option>
                     </select>
                </div>

                <!-- Note -->
                <div>
                     <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ghi chú</label>
                     <textarea asp-for="Transaction.Note" rows="3" class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary text-sm transition-all" placeholder="Nhập ghi chú..."></textarea>
                </div>
                
                 <!-- Attachments / Advanced Placeholders -->
                 <div class="flex items-center gap-3 pt-2">
                     <button type="button" class="flex items-center gap-2 px-3 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg text-xs font-medium text-gray-600 dark:text-gray-300 transition-colors">
                         <i class="fas fa-camera"></i> Thêm ảnh
                     </button>
                      <button type="button" id="btnScanOcr" class="flex items-center gap-2 px-3 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg text-xs font-medium text-gray-600 dark:text-gray-300 transition-colors" onclick="document.getElementById('ocrFileInput').click()">
                         <i class="fas fa-expand"></i> Quét hóa đơn
                     </button>
                     <input type="file" id="ocrFileInput" class="hidden" accept="image/*" onchange="handleOcrFile(this)" />
                 </div>
                 
                 <!-- OCR Preview Container (Hidden by default) -->
                 <div id="ocrPreviewContainer" class="hidden mt-4 relative rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700 max-h-60 ocr-scan-container">
                     <img id="ocrPreviewImage" class="w-full h-full object-cover" />
                     <div class="ocr-scan-line"></div>
                     <div class="absolute inset-0 bg-black/50 flex items-center justify-center text-white font-medium backdrop-blur-[2px]" id="ocrOverlay">
                         <i class="fas fa-magic mr-2 animate-bounce"></i> Đang phân tích...
                     </div>
                 </div>
            </div>

            <!-- Advanced Options -->
            <details class="group rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden bg-gray-50/50 dark:bg-gray-800/20">
                <summary class="flex items-center justify-between p-4 cursor-pointer list-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Tùy chọn nâng cao</span>
                    <span class="transition-transform group-open:rotate-180">
                        <i class="fas fa-chevron-down text-gray-400"></i>
                    </span>
                </summary>
                <div class="p-4 border-t border-gray-200 dark:border-gray-700 space-y-4">
                     <!-- Savings Goal -->
                     <div>
                         <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Đóng góp cho Mục tiêu tiết kiệm</label>
                         <select asp-for="SavingsGoalId" asp-items="Model.SavingsGoalList" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary text-sm">
                             <option value="">-- Không chọn --</option>
                         </select>
                     </div>
                     
                     <!-- Recurring Transaction -->
                     <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
                         <div class="flex items-center gap-2 mb-3">
                            <input asp-for="Transaction.IsRecurring" type="checkbox" id="isRecurring" class="w-4 h-4 text-primary rounded border-gray-300 focus:ring-primary bg-white dark:bg-gray-800" onchange="toggleRecurring()" />
                            <label for="isRecurring" class="text-sm font-medium text-gray-700 dark:text-gray-300 select-none">Lặp lại giao dịch này</label>
                         </div>
                         
                         <div id="recurringOptions" class="hidden pl-6 space-y-3">
                             <div class="grid grid-cols-2 gap-3">
                                 <div>
                                     <label class="block text-xs font-medium text-gray-500 mb-1">Tần suất</label>
                                     <select asp-for="Transaction.RecurringFrequency" class="w-full px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm">
                                         <option value="Daily">Hàng ngày</option>
                                         <option value="Weekly">Hàng tuần</option>
                                         <option value="Monthly" selected>Hàng tháng</option>
                                         <option value="Yearly">Hàng năm</option>
                                     </select>
                                 </div>
                                 <div>
                                     <label class="block text-xs font-medium text-gray-500 mb-1">Mỗi (khoảng)</label>
                                     <input asp-for="Transaction.RecurringInterval" type="number" min="1" value="1" class="w-full px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm" />
                                 </div>
                             </div>
                             <div>
                                  <label class="block text-xs font-medium text-gray-500 mb-1">Kết thúc vào (Tùy chọn)</label>
                                  <input asp-for="Transaction.RecurringEndDate" type="date" class="w-full px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm" />
                             </div>
                         </div>
                     </div>
                </div>
            </details>

            <!-- Submit -->
            <button type="submit" class="w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold rounded-2xl shadow-lg hover:shadow-xl hover:shadow-primary/30 transition-all transform active:scale-95">
                @(Model.IsEditMode ? "Lưu thay đổi" : "Tạo giao dịch")
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categories = @Json.Serialize(Model.Categories);
        const originalCategoryId = '@Model.Transaction.CategoryId';

        async function handleOcrFile(input) {
            if (!input.files || input.files.length === 0) return;
            
            const file = input.files[0];
            const btn = document.getElementById('btnScanOcr');
            const previewContainer = document.getElementById('ocrPreviewContainer');
            const previewImage = document.getElementById('ocrPreviewImage');
            const originalText = btn.innerHTML;
            
            // Show loading state
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang quét...';
            btn.disabled = true;
            
            try {
                // Convert to Base64 and Show Preview
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = async function() {
                    const base64 = reader.result;
                    
                    // Show preview with scan animation
                    previewImage.src = base64;
                    previewContainer.classList.remove('hidden');
                    previewContainer.classList.add('ocr-scanning');
                    
                    // Call API
                    const response = await fetch('/api/Ocr/scan', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ imageBase64: base64 })
                    });
                    
                    if (!response.ok) throw new Error('OCR failed');
                    
                    const result = await response.json();
                    
                    // Stop animation
                    previewContainer.classList.remove('ocr-scanning');
                    document.getElementById('ocrOverlay').classList.add('hidden');
                    
                    // Populate form
                    if (result.amount) {
                        document.querySelector('input[name="Transaction.Amount"]').value = result.amount;
                    }
                    if (result.merchantName) {
                        document.querySelector('textarea[name="Transaction.Note"]').value = result.merchantName + "\n" + (result.rawText || "");
                    }
                    if (result.date) {
                         const d = new Date(result.date);
                         const yyyy = d.getFullYear();
                         const mm = String(d.getMonth() + 1).padStart(2, '0');
                         const dd = String(d.getDate()).padStart(2, '0');
                         document.querySelector('input[name="Transaction.TransactionDate"]').value = `${yyyy}-${mm}-${dd}`;
                    }
                    
                    // Show success visual
                    btn.innerHTML = '<i class="fas fa-check"></i> Xong!';
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                        // Optional: hide preview after success
                        // previewContainer.classList.add('hidden'); 
                    }, 2000);
                };
            } catch (error) {
                console.error(error);
                alert('Có lỗi xảy ra khi quét hóa đơn. Vui lòng thử lại.');
                btn.innerHTML = originalText;
                btn.disabled = false;
                previewContainer.classList.add('hidden');
            }
        }

        function toggleRecurring() {
            const isChecked = document.getElementById('isRecurring').checked;
            const options = document.getElementById('recurringOptions');
            if (isChecked) {
                options.classList.remove('hidden');
            } else {
                options.classList.add('hidden');
            }
        }

        function toggleType(type) {
            const pairedAccountGroup = document.getElementById('pairedAccountGroup');
            const categorySelection = document.getElementById('categorySelection');
            const accountLabel = document.getElementById('accountLabel');
            
            if (type == 3) { // Transfer
                pairedAccountGroup.classList.remove('hidden');
                categorySelection.classList.add('hidden');
                accountLabel.innerText = "Từ ví";
            } else { // Income / Expense
                pairedAccountGroup.classList.add('hidden');
                categorySelection.classList.remove('hidden');
                accountLabel.innerText = "Ví / Tài khoản";
                renderCategories(type);
            }
        }

        function renderCategories(type) {
            const grid = document.getElementById('categoryGrid');
            grid.innerHTML = '';
            
            const filtered = categories.filter(c => c.type == type);
            // Add 'Create New' or 'Uncategorized' if needed?
            
            filtered.forEach(c => {
                const currentId = document.getElementById('selectedCategoryId').value;
                const isSelected = c.id == currentId;
                const div = document.createElement('div');
                div.className = `flex flex-col items-center gap-1 p-2 rounded-2xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition-all border-2 ${isSelected ? 'border-primary bg-blue-50 dark:bg-blue-900/20' : 'border-transparent'}`;
                div.onclick = () => selectCategory(c.id, div);
                
                div.innerHTML = `
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg shadow-sm" style="background-color: \${c.color ? c.color + '20' : '#f3f4f6'}; color: \${c.color || '#64748b'}">
                        \${c.icon ? `<i class="\${c.icon}"></i>` : '<i class="fas fa-tag"></i>'}
                    </div>
                    <span class="text-[10px] text-center font-medium text-gray-600 dark:text-gray-400 leading-tight truncate w-full">\${c.name}</span>
                `;
                grid.appendChild(div);
            });
        }

        function selectCategory(id, element) {
            document.getElementById('selectedCategoryId').value = id;
            
            // Visual feedback
            const siblings = element.parentElement.children;
            for(let sib of siblings) {
                sib.classList.remove('border-primary', 'bg-blue-50', 'dark:bg-blue-900/20');
                sib.classList.add('border-transparent');
            }
            element.classList.remove('border-transparent');
            element.classList.add('border-primary', 'bg-blue-50', 'dark:bg-blue-900/20');
        }

        // Init
        document.addEventListener('DOMContentLoaded', () => {
             const typeInputs = document.querySelectorAll('input[name="Transaction.TransactionType"]');
             let currentType = 2; // Default Expense
             typeInputs.forEach(input => {
                 if(input.checked) currentType = input.value;
             });
             toggleType(currentType);
             
             // If editing, make sure category is selected visually
             if(originalCategoryId && document.getElementById('selectedCategoryId').value === '') {
                 document.getElementById('selectedCategoryId').value = originalCategoryId;
             }
             if(currentType != 3) renderCategories(currentType);
        });
    </script>
}
