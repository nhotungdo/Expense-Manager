@page
@model MoneyTrackerApp.Pages.Transactions.CreateModel
@{
    ViewData["Title"] = "Tạo giao dịch";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Tạo giao dịch mới</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Transaction Type -->
                        <div class="mb-4 text-center">
                            <div class="btn-group" role="group" aria-label="Transaction Type">
                                <input type="radio" class="btn-check" name="Transaction.TransactionType" id="typeExpense" value="2" checked onchange="toggleType(2)">
                                <label class="btn btn-outline-danger" for="typeExpense">Chi tiêu</label>

                                <input type="radio" class="btn-check" name="Transaction.TransactionType" id="typeIncome" value="1" onchange="toggleType(1)">
                                <label class="btn btn-outline-success" for="typeIncome">Thu nhập</label>

                                <input type="radio" class="btn-check" name="Transaction.TransactionType" id="typeTransfer" value="3" onchange="toggleType(3)">
                                <label class="btn btn-outline-primary" for="typeTransfer">Chuyển khoản</label>
                            </div>
                            <span asp-validation-for="Transaction.TransactionType" class="text-danger d-block mt-1"></span>
                        </div>

                        <div class="row">
                            <!-- Amount -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Transaction.Amount" class="form-label">Số tiền</label>
                                <div class="input-group">
                                    <input asp-for="Transaction.Amount" class="form-control" type="number" step="0.01" min="0.01" required />
                                    <span class="input-group-text">VND</span>
                                </div>
                                <span asp-validation-for="Transaction.Amount" class="text-danger"></span>
                            </div>

                            <!-- Date -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Transaction.TransactionDate" class="form-label">Ngày</label>
                                <input asp-for="Transaction.TransactionDate" class="form-control" type="date" required />
                                <span asp-validation-for="Transaction.TransactionDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Account -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Transaction.AccountId" class="form-label">Ví / Tài khoản</label>
                                <select asp-for="Transaction.AccountId" class="form-select" asp-items="Model.AccountList" required>
                                    <option value="">-- Chọn tài khoản --</option>
                                </select>
                                <span asp-validation-for="Transaction.AccountId" class="text-danger"></span>
                            </div>

                            <!-- Category (Hidden for Transfer) -->
                            <div class="col-md-6 mb-3" id="categoryGroup">
                                <label asp-for="Transaction.CategoryId" class="form-label">Danh mục</label>
                                <select asp-for="Transaction.CategoryId" class="form-select" id="categorySelect">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                                <span asp-validation-for="Transaction.CategoryId" class="text-danger"></span>
                            </div>

                            <!-- Paired Account (Visible for Transfer) -->
                            <div class="col-md-6 mb-3 d-none" id="pairedAccountGroup">
                                <label asp-for="Transaction.PairedAccountId" class="form-label">Đến tài khoản</label>
                                <select asp-for="Transaction.PairedAccountId" class="form-select" asp-items="Model.AccountList">
                                    <option value="">-- Chọn tài khoản đích --</option>
                                </select>
                                <span asp-validation-for="Transaction.PairedAccountId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Note -->
                        <div class="mb-3">
                            <label asp-for="Transaction.Note" class="form-label">Ghi chú</label>
                            <textarea asp-for="Transaction.Note" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Transaction.Note" class="text-danger"></span>
                        </div>

                        <!-- Hidden Currency Field -->
                        <input type="hidden" asp-for="Transaction.Currency" value="VND" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-page="/Transactions/Index" class="btn btn-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary">Lưu giao dịch</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categories = @Json.Serialize(Model.Categories);

        function toggleType(type) {
            const categoryGroup = document.getElementById('categoryGroup');
            const pairedAccountGroup = document.getElementById('pairedAccountGroup');
            
            if (type == 3) { // Transfer
                categoryGroup.classList.add('d-none');
                pairedAccountGroup.classList.remove('d-none');
            } else {
                categoryGroup.classList.remove('d-none');
                pairedAccountGroup.classList.add('d-none');
                filterCategories(type);
            }
        }

        function filterCategories(type) {
            const select = document.getElementById('categorySelect');
            const currentValue = select.value;
            
            // Clear existing options
            select.innerHTML = '<option value="">-- Chọn danh mục --</option>';
            
            // Filter and add options
            const filteredCategories = categories.filter(c => c.type == type);
            
            filteredCategories.forEach(c => {
                const option = document.createElement('option');
                option.value = c.id;
                option.text = c.name; // You might want to add icon here if possible, but standard select doesn't support HTML in options easily.
                if (c.id == currentValue) {
                    option.selected = true;
                }
                select.appendChild(option);
            });
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Get initial type
            const type = document.querySelector('input[name="Transaction.TransactionType"]:checked').value;
            toggleType(type);
        });
    </script>
}
