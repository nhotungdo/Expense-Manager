@page
@model MoneyTrackerApp.Pages.Transactions.CreateModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Sửa giao dịch" : "Thêm giao dịch";
}

<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="flex items-center gap-3 mb-6">
        <a asp-page="/Transactions/Index" class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-slate-100 transition-colors text-slate-500">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="text-2xl font-bold text-slate-900">@(Model.IsEditMode ? "Sửa giao dịch" : "Giao dịch mới")</h1>
    </div>

    <form method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-600 p-4 rounded-xl text-sm"></div>
        <input type="hidden" asp-for="Id" />
        
        <!-- 1. Type Switcher (Tabs) -->
        <div class="bg-slate-100 p-1 rounded-xl flex">
            <label class="flex-1 relative cursor-pointer group">
                <input type="radio" asp-for="Transaction.TransactionType" value="2" class="peer sr-only" onchange="toggleType(2)" />
                <div class="text-center py-2.5 rounded-lg text-sm font-medium text-slate-600 transition-all duration-200 peer-checked:bg-white peer-checked:text-rose-600 peer-checked:shadow-sm">
                    Chi tiêu
                </div>
            </label>
            <label class="flex-1 relative cursor-pointer group">
                <input type="radio" asp-for="Transaction.TransactionType" value="1" class="peer sr-only" onchange="toggleType(1)" />
                <div class="text-center py-2.5 rounded-lg text-sm font-medium text-slate-600 transition-all duration-200 peer-checked:bg-white peer-checked:text-emerald-600 peer-checked:shadow-sm">
                    Thu nhập
                </div>
            </label>
            <label class="flex-1 relative cursor-pointer group">
                <input type="radio" asp-for="Transaction.TransactionType" value="3" class="peer sr-only" onchange="toggleType(3)" />
                <div class="text-center py-2.5 rounded-lg text-sm font-medium text-slate-600 transition-all duration-200 peer-checked:bg-white peer-checked:text-blue-600 peer-checked:shadow-sm">
                    Chuyển tiền
                </div>
            </label>
        </div>

        <!-- 2. Amount Input -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Số tiền @(Model.Transaction.Currency ?? "VND")</label>
            <div class="relative inline-block w-full max-w-xs">
                <!-- Using type="number" simpler for now -->
                <input asp-for="Transaction.Amount" type="number" step="0.01" class="block w-full text-center text-4xl font-bold text-slate-900 border-none focus:ring-0 p-0 placeholder-slate-200" placeholder="0" />
                <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-full ml-2">
                    <span class="text-sm font-medium text-slate-400"></span>
                </div>
            </div>
            <input type="hidden" asp-for="Transaction.Currency" value="VND" />
            <span asp-validation-for="Transaction.Amount" class="text-xs text-rose-500 block mt-2"></span>
        </div>

        <!-- 3. Category (Grid) -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm" id="categorySelection">
            <label class="block text-sm font-semibold text-slate-700 mb-4">Danh mục</label>
            
            <!-- Hidden Input for Form Submission -->
            <input type="hidden" asp-for="Transaction.CategoryId" id="selectedCategoryId" />
            
            <div class="grid grid-cols-4 sm:grid-cols-5 gap-3 max-h-60 overflow-y-auto px-1" id="categoryGrid">
                <!-- Javascript will populate this based on type -->
            </div>
             <span asp-validation-for="Transaction.CategoryId" class="text-xs text-rose-500 block mt-2"></span>
             
             <!-- Suggestion placeholder -->
             <div id="aiSuggestion" class="mt-3 hidden bg-blue-50 text-blue-700 px-3 py-2 rounded-lg text-xs flex items-center gap-2">
                 <i class="fas fa-magic"></i> Maybe: <span class="font-bold underline cursor-pointer" id="aiSuggestionText">Food & Drink</span>
             </div>
        </div>

        <!-- 4. Details -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <!-- Date -->
            <div>
                 <label class="block text-sm font-medium text-slate-700 mb-1">Thời gian</label>
                 <input asp-for="Transaction.TransactionDate" type="date" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-blue-500 text-sm" />
            </div>

            <!-- Wallet (Source) -->
            <div>
                 <label class="block text-sm font-medium text-slate-700 mb-1" id="accountLabel">Ví nguồn</label>
                 <select asp-for="Transaction.AccountId" asp-items="Model.AccountList" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-blue-500 text-sm">
                 </select>
                 <span asp-validation-for="Transaction.AccountId" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

             <!-- Wallet (Destination) for Transfer -->
            <div id="pairedAccountGroup" class="hidden">
                 <label class="block text-sm font-medium text-slate-700 mb-1">Đến ví</label>
                 <select asp-for="Transaction.PairedAccountId" asp-items="Model.AccountList" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-blue-500 text-sm">
                     <option value="">-- Chọn ví đích --</option>
                 </select>
            </div>

            <!-- Note -->
            <div>
                 <label class="block text-sm font-medium text-slate-700 mb-1">Ghi chú</label>
                 <textarea asp-for="Transaction.Note" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-blue-500 text-sm" placeholder="Nhập ghi chú..."></textarea>
            </div>
            
             <!-- Attachments / Advanced Placeholders -->
             <div class="flex items-center gap-3 pt-2">
                 <button type="button" class="flex items-center gap-2 px-3 py-2 bg-slate-50 hover:bg-slate-100 rounded-lg text-xs font-medium text-slate-600 transition-colors">
                     <i class="fas fa-camera"></i> Thêm ảnh
                 </button>
                  <button type="button" class="flex items-center gap-2 px-3 py-2 bg-slate-50 hover:bg-slate-100 rounded-lg text-xs font-medium text-slate-600 transition-colors">
                     <i class="fas fa-expand"></i> Quét hóa đơn
                 </button>
             </div>
        </div>

        <!-- Advanced Options -->
        <details class="group bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <summary class="flex items-center justify-between p-4 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <span class="text-sm font-medium text-slate-700">Tùy chọn nâng cao (Tiết kiệm, Nợ...)</span>
                <span class="transition-transform group-open:rotate-180">
                    <i class="fas fa-chevron-down text-slate-400"></i>
                </span>
            </summary>
            <div class="p-4 border-t border-slate-100 space-y-4">
                 <!-- Savings Goal -->
                 <div>
                     <label class="block text-sm font-medium text-slate-700 mb-1">Đóng góp cho Mục tiêu tiết kiệm</label>
                     <select asp-for="SavingsGoalId" asp-items="Model.SavingsGoalList" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-blue-500 text-sm">
                         <option value="">-- Không chọn --</option>
                     </select>
                     <p class="text-xs text-slate-500 mt-1">Chọn nếu giao dịch này đóng góp cho mục tiêu tiết kiệm.</p>
                 </div>
                 
                 <!-- Placeholder for Debt/Group -->
                 <div class="p-3 bg-slate-50 rounded-xl text-xs text-slate-500 text-center">
                     Tính năng Nợ và Chi tiêu nhóm đang được phát triển.
                 </div>
            </div>
        </details>

        <!-- Submit -->
        <button type="submit" class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-2xl shadow-lg hover:shadow-xl transition-all transform active:scale-95">
            @(Model.IsEditMode ? "Lưu thay đổi" : "Tạo giao dịch")
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categories = @Json.Serialize(Model.Categories);
        const originalCategoryId = '@Model.Transaction.CategoryId';

        function toggleType(type) {
            const pairedAccountGroup = document.getElementById('pairedAccountGroup');
            const categorySelection = document.getElementById('categorySelection');
            const accountLabel = document.getElementById('accountLabel');
            
            if (type == 3) { // Transfer
                pairedAccountGroup.classList.remove('hidden');
                categorySelection.classList.add('hidden');
                accountLabel.innerText = "Từ ví";
            } else { // Income / Expense
                pairedAccountGroup.classList.add('hidden');
                categorySelection.classList.remove('hidden');
                accountLabel.innerText = "Ví / Tài khoản";
                renderCategories(type);
            }
        }

        function renderCategories(type) {
            const grid = document.getElementById('categoryGrid');
            grid.innerHTML = '';
            
            const filtered = categories.filter(c => c.type == type);
            // Add 'Create New' or 'Uncategorized' if needed?
            
            filtered.forEach(c => {
                const currentId = document.getElementById('selectedCategoryId').value;
                const isSelected = c.id == currentId;
                const div = document.createElement('div');
                div.className = `flex flex-col items-center gap-1 p-2 rounded-xl cursor-pointer hover:bg-slate-50 transition-all border-2 ${isSelected ? 'border-blue-500 bg-blue-50' : 'border-transparent'}`;
                div.onclick = () => selectCategory(c.id, div);
                
                div.innerHTML = `
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg" style="background-color: \${c.color ? c.color + '20' : '#f1f5f9'}; color: \${c.color || '#64748b'}">
                        \${c.icon ? `<i class="\${c.icon}"></i>` : '<i class="fas fa-tag"></i>'}
                    </div>
                    <span class="text-[10px] text-center font-medium text-slate-600 leading-tight truncate w-full">\${c.name}</span>
                `;
                grid.appendChild(div);
            });
        }

        function selectCategory(id, element) {
            document.getElementById('selectedCategoryId').value = id;
            
            // Visual feedback
            const siblings = element.parentElement.children;
            for(let sib of siblings) {
                sib.classList.remove('border-blue-500', 'bg-blue-50');
                sib.classList.add('border-transparent');
            }
            element.classList.remove('border-transparent');
            element.classList.add('border-blue-500', 'bg-blue-50');
        }

        // Init
        document.addEventListener('DOMContentLoaded', () => {
             const typeInputs = document.querySelectorAll('input[name="Transaction.TransactionType"]');
             let currentType = 2; // Default Expense
             typeInputs.forEach(input => {
                 if(input.checked) currentType = input.value;
             });
             toggleType(currentType);
             
             // If editing, make sure category is selected visually
             if(originalCategoryId && document.getElementById('selectedCategoryId').value === '') {
                 document.getElementById('selectedCategoryId').value = originalCategoryId;
             }
             if(currentType != 3) renderCategories(currentType);
        });
    </script>
}
