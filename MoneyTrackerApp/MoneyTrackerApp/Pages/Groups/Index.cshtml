@page
@model MoneyTrackerApp.Pages.Groups.IndexModel
@{
    ViewData["Title"] = "Nhóm chi tiêu";
}

<div class="groups-page modern-page">
    <!-- Page Header -->
    <div class="page-header-modern">
        <div class="header-content">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-users"></i>
                    Nhóm chi tiêu
                </h1>
                <p class="page-subtitle">Quản lý chi tiêu chung và chia hóa đơn</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline" onclick="showJoinGroup()">
                    <i class="fas fa-user-plus"></i>
                    Tham gia nhóm
                </button>
                <button class="btn btn-primary" onclick="showCreateGroupModal()">
                    <i class="fas fa-plus"></i>
                    Tạo nhóm mới
                </button>
            </div>
        </div>
    </div>

    <!-- Groups Overview -->
    <div class="groups-overview">
        <div class="overview-stat-card">
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Tổng số nhóm</p>
                <h3 class="stat-value" id="totalGroups">0</h3>
            </div>
        </div>

        <div class="overview-stat-card">
            <div class="stat-icon">
                <i class="fas fa-receipt"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Tổng chi tiêu</p>
                <h3 class="stat-value" id="totalExpenses">0 ₫</h3>
            </div>
        </div>

        <div class="overview-stat-card">
            <div class="stat-icon balance">
                <i class="fas fa-balance-scale"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Số dư của bạn</p>
                <h3 class="stat-value" id="myBalance">0 ₫</h3>
            </div>
        </div>

        <div class="overview-stat-card">
            <div class="stat-icon pending">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Chờ thanh toán</p>
                <h3 class="stat-value warning" id="pendingPayments">0 ₫</h3>
            </div>
        </div>
    </div>

    <!-- Groups Grid -->
    <div class="groups-section">
        <div class="section-header-inline">
            <h3 class="section-title">
                <i class="fas fa-layer-group"></i>
                Nhóm của bạn
            </h3>
            <div class="groups-view-toggle">
                <button class="view-btn active" data-view="grid" onclick="switchView('grid')">
                    <i class="fas fa-th"></i>
                </button>
                <button class="view-btn" data-view="list" onclick="switchView('list')">
                    <i class="fas fa-list"></i>
                </button>
            </div>
        </div>

        <div class="groups-grid" id="groupsList">
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Đang tải nhóm...</p>
            </div>
        </div>
    </div>
</div>

<!-- Create Group Modal -->
<div class="modal fade" id="createGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo nhóm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="groupForm">
                    <input type="hidden" id="groupId">

                    <div class="form-group">
                        <label>Tên nhóm *</label>
                        <input type="text" class="form-control" id="groupName" placeholder="VD: Du lịch Đà Lạt, Ăn trưa văn phòng..." required maxlength="100">
                    </div>

                    <div class="form-group">
                        <label>Mô tả</label>
                        <textarea class="form-control" id="groupDescription" rows="3" placeholder="Mô tả ngắn về nhóm..."></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Biểu tượng</label>
                            <select class="form-select" id="groupIcon" style="font-size: 1.2rem;">
                                <option value="🏠">🏠 Nhà</option>
                                <option value="✈️">✈️ Du lịch</option>
                                <option value="🍕">🍕 Ăn uống</option>
                                <option value="🎉">🎉 Tiệc tùng</option>
                                <option value="🏖️">🏖️ Nghỉ mát</option>
                                <option value="💼">💼 Công việc</option>
                                <option value="🎓">🎓 Giáo dục</option>
                                <option value="⚽">⚽ Thể thao</option>
                                <option value="🎁">🎁 Quà tặng</option>
                                <option value="🛒">🛒 Mua sắm</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Màu sắc</label>
                            <input type="color" class="form-control" id="groupColor" value="#4f46e5" style="height: 48px; padding: 4px;">
                        </div>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="groupIsPublic" checked>
                        <label class="form-check-label" for="groupIsPublic">
                            Nhóm công khai (Mọi người có thể tìm thấy)
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveGroup()">Tạo nhóm</button>
            </div>
        </div>
    </div>
</div>

<!-- Group Details Modal -->
<div class="modal fade" id="groupDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div class="group-header-info">
                    <div class="group-icon-large" id="groupIconLarge">👥</div>
                    <div>
                        <h5 class="modal-title" id="groupNameTitle">Tên nhóm</h5>
                        <p class="group-description" id="groupDescriptionText"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Group Tabs -->
                <div class="group-tabs">
                    <button class="group-tab active" data-tab="transactions" onclick="switchGroupTab('transactions')">
                        <i class="fas fa-receipt"></i>
                        Giao dịch
                    </button>
                    <button class="group-tab" data-tab="balances" onclick="switchGroupTab('balances')">
                        <i class="fas fa-balance-scale"></i>
                        Số dư
                    </button>
                    <button class="group-tab" data-tab="members" onclick="switchGroupTab('members')">
                        <i class="fas fa-users"></i>
                        Thành viên
                    </button>
                    <button class="group-tab" data-tab="chat" onclick="switchGroupTab('chat')">
                        <i class="fas fa-comments"></i>
                        Trò chuyện
                    </button>
                </div>

                <!-- Tab Content -->
                <div class="group-tab-content">
                    <!-- Transactions Tab -->
                    <div class="tab-pane active" id="transactionsTab">
                        <div class="tab-header">
                            <h4>Danh sách giao dịch</h4>
                            <button class="btn btn-primary btn-sm" onclick="showAddTransactionModal()">
                                <i class="fas fa-plus"></i>
                                Thêm chi tiêu
                            </button>
                        </div>
                        <div id="transactionsList">
                            <div class="loading-state">
                                <div class="spinner"></div>
                                <p>Đang tải...</p>
                            </div>
                        </div>
                    </div>

                    <!-- Balances Tab -->
                    <div class="tab-pane" id="balancesTab" style="display: none;">
                        <div class="balances-container">
                            <div class="balances-section">
                                <h4>Số dư thành viên</h4>
                                <div id="memberBalancesList"></div>
                            </div>
                            <div class="settlements-section">
                                <h4>Đề xuất thanh toán</h4>
                                <div id="settlementsList"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Members Tab -->
                    <div class="tab-pane" id="membersTab" style="display: none;">
                        <div class="tab-header">
                            <h4>Thành viên nhóm</h4>
                            <button class="btn btn-outline btn-sm" onclick="showInviteMember()">
                                <i class="fas fa-user-plus"></i>
                                Mời thành viên
                            </button>
                        </div>
                        <div id="membersList"></div>
                    </div>

                    <!-- Chat Tab -->
                    <div class="tab-pane" id="chatTab" style="display: none;">
                        <div class="chat-container">
                            <div class="chat-messages" id="chatMessages">
                                <!-- Messages populated by JS -->
                            </div>
                            <div class="chat-input-container">
                                <input type="text" class="form-control" id="chatInput" placeholder="Nhập tin nhắn...">
                                <button class="btn btn-primary" onclick="sendMessage()">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Transaction Modal -->
<div class="modal fade" id="addTransactionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm chi tiêu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="transactionForm">
                    <input type="hidden" id="transactionGroupId">

                    <div class="form-group">
                        <label>Mô tả *</label>
                        <input type="text" class="form-control" id="transactionDescription" placeholder="Mua gì?" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Số tiền *</label>
                            <div class="input-with-icon">
                                <span class="currency-symbol">₫</span>
                                <input type="number" class="form-control amount-input" id="transactionAmount" required min="0" step="0.01">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Đơn vị</label>
                            <select class="form-select" id="transactionCurrency">
                                <option value="VND">VND</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Ngày chi</label>
                        <input type="date" class="form-control" id="transactionDate" required>
                    </div>

                    <div class="form-group">
                        <label>Cách chia tiền</label>
                        <select class="form-select" id="splitMethod" onchange="toggleCustomSplit()">
                            <option value="1">Chia đều cho tất cả</option>
                            <option value="2">Tùy chỉnh (Theo số tiền)</option>
                            <option value="3">Tùy chỉnh (Theo phần trăm)</option>
                        </select>
                    </div>

                    <div id="customSplitsContainer" style="display: none;">
                        <!-- Custom splits populated by JS -->
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveTransaction()">Thêm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/groups.css">
    <script src="~/js/groups.js"></script>
}
