@page
@model MoneyTrackerApp.Pages.Groups.IndexModel
@{
    ViewData["Title"] = "Chi tiêu nhóm";
}

<div class="min-h-screen bg-slate-50 dark:bg-slate-900 pb-20 transition-colors duration-300">
    <!-- Hero Section -->
    <div class="relative bg-white dark:bg-slate-800 shadow-sm border-b border-slate-200 dark:border-slate-700 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 to-blue-50/50 dark:from-indigo-900/10 dark:to-blue-900/10 opacity-50"></div>
        <div class="container mx-auto px-4 py-12 relative z-10">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                
                <!-- Text Content -->
                <div class="animate-fade-in-up">
                    <h1 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400 mb-3 tracking-tight">
                        Chi tiêu nhóm
                    </h1>
                    <p class="text-slate-500 dark:text-slate-400 text-lg max-w-lg leading-relaxed">
                        Quản lý các chuyến đi và chi phí chung một cách dễ dàng và minh bạch.
                    </p>
                </div>

                <!-- Action Button -->
                <div class="animate-fade-in-up delay-100">
                     <button onclick="openCreateGroupModal()" 
                            class="group relative inline-flex items-center justify-center px-8 py-3.5 text-base font-bold text-white transition-all duration-200 bg-blue-600 rounded-2xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600">
                        <span class="absolute inset-0 w-full h-full -mt-1 rounded-2xl opacity-30 bg-gradient-to-b from-transparent via-transparent to-black"></span>
                        <span class="relative flex items-center gap-2">
                            <i class="fas fa-plus text-lg"></i>
                            <span>Tạo nhóm mới</span>
                        </span>
                    </button>
                </div>
            </div>
            
            <!-- Summary Stats (Optional Idea: Total Balance across all groups) -->
            @{
                decimal totalBalance = 0;
                foreach(var b in Model.UserBalances.Values) totalBalance += b;
                bool isPositive = totalBalance >= 0;
            }
            @if (Model.Groups.Any())
            {
               <div class="mt-10 inline-flex items-center gap-4 bg-white/60 dark:bg-slate-700/60 backdrop-blur-md px-6 py-3 rounded-2xl border border-white/20 shadow-sm animate-fade-in-up delay-200">
                    <div class="flex flex-col">
                        <span class="text-xs uppercase tracking-wider font-bold text-slate-400">Tổng số dư của bạn</span>
                        <span class="text-2xl font-bold @(isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                            @Math.Abs(totalBalance).ToString("C0")
                            <span class="text-xs font-medium text-slate-500 ml-1">(@(isPositive ? "bạn được nhận" : "bạn cần trả"))</span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Content Grid -->
    <div class="container mx-auto px-4 -mt-6">
        @if (!Model.Groups.Any())
        {
            <div class="flex flex-col items-center justify-center py-20 animate-fade-in">
                 <div class="relative w-48 h-48 mb-6 group">
                     <div class="absolute inset-0 bg-blue-100 dark:bg-blue-900/30 rounded-full blur-2xl opacity-50 group-hover:opacity-75 transition-opacity"></div>
                     <div class="relative bg-white dark:bg-slate-800 rounded-[2rem] p-8 shadow-xl border border-slate-50 dark:border-slate-700 transform group-hover:scale-105 transition-transform duration-500">
                         <img src="https://cdn-icons-png.flaticon.com/512/1256/1256650.png" alt="Empty" class="w-full h-full object-contain opacity-80" />
                     </div>
                 </div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Chưa có nhóm nào</h2>
                <p class="text-slate-500 dark:text-slate-400 max-w-md mx-auto text-center mb-8">
                    Hãy tạo nhóm đầu tiên để bắt đầu chia sẻ chi phí với bạn bè trong các chuyến đi hoặc dự án chung!
                </p>
                <button onclick="openCreateGroupModal()" class="text-blue-600 dark:text-blue-400 font-bold hover:underline">
                    Bắt đầu ngay &rarr;
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 py-8">
                @foreach (var group in Model.Groups)
                {
                    var balance = Model.UserBalances.ContainsKey(group.Id) ? Model.UserBalances[group.Id] : 0;
                    var balanceIsPositive = balance >= 0;
                    var groupColor = !string.IsNullOrEmpty(group.Color) ? group.Color : "#3B82F6";
                    
                    <a asp-page="./Details" asp-route-id="@group.Id" 
                       class="group relative flex flex-col bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-300 border border-slate-100 dark:border-slate-700 overflow-hidden hover:-translate-y-2">
                        
                        <!-- Decorative Gradient Blob -->
                        <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full blur-3xl opacity-20 transition-opacity group-hover:opacity-40"
                             style="background-color: @groupColor;"></div>

                        <!-- Card Header -->
                        <div class="flex justify-between items-start mb-6 relative z-10">
                            <div class="flex items-center gap-4">
                                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg transform group-hover:scale-110 transition-transform duration-300"
                                     style="background: linear-gradient(135deg, @groupColor, #1e293b);">
                                    @if (!string.IsNullOrEmpty(group.Icon))
                                    {
                                        <i class="@group.Icon"></i>
                                    }
                                    else
                                    {
                                        <span class="font-bold">@group.Name.Substring(0, 1).ToUpper()</span>
                                    }
                                </div>
                                <div>
                                    <h3 class="font-bold text-xl text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors line-clamp-1">
                                        @group.Name
                                    </h3>
                                    <span class="text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-700/50 px-2 py-0.5 rounded-full">
                                        @group.GroupMembers.Count thành viên
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Description & Stats -->
                        <div class="flex-1 mb-6 relative z-10">
                             <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 h-10 mb-4">
                                @(string.IsNullOrEmpty(group.Description) ? "Không có mô tả." : group.Description)
                            </p>
                            
                            <!-- User Status in Group -->
                            <div class="bg-slate-50 dark:bg-slate-700/30 rounded-xl p-3 flex items-center justify-between border border-slate-100 dark:border-slate-700/50">
                                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Số dư của bạn</span>
                                <span class="font-bold text-base @(balanceIsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                                    @Math.Abs(balance).ToString("C0")
                                    <i class="fas @(balanceIsPositive ? "fa-arrow-up" : "fa-arrow-down") ml-1 text-xs opacity-75"></i>
                                </span>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="flex items-center justify-between pt-4 border-t border-slate-50 dark:border-slate-700/50 relative z-10">
                            <div class="flex -space-x-2">
                                @foreach (var member in group.GroupMembers.Take(4))
                                {
                                    <div class="w-8 h-8 rounded-full ring-2 ring-white dark:ring-slate-800 bg-slate-200 dark:bg-slate-600 flex items-center justify-center text-xs font-bold text-slate-600 dark:text-slate-300" title="@member.User.FullName">
                                        @(member.User.FullName?.Substring(0,1) ?? "?")
                                    </div>
                                }
                                @if (group.GroupMembers.Count > 4)
                                {
                                     <div class="w-8 h-8 rounded-full ring-2 ring-white dark:ring-slate-800 bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-xs font-bold text-slate-500">
                                        +@(group.GroupMembers.Count - 4)
                                    </div>
                                }
                            </div>
                            
                            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity transform translate-x-2 group-hover:translate-x-0">
                                Xem chi tiết &rarr;
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- Premium Create Modal -->
<div id="createGroupModalBackdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-50 hidden transition-all duration-300 opacity-0" aria-hidden="true">
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="relative bg-white dark:bg-slate-800 rounded-3xl shadow-2xl max-w-lg w-full p-8 transform scale-95 transition-all duration-300" id="createGroupModalContent">
            
            <!-- Modal Header -->
            <div class="text-center mb-8">
                <div class="w-20 h-20 bg-gradient-to-tr from-blue-500 to-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-500/30 text-white text-3xl">
                    <i class="fas fa-layer-group"></i>
                </div>
                <h3 class="text-2xl font-bold text-slate-900 dark:text-white">Tạo nhóm mới</h3>
                <p class="text-slate-500 dark:text-slate-400 mt-2">Tạo không gian để theo dõi chi tiêu cùng nhau.</p>
            </div>
            
            <form method="post" asp-page-handler="CreateGroup" class="space-y-6">
                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Tên nhóm</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <i class="fas fa-tag"></i>
                        </div>
                        <input type="text" asp-for="Input.Name" class="block w-full pl-11 pr-4 py-3.5 bg-slate-50 dark:bg-slate-700 border-transparent focus:bg-white dark:focus:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-medium text-slate-900 dark:text-white placeholder-slate-400" required placeholder="Ví dụ: Chuyến đi Phú Quốc">
                    </div>
                    <span asp-validation-for="Input.Name" class="text-red-500 text-xs font-semibold"></span>
                </div>

                 <div class="space-y-2">
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Mô tả (tùy chọn)</label>
                    <div class="relative">
                         <div class="absolute top-3.5 left-0 pl-4 flex items-start pointer-events-none text-slate-400">
                            <i class="fas fa-align-left"></i>
                        </div>
                        <textarea asp-for="Input.Description" class="block w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-700 border-transparent focus:bg-white dark:focus:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-medium text-slate-900 dark:text-white placeholder-slate-400" rows="3" placeholder="Nhóm này dùng để làm gì?"></textarea>
                    </div>
                </div>

                <!-- Color & Icon Picker (Simplified via hidden, could be expanded) -->
                <input type="hidden" asp-for="Input.Icon" value="fas fa-users">
                <input type="hidden" asp-for="Input.Color" value="#3B82F6">
                
                <div class="flex gap-4 pt-4">
                    <button type="button" onclick="closeCreateGroupModal()" class="flex-1 px-6 py-3.5 text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 rounded-xl font-bold transition-colors">
                        Hủy
                    </button>
                    <button type="submit" class="flex-1 px-6 py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl hover:shadow-lg hover:shadow-blue-500/30 font-bold transition-all transform hover:-translate-y-0.5">
                        Tạo nhóm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCreateGroupModal() {
        const backdrop = document.getElementById('createGroupModalBackdrop');
        const content = document.getElementById('createGroupModalContent');
        backdrop.classList.remove('hidden');
        // Trigger reflow
        void backdrop.offsetWidth;
        
        backdrop.classList.remove('opacity-0');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
    }

    function closeCreateGroupModal() {
        const backdrop = document.getElementById('createGroupModalBackdrop');
        const content = document.getElementById('createGroupModalContent');
        
        backdrop.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        
        setTimeout(() => {
            backdrop.classList.add('hidden');
        }, 300);
    }
</script>
