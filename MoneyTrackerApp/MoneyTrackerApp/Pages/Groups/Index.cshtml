@page
@model MoneyTrackerApp.Pages.Groups.IndexModel
@{
    ViewData["Title"] = "Chi tiêu nhóm";
}

<div id="groupsApp" class="groups-container" v-cloak>
    <!-- Page Header -->
    <header class="page-header">
        <div class="header-top">
            <div class="header-title-group">
                <h1>💰 Chi tiêu nhóm</h1>
                <p>Quản lý chi tiêu chung với bạn bè và gia đình</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-secondary" @@click="openExportModal" title="Xuất dữ liệu">
                    <i class="fas fa-download"></i>
                    <span>Xuất</span>
                </button>
                <button class="btn btn-secondary" @@click="openFilterModal">
                    <i class="fas fa-filter"></i>
                    <span>Lọc</span>
                </button>
                <div class="dropdown-wrapper">
                    <button class="btn btn-primary" @@click="toggleCreateDropdown">
                        <i class="fas fa-plus"></i>
                        <span>Tạo nhóm</span>
                        <i class="fas fa-chevron-down" style="margin-left: 0.5rem; font-size: 0.75rem;"></i>
                    </button>
                    <div v-if="showCreateDropdown" class="dropdown-menu">
                        <button @@click="openCreateGroupModal" class="dropdown-item">
                            <i class="fas fa-users"></i>
                            <span>Tạo nhóm trống</span>
                        </button>
                        <button @@click="openTemplateModal" class="dropdown-item">
                            <i class="fas fa-magic"></i>
                            <span>Từ mẫu có sẵn</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid slide-up">
            <div class="stat-card primary">
                <div class="stat-icon">
                    <i class="fas fa-balance-scale"></i>
                </div>
                <div class="stat-label">Tổng số dư</div>
                <div class="stat-value" :class="totalBalance >= 0 ? 'text-success' : 'text-danger'">
                    {{ formatCurrency(Math.abs(totalBalance)) }}
                </div>
                <div class="stat-change">{{ totalBalance >= 0 ? 'Bạn được nhận' : 'Bạn đang nợ' }}</div>
            </div>

            <div class="stat-card success">
                <div class="stat-icon">
                    <i class="fas fa-arrow-down"></i>
                </div>
                <div class="stat-label">Bạn sẽ nhận</div>
                <div class="stat-value">{{ formatCurrency(totalReceivables) }}</div>
                <div class="stat-change">Từ {{ receivableCount }} {{ receivableCount === 1 ? 'người' : 'người' }}</div>
            </div>

            <div class="stat-card danger">
                <div class="stat-icon">
                    <i class="fas fa-arrow-up"></i>
                </div>
                <div class="stat-label">Bạn cần trả</div>
                <div class="stat-value">{{ formatCurrency(totalPayables) }}</div>
                <div class="stat-change">Cho {{ payableCount }} {{ payableCount === 1 ? 'người' : 'người' }}</div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="content-grid">
        <!-- Groups List -->
        <section class="groups-section fade-in">
            <div class="section-header">
                <h2 class="section-title">Nhóm của bạn</h2>
                <div class="section-actions">
                    <div class="view-toggle">
                        <button :class="{ active: viewMode === 'grid' }" @@click="viewMode = 'grid'" title="Xem dạng lưới">
                            <i class="fas fa-th"></i>
                        </button>
                        <button :class="{ active: viewMode === 'list' }" @@click="viewMode = 'list'" title="Xem dạng danh sách">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" v-model="searchQuery" placeholder="Tìm kiếm nhóm...">
                    </div>
                </div>
            </div>

            <!-- Loading State -->
            <div v-if="loading" class="loading-spinner">
                <div class="spinner"></div>
            </div>

            <!-- Empty State -->
            <div v-else-if="filteredGroups.length === 0" class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-users-slash"></i>
                </div>
                <p class="empty-text">Chưa có nhóm nào. Tạo nhóm để bắt đầu!</p>
                <button class="btn btn-primary" @@click="openCreateGroupModal">
                    <i class="fas fa-plus"></i>
                    Tạo nhóm đầu tiên
                </button>
            </div>

            <!-- Bulk Actions Bar -->
            <div v-if="selectedGroups.length > 0" class="bulk-actions-bar">
                <div class="bulk-info">
                    <input type="checkbox" 
                           :checked="selectedGroups.length === filteredGroups.length"
                           @@change="toggleSelectAll"
                           style="margin-right: 0.75rem;">
                    <span>Đã chọn {{ selectedGroups.length }} nhóm</span>
                </div>
                <div class="bulk-buttons">
                    <button class="btn-bulk" @@click="bulkArchive">
                        <i class="fas fa-archive"></i> Lưu trữ
                    </button>
                    <button class="btn-bulk danger" @@click="bulkDelete">
                        <i class="fas fa-trash"></i> Xóa
                    </button>
                    <button class="btn-bulk" @@click="clearSelection">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                </div>
            </div>

            <!-- Groups List -->
            <div v-else class="groups-list" :class="viewMode">
                <div v-for="(group, index) in filteredGroups" 
                     :key="group.id" 
                     class="group-card"
                     :class="{ selected: selectedGroups.includes(group.id) }"
                     :style="{ animationDelay: (index * 0.05) + 's' }">
                    <div class="group-select-checkbox" v-if="selectionMode">
                        <input type="checkbox" 
                               :checked="selectedGroups.includes(group.id)"
                               @@change="toggleGroupSelection(group.id)"
                               @@click.stop>
                    </div>
                    <div class="group-card-content" @@click="viewGroupDetails(group)">
                        <div class="group-avatar">
                            {{ group.name.charAt(0).toUpperCase() }}
                        </div>
                        <div class="group-info">
                            <h3 class="group-name">{{ group.name }}</h3>
                            <div class="group-meta">
                                <span><i class="fas fa-users"></i> {{ group.memberCount || 0 }} thành viên</span>
                                <span><i class="fas fa-receipt"></i> {{ group.transactionCount || 0 }} chi tiêu</span>
                            </div>
                        </div>
                        <div class="group-balance">
                            <div class="balance-label">Số dư của bạn</div>
                            <div class="balance-amount" :class="getBalanceClass(group.id)">
                                {{ formatCurrency(Math.abs(getGroupBalance(group.id))) }}
                            </div>
                        </div>
                        <i class="fas fa-chevron-right" style="color: var(--text-muted);"></i>
                    </div>
                    <div class="group-card-actions">
                        <button class="action-btn" @@click.stop="quickAddExpense(group)" title="Thêm chi tiêu nhanh">
                            <i class="fas fa-plus-circle"></i>
                        </button>
                        <button class="action-btn" @@click.stop="shareGroup(group)" title="Chia sẻ nhóm">
                            <i class="fas fa-share-alt"></i>
                        </button>
                        <button class="action-btn" @@click.stop="toggleGroupMenu(group.id)" title="Thêm">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <div v-if="activeGroupMenu === group.id" class="group-context-menu">
                            <button @@click.stop="openGroupSettings(group)">
                                <i class="fas fa-cog"></i> Cài đặt
                            </button>
                            <button @@click.stop="archiveGroup(group)">
                                <i class="fas fa-archive"></i> Lưu trữ
                            </button>
                            <button @@click.stop="exportGroupData(group)">
                                <i class="fas fa-file-export"></i> Xuất dữ liệu
                            </button>
                            <button @@click.stop="leaveGroup(group)" class="danger">
                                <i class="fas fa-sign-out-alt"></i> Rời nhóm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sidebar -->
        <aside class="sidebar">
            <!-- Quick Stats -->
            <div class="sidebar-card">
                <h3 class="sidebar-card-title">Thống kê nhanh</h3>
                <div class="quick-stats">
                    <div class="quick-stat-item">
                        <div class="stat-icon-sm">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <div class="stat-value-sm">{{ groups.length }}</div>
                            <div class="stat-label-sm">Tổng nhóm</div>
                        </div>
                    </div>
                    <div class="quick-stat-item">
                        <div class="stat-icon-sm">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <div>
                            <div class="stat-value-sm">{{ totalTransactions }}</div>
                            <div class="stat-label-sm">Tổng giao dịch</div>
                        </div>
                    </div>
                    <div class="quick-stat-item">
                        <div class="stat-icon-sm">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div>
                            <div class="stat-value-sm">{{ formatCurrency(totalSpent) }}</div>
                            <div class="stat-label-sm">Tổng chi tiêu</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart Card -->
            <div class="sidebar-card">
                <h3 class="sidebar-card-title">Chi tiêu theo danh mục</h3>
                <div style="height: 220px; position: relative;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="sidebar-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                    <h3 class="sidebar-card-title" style="margin-bottom: 0;">Hoạt động gần đây</h3>
                    <button class="btn-link" @@click="refreshActivities">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <div v-if="recentActivities.length === 0" class="empty-state" style="padding: 2rem 1rem;">
                    <p style="font-size: 0.875rem; color: var(--text-muted);">Chưa có hoạt động nào</p>
                </div>
                <div v-else class="activity-list">
                    <div v-for="activity in recentActivities.slice(0, 5)" :key="activity.id" class="activity-item">
                        <div class="activity-icon">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <div class="activity-content">
                            <p class="activity-desc">
                                <strong>{{ activity.paidByUserName }}</strong> đã thêm 
                                <strong>{{ activity.description }}</strong>
                            </p>
                            <span class="activity-time">{{ formatTimeAgo(activity.transactionDate) }} • {{ activity.groupName }}</span>
                        </div>
                        <div class="activity-amount">
                            {{ formatCurrency(activity.amount) }}
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </div>

    <!-- Create Group Modal -->
    <div v-if="showCreateModal" class="modal-backdrop" @@click.self="closeCreateGroupModal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Tạo nhóm mới</h3>
                <button class="modal-close" @@click="closeCreateGroupModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Tên nhóm</label>
                    <input type="text" 
                           v-model="newGroup.name" 
                           class="form-input" 
                           placeholder="Ví dụ: Du lịch Hè 2024"
                           @@keyup.enter="createGroup">
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả (Tùy chọn)</label>
                    <textarea v-model="newGroup.description" 
                              class="form-textarea" 
                              placeholder="Nhóm này dùng để làm gì?"
                              rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Thêm thành viên</label>
                    <div v-if="friends.length === 0" style="padding: 1rem; background: var(--bg-main); border-radius: var(--radius); text-align: center; color: var(--text-muted); font-size: 0.875rem;">
                        Chưa có bạn bè. Thêm bạn bè trước để mời họ.
                    </div>
                    <div v-else style="display: grid; gap: 0.5rem; max-height: 200px; overflow-y: auto;">
                        <label v-for="friend in friends" 
                               :key="friend.friendId"
                               style="display: flex; align-items: center; padding: 0.75rem; background: var(--bg-main); border-radius: var(--radius); cursor: pointer; transition: all 0.2s;"
                               :style="newGroup.selectedFriendIds.includes(friend.friendId) ? 'background: rgba(99, 102, 241, 0.1); border: 2px solid var(--primary);' : 'border: 2px solid transparent;'">
                            <input type="checkbox" 
                                   :value="friend.friendId" 
                                   v-model="newGroup.selectedFriendIds"
                                   style="margin-right: 0.75rem;">
                            <span style="font-weight: 500;">{{ friend.friendName }}</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @@click="closeCreateGroupModal">Hủy</button>
                <button class="btn btn-primary" @@click="createGroup" :disabled="!newGroup.name">
                    <i class="fas fa-check"></i>
                    Tạo nhóm
                </button>
            </div>
        </div>
    </div>

    <!-- Filter Modal -->
    <div v-if="showFilterModal" class="modal-backdrop" @@click.self="closeFilterModal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Lọc nhóm</h3>
                <button class="modal-close" @@click="closeFilterModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Trạng thái số dư</label>
                    <select v-model="filters.balanceStatus" class="form-select">
                        <option value="all">Tất cả</option>
                        <option value="positive">Được nhận tiền</option>
                        <option value="negative">Đang nợ</option>
                        <option value="settled">Đã thanh toán</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Sắp xếp theo</label>
                    <select v-model="filters.sortBy" class="form-select">
                        <option value="name">Tên nhóm</option>
                        <option value="balance">Số dư</option>
                        <option value="members">Số thành viên</option>
                        <option value="activity">Hoạt động gần đây</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Thứ tự</label>
                    <select v-model="filters.sortOrder" class="form-select">
                        <option value="asc">Tăng dần</option>
                        <option value="desc">Giảm dần</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @@click="resetFilters">Đặt lại</button>
                <button class="btn btn-primary" @@click="applyFilters">
                    <i class="fas fa-check"></i>
                    Áp dụng
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Add Expense Modal -->
    <div v-if="showQuickExpenseModal" class="modal-backdrop" @@click.self="closeQuickExpenseModal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Thêm chi tiêu nhanh</h3>
                <button class="modal-close" @@click="closeQuickExpenseModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Nhóm</label>
                    <input type="text" class="form-input" :value="selectedGroup?.name" disabled>
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả</label>
                    <input type="text" 
                           v-model="quickExpense.description" 
                           class="form-input" 
                           placeholder="Ví dụ: Ăn trưa">
                </div>
                <div class="form-group">
                    <label class="form-label">Số tiền</label>
                    <input type="number" 
                           v-model="quickExpense.amount" 
                           class="form-input" 
                           placeholder="0">
                </div>
                <div class="form-group">
                    <label class="form-label">Người trả</label>
                    <select v-model="quickExpense.paidBy" class="form-select">
                        <option value="me">Tôi</option>
                        <option value="other">Người khác</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @@click="closeQuickExpenseModal">Hủy</button>
                <button class="btn btn-primary" @@click="addQuickExpense" :disabled="!quickExpense.description || !quickExpense.amount">
                    <i class="fas fa-check"></i>
                    Thêm chi tiêu
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <transition name="toast">
        <div v-if="toast.show" class="toast" :class="toast.type">
            <i class="fas" :class="toast.icon"></i>
            <span>{{ toast.message }}</span>
        </div>
    </transition>

    <!-- Export Modal -->
    <div v-if="showExportModal" class="modal-backdrop" @@click.self="closeExportModal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Xuất dữ liệu</h3>
                <button class="modal-close" @@click="closeExportModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Định dạng</label>
                    <div class="export-format-grid">
                        <label class="export-format-option" :class="{ selected: exportFormat === 'csv' }">
                            <input type="radio" value="csv" v-model="exportFormat">
                            <div class="format-card">
                                <i class="fas fa-file-csv"></i>
                                <span>CSV</span>
                                <small>Bảng tính Excel</small>
                            </div>
                        </label>
                        <label class="export-format-option" :class="{ selected: exportFormat === 'pdf' }">
                            <input type="radio" value="pdf" v-model="exportFormat">
                            <div class="format-card">
                                <i class="fas fa-file-pdf"></i>
                                <span>PDF</span>
                                <small>Tài liệu in</small>
                            </div>
                        </label>
                        <label class="export-format-option" :class="{ selected: exportFormat === 'json' }">
                            <input type="radio" value="json" v-model="exportFormat">
                            <div class="format-card">
                                <i class="fas fa-file-code"></i>
                                <span>JSON</span>
                                <small>Dữ liệu thô</small>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Nội dung xuất</label>
                    <div style="display: grid; gap: 0.5rem;">
                        <label style="display: flex; align-items: center; padding: 0.75rem; background: var(--bg-main); border-radius: var(--radius); cursor: pointer;">
                            <input type="checkbox" v-model="exportOptions.includeTransactions" style="margin-right: 0.75rem;">
                            <span>Giao dịch</span>
                        </label>
                        <label style="display: flex; align-items: center; padding: 0.75rem; background: var(--bg-main); border-radius: var(--radius); cursor: pointer;">
                            <input type="checkbox" v-model="exportOptions.includeBalances" style="margin-right: 0.75rem;">
                            <span>Số dư</span>
                        </label>
                        <label style="display: flex; align-items: center; padding: 0.75rem; background: var(--bg-main); border-radius: var(--radius); cursor: pointer;">
                            <input type="checkbox" v-model="exportOptions.includeMembers" style="margin-right: 0.75rem;">
                            <span>Thành viên</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @@click="closeExportModal">Hủy</button>
                <button class="btn btn-primary" @@click="performExport">
                    <i class="fas fa-download"></i>
                    Xuất dữ liệu
                </button>
            </div>
        </div>
    </div>

    <!-- Template Modal -->
    <div v-if="showTemplateModal" class="modal-backdrop" @@click.self="closeTemplateModal">
        <div class="modal modal-lg">
            <div class="modal-header">
                <h3 class="modal-title">Chọn mẫu nhóm</h3>
                <button class="modal-close" @@click="closeTemplateModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="template-grid">
                    <div v-for="template in groupTemplates" 
                         :key="template.id"
                         class="template-card"
                         @@click="selectTemplate(template)">
                        <div class="template-icon">
                            <i :class="template.icon"></i>
                        </div>
                        <h4>{{ template.name }}</h4>
                        <p>{{ template.description }}</p>
                        <div class="template-tags">
                            <span v-for="tag in template.tags" :key="tag" class="tag">{{ tag }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Keyboard Shortcuts Help -->
    <div v-if="showShortcutsModal" class="modal-backdrop" @@click.self="closeShortcutsModal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Phím tắt</h3>
                <button class="modal-close" @@click="closeShortcutsModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="shortcuts-list">
                    <div class="shortcut-item">
                        <kbd>Ctrl</kbd> + <kbd>N</kbd>
                        <span>Tạo nhóm mới</span>
                    </div>
                    <div class="shortcut-item">
                        <kbd>Ctrl</kbd> + <kbd>F</kbd>
                        <span>Tìm kiếm</span>
                    </div>
                    <div class="shortcut-item">
                        <kbd>Ctrl</kbd> + <kbd>E</kbd>
                        <span>Xuất dữ liệu</span>
                    </div>
                    <div class="shortcut-item">
                        <kbd>Ctrl</kbd> + <kbd>K</kbd>
                        <span>Lọc nhóm</span>
                    </div>
                    <div class="shortcut-item">
                        <kbd>?</kbd>
                        <span>Hiện phím tắt</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Action Button -->
    <div class="fab-container">
        <button class="fab" @@click="toggleFabMenu" :class="{ active: showFabMenu }">
            <i class="fas" :class="showFabMenu ? 'fa-times' : 'fa-plus'"></i>
        </button>
        <transition name="fab-menu">
            <div v-if="showFabMenu" class="fab-menu">
                <button class="fab-menu-item" @@click="openCreateGroupModal" title="Tạo nhóm">
                    <i class="fas fa-users"></i>
                    <span>Tạo nhóm</span>
                </button>
                <button class="fab-menu-item" @@click="toggleSelectionMode" title="Chọn nhiều">
                    <i class="fas fa-check-square"></i>
                    <span>Chọn nhiều</span>
                </button>
                <button class="fab-menu-item" @@click="openShortcutsModal" title="Phím tắt">
                    <i class="fas fa-keyboard"></i>
                    <span>Phím tắt</span>
                </button>
            </div>
        </transition>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/groups.css" asp-append-version="true" />
}

@section Scripts {
    <script>
