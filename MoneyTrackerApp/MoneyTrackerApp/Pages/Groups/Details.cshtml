@page "{id:long}"
@model MoneyTrackerApp.Pages.Groups.DetailsModel
@{
    ViewData["Title"] = Model.Group.Name;
    var primaryColor = !string.IsNullOrEmpty(Model.Group.Color) ? Model.Group.Color : "#3B82F6";
}

<div class="min-h-screen pb-20 bg-slate-50 dark:bg-slate-900 transition-colors">
    
    @if (Model.IsPendingMember)
    {
        <!-- Pending Invitation Overlay -->
        <div class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-md w-full p-8 text-center border border-slate-200 dark:border-slate-700">
                <div class="w-20 h-20 bg-blue-50 dark:bg-blue-900/20 rounded-full flex items-center justify-center mx-auto mb-6 text-blue-600 dark:text-blue-400">
                    <i class="fas fa-envelope-open-text text-3xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Lời mời tham gia nhóm</h2>
                <p class="text-slate-600 dark:text-slate-300 mb-8">
                    Bạn đã được mời tham gia nhóm chi tiêu <span class="font-bold text-slate-900 dark:text-white">@Model.Group.Name</span>.
                    <br>Vui lòng xác nhận để tham gia.
                </p>
                <div class="grid grid-cols-2 gap-4">
                    <form method="post" asp-page-handler="DeclineInvite" class="w-full">
                         <button type="submit" class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-xl font-bold transition-colors">
                            Từ chối
                        </button>
                    </form>
                    <form method="post" asp-page-handler="AcceptInvite" class="w-full">
                        <button type="submit" class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold shadow-lg shadow-blue-500/30 transition-colors">
                            Tham gia
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    
    <!-- Hero Header -->
    <div class="relative bg-white dark:bg-slate-800 shadow-sm border-b border-slate-200 dark:border-slate-700">
        <!-- Color Banner -->
        <div class="h-32 w-full opacity-90" style="background: linear-gradient(135deg, @primaryColor, #1e293b);"></div>
        
        <div class="container mx-auto px-4">
            <div class="relative -mt-12 flex flex-col md:flex-row items-end md:items-center justify-between gap-6 pb-6">
                
                <!-- Group Identity -->
                <div class="flex items-center gap-6">
                    <div class="h-24 w-24 rounded-2xl bg-white dark:bg-slate-800 p-1 shadow-xl ring-1 ring-slate-100 dark:ring-slate-700">
                        <div class="h-full w-full rounded-xl flex items-center justify-center text-4xl text-white shadow-inner"
                             style="background-color: @primaryColor;">
                            @if (!string.IsNullOrEmpty(Model.Group.Icon))
                            {
                                <i class="@Model.Group.Icon"></i>
                            }
                            else
                            {
                                <span class="font-bold">@Model.Group.Name.Substring(0, 1).ToUpper()</span>
                            }
                        </div>
                    </div>
                    
                    <div class="mb-2">
                        <h1 class="text-3xl font-bold text-slate-900 dark:text-white drop-shadow-sm">@Model.Group.Name</h1>
                        <div class="flex items-center text-slate-600 dark:text-slate-300 text-sm mt-1 gap-4">
                            <span class="bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded-full flex items-center gap-1.5">
                                <i class="fas fa-users text-xs"></i> @Model.Group.GroupMembers.Count thành viên
                            </span>
                            @if(!string.IsNullOrEmpty(Model.Group.Description)) {
                                <span class="max-w-md truncate hidden md:inline-block border-l border-slate-300 dark:border-slate-600 pl-4">
                                    @Model.Group.Description
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-3 mb-2">
                    <button onclick="openReportModal()" class="px-4 py-2 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-600 font-medium shadow-sm transition-colors flex items-center gap-2">
                        <i class="fas fa-chart-pie"></i> <span class="hidden sm:inline">Báo cáo</span>
                    </button>
                    @if (Model.Group.CreatedByUserId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <button onclick="openSettingsModal()" class="px-4 py-2 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-600 font-medium shadow-sm transition-colors flex items-center gap-2">
                            <i class="fas fa-cog"></i> <span class="hidden sm:inline">Cài đặt</span>
                        </button>
                    }
                    <button onclick="openAddExpenseModal()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-lg shadow-blue-500/30 transition-all hover:-translate-y-0.5 font-medium flex items-center gap-2">
                        <i class="fas fa-plus"></i> <span>Thêm chi tiêu</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 mt-8">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800 flex items-center justify-between shadow-sm animate-fade-in-down">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-800 flex items-center justify-center text-green-600 dark:text-green-400">
                        <i class="fas fa-check"></i>
                    </div>
                    <span class="font-medium">@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-green-600 dark:text-green-400 hover:text-green-800 dark:hover:text-green-200">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 flex items-center justify-between shadow-sm animate-fade-in-down">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-800 flex items-center justify-center text-red-600 dark:text-red-400">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <span class="font-medium">@TempData["ErrorMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-200">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Left Panel: Stats & Transactions (8 cols) -->
            <div class="lg:col-span-8 space-y-8">
                
                <!-- Personal Summary Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <!-- Total Spend Card -->
                    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-8 h-8 rounded-full bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                                <i class="fas fa-receipt text-xs"></i>
                            </div>
                            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Tổng chi tiêu</span>
                        </div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">@Model.TotalGroupSpending.ToString("C0")</p>
                    </div>

                    <!-- You Paid Card -->
                    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-8 h-8 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                                <i class="fas fa-wallet text-xs"></i>
                            </div>
                            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Bạn đã trả</span>
                        </div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">@Model.CurrentUserPaid.ToString("C0")</p>
                    </div>

                    <!-- Balance Card -->
                    @{
                        var isOwed = Model.CurrentUserBalance >= 0;
                        var balanceColorClass = isOwed ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400";
                        var balanceBgClass = isOwed ? "bg-emerald-50 dark:bg-emerald-900/20" : "bg-rose-50 dark:bg-rose-900/20";
                    }
                    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 relative overflow-hidden">
                        <div class="absolute right-0 top-0 p-3 opacity-5">
                            <i class="fas fa-scale-balanced text-6xl"></i>
                        </div>
                        <div class="flex items-center gap-3 mb-2">
                             <div class="w-8 h-8 rounded-full @balanceBgClass flex items-center justify-center">
                                <i class="fas @(isOwed ? "fa-arrow-down" : "fa-arrow-up") text-xs @balanceColorClass"></i>
                            </div>
                            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Số dư của bạn</span>
                        </div>
                        <p class="text-2xl font-bold @balanceColorClass">
                             @Math.Abs(Model.CurrentUserBalance).ToString("C0")
                        </p>
                        <p class="text-xs text-slate-400 mt-1">
                            @(isOwed ? "Bạn được trả" : "Bạn nợ")
                        </p>
                    </div>
                </div>

                <!-- Transaction List -->
                <div id="transactions">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Giao dịch gần đây</h2>
                        <a href="#transactions" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">Xem tất cả</a>
                    </div>
                
                    @if (Model.Transactions.Count == 0)
                    {
                        <div class="bg-white dark:bg-slate-800 rounded-2xl p-10 text-center shadow-sm border border-slate-100 dark:border-slate-700">
                            <div class="inline-flex w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-700 items-center justify-center mb-4 text-slate-400">
                                <i class="fas fa-file-invoice-dollar text-2xl"></i>
                            </div>
                            <p class="text-slate-900 dark:text-white font-medium mb-1">Chưa có chi tiêu nào</p>
                            <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">Thêm chi tiêu đầu tiên để bắt đầu.</p>
                            <button onclick="openAddExpenseModal()" class="text-blue-600 font-semibold text-sm">Thêm chi tiêu</button>
                        </div>
                    }

                    <div class="space-y-4">
                        @{ DateTime? lastDate = null; }
                        @foreach (var transaction in Model.Transactions)
                        {
                            bool isNewDate = lastDate != transaction.TransactionDate.Date;
                            if (isNewDate)
                            {
                                <div class="sticky top-0 z-10 bg-slate-50/95 dark:bg-slate-900/95 backdrop-blur-sm py-2 px-1">
                                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 animate-fade-in">
                                        @transaction.TransactionDate.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                lastDate = transaction.TransactionDate.Date;
                            }

                            <!-- Transaction Item -->
                            <div class="group flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-md transition-all cursor-pointer">
                                
                                <!-- Category Icon -->
                                <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-300 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/20 group-hover:text-blue-600 transition-colors">
                                    <i class="fas fa-shopping-bag text-lg"></i>
                                </div>

                                <!-- Details -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-start">
                                        <h3 class="font-semibold text-slate-900 dark:text-white truncate">@transaction.Description</h3>
                                        <span class="font-bold text-slate-900 dark:text-white">@transaction.Amount.ToString("C0")</span>
                                    </div>
                                    <div class="flex justify-between items-center mt-1">
                                        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                                            <div class="flex items-center gap-1">
                                                <div class="w-4 h-4 rounded-full bg-slate-200 flex items-center justify-center text-[8px]">
                                                    @(transaction.PaidByUser.FullName?.Substring(0,1) ?? "?")
                                                </div>
                                                <span class="font-medium">@(transaction.PaidByUser.FullName?.Split(' ').FirstOrDefault() ?? "Unknown")</span>
                                            </div>
                                            <span>đã trả</span>
                                        </div>
                                         <div class="text-xs text-slate-400 flex items-center gap-1">
                                             @if(!string.IsNullOrEmpty(transaction.Category)) {
                                                <span class="bg-slate-100 dark:bg-slate-700 px-1.5 py-0.5 rounded text-[10px] uppercase font-bold tracking-wide">@transaction.Category</span>
                                             }
                                             @if(!string.IsNullOrEmpty(transaction.AttachmentUrl)) {
                                                 <a href="@transaction.AttachmentUrl" target="_blank" class="ml-2 text-blue-500 hover:text-blue-600 transition-colors" title="Xem hóa đơn">
                                                     <i class="fas fa-paperclip"></i>
                                                 </a>
                                             }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Panel: Members (4 cols) -->
            <div class="lg:col-span-4 space-y-6">
                <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 p-6 lg:sticky lg:top-8">
                     <div class="flex justify-between items-center mb-6">
                        <h3 class="font-bold text-slate-900 dark:text-white">Thành viên</h3>
                         <button onclick="openInviteMemberModal()" class="text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20 px-2.5 py-1.5 rounded-lg hover:bg-blue-100 transition-colors">
                             <i class="fas fa-user-plus mr-1"></i> MỜI
                         </button>
                    </div>

                    <div class="space-y-4">
                        @foreach(var member in Model.Group.GroupMembers)
                        {
                            <div class="flex items-center justify-between group p-2 hover:bg-slate-50 dark:hover:bg-slate-700/30 rounded-xl transition-colors -mx-2">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white flex items-center justify-center font-bold text-sm shadow-sm ring-2 ring-white dark:ring-slate-800 @(member.JoinedAt == null ? "opacity-50 grayscale" : "")">
                                        @Model.GetInitials(member.User.FullName)
                                    </div>
                                    <div class="@(member.JoinedAt == null ? "opacity-75" : "")">
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                                            @member.User.FullName
                                            @if(member.UserId == Model.Group.CreatedByUserId) {
                                                <span class="text-[10px] bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 px-1.5 py-0.5 rounded-md font-bold uppercase tracking-wide">Admin</span>
                                            }
                                            @if(member.JoinedAt == null) {
                                                <span class="text-[10px] bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-300 px-1.5 py-0.5 rounded-md font-bold uppercase tracking-wide">Đã mời</span>
                                            }
                                        </p>
                                        <p class="text-xs text-slate-500 truncate max-w-[140px]">@member.User.Email</p>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @foreach(var invite in Model.ExternalInvitations)
                        {
                            <div class="flex items-center justify-between group p-2 hover:bg-slate-50 dark:hover:bg-slate-700/30 rounded-xl transition-colors -mx-2">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-400 flex items-center justify-center font-bold text-sm shadow-sm ring-2 ring-white dark:ring-slate-800 opacity-75">
                                        <i class="fas fa-envelope"></i>
                                    </div>
                                    <div class="opacity-75">
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                                            @(invite.InviteEmail.Contains("@") ? invite.InviteEmail.Split('@')[0] : invite.InviteEmail)
                                            <span class="text-[10px] bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-300 px-1.5 py-0.5 rounded-md font-bold uppercase tracking-wide">Đang chờ</span>
                                        </p>
                                        <p class="text-xs text-slate-500 truncate max-w-[140px]">@invite.InviteEmail</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <form method="post" asp-page-handler="Export" class="mt-6">
                        <button type="submit" class="w-full py-3 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors flex items-center justify-center gap-2">
                            <i class="fas fa-file-export text-slate-400"></i> Xuất sao kê
                        </button>
                    </form>
                    
                    <form method="post" asp-page-handler="LeaveGroup" onsubmit="return confirm('Bạn có chắc chắn muốn rời nhóm? Dữ liệu chi tiêu của bạn sẽ vẫn được giữ lại nhưng bạn sẽ không còn quyền truy cập.');" class="mt-3">
                         <button type="submit" class="w-full py-3 border border-rose-100 dark:border-rose-900/30 bg-rose-50 dark:bg-rose-900/10 text-rose-600 dark:text-rose-400 rounded-xl text-sm font-medium hover:bg-rose-100 dark:hover:bg-rose-900/20 transition-colors">
                            Rời nhóm
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div id="addExpenseModalBackdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden transition-opacity opacity-0" aria-hidden="true">
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="relative bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-lg w-full p-6 transform scale-95 transition-transform" id="addExpenseModalContent">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">Thêm Chi Tiêu Mới</h3>
            
            <form method="post" asp-page-handler="AddExpense" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="mb-4 p-3 bg-red-50 text-red-600 rounded-lg text-sm"></div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Mô tả</label>
                        <input type="text" asp-for="ExpenseInput.Description" class="w-full rounded-xl border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 dark:text-white focus:ring-blue-500 focus:border-blue-500" required placeholder="Ví dụ: Ăn trưa, Vé xem phim...">
                        <span asp-validation-for="ExpenseInput.Description" class="text-red-500 text-xs"></span>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                             <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Số tiền (VND)</label>
                             <input type="number" id="expenseAmount" asp-for="ExpenseInput.Amount" class="w-full rounded-xl border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 dark:text-white focus:ring-blue-500 focus:border-blue-500" required min="1000" step="1000">
                             <span asp-validation-for="ExpenseInput.Amount" class="text-red-500 text-xs"></span>
                        </div>
                        <div>
                             <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Ngày</label>
                             <input type="date" asp-for="ExpenseInput.Date" class="w-full rounded-xl border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 dark:text-white focus:ring-blue-500 focus:border-blue-500" required>
                             <span asp-validation-for="ExpenseInput.Date" class="text-red-500 text-xs"></span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Người trả tiền</label>
                        <select asp-for="ExpenseInput.PaidByUserId" class="w-full rounded-xl border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 dark:text-white focus:ring-blue-500 focus:border-blue-500">
                            @foreach(var member in Model.GroupParticipants)
                            {
                                <option value="@member.Id">@member.FullName</option>
                            }
                        </select>
                        <span asp-validation-for="ExpenseInput.PaidByUserId" class="text-red-500 text-xs"></span>
                    </div>

                    <div>
                         <div class="flex justify-between items-center mb-1">
                             <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Chia tiền</label>
                             <div class="flex items-center space-x-2">
                                 <label class="inline-flex items-center cursor-pointer text-xs text-blue-600 dark:text-blue-400 font-medium">
                                     <input type="checkbox" id="selectAllSplit" checked class="form-checkbox h-3 w-3 mr-1 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                                     Chọn tất cả
                                 </label>
                             </div>
                         </div>
                         <div class="bg-slate-50 dark:bg-slate-700 p-3 rounded-xl max-h-40 overflow-y-auto space-y-2 border border-slate-200 dark:border-slate-600">
                             @foreach(var member in Model.GroupParticipants)
                             {
                                 <div class="flex items-center justify-between">
                                     <div class="flex items-center">
                                         <input type="checkbox" name="ExpenseInput.SplitUserIds" value="@member.Id" id="split_@member.Id" class="split-checkbox w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" checked>
                                         <label for="split_@member.Id" class="ml-2 text-sm font-medium text-slate-900 dark:text-gray-300">@member.FullName</label>
                                     </div>
                                 </div>
                             }
                         </div>
                         <p class="text-xs text-right mt-1 text-slate-500 dark:text-slate-400 font-medium" id="splitAmountDisplay">Mỗi người: 0đ</p>
                    </div>

                     <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Danh mục</label>
