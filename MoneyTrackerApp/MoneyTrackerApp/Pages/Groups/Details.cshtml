<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Chart Initialization
        try {
            const categoryData = @Html.Raw(Model.CategorySpendingJson ?? "[]");
            const ctx = document.getElementById('expenseChart');
            
            if (ctx && typeof Chart !== 'undefined' && categoryData && categoryData.length > 0) {
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: categoryData.map(d => d.Label),
                        datasets: [{
                            label: 'Chi tiêu',
                            data: categoryData.map(d => d.Value),
                            backgroundColor: [
                                '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#6366f1'
                            ],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
        } catch (e) {
            console.warn("Chart initialization failed:", e);
        }
        
        // Auto-Reopen Modals if Validation Failed
        @if (ViewData["ShowAddExpenseModal"] as bool? == true) {
            <text>openAddExpenseModal();</text>
        }
        @if (ViewData["ShowInviteMemberModal"] as bool? == true) {
             <text>openInviteMemberModal();</text>
        }
         @if (ViewData["ShowSettingsModal"] as bool? == true) {
             <text>openSettingsModal();</text>
        }

        // --- Split Calculation Logic ---
        const amountInput = document.getElementById('expenseAmount');
        const selectAllCheckbox = document.getElementById('selectAllSplit');
        const splitCheckboxes = document.querySelectorAll('.split-checkbox');
        const displayLabel = document.getElementById('splitAmountDisplay');

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        }

        function calculateSplit() {
            const amount = parseFloat(amountInput.value);
            if (isNaN(amount) || amount <= 0) {
                if(displayLabel) displayLabel.textContent = "Mỗi người: 0đ";
                return;
            }

            const checkedCount = Array.from(splitCheckboxes).filter(cb => cb.checked).length;
            if (checkedCount === 0) {
                 if(displayLabel) displayLabel.textContent = "Chưa chọn thành viên nào";
                return;
            }

            const perPerson = amount / checkedCount;
             if(displayLabel) displayLabel.textContent = `Mỗi người: ${formatCurrency(perPerson)}`;
        }

        // Event Listeners
        if(amountInput) {
            amountInput.addEventListener('input', calculateSplit);
        }

        if(selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function() {
                const isChecked = this.checked;
                splitCheckboxes.forEach(cb => {
                    cb.checked = isChecked;
                });
                calculateSplit();
            });
        }

        splitCheckboxes.forEach(cb => {
            cb.addEventListener('change', function() {
                if (!this.checked) {
                   if(selectAllCheckbox) selectAllCheckbox.checked = false;
                } else {
                    const allChecked = Array.from(splitCheckboxes).every(c => c.checked);
                    if(allChecked && selectAllCheckbox) selectAllCheckbox.checked = true;
                }
                calculateSplit();
            });
        });

        // --- Invite Logic ---
        const myFriendsRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FriendsList ?? new List<MoneyTrackerApp.DTOs.FriendshipDto>()));
        const currentGroupMembers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GroupParticipants.Select(p => p.Id)));
        
        let selectedUserIds = new Set();
        let searchTimeout;

        function initInviteModal() {
            renderUserList(myFriendsRaw);
            updateSelectedPreview();
        }

        // Render User List Item
        function renderUserList(users, isSearchResult = false) {
             const listContainer = document.getElementById('usersList');
             const title = document.getElementById('listTitle');
             listContainer.innerHTML = '';

             if(isSearchResult) {
                 title.textContent = `Kết quả tìm kiếm (${users.length})`;
             } else {
                 title.textContent = 'Gợi ý từ danh bạ';
             }

             if (users.length === 0) {
                 listContainer.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-full text-slate-400 py-8">
                        <i class="fas fa-search-minus text-3xl mb-2"></i>
                        <p class="text-sm">Không tìm thấy người dùng nào.</p>
                    </div>`;
                 return;
             }

             users.forEach(user => {
                 // Map DTO fields correctly (DetailsModel uses FriendshipDto for Friends, but Search might return simple object)
                 // Priority: FriendId (DTO) -> id (Search)
                 const uid = user.FriendId || user.friendId || user.id || user.Id; 
                 const name = user.FriendName || user.friendName || user.name || user.fullName;
                 const avatar = user.FriendAvatar || user.friendAvatar || user.avatar || user.profilePictureUrl; // May be null
                 const subtext = user.UserName || user.userName || user.email || "";

                 // Check if already in group
                 const isMember = currentGroupMembers.includes(uid);
                 
                 const startInitial = name ? name.charAt(0).toUpperCase() : "?";
                 const avatarHtml = avatar 
                    ? `<img src="${avatar}" class="w-10 h-10 rounded-full object-cover border border-slate-200">`
                    : `<div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 text-white flex items-center justify-center font-bold shadow-sm">${startInitial}</div>`;

                 const isSelected = selectedUserIds.has(uid);
                 const btnClass = isSelected 
                    ? "bg-green-500 hover:bg-green-600 text-white border-transparent"
                    : "bg-white dark:bg-slate-700 border-slate-200 dark:border-slate-600 text-blue-600 hover:bg-slate-50 dark:hover:bg-slate-600";
                 const btnIcon = isSelected ? "fa-check" : "fa-plus";
                 const btnText = isSelected ? "Đã chọn" : "Thêm";

                 const div = document.createElement('div');
                 div.className = `flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors border border-transparent ${isSelected ? 'bg-blue-50/50 dark:bg-blue-900/10' : ''}`;
                 
                 if (isMember) {
                     div.classList.add('opacity-60', 'grayscale');
                     div.title = "Đã là thành viên";
                 }

                 div.innerHTML = `
                    <div class="flex items-center gap-3">
                        ${avatarHtml}
                        <div>
                            <p class="text-sm font-bold text-slate-900 dark:text-white leading-tight">${name}</p>
                            <p class="text-xs text-slate-500">${subtext}</p>
                        </div>
                    </div>
                    <button type="button" 
                        onclick="${!isMember ? `toggleUserSelection(${uid}, '${name.replace(/'/g, "\\'")}', this)` : ''}"
                        class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-all shadow-sm flex items-center gap-1.5 ${isMember ? 'cursor-not-allowed bg-slate-100 text-slate-400' : btnClass}">
                        <i class="fas ${isMember ? 'fa-check' : btnIcon}"></i> ${isMember ? 'Đã tham gia' : btnText}
                    </button>
                 `;
                 listContainer.appendChild(div);
             });
        }

        window.toggleUserSelection = function(uid, name, btn) {
            if (selectedUserIds.has(uid)) {
                selectedUserIds.delete(uid);
                // Update Button State
                btn.className = "px-3 py-1.5 rounded-lg text-xs font-bold border transition-all shadow-sm flex items-center gap-1.5 bg-white dark:bg-slate-700 border-slate-200 dark:border-slate-600 text-blue-600 hover:bg-slate-50 dark:hover:bg-slate-600";
                btn.innerHTML = `<i class="fas fa-plus"></i> Thêm`;
                btn.parentElement.classList.remove('bg-blue-50/50', 'dark:bg-blue-900/10');
            } else {
                selectedUserIds.add(uid);
                // Update Button State
                btn.className = "px-3 py-1.5 rounded-lg text-xs font-bold border transition-all shadow-sm flex items-center gap-1.5 bg-green-500 hover:bg-green-600 text-white border-transparent";
                btn.innerHTML = `<i class="fas fa-check"></i> Đã chọn`;
                btn.parentElement.classList.add('bg-blue-50/50', 'dark:bg-blue-900/10');
            }
            updateSelectedPreview();
        };

        function updateSelectedPreview() {
            const container = document.getElementById('selectedUsersContainer');
            const preview = document.getElementById('selectedUsersPreview');
            
            // Update hidden inputs
            container.innerHTML = '';
            selectedUserIds.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'InviteInput.UserIds';
                input.value = id;
                container.appendChild(input);
            });

            // Update UI Preview (Optional, shows chips of selected users)
            if (selectedUserIds.size > 0) {
                preview.innerHTML = `
                    <div class="text-xs text-slate-500 w-full mb-1">Đã chọn ${selectedUserIds.size} người:</div>
                `;
                preview.classList.remove('hidden');
            } else {
                preview.classList.add('hidden');
            }
        }

        // Search Logic
        const searchInput = document.getElementById('userSearchInput');
        if(searchInput) {
            searchInput.addEventListener('input', function(e) {
                const query = e.target.value.trim();
                clearTimeout(searchTimeout);

                if (query.length === 0) {
                    renderUserList(myFriendsRaw); // Reset to friends
                    return;
                }

                searchTimeout = setTimeout(() => {
                    // Show Loading
                    document.getElementById('usersList').innerHTML = `
                         <div class="flex flex-col items-center justify-center h-full text-slate-500 py-4">
                             <i class="fas fa-spinner fa-spin text-xl mb-2"></i> 
                             <span>Đang tìm kiếm...</span>
                         </div>
                    `;

                    fetch(`?handler=SearchPeople&query=${encodeURIComponent(query)}`)
                        .then(res => res.json())
                        .then(data => {
                            renderUserList(data, true);
                        })
                        .catch(err => {
                            console.error(err);
                            document.getElementById('usersList').innerHTML = `<p class="text-center text-red-500 py-4">Lỗi tìm kiếm.</p>`;
                        });
                }, 400); // Debounce
            });
        }

        window.switchInviteTab = function(tabName, btn) {
            // UI Update
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('text-blue-600', 'border-blue-600');
                b.classList.add('text-slate-500', 'border-transparent');
            });
            btn.classList.add('text-blue-600', 'border-blue-600');
            btn.classList.remove('text-slate-500', 'border-transparent');

            // Content Update
            document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
            if(tabName === 'friends') {
                document.getElementById('friendsTab').classList.remove('hidden');
                document.getElementById('friendsTab').classList.add('block');
            } else {
                document.getElementById('emailTab').classList.remove('hidden');
                document.getElementById('emailTab').classList.add('block');
            }
        };

        // Initialize
        initInviteModal();

    });
</script>

