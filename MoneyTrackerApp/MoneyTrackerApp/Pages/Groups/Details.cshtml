@page "{id:int}"
@model MoneyTrackerApp.Pages.Groups.DetailsModel
@{
    ViewData["Title"] = "Chi tiết nhóm";
}

<div id="groupDetailsApp" class="group-details-container" v-cloak>
    <!-- Header -->
    <header class="details-header">
        <div class="header-left">
            <button class="btn-back" @@click="goBack">
                <i class="fas fa-arrow-left"></i>
            </button>
            <div class="header-info">
                <h1 class="group-title">{{ group.name }}</h1>
                <p class="group-description">{{ group.description }}</p>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn btn-secondary" @@click="openSettingsModal">
                <i class="fas fa-cog"></i>
                <span>Cài đặt</span>
            </button>
            <button class="btn btn-primary" @@click="openAddExpenseModal">
                <i class="fas fa-plus"></i>
                <span>Thêm chi tiêu</span>
            </button>
        </div>
    </header>

    <!-- Stats Overview -->
    <div class="stats-overview">
        <div class="stat-card primary">
            <div class="stat-icon">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tổng chi tiêu</div>
                <div class="stat-value">{{ formatCurrency(statistics.totalExpenses) }}</div>
                <div class="stat-trend" :class="statistics.expenseTrend > 0 ? 'up' : 'down'">
                    <i :class="statistics.expenseTrend > 0 ? 'fas fa-arrow-up' : 'fas fa-arrow-down'"></i>
                    {{ Math.abs(statistics.expenseTrend) }}% so với tháng trước
                </div>
            </div>
        </div>

        <div class="stat-card success">
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Thành viên</div>
                <div class="stat-value">{{ members.length }}</div>
                <div class="stat-info">{{ activeMembers }} đang hoạt động</div>
            </div>
        </div>

        <div class="stat-card warning">
            <div class="stat-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Chi tiêu trung bình</div>
                <div class="stat-value">{{ formatCurrency(statistics.averageExpense) }}</div>
                <div class="stat-info">Mỗi giao dịch</div>
            </div>
        </div>

        <div class="stat-card" :class="budgetStatus">
            <div class="stat-icon">
                <i class="fas fa-bullseye"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Ngân sách</div>
                <div class="stat-value">{{ formatCurrency(budget.limit) }}</div>
                <div class="stat-progress">
                    <div class="progress-bar">
                        <div class="progress-fill" :style="{ width: budgetPercentage + '%' }"></div>
                    </div>
                    <span>{{ budgetPercentage }}% đã sử dụng</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- Left Column -->
        <div class="left-column">
            <!-- Tabs -->
            <div class="tabs-container">
                <div class="tabs">
                    <button :class="{ active: activeTab === 'transactions' }" @@click="activeTab = 'transactions'">
                        <i class="fas fa-receipt"></i> Giao dịch
                    </button>
                    <button :class="{ active: activeTab === 'analytics' }" @@click="activeTab = 'analytics'">
                        <i class="fas fa-chart-bar"></i> Phân tích
                    </button>
                    <button :class="{ active: activeTab === 'members' }" @@click="activeTab = 'members'">
                        <i class="fas fa-users"></i> Thành viên
                    </button>
                    <button :class="{ active: activeTab === 'categories' }" @@click="activeTab = 'categories'">
                        <i class="fas fa-tags"></i> Danh mục
                    </button>
                </div>
            </div>

            <!-- Tab Content -->
            <div class="tab-content">
                <!-- Transactions Tab -->
                <div v-if="activeTab === 'transactions'" class="transactions-tab">
                    <div class="tab-header">
                        <h3>Danh sách giao dịch</h3>
                        <div class="tab-actions">
                            <select v-model="transactionFilter" class="filter-select">
                                <option value="all">Tất cả</option>
                                <option value="week">Tuần này</option>
                                <option value="month">Tháng này</option>
                                <option value="custom">Tùy chỉnh</option>
                            </select>
                        </div>
                    </div>

                    <div v-if="loading" class="loading-state">
                        <div class="spinner"></div>
                    </div>

                    <div v-else-if="filteredTransactions.length === 0" class="empty-state">
                        <i class="fas fa-receipt"></i>
                        <p>Chưa có giao dịch nào</p>
                    </div>

                    <div v-else class="transactions-list">
                        <div v-for="transaction in filteredTransactions" 
                             :key="transaction.id"
                             class="transaction-item"
                             @@click="viewTransactionDetail(transaction)">
                            <div class="transaction-icon" :style="{ background: getCategoryColor(transaction.categoryId) }">
                                <i :class="getCategoryIcon(transaction.categoryId)"></i>
                            </div>
                            <div class="transaction-info">
                                <div class="transaction-title">{{ transaction.description }}</div>
                                <div class="transaction-meta">
                                    <span class="payer">{{ transaction.paidByUserName }}</span>
                                    <span class="date">{{ formatDate(transaction.transactionDate) }}</span>
                                </div>
                            </div>
                            <div class="transaction-amount">
                                <div class="amount">{{ formatCurrency(transaction.amount) }}</div>
                                <div class="split-info" :class="getSplitClass(transaction)">
                                    {{ getSplitText(transaction) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Analytics Tab -->
                <div v-if="activeTab === 'analytics'" class="analytics-tab">
                    <div class="analytics-grid">
                        <!-- Spending by Category Chart -->
                        <div class="chart-card">
                            <h4>Chi tiêu theo danh mục</h4>
                            <canvas id="categoryChart"></canvas>
                        </div>

                        <!-- Spending Trend Chart -->
                        <div class="chart-card">
                            <h4>Xu hướng chi tiêu</h4>
                            <canvas id="trendChart"></canvas>
                        </div>

                        <!-- Member Contribution Chart -->
                        <div class="chart-card">
                            <h4>Đóng góp của thành viên</h4>
                            <canvas id="memberChart"></canvas>
                        </div>

                        <!-- Top Categories -->
                        <div class="chart-card">
                            <h4>Danh mục chi tiêu nhiều nhất</h4>
                            <div class="top-categories">
                                <div v-for="(cat, index) in topCategories" :key="cat.id" class="category-item">
                                    <div class="category-rank">{{ index + 1 }}</div>
                                    <div class="category-info">
                                        <div class="category-name">{{ cat.name }}</div>
                                        <div class="category-progress">
                                            <div class="progress-bar">
                                                <div class="progress-fill" :style="{ width: cat.percentage + '%', background: cat.color }"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="category-amount">{{ formatCurrency(cat.amount) }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Members Tab -->
                <div v-if="activeTab === 'members'" class="members-tab">
                    <div class="tab-header">
                        <h3>Quản lý thành viên</h3>
                        <button class="btn btn-primary btn-sm" @@click="openAddMemberModal">
                            <i class="fas fa-user-plus"></i> Thêm thành viên
                        </button>
                    </div>

                    <div class="members-list">
                        <div v-for="member in members" :key="member.userId" class="member-card">
                            <div class="member-avatar">
                                <img v-if="member.avatarUrl" :src="member.avatarUrl" :alt="member.userName">
                                <span v-else>{{ member.userName.charAt(0).toUpperCase() }}</span>
                            </div>
                            <div class="member-info">
                                <div class="member-name">
                                    {{ member.userName }}
                                    <span v-if="member.userId == group.createdByUserId" class="badge badge-owner">Chủ nhóm</span>
                                    <span v-else-if="member.role === 'admin'" class="badge badge-admin">Quản trị</span>
                                </div>
                                <div class="member-stats">
                                    <span><i class="fas fa-receipt"></i> {{ member.transactionCount }} giao dịch</span>
                                    <span><i class="fas fa-coins"></i> {{ formatCurrency(member.totalPaid) }}</span>
                                </div>
                            </div>
                            <div class="member-balance" :class="getBalanceClass(member.balance)">
                                <div class="balance-label">{{ getBalanceLabel(member.balance) }}</div>
                                <div class="balance-amount">{{ formatCurrency(Math.abs(member.balance)) }}</div>
                            </div>
                            <div class="member-actions" v-if="canManageMembers">
                                <button class="btn-icon" @@click="editMemberRole(member)" title="Chỉnh sửa quyền">
                                    <i class="fas fa-user-cog"></i>
                                </button>
                                <button class="btn-icon danger" @@click="removeMember(member)" title="Xóa khỏi nhóm">
                                    <i class="fas fa-user-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Categories Tab -->
                <div v-if="activeTab === 'categories'" class="categories-tab">
                    <div class="tab-header">
                        <h3>Quản lý danh mục</h3>
                        <button class="btn btn-primary btn-sm" @@click="openAddCategoryModal">
                            <i class="fas fa-plus"></i> Thêm danh mục
                        </button>
                    </div>

                    <div class="categories-grid">
                        <div v-for="category in categories" :key="category.id" class="category-card">
                            <div class="category-header">
                                <div class="category-icon" :style="{ background: category.color }">
                                    <i :class="category.icon"></i>
                                </div>
                                <div class="category-info">
                                    <div class="category-name">{{ category.name }}</div>
                                    <div class="category-count">{{ category.transactionCount }} giao dịch</div>
                                </div>
                                <div class="category-actions">
                                    <button class="btn-icon" @@click="editCategory(category)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon danger" @@click="deleteCategory(category)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="category-stats">
                                <div class="stat">
                                    <span class="label">Tổng chi tiêu</span>
                                    <span class="value">{{ formatCurrency(category.totalAmount) }}</span>
                                </div>
                                <div class="stat">
                                    <span class="label">Trung bình</span>
                                    <span class="value">{{ formatCurrency(category.averageAmount) }}</span>
                                </div>
                            </div>
                            <div class="category-budget" v-if="category.budgetLimit">
                                <div class="budget-header">
                                    <span>Ngân sách</span>
                                    <span>{{ formatCurrency(category.budgetLimit) }}</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" 
                                         :style="{ width: (category.totalAmount / category.budgetLimit * 100) + '%' }"
                                         :class="{ 'over-budget': category.totalAmount > category.budgetLimit }"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Sidebar -->
        <aside class="right-column">
            <!-- Balance Summary -->
            <div class="sidebar-card">
                <h4>Tổng quan số dư</h4>
                <div class="balance-summary">
                    <div class="balance-item positive">
                        <div class="balance-icon">
                            <i class="fas fa-arrow-down"></i>
                        </div>
                        <div class="balance-info">
                            <div class="balance-label">Bạn được nhận</div>
                            <div class="balance-value">{{ formatCurrency(myBalance.receivable) }}</div>
                        </div>
                    </div>
                    <div class="balance-item negative">
                        <div class="balance-icon">
                            <i class="fas fa-arrow-up"></i>
                        </div>
                        <div class="balance-info">
                            <div class="balance-label">Bạn cần trả</div>
                            <div class="balance-value">{{ formatCurrency(myBalance.payable) }}</div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-success btn-block" @@click="openSettleUpModal">
                    <i class="fas fa-hand-holding-usd"></i> Thanh toán nợ
                </button>
            </div>

            <!-- Budget Alerts -->
            <div class="sidebar-card" v-if="budgetAlerts.length > 0">
                <h4>Cảnh báo ngân sách</h4>
                <div class="alerts-list">
                    <div v-for="alert in budgetAlerts" :key="alert.id" class="alert-item" :class="alert.severity">
                        <div class="alert-icon">
                            <i :class="alert.icon"></i>
                        </div>
                        <div class="alert-content">
                            <div class="alert-title">{{ alert.title }}</div>
                            <div class="alert-message">{{ alert.message }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="sidebar-card">
                <h4>Hành động nhanh</h4>
                <div class="quick-actions">
                    <button class="quick-action-btn" @@click="openAddExpenseModal">
                        <i class="fas fa-plus-circle"></i>
                        <span>Thêm chi tiêu</span>
                    </button>
                    <button class="quick-action-btn" @@click="openSettleUpModal">
                        <i class="fas fa-exchange-alt"></i>
                        <span>Thanh toán</span>
                    </button>
                    <button class="quick-action-btn" @@click="exportData">
                        <i class="fas fa-download"></i>
                        <span>Xuất dữ liệu</span>
                    </button>
                    <button class="quick-action-btn" @@click="shareGroup">
                        <i class="fas fa-share-alt"></i>
                        <span>Chia sẻ</span>
                    </button>
                </div>
            </div>
        </aside>
    </div>

    <!-- Toast Notification -->
    <transition name="toast">
        <div v-if="toast.show" class="toast" :class="toast.type">
            <i class="fas" :class="toast.icon"></i>
            <span>{{ toast.message }}</span>
        </div>
    </transition>
    
    <!-- Modals -->
    <teleport to="body">
        <!-- Expense Modal -->
        <div v-if="showExpenseModal" class="modal-overlay" @@click.self="closeExpenseModal">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>{{ currentExpense.id ? 'Chỉnh sửa chi tiêu' : 'Thêm chi tiêu mới' }}</h3>
                    <button class="btn-close" @@click="closeExpenseModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="modal-body">
                    <div class="form-group">
                        <label>Mô tả <span class="required">*</span></label>
                        <input 
                            type="text" 
                            v-model="currentExpense.description" 
                            placeholder="Ví dụ: Ăn trưa, Xăng xe..."
                            class="form-control"
                        />
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Số tiền <span class="required">*</span></label>
                            <input 
                                type="number" 
                                v-model="currentExpense.amount" 
                                placeholder="0"
                                class="form-control"
                                min="0"
                            />
                        </div>
                        
                        <div class="form-group">
                            <label>Danh mục</label>
                            <select v-model="currentExpense.categoryId" class="form-control">
                                <option :value="null">Chọn danh mục</option>
                                <option v-for="cat in categories" :key="cat.id" :value="cat.id">
                                    {{ cat.name }}
                                </option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label>Người trả <span class="required">*</span></label>
                        <select v-model="currentExpense.paidByUserId" class="form-control">
                            <option v-for="member in members" :key="member.userId" :value="member.userId">
                                {{ member.userName }}
                            </option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label>Ngày giao dịch</label>
                        <input 
                            type="date" 
                            v-model="currentExpense.transactionDate" 
                            class="form-control"
                        />
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button class="btn btn-secondary" @@click="closeExpenseModal">Hủy</button>
                    <button class="btn btn-primary" @@click="saveExpense" :disabled="!currentExpense.description || !currentExpense.amount">
                        {{ currentExpense.id ? 'Cập nhật' : 'Thêm' }}
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Add Member Modal -->
        <div v-if="showAddMemberModal" class="modal-overlay" @@click.self="closeAddMemberModal">
            <div class="modal-container modal-sm">
                <div class="modal-header">
                    <h3>Thêm thành viên</h3>
                    <button class="btn-close" @@click="closeAddMemberModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="modal-body">
                    <div class="form-group">
                        <label>Tìm kiếm bạn bè</label>
                        <input 
                            type="text" 
                            v-model="friendSearch" 
                            placeholder="Nhập tên hoặc email..."
                            class="form-control"
                        />
                    </div>
                    
                    <div class="friends-list">
                        <div 
                            v-for="friend in filteredFriends" 
                            :key="friend.id"
                            class="friend-item"
                            @@click="selectedFriend = friend"
                        >
                            <div class="friend-avatar">
                                {{ friend.userName.charAt(0).toUpperCase() }}
                            </div>
                            <div class="friend-info">
                                <div class="friend-name">{{ friend.userName }}</div>
                                <div class="friend-email">{{ friend.email }}</div>
                            </div>
                            <i v-if="selectedFriend?.id === friend.id" class="fas fa-check text-success"></i>
                        </div>
                        
                        <div v-if="filteredFriends.length === 0" class="empty-state">
                            <i class="fas fa-user-friends"></i>
                            <p>Không tìm thấy bạn bè</p>
                        </div>
                    </div>
                    
                    <div v-if="selectedFriend" class="form-group">
                        <label>Vai trò</label>
                        <select v-model="newMemberRole" class="form-control">
                            <option value="Member">Thành viên</option>
                            <option value="Admin">Quản trị viên</option>
                        </select>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button class="btn btn-secondary" @@click="closeAddMemberModal">Hủy</button>
                    <button class="btn btn-primary" @@click="addMember" :disabled="!selectedFriend">
                        Thêm
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Settle Up Modal -->
        <div v-if="showSettleUpModal" class="modal-overlay" @@click.self="closeSettleUpModal">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>Thanh toán nợ</h3>
                    <button class="btn-close" @@click="closeSettleUpModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="modal-body">
                    <div class="settlements-list">
                        <div v-for="settlement in settlements" :key="settlement.id" class="settlement-item">
                            <div class="settlement-info">
                                <div class="settlement-from">
                                    <div class="avatar">{{ settlement.fromUserName.charAt(0) }}</div>
                                    <span>{{ settlement.fromUserName }}</span>
                                </div>
                                <div class="settlement-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                    <div class="settlement-amount">{{ formatCurrency(settlement.amount) }}</div>
                                </div>
                                <div class="settlement-to">
                                    <div class="avatar">{{ settlement.toUserName.charAt(0) }}</div>
                                    <span>{{ settlement.toUserName }}</span>
                                </div>
                            </div>
                            <button 
                                class="btn btn-sm btn-success"
                                @@click="settleDebt(settlement)"
                            >
                                <i class="fas fa-check"></i> Đã thanh toán
                            </button>
                        </div>
                        
                        <div v-if="settlements.length === 0" class="empty-state">
                            <i class="fas fa-check-circle text-success"></i>
                            <p>Tất cả đã thanh toán!</p>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button class="btn btn-secondary" @@click="closeSettleUpModal">Đóng</button>
                </div>
            </div>
        </div>
        
        <!-- Settings Modal -->
        <div v-if="showSettingsModal" class="modal-overlay" @@click.self="closeSettingsModal">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>Cài đặt nhóm</h3>
                    <button class="btn-close" @@click="closeSettingsModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="modal-body">
                    <div class="form-group">
                        <label>Tên nhóm</label>
                        <input 
                            type="text" 
                            v-model="groupSettings.name" 
                            class="form-control"
                        />
                    </div>
                    
                    <div class="form-group">
                        <label>Mô tả</label>
                        <textarea 
                            v-model="groupSettings.description" 
                            class="form-control"
                            rows="3"
                        ></textarea>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button class="btn btn-secondary" @@click="closeSettingsModal">Hủy</button>
                    <button class="btn btn-primary" @@click="saveSettings">
                        Lưu thay đổi
                    </button>
                </div>
            </div>
        </div>
    </teleport>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/group-details.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.groupId = @Model.GroupId;
        window.currentUserId = '@Model.CurrentUserId';
    </script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/group-details.js" asp-append-version="true"></script>
}
